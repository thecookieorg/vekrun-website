---
/** The global footer: the mark and one line, two short link columns, the legal line. */
import Logo from './Logo.astro';
import { footerColumns, site } from '@/data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container-site py-14">
    <div class="grid gap-10 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:gap-16">
      <div class="max-w-xs">
        <Logo />
        <p class="mt-4 text-[0.95rem] leading-relaxed text-text-2">{site.headline}</p>
      </div>
      {footerColumns.map((col) => (
        <nav aria-label={col.title}>
          <h2 class="text-[0.75rem] font-[560] uppercase tracking-[0.06em] text-text-3">{col.title}</h2>
          <ul class="mt-3 space-y-2">
            {col.items.map((item) => <li><a href={item.href} class="footer-link">{item.label}</a></li>)}
          </ul>
        </nav>
      ))}
    </div>
    <p class="mt-12 border-t border-border pt-6 text-[0.8125rem] text-text-3">© {year} Vekrun. Proprietary software. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); background: var(--background-secondary); }
  .footer-link { font-size: 0.9375rem; color: var(--foreground-secondary); transition: color var(--dur-fast); }
  .footer-link:hover { color: var(--foreground); }
  .footer-link:focus-visible { color: var(--foreground); }
</style>
