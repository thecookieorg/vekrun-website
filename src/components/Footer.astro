---
import Logo from './Logo.astro';
import { footerColumns, site } from '@/data/site';
const year = new Date().getFullYear();
---
<footer class="border-t border-border bg-bg-elevated">
  <div class="container-site py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_repeat(3,minmax(0,1fr))]">
      <div class="max-w-xs">
        <Logo />
        <p class="mt-4 text-[0.9375rem] leading-relaxed text-text-2">{site.tagline}</p>
        <p class="mt-3 text-[0.8125rem] leading-relaxed text-text-3">
          Free and open source. No Vekrun account, no Vekrun subscription. Third-party model providers and the machines you run workers on may have their own costs.
        </p>
      </div>
      {footerColumns.map((col) => (
        <nav aria-label={col.title}>
          <h2 class="text-[0.8125rem] font-[560] text-text">{col.title}</h2>
          <ul class="mt-3 space-y-2">
            {col.items.map((item) => (
              <li><a href={item.href} class="text-[0.9rem] text-text-2 transition-colors hover:text-text">{item.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="mt-12 flex flex-col gap-3 border-t border-border pt-6 text-[0.8125rem] text-text-3 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Vekrun contributors. Source code will be published under the {site.license.name} ({site.license.status}).</p>
      <p>
        {site.repo.public
          ? <a href={site.repo.url} class="hover:text-text" target="_blank" rel="noopener noreferrer">Source on GitHub</a>
          : <span>Source repository: not yet public. <a href="/roadmap/" class="underline underline-offset-2 hover:text-text">See the roadmap</a>.</span>}
      </p>
    </div>
  </div>
</footer>
