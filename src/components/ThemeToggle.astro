---
import { Sun, Moon } from '@lucide/astro';
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<button
  type="button"
  data-theme-toggle
  class:list={['theme-toggle', className]}
  aria-label="Switch to light theme"
  title="Switch theme"
>
  <Sun class="theme-icon-sun h-4 w-4" aria-hidden="true" />
  <Moon class="theme-icon-moon h-4 w-4" aria-hidden="true" />
</button>

<style>
  .theme-toggle { display: inline-flex; height: 2.25rem; width: 2.25rem; align-items: center; justify-content: center; border-radius: 8px; border: 1px solid var(--border); color: var(--text-2); background: transparent; transition: color var(--dur-fast), border-color var(--dur-fast), background-color var(--dur-fast); }
  .theme-toggle:hover { color: var(--text); border-color: var(--border-strong); background: var(--surface); }
  :global(:root[data-theme='dark']) .theme-icon-moon { display: none; }
  :global(:root[data-theme='light']) .theme-icon-sun { display: none; }
</style>

<script>
  const KEY = 'starlight-theme';
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const label = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    buttons.forEach((b) => b.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme'));
  };
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      document.querySelector('meta[data-theme-color]')?.setAttribute('content', next === 'light' ? '#f5f7fb' : '#080b12');
      try { localStorage.setItem(KEY, next); } catch {}
      label();
    }),
  );
  label();
</script>
