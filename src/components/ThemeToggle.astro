---
/**
 * Theme choice: system, light or dark, as three small buttons that read as one
 * control. The choice persists in localStorage ('vekrun-theme'); 'system'
 * follows the operating system and updates live. The inline script in
 * Base.astro applies the theme before first paint.
 */
import { Monitor, Sun, Moon } from '@lucide/astro';
interface Props { class?: string }
const { class: className = '' } = Astro.props;
const options = [
  { value: 'system', label: 'Use system theme', Icon: Monitor },
  { value: 'light', label: 'Use light theme', Icon: Sun },
  { value: 'dark', label: 'Use dark theme', Icon: Moon },
];
---
<div class:list={['theme-toggle', className]} role="group" aria-label="Theme" data-theme-toggle>
  {options.map(({ value, label, Icon }) => (
    <button type="button" class="theme-opt" data-value={value} aria-label={label} title={label} aria-pressed="false">
      <Icon class="h-3.5 w-3.5" aria-hidden="true" />
    </button>
  ))}
</div>

<style>
  .theme-toggle { display: inline-flex; align-items: center; gap: 2px; padding: 2px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--background); }
  .theme-opt { display: inline-flex; height: 1.9rem; width: 1.9rem; align-items: center; justify-content: center; border: 0; border-radius: 7px; background: transparent; color: var(--foreground-muted); cursor: pointer; transition: color var(--dur-fast), background-color var(--dur-fast); }
  .theme-opt:hover { color: var(--foreground); }
  .theme-opt[aria-pressed='true'] { color: var(--foreground); background: var(--surface-elevated); }
  .theme-opt:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 0; }
  @media (prefers-reduced-motion: reduce) { .theme-opt { transition: none; } }
</style>

<script>
  const KEY = 'vekrun-theme';
  const html = document.documentElement;
  const groups = document.querySelectorAll<HTMLElement>('[data-theme-toggle]');
  const sync = () => {
    const choice = html.dataset.themeChoice ?? 'system';
    groups.forEach((g) => g.querySelectorAll<HTMLButtonElement>('[data-value]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.value === choice))));
  };
  groups.forEach((g) =>
    g.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-value]');
      if (!btn) return;
      const choice = btn.dataset.value!;
      (window as unknown as { __vekrunTheme?: { apply: (c: string) => void } }).__vekrunTheme?.apply(choice);
      try { localStorage.setItem(KEY, choice); } catch {}
      sync();
    }),
  );
  sync();
</script>
