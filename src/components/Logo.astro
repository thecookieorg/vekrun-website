---
/** The Vekrun mark: a prompt chevron folded into a V with a block cursor, on a gradient-edged tile. */
interface Props { class?: string; size?: number; wordmark?: boolean }
const { class: className = '', size = 26, wordmark = true } = Astro.props;
const id = `vk-${Math.random().toString(36).slice(2, 7)}`;
---
<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true" class="shrink-0">
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="var(--accent)" /><stop offset="1" stop-color="var(--accent-2)" />
      </linearGradient>
    </defs>
    <rect x="1" y="1" width="30" height="30" rx="8" fill="var(--surface-2)" stroke={`url(#${id})`} stroke-opacity="0.7" />
    <path d="M8.5 9.5 16 22.5 23.5 9.5" stroke={`url(#${id})`} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    <rect x="19.5" y="20" width="5" height="3" rx="0.75" fill="var(--text)" />
  </svg>
  {wordmark && <span class="font-sans font-[600] tracking-[-0.025em] text-[1.0625rem] text-text">Vekrun</span>}
</span>
