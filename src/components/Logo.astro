---
interface Props { class?: string; size?: number; wordmark?: boolean }
const { class: className = '', size = 26, wordmark = true } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true" class="shrink-0">
    <rect x="1" y="1" width="30" height="30" rx="8" fill="var(--surface-2)" stroke="var(--border-strong)" />
    <path d="M8.5 9.5 16 22.5 23.5 9.5" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    <rect x="19.5" y="20" width="5" height="3" rx="0.75" fill="var(--text)" />
  </svg>
  {wordmark && <span class="font-sans font-[600] tracking-[-0.02em] text-[1.0625rem] text-text">Vekrun</span>}
</span>
