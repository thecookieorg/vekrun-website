---
/** The review inbox as a concept: requests for you, teammates' PRs, and a native finding with a suggestion. */
import Mock from './Mock.astro';
import ConceptNotice from '@/components/ConceptNotice.astro';
---
<Mock title="review inbox" tabs={['Requested from you (2)', 'Teammates (5)', 'Mine (1)']}>
  <div class="grid grid-cols-1 divide-y divide-border sm:grid-cols-[1fr_1.4fr] sm:divide-x sm:divide-y-0">
    <ul class="divide-y divide-border text-[0.78rem]">
      <li class="bg-accent-soft p-3"><p class="font-[560] text-text">#88 Add GitHub OAuth provider</p><p class="mt-0.5 text-text-3">api · feat/github-oauth · requested 2h ago</p></li>
      <li class="p-3"><p class="font-[560] text-text">#91 Retry provider errors with backoff</p><p class="mt-0.5 text-text-3">gateway · fix/retries · requested 1d ago</p></li>
    </ul>
    <div class="p-4 text-[0.78rem]">
      <p class="font-mono text-text-3">src/auth/providers/github.rs:52</p>
      <pre class="mt-2 overflow-x-auto rounded-md border border-border bg-term-bg p-3 font-mono leading-relaxed text-term-fg"><code><span class="text-danger">- if state == expected_state &#123;</span>
<span class="text-ok">+ if constant_time_eq(state.as_bytes(), expected_state.as_bytes()) &#123;</span></code></pre>
      <p class="mt-3 text-text"><span class="text-accent">Review engine</span>  State token compared with <code class="font-mono">==</code>, which is timing-dependent. Suggested a constant-time comparison.</p>
      <p class="mt-2 text-text-3">Correctness · one finding · evidence: diff lines 48–56. Awaiting your decision: post suggestion, dismiss, or ask the Review Council.</p>
    </div>
  </div>
</Mock>
<ConceptNotice class="mt-3" />
