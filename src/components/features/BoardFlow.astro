---
/** The Board's core sequence. It is a real sequence, so the steps are numbered. */
import ConceptNotice from '@/components/ConceptNotice.astro';
const steps = [
  { title: 'Select a ticket', body: 'Your assigned work from every connected provider, in one Kanban. The card keeps its source identity and a link back to the original.', mock: 'ticket' },
  { title: 'Start Work', body: 'Vekrun creates a branch from your naming template, a Git worktree, and a terminal in it. Choose Manual, AI Agent or Factory.', mock: 'start' },
  { title: 'Build', body: 'Work yourself, hand the ticket to one agent as framed context, or let Factory plan and delegate. The ticket text is data, never instructions.', mock: 'build' },
  { title: 'Review', body: 'Diffs, test evidence and verification reports gather on the ticket. Nothing merges without your approval.', mock: 'review' },
  { title: 'Deliver', body: 'The pull request links back to the ticket and the status moves in the provider, once you confirm the transition.', mock: 'deliver' },
];
---
<ol class="board-flow" aria-label="From ticket to delivery, in order">
  {steps.map((s, i) => (
    <li class="board-flow__step">
      <div class="board-flow__mock" aria-hidden="true">
        {s.mock === 'ticket' && (
          <div class="bf-card">
            <span class="bf-key">VEK-142</span>
            <span class="bf-title">Add OAuth sign-in for GitHub</span>
            <span class="bf-meta"><i class="bf-pill">Linear</i><i class="bf-pill">High</i></span>
          </div>
        )}
        {s.mock === 'start' && (
          <div class="bf-menu">
            <span class="bf-menu__head">Start Work</span>
            <span class="bf-menu__item">Manual</span>
            <span class="bf-menu__item bf-menu__item--on">AI Agent</span>
            <span class="bf-menu__item">Factory</span>
            <span class="bf-menu__foot">feat/vek-142-oauth · worktree</span>
          </div>
        )}
        {s.mock === 'build' && (
          <div class="bf-term">
            <span><b class="bf-g">$</b> cargo test -p auth</span>
            <span class="bf-d">running 12 tests</span>
            <span class="bf-d">test oauth::callback ... <b class="bf-g">ok</b></span>
            <span class="bf-d">agent: diff ready for approval</span>
          </div>
        )}
        {s.mock === 'review' && (
          <div class="bf-review">
            <span class="bf-review__row"><b class="bf-g">+</b> src/auth/oauth.rs</span>
            <span class="bf-review__row"><b class="bf-g">+</b> tests/oauth.rs</span>
            <span class="bf-review__row bf-d">verifier: 12 passed, evidence attached</span>
            <span class="bf-review__approve">Approve merge</span>
          </div>
        )}
        {s.mock === 'deliver' && (
          <div class="bf-card">
            <span class="bf-key">VEK-142</span>
            <span class="bf-title">Add OAuth sign-in for GitHub</span>
            <span class="bf-meta"><i class="bf-pill bf-pill--ok">In Review</i><i class="bf-pill">PR #88</i></span>
          </div>
        )}
      </div>
      <div class="board-flow__text">
        <span class="board-flow__index">{i + 1}</span>
        <h3 class="board-flow__title">{s.title}</h3>
        <p class="board-flow__body">{s.body}</p>
      </div>
    </li>
  ))}
</ol>
<ConceptNotice class="mt-4" text="Product concept. The sequence is the one implemented for local tickets today; the provider names are the planned sources." />

<style>
  .board-flow { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
  .board-flow__step { background: var(--bg); display: flex; flex-direction: column; }
  .board-flow__mock { background: var(--surface); border-bottom: 1px solid var(--border); padding: 1rem; height: 11.5rem; display: flex; align-items: center; font-family: var(--font-mono); font-size: 0.6875rem; color: var(--text-2); }
  .board-flow__text { padding: 1rem 1rem 1.25rem; }
  .board-flow__index { font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent); }
  .board-flow__title { margin-top: 0.25rem; font-size: 1rem; font-weight: 580; color: var(--text); letter-spacing: -0.01em; }
  .board-flow__body { margin-top: 0.4rem; font-size: 0.875rem; line-height: 1.5; color: var(--text-2); }
  .bf-card, .bf-menu, .bf-term, .bf-review { width: 100%; display: flex; flex-direction: column; gap: 0.35rem; border: 1px solid var(--border-strong); border-radius: 8px; padding: 0.6rem 0.7rem; background: var(--bg-elevated); }
  .bf-key { color: var(--text-3); }
  .bf-title { color: var(--text); font-family: var(--font-sans); font-size: 0.8125rem; line-height: 1.3; }
  .bf-meta { display: flex; gap: 0.3rem; flex-wrap: wrap; }
  .bf-pill { font-style: normal; border: 1px solid var(--border-strong); border-radius: 999px; padding: 0.1rem 0.4rem; color: var(--text-3); }
  .bf-pill--ok { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 40%, transparent); }
  .bf-menu__head { color: var(--text-3); }
  .bf-menu__item { padding: 0.25rem 0.4rem; border-radius: 4px; color: var(--text); font-family: var(--font-sans); font-size: 0.8125rem; }
  .bf-menu__item--on { background: var(--accent-soft); color: var(--accent); }
  .bf-menu__foot { color: var(--text-3); margin-top: 0.2rem; }
  .bf-term { background: var(--term-bg); color: var(--term-fg); border-color: var(--border); }
  .bf-g { color: var(--term-green); font-weight: 500; }
  .bf-d { color: var(--term-dim); }
  .bf-review__row { color: var(--text); }
  .bf-review__approve { margin-top: 0.2rem; align-self: flex-start; background: var(--accent); color: var(--accent-ink); border-radius: 5px; padding: 0.25rem 0.5rem; font-family: var(--font-sans); font-size: 0.75rem; font-weight: 560; }
  @media (max-width: 64rem) { .board-flow { grid-template-columns: repeat(2, minmax(0, 1fr)); } .board-flow__step:last-child { grid-column: span 2; } }
  @media (max-width: 36rem) { .board-flow { grid-template-columns: 1fr; } .board-flow__step:last-child { grid-column: auto; } .board-flow__mock { height: auto; min-height: 0; } }
</style>
