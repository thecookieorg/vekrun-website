---
/**
 * The Factory architecture as an inspectable diagram. Click or focus a stage to read what it does.
 * Pure HTML/CSS plus a small script for the detail panel.
 */
import ConceptNotice from '@/components/ConceptNotice.astro';
const stages = [
  { id: 'objective', label: 'Objective', who: 'You', text: 'A goal and acceptance criteria, typed in plain language or taken from a ticket on the Board.', detail: 'Repository text and ticket content are treated as untrusted input. They inform the plan; they never change the policy.' },
  { id: 'manager', label: 'Manager', who: 'Manager agent', text: 'Reads the project, proposes a plan, decomposes it into a dependency graph of tasks and asks for your approval.', detail: 'Managers delegate under an authority that never widens: a child task cannot get more budget or tool permissions than its parent holds. Delegation depth and spawn counts are capped.' },
  { id: 'workers', label: 'Workers', who: 'Specialised agents', text: 'Developer, debugger, tester, reviewer and documentation roles each take a leased task in a separate Git worktree.', detail: 'Parallel tasks never share a working directory. A concurrency cap limits how many run at once. Every tool call goes through the policy engine and leaves an audit event.' },
  { id: 'verifier', label: 'Verifier', who: 'Independent agent', text: 'A different agent receives the objective, the acceptance criteria and the diff, runs the tests and reports with evidence.', detail: 'The implementer never attests to its own work. A pass without evidence is refused by the contract. Failure opens a bounded repair task, then re-verification, then escalation if the bound is reached.' },
  { id: 'integrator', label: 'Integrator', who: 'Integrator agent', text: 'Previews the merge of every verified branch, surfaces conflicts, and waits.', detail: 'Protected project state is never changed without approval. The merge itself is verified again before the chain closes.' },
  { id: 'approval', label: 'Approval', who: 'You', text: 'Everything waiting for a person lands in one Agent Inbox: approvals, escalations, conflicts and decisions.', detail: 'You can pause, redirect or reassign a task mid-flight. Vekrun says plainly which in-progress operations are not transactional rather than pretending they are.' },
] as const;
---
<div class="factory-diagram" data-factory-diagram>
  <ol class="factory-stages" aria-label="Factory stages, in order">
    {stages.map((s, i) => (
      <li class="factory-stage">
        <button type="button" class="factory-stage__button" data-stage={s.id} aria-pressed={i === 1 ? 'true' : 'false'} aria-describedby="factory-detail">
          <span class="factory-stage__index">{i + 1}</span>
          <span class="factory-stage__label">{s.label}</span>
          <span class="factory-stage__who">{s.who}</span>
        </button>
        {s.id === 'workers' && (
          <span class="factory-stage__fan" aria-hidden="true">
            <i>worktree a</i><i>worktree b</i><i>worktree c</i>
          </span>
        )}
      </li>
    ))}
  </ol>
  <div id="factory-detail" class="factory-detail" aria-live="polite">
    {stages.map((s, i) => (
      <div data-stage-detail={s.id} hidden={i !== 1}>
        <p class="factory-detail__title">{s.label} <span class="text-text-3">· {s.who}</span></p>
        <p class="factory-detail__text">{s.text}</p>
        <p class="factory-detail__more">{s.detail}</p>
      </div>
    ))}
  </div>
  <ConceptNotice class="mt-4" text="Architecture diagram. Stages and rules match the current source; the layout is an illustration, not a screenshot." />
</div>

<style>
  .factory-stages { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0; border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--border); }
  .factory-stage { position: relative; background: var(--surface); display: flex; flex-direction: column; }
  .factory-stage + .factory-stage { margin-left: 1px; }
  .factory-stage__button { display: flex; flex-direction: column; align-items: flex-start; gap: 0.35rem; width: 100%; text-align: left; padding: 1rem 0.9rem 1.1rem; background: transparent; border: 0; cursor: pointer; min-height: 7.5rem; transition: background-color var(--dur-fast); }
  .factory-stage__button:hover { background: var(--surface-2); }
  .factory-stage__button[aria-pressed='true'] { background: var(--accent-soft); box-shadow: inset 0 -2px 0 var(--accent); }
  .factory-stage__index { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-3); }
  .factory-stage__button[aria-pressed='true'] .factory-stage__index { color: var(--accent); }
  .factory-stage__label { font-weight: 580; letter-spacing: -0.01em; color: var(--text); font-size: 0.95rem; }
  .factory-stage__who { font-size: 0.75rem; color: var(--text-3); }
  .factory-stage__fan { display: flex; flex-direction: column; gap: 3px; padding: 0 0.9rem 0.9rem; }
  .factory-stage__fan i { font-style: normal; font-family: var(--font-mono); font-size: 0.6875rem; color: var(--text-3); padding: 0.25rem 0.5rem; border: 1px dashed var(--border-strong); border-radius: 4px; }
  .factory-detail { margin-top: 1rem; border: 1px solid var(--border); border-radius: var(--radius); padding: 1.1rem 1.25rem; background: var(--bg-elevated); min-height: 7.5rem; }
  .factory-detail__title { font-weight: 580; color: var(--text); }
  .factory-detail__text { margin-top: 0.35rem; color: var(--text-2); font-size: 0.95rem; line-height: 1.55; }
  .factory-detail__more { margin-top: 0.5rem; color: var(--text-3); font-size: 0.875rem; line-height: 1.55; }
  @media (max-width: 64rem) {
    .factory-stages { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; }
    .factory-stage + .factory-stage { margin-left: 0; }
  }
  @media (max-width: 36rem) {
    .factory-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .factory-stage__button { min-height: 6rem; padding: 0.8rem 0.75rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-factory-diagram]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-stage]');
    const details = root.querySelectorAll<HTMLElement>('[data-stage-detail]');
    buttons.forEach((b) => b.addEventListener('click', () => {
      buttons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      details.forEach((d) => { d.hidden = d.dataset.stageDetail !== b.dataset.stage; });
    }));
  });
</script>
