---
/** A numbered sequence. Only for content that really is a sequence. */
export interface Step { title: string; body: string }
interface Props { steps: Step[]; columns?: 3 | 4; class?: string; label?: string }
const { steps, columns = 3, class: className = '', label = 'Steps, in order' } = Astro.props;
---
<ol class:list={['grid gap-x-8 gap-y-6', columns === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-3', className]} aria-label={label}>
  {steps.map((s, i) => (
    <li class="border-t border-border pt-4">
      <span class="font-mono text-xs text-accent" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <h3 class="mt-1.5 text-[1rem] font-[580] text-text">{s.title}</h3>
      <p class="mt-1.5 text-[0.9rem] leading-relaxed text-text-2">{s.body}</p>
    </li>
  ))}
</ol>
