---
/** The Board as a concept: four columns, cards with their source, status and what Vekrun is doing for them. */
import Mock from './Mock.astro';
import ConceptNotice from '@/components/ConceptNotice.astro';
interface Card { id: string; title: string; src: string; tag?: string; tagTone?: 'ok' | 'warn' | 'info'; agent?: string }
const columns: { name: string; cards: Card[] }[] = [
  { name: 'To Do', cards: [
    { id: 'VEK-148', title: 'Rate-limit the webhook endpoint', src: 'Li' },
    { id: 'API-212', title: 'Expired tokens return 500 instead of 401', src: 'Ji', tag: 'Bug', tagTone: 'warn' },
    { id: '#61', title: 'Document the export format', src: 'Gh' },
  ] },
  { name: 'In Progress', cards: [
    { id: 'VEK-142', title: 'Add OAuth sign-in for GitHub', src: 'Li', agent: 'AI agent · implementing', tag: 'Tests running', tagTone: 'warn' },
    { id: 'VEK-139', title: 'Paginate the activity feed', src: 'Li', agent: 'You · feat/vek-139' },
  ] },
  { name: 'In Review', cards: [
    { id: 'API-207', title: 'Retry failed provider calls', src: 'Ji', tag: 'PR #88 · verified', tagTone: 'ok' },
  ] },
  { name: 'Done', cards: [
    { id: 'VEK-131', title: 'Shell integration marks', src: 'Li', tag: 'Merged', tagTone: 'info' },
  ] },
];
---
<Mock title="Board · all providers · assigned to you" tabs={['Board', 'Terminal', 'Agents', 'Git']}>
  <div class="kanban">
    {columns.map((c) => (
      <section class="kanban__col" aria-label={c.name}>
        <h3 class="kanban__head">{c.name} <span>{c.cards.length}</span></h3>
        {c.cards.map((k) => (
          <article class="kanban__card">
            <p class="kanban__meta"><span class="kanban__src" aria-hidden="true">{k.src}</span><span>{k.id}</span></p>
            <p class="kanban__title">{k.title}</p>
            {(k.tag || k.agent) && (
              <p class="kanban__foot">
                {k.agent && <span class="kanban__agent">{k.agent}</span>}
                {k.tag && <span class:list={['kanban__tag', k.tagTone && `kanban__tag--${k.tagTone}`]}>{k.tag}</span>}
              </p>
            )}
          </article>
        ))}
        {c.name === 'To Do' && <p class="kanban__start">Start Work</p>}
      </section>
    ))}
  </div>
</Mock>
<ConceptNotice class="mt-3" text="Product preview. The Board works with local tickets today; the Linear, Jira and GitHub sources shown are planned." />

<style>
  .kanban { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--border); }
  .kanban__col { background: var(--surface); padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
  .kanban__head { font-size: 0.75rem; font-weight: 560; color: var(--text-2); display: flex; justify-content: space-between; padding: 0 0.1rem 0.35rem; }
  .kanban__head span { color: var(--text-3); font-weight: 400; font-family: var(--font-mono); }
  .kanban__card { border: 1px solid var(--border-strong); border-radius: 8px; background: var(--bg-elevated); padding: 0.55rem 0.65rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .kanban__meta { display: flex; align-items: center; gap: 0.4rem; font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-3); }
  .kanban__src { display: inline-flex; width: 1.1rem; height: 1.1rem; align-items: center; justify-content: center; border-radius: 4px; border: 1px solid var(--border-strong); font-size: 0.6rem; color: var(--text-2); }
  .kanban__title { font-size: 0.8125rem; line-height: 1.3; color: var(--text); }
  .kanban__foot { display: flex; flex-wrap: wrap; gap: 0.3rem; font-size: 0.68rem; }
  .kanban__agent { color: var(--text-3); }
  .kanban__tag { border: 1px solid var(--border-strong); border-radius: 999px; padding: 0.08rem 0.4rem; color: var(--text-3); }
  .kanban__tag--ok { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 45%, transparent); }
  .kanban__tag--warn { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 45%, transparent); }
  .kanban__tag--info { color: var(--info); border-color: color-mix(in srgb, var(--info) 45%, transparent); }
  .kanban__start { margin-top: auto; align-self: flex-start; background: var(--accent); color: var(--accent-ink); border-radius: 5px; padding: 0.3rem 0.55rem; font-size: 0.75rem; font-weight: 560; }
  @media (max-width: 48rem) { .kanban { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 30rem) { .kanban { grid-template-columns: 1fr; } }
</style>
