---
/**
 * AI coding in one frame: pick a model, ask in the project, watch the agent read
 * files and propose a change as a diff, approve or reject it yourself, see the
 * tests you allowed run, then hand the next question to a local model.
 * Scripted first; the model picker and the Approve/Reject buttons are real.
 * Final state is in the markup.
 */
import Window from '@/components/mock/Window.astro';
import DemoControls from '@/components/mock/DemoControls.astro';

interface Props { notice?: string }
const { notice = 'Illustrative product concept. Claude, OpenAI, Gemini and OpenAI-compatible keys, Ollama and LM Studio detection, agent modes, diffs shown before writes, allowed commands and switching models per task work in the development build on macOS. Coding-agent accounts are planned.' } = Astro.props;

const providers = [
  { id: 'claude', mono: 'Cl', name: 'Claude', model: 'Claude · Sonnet', mode: 'key', billed: 'Billed by Anthropic' },
  { id: 'openai', mono: 'Op', name: 'OpenAI', model: 'OpenAI · GPT', mode: 'key', billed: 'Billed by OpenAI' },
  { id: 'gemini', mono: 'Ge', name: 'Gemini', model: 'Gemini · Pro', mode: 'key', billed: 'Billed by Google' },
  { id: 'compat', mono: '{}', name: 'Compatible endpoint', model: 'Your endpoint', mode: 'key', billed: 'Billed by your provider' },
  { id: 'ollama', mono: 'Ol', name: 'Ollama', model: 'Ollama · local model', mode: 'local', billed: 'Free, runs on your machine' },
  { id: 'lmstudio', mono: 'LM', name: 'LM Studio', model: 'LM Studio · local model', mode: 'local', billed: 'Free, runs on your machine' },
];
---
<figure class="cs" data-demo-root="coding" data-coding>
  <Window title="acme-api" crumbs={['Agent', 'Build']} class="cs-window">
    <span slot="status" class="inline-flex items-center gap-1.5"><span class="live-dot" aria-hidden="true"></span><span data-field="model">Ollama · local model</span></span>
    <span slot="status" class="hidden sm:inline" data-field="billed">Free, runs on your machine</span>

    <div class="cs-pick" role="radiogroup" aria-label="Choose a model">
      {providers.map((p, i) => (
        <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="cs-opt" data-provider={p.id} data-model={p.model} data-mode={p.mode} data-billed={p.billed} data-name={p.name}>
          <span class="cs-mono" aria-hidden="true">{p.mono}</span><span class="cs-name">{p.name}</span>
        </button>
      ))}
      <span class="cs-opt cs-opt-planned" aria-disabled="true" title="Planned"><span class="cs-mono" aria-hidden="true">Ac</span><span class="cs-name">Coding-agent accounts</span><span class="cs-planned">Planned</span></span>
      <span class="cs-keys">Keys stay in your OS keychain</span>
    </div>

    <div class="cs-body">
      <section class="cs-chat" aria-label="Conversation (simulated)">
        <div class="cs-msg cs-you">
          <span class="cs-who">You</span>
          <p><span data-type data-t="300" data-cps="30">Why does /me return 500 when the session token is expired?</span></p>
        </div>
        <div class="cs-msg cs-agent" data-t="2900">
          <span class="cs-who">Agent · <span data-field="who">Claude</span></span>
          <ul class="cs-steps">
            <li data-t="3000"><span class="cs-ic cs-read"></span>Read <code>src/auth/session.rs</code>, <code>src/routes/me.rs</code></li>
            <li data-t="4100"><span class="cs-ic cs-read"></span>Found <code>unwrap()</code> on the expired-token path at <code>session.rs:88</code></li>
            <li data-t="5000"><span class="cs-ic cs-ic-diff"></span>Proposed change · 1 file · +4 −1 · <span class="cs-wait" data-field="approve">Approved by you</span></li>
          </ul>
        </div>
        <div class="cs-msg cs-you cs-approve" data-t="7200" data-stage="approved"><span class="cs-who">You</span><p data-field="decision">Approved. Run the auth tests.</p></div>
        <div class="cs-msg cs-agent" data-t="8000" data-stage="tests">
          <span class="cs-who">Agent · <span data-field="who2">Claude</span></span>
          <ul class="cs-steps">
            <li data-t="8000"><span class="cs-ic cs-run"></span>Ran <code>cargo test --test auth</code> · allowed command</li>
            <li data-t="9600"><span class="cs-ic cs-ok"></span>9 passed · 1 new: <code>expired_token_returns_401</code></li>
          </ul>
        </div>
        <div class="cs-msg cs-you" data-t="11000" data-stage="switch">
          <span class="cs-who">You <span class="cs-switch">switched to Ollama · local model</span></span>
          <p><span data-type data-t="11200" data-cps="30">Summarise what changed for the PR description.</span></p>
        </div>
      </section>
      <aside class="cs-diffpane" aria-label="Proposed change (simulated)" data-t="5000">
        <div class="window-pane-head"><span>src/auth/session.rs</span><span data-field="diffstate">Applied</span></div>
        <div class="window-mono cs-diff" data-diff>
          <div class="diff-row diff-ctx"><span>86</span><span>pub fn current(&amp;self, token: &amp;str) -&gt; Result&lt;User&gt; &#123;</span></div>
          <div class="diff-row diff-del"><span>88</span><span>-    let claims = self.decode(token).unwrap();</span></div>
          <div class="diff-row diff-add"><span>88</span><span>+    let claims = match self.decode(token) &#123;</span></div>
          <div class="diff-row diff-add"><span>89</span><span>+        Ok(c) =&gt; c,</span></div>
          <div class="diff-row diff-add"><span>90</span><span>+        Err(Expired) =&gt; return Err(AuthError::Unauthorized),</span></div>
          <div class="diff-row diff-add"><span>91</span><span>+    &#125;;</span></div>
          <div class="diff-row diff-ctx"><span>92</span><span>    self.users.by_id(claims.sub)</span></div>
        </div>
        <div class="cs-actions" data-t="5000">
          <button type="button" class="cs-btn cs-btn-ok" data-approve>Approve</button>
          <button type="button" class="cs-btn" data-reject>Reject</button>
          <span class="cs-verdict" data-field="verdict">Approved by you · written to the worktree</span>
        </div>
      </aside>
    </div>
  </Window>
  <DemoControls notice={notice} />
</figure>

<style is:global>
  .cs-window { font-size: 0.8rem; }
  .cs-pick { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--border); background: var(--surface-2); }
  .cs-opt { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.25rem 0.6rem 0.25rem 0.3rem; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); color: var(--text-2); font-size: 0.75rem; cursor: pointer; transition: border-color var(--dur-fast), color var(--dur-fast), box-shadow var(--dur), transform var(--dur-fast) var(--ease-out); }
  .cs-opt:hover { color: var(--text); border-color: var(--border-strong); transform: translateY(-1px); }
  .cs-opt[aria-checked='true'] { color: var(--text); border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), 0 8px 24px -12px color-mix(in srgb, var(--accent) 60%, transparent); background: var(--accent-soft); }
  .cs-opt:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cs-opt-planned { cursor: default; opacity: 0.6; }
  .cs-opt-planned:hover { transform: none; border-color: var(--border); color: var(--text-2); }
  .cs-mono { display: inline-flex; width: 1.35rem; height: 1.35rem; align-items: center; justify-content: center; border-radius: 6px; background: var(--surface-3); border: 1px solid var(--border); font-family: var(--font-mono); font-size: 0.62rem; color: var(--text-2); }
  .cs-opt[aria-checked='true'] .cs-mono { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 50%, transparent); }
  .cs-planned { font-size: 0.62rem; color: var(--text-3); border: 1px solid var(--border-strong); border-radius: 999px; padding: 0.02rem 0.35rem; }
  .cs-keys { margin-left: auto; font-family: var(--font-mono); font-size: 0.66rem; color: var(--text-3); }
  @media (max-width: 47.9rem) { .cs-keys { display: none; } }
  .cs-body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1px; background: var(--border); min-height: 20rem; }
  @media (min-width: 48rem) { .cs-body { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: 22rem; } }
  .cs-chat { background: var(--surface); padding: 0.85rem 0.95rem; display: flex; flex-direction: column; gap: 0.7rem; min-width: 0; }
  .cs-msg { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.8125rem; animation: rise-sm 300ms var(--ease-out) both; }
  .cs-msg[hidden] { display: none; }
  .cs-who { font-family: var(--font-mono); font-size: 0.66rem; color: var(--text-3); }
  .cs-you p { color: var(--text); margin: 0; min-height: 1.3em; }
  .cs-approve p { color: var(--ok); }
  .cs-approve.is-rejected p { color: var(--warn); }
  .cs-switch { color: var(--accent); margin-left: 0.4rem; }
  .cs-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.3rem; color: var(--text-2); }
  .cs-steps li { display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap; }
  .cs-steps li[hidden] { display: none; }
  .cs-steps code { font-size: 0.72rem; color: var(--text); background: var(--surface-2); border: 1px solid var(--border); border-radius: 4px; padding: 0 0.3rem; }
  .cs-ic { width: 0.6rem; height: 0.6rem; border-radius: 50%; border: 1.5px solid var(--border-strong); flex-shrink: 0; }
  .cs-read { border-color: var(--info); } .cs-ic-diff { border-color: var(--warn); background: var(--warn); } .cs-run { border-color: var(--warn); } .cs-ok { border-color: var(--ok); background: var(--ok); }
  .cs-wait { color: var(--warn); }
  .cs-diffpane { background: var(--term-bg); display: flex; flex-direction: column; min-width: 0; animation: fade 300ms both; }
  .cs-diffpane[hidden] { display: none; }
  .cs-diff { padding: 0.5rem 0.4rem; overflow: hidden; transition: opacity var(--dur); }
  .cs-diff.is-rejected { opacity: 0.45; }
  .cs-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; padding: 0.6rem 0.85rem; border-top: 1px solid var(--border); margin-top: auto; }
  .cs-actions[hidden] { display: none; }
  .cs-btn { font: inherit; font-size: 0.72rem; border: 1px solid var(--border-strong); border-radius: 6px; padding: 0.3rem 0.65rem; color: var(--text-2); background: transparent; cursor: pointer; transition: background-color var(--dur-fast), color var(--dur-fast), opacity var(--dur-fast); }
  .cs-btn:hover { color: var(--text); background: var(--surface-2); }
  .cs-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cs-btn-ok { background: var(--accent); color: var(--accent-ink); border-color: transparent; font-weight: 580; }
  .cs-btn-ok:hover { background: var(--accent-strong); color: var(--accent-ink); }
  .cs-btn:disabled { opacity: 0.4; cursor: default; }
  .cs-verdict { font-family: var(--font-mono); font-size: 0.66rem; color: var(--ok); }
  .cs-verdict.is-rejected { color: var(--warn); }
  .cs-verdict[hidden] { display: none; }
  @media (max-width: 47.9rem) { .cs-diffpane { max-height: 13rem; } }
  @media (prefers-reduced-motion: reduce) { .cs-msg, .cs-diffpane { animation: none; } .cs-opt { transition: none; } .cs-opt:hover { transform: none; } }
</style>

<script>
  import { createSequence, typeSteps, type Step } from '@/scripts/sequence';

  document.querySelectorAll<HTMLElement>('[data-coding]').forEach((root) => {
    const timed = Array.from(root.querySelectorAll<HTMLElement>('[data-t]:not([data-type])'));
    const typers = Array.from(root.querySelectorAll<HTMLElement>('[data-type]'));
    const texts = typers.map((n) => n.textContent ?? '');
    const f = (n: string) => root.querySelector<HTMLElement>(`[data-field="${n}"]`)!;
    const stage = (n: string) => root.querySelector<HTMLElement>(`[data-stage="${n}"]`)!;
    const options = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="radio"]'));
    const approve = root.querySelector<HTMLButtonElement>('[data-approve]')!;
    const reject = root.querySelector<HTMLButtonElement>('[data-reject]')!;
    const diff = root.querySelector<HTMLElement>('[data-diff]')!;
    const decision = f('decision');
    let timers: number[] = [];
    const later = (t: number, fn: () => void) => timers.push(window.setTimeout(fn, t));
    const cancel = () => { timers.forEach((t) => clearTimeout(t)); timers = []; };

    const select = (btn: HTMLButtonElement, focus = false) => {
      options.forEach((o) => { const on = o === btn; o.setAttribute('aria-checked', String(on)); o.tabIndex = on ? 0 : -1; });
      f('model').textContent = btn.dataset.model ?? '';
      f('billed').textContent = btn.dataset.billed ?? '';
      if (focus) btn.focus();
    };
    const byId = (id: string) => options.find((o) => o.dataset.provider === id)!;

    const decide = (ok: boolean) => {
      approve.disabled = true; reject.disabled = true;
      f('verdict').hidden = false;
      f('verdict').textContent = ok ? 'Approved by you · written to the worktree' : 'Rejected by you · nothing written';
      f('verdict').classList.toggle('is-rejected', !ok);
      f('diffstate').textContent = ok ? 'Applied' : 'Discarded';
      f('approve').textContent = ok ? 'Approved by you' : 'Rejected by you';
      diff.classList.toggle('is-rejected', !ok);
      stage('approved').hidden = false; stage('approved').classList.toggle('is-rejected', !ok);
      decision.textContent = ok ? 'Approved. Run the auth tests.' : 'Rejected. Keep the unwrap for now and open a ticket instead.';
    };

    const reset = () => {
      cancel();
      timed.forEach((n) => { n.hidden = true; });
      typers.forEach((n) => { n.textContent = ''; });
      select(byId('claude'));
      f('who').textContent = 'Claude'; f('who2').textContent = 'Claude';
      f('diffstate').textContent = 'Proposed'; f('approve').textContent = 'Approve?';
      f('verdict').hidden = true; f('verdict').classList.remove('is-rejected'); diff.classList.remove('is-rejected');
      approve.disabled = false; reject.disabled = false;
      stage('approved').classList.remove('is-rejected'); decision.textContent = 'Approved. Run the auth tests.';
    };

    /* The picker and the decision buttons are real; using them pauses the script. */
    options.forEach((o, i) => {
      o.addEventListener('click', () => { seq.pause(); select(o); f('who').textContent = o.dataset.name ?? ''; });
      o.addEventListener('keydown', (e) => {
        const n = options.length;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); seq.pause(); select(options[(i + 1) % n]!, true); }
        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); seq.pause(); select(options[(i - 1 + n) % n]!, true); }
      });
    });
    approve.addEventListener('click', () => {
      seq.pause(); cancel(); decide(true);
      later(700, () => { stage('tests').hidden = false; stage('tests').querySelectorAll<HTMLElement>('[data-t]').forEach((n, i) => later(i * 900, () => { n.hidden = false; })); });
    });
    reject.addEventListener('click', () => { seq.pause(); cancel(); decide(false); });

    const steps: Step[] = timed.map((n) => ({ t: Number(n.dataset.t), run: () => { n.hidden = false; } }));
    typers.forEach((n, i) => steps.push(...typeSteps(() => n, texts[i]!, Number(n.dataset.t), Number(n.dataset.cps ?? 28)).steps));
    steps.push(
      { t: 7200, run: () => decide(true) },
      { t: 11000, run: () => { select(byId('ollama')); f('who2').textContent = 'Claude'; } },
    );
    const seq = createSequence(root, steps, { reset });
  });
</script>
