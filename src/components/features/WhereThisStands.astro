---
/** The one status paragraph on a feature page. Short, specific, linked to the roadmap. */
import Button from '@/components/Button.astro';
import { site } from '@/data/site';
---
<section class="border-t border-border bg-bg-elevated">
  <div class="container-site py-12 sm:py-14">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-2xl">
        <h2 class="heading-3">Where this stands</h2>
        <p class="mt-2 text-[0.9375rem] leading-relaxed text-text-2">{site.status.line} <slot /></p>
      </div>
      <Button href="/roadmap/" variant="secondary" class="shrink-0">See the roadmap</Button>
    </div>
  </div>
</section>
