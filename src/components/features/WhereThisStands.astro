---
/** The one status paragraph on a feature page. Short, specific, linked to the roadmap. */
import Button from '@/components/Button.astro';
import { site } from '@/data/site';
---
<section class="wts rule bg-bg-elevated">
  <div class="container-site py-12 sm:py-14">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-2xl">
        <p class="kicker">Where this stands</p>
        <p class="mt-3 inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1.5 text-[0.8125rem] text-text-2"><span class="h-1.5 w-1.5 rounded-full bg-warn" aria-hidden="true"></span>{site.status.label}</p>
        <p class="mt-4 text-[0.9375rem] leading-relaxed text-text-2">{site.status.line} <slot /></p>
      </div>
      <Button href="/roadmap/" variant="secondary" class="shrink-0">See the roadmap</Button>
    </div>
  </div>
</section>
