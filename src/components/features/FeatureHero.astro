---
/** Top of every feature page: the area, the claim, one paragraph. Status lives at the bottom of the page, once. */
interface Props { area: string; title: string; lede: string }
const { area, title, lede } = Astro.props;
---
<section class="relative overflow-hidden border-b border-border">
  <div class="dot-field pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="container-site relative py-16 sm:py-20 lg:py-24">
    <div class="max-w-3xl">
      <p class="text-[0.9375rem] text-text-2">{area}</p>
      <h1 class="heading-1 mt-3 text-text">{title}</h1>
      <p class="lede mt-5 measure-wide">{lede}</p>
    </div>
    <slot />
  </div>
</section>
