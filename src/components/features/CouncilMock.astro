---
/** A Council report, as a concept. Three members, one disagreement, one decision left to the person. */
import Mock from './Mock.astro';
import ConceptNotice from '@/components/ConceptNotice.astro';
const members = [
  { name: 'Architecture', model: 'Claude', pos: 'Keep sessions in the control plane; the worker only needs a lease id.' },
  { name: 'Security', model: 'local: qwen2.5', pos: 'Agrees, and asks for session tokens to be hashed at rest.' },
  { name: 'Product', model: 'Gemini', pos: 'Disagrees: a worker-side cache avoids a round-trip on every tool call.' },
];
---
<Mock title="council · session store design · round 2 of 2" tabs={['Positions', 'Critiques', 'Report']}>
  <div class="grid gap-px bg-border sm:grid-cols-3">
    {members.map((m) => (
      <div class="bg-surface p-4 text-[0.78rem]">
        <p class="font-[560] text-text">{m.name} <span class="font-mono text-text-3">· {m.model}</span></p>
        <p class="mt-2 leading-relaxed text-text-2">{m.pos}</p>
      </div>
    ))}
  </div>
  <div class="border-t border-border bg-bg-elevated p-4 text-[0.78rem]">
    <p class="text-text"><span class="text-text-3">Moderator</span>  Two of three favour control-plane ownership. Disagreement recorded: a worker-side cache trades consistency for latency. Evidence cited: crates/vekrun-control-plane/src/lease.rs, read-only.</p>
    <p class="mt-2 text-text-3">Usage: 3 members · 2 rounds · estimate 41k tokens · limit 60k · your decision is required.</p>
  </div>
</Mock>
<ConceptNotice class="mt-3" />
