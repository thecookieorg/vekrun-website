---
/** A Council session as a concept: three models, one disagreement, the decision left to you. */
import Mock from './Mock.astro';
import ConceptNotice from '@/components/ConceptNotice.astro';
const members = [
  { name: 'Architecture', model: 'Claude', pos: 'Keep sign-in sessions server-side; the client only holds an opaque id.' },
  { name: 'Security', model: 'local model', pos: 'Agrees, and asks that session tokens be hashed before they are stored.' },
  { name: 'Product', model: 'Gemini', pos: 'Disagrees: a short-lived client cache would avoid a round trip on every request.' },
];
---
<Mock title="Council · where to keep sign-in sessions · round 2 of 2" tabs={['Positions', 'Critiques', 'Report']}>
  <div class="grid gap-px bg-border sm:grid-cols-3">
    {members.map((m) => (
      <div class="bg-surface p-4 text-[0.78rem]">
        <p class="font-[560] text-text">{m.name} <span class="font-mono text-text-3">· {m.model}</span></p>
        <p class="mt-2 leading-relaxed text-text-2">{m.pos}</p>
      </div>
    ))}
  </div>
  <div class="border-t border-border bg-bg-elevated p-4 text-[0.78rem]">
    <p class="text-text"><span class="text-text-3">Summary</span>  Two of three favour server-side sessions. The disagreement is recorded: a client cache trades consistency for speed. Evidence cited from src/auth/session.rs.</p>
    <p class="mt-2 text-text-3">3 members · 2 rounds · estimated cost shown before the session · your decision is required.</p>
  </div>
</Mock>
<ConceptNotice class="mt-3" />
