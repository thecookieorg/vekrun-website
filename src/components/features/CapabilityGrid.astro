---
/** A ruled grid of capabilities. Each cell names what it is, what it does, and whether it exists today. */
import StatusBadge from '@/components/StatusBadge.astro';
import type { Availability } from '@/data/site';
export interface Capability { title: string; description: string; status: Availability; note?: string }
interface Props { items: Capability[]; columns?: 2 | 3; class?: string }
const { items, columns = 3, class: className = '' } = Astro.props;
---
<ul class:list={['ruled-grid list-none p-0 m-0', columns === 3 ? 'sm:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2', className]}>
  {items.map((c) => (
    <li class="flex flex-col gap-3 p-5 sm:p-6">
      <div class="flex items-start justify-between gap-3">
        <h3 class="heading-3 text-text">{c.title}</h3>
        <StatusBadge status={c.status} compact class="mt-0.5" />
      </div>
      <p class="text-[0.9375rem] leading-relaxed text-text-2">{c.description}</p>
      {c.note && <p class="text-[0.8125rem] leading-snug text-text-3">{c.note}</p>}
    </li>
  ))}
</ul>
