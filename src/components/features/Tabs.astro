---
/**
 * Accessible tabs: tablist/tab/tabpanel roles, arrow-key navigation, Home/End.
 * Panels are rendered server-side; the script only toggles visibility.
 */
export interface Tab { id: string; label: string }
interface Props { tabs: Tab[]; label: string; class?: string }
const { tabs, label, class: className = '' } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---
<div class:list={['tabs', className]} data-tabs>
  <div role="tablist" aria-label={label} class="flex flex-wrap gap-1 border-b border-border">
    {tabs.map((t, i) => (
      <button
        role="tab"
        type="button"
        id={`tab-${uid}-${t.id}`}
        aria-controls={`panel-${uid}-${t.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        data-tab={t.id}
        class="-mb-px rounded-t-md border-b-2 border-transparent px-3 py-2.5 text-[0.9375rem] text-text-2 transition-colors hover:text-text aria-selected:border-accent aria-selected:text-text"
      >{t.label}</button>
    ))}
  </div>
  <div data-tab-panels data-uid={uid}>
    <slot />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panelsRoot = root.querySelector<HTMLElement>('[data-tab-panels]');
    const uid = panelsRoot?.dataset.uid ?? '';
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-tab-panel]'));
    panels.forEach((p, i) => {
      p.setAttribute('role', 'tabpanel');
      p.id = `panel-${uid}-${p.dataset.tabPanel}`;
      p.setAttribute('aria-labelledby', `tab-${uid}-${p.dataset.tabPanel}`);
      p.tabIndex = 0;
      p.hidden = i !== 0;
    });
    const select = (idx: number, focus = true) => {
      tabs.forEach((t, i) => {
        t.setAttribute('aria-selected', String(i === idx));
        t.tabIndex = i === idx ? 0 : -1;
      });
      panels.forEach((p, i) => { p.hidden = i !== idx; });
      if (focus) tabs[idx]?.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i, false));
      t.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        if (e.key === 'ArrowRight') { e.preventDefault(); select(i === last ? 0 : i + 1); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); select(i === 0 ? last : i - 1); }
        else if (e.key === 'Home') { e.preventDefault(); select(0); }
        else if (e.key === 'End') { e.preventDefault(); select(last); }
      });
    });
  });
</script>
