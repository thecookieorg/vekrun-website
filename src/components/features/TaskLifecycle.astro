---
/** The fourteen task states, as a plain list grouped by phase. Names match crates/vekrun-types. */
const groups = [
  { phase: 'Before work', states: ['draft', 'ready', 'queued'] },
  { phase: 'In flight', states: ['claimed', 'running', 'waiting-on-dependency', 'waiting-for-approval'] },
  { phase: 'Closing', states: ['verifying', 'integrating', 'completed', 'archived'] },
  { phase: 'Stopped', states: ['blocked', 'failed', 'cancelled'] },
];
---
<div class="ruled-grid sm:grid-cols-2 lg:grid-cols-4">
  {groups.map((g) => (
    <div class="p-5">
      <p class="text-sm font-[560] text-text">{g.phase}</p>
      <ul class="mt-3 space-y-1.5 font-mono text-[0.8125rem] text-text-2">
        {g.states.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  ))}
</div>
