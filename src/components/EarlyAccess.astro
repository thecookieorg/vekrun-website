---
/**
 * Request early access. There is no form backend: the form composes an email
 * to `site.earlyAccess.email` and opens it in the visitor's own email app, so
 * nothing is sent until they press send. Without JavaScript the browser's
 * native mailto submission does the same. `?edition=teams` preselects Teams.
 */
import Button from '@/components/Button.astro';
import { site } from '@/data/site';
const to = site.earlyAccess.email;
---
<form class="ea" action={`mailto:${to}`} method="post" enctype="text/plain" data-ea data-to={to}>
  <fieldset class="ea-f">
    <legend class="ea-l">Which edition?</legend>
    <div class="ea-seg">
      <label><input type="radio" name="edition" value="Personal" checked /><span>Personal<small>Free, on your computer</small></span></label>
      <label><input type="radio" name="edition" value="Teams" /><span>Teams<small>Your team, your servers</small></span></label>
    </div>
  </fieldset>
  <div class="ea-row">
    <label class="ea-field"><span class="ea-l">Your name</span><input name="name" autocomplete="name" required /></label>
    <label class="ea-field"><span class="ea-l">Your computer</span>
      <select name="platform"><option>macOS</option><option>Windows</option><option>Linux</option></select>
    </label>
  </div>
  <label class="ea-field" data-team><span class="ea-l">Engineers on the team <small>(optional)</small></span><input name="engineers" inputmode="numeric" /></label>
  <label class="ea-field"><span class="ea-l">What would you hand Vekrun first? <small>(optional)</small></span><textarea name="first" rows="3"></textarea></label>
  <div class="ea-go">
    <Button type="submit" size="lg">Write the email</Button>
    <p>Opens a message to <a href={`mailto:${to}?subject=${encodeURIComponent('Vekrun early access')}`} class="text-accent link-slide">{to}</a> in your email app. Nothing is sent until you send it.</p>
  </div>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-ea]')) {
    const team = form.querySelector<HTMLElement>('[data-team]');
    const sync = () => { if (team) team.hidden = (new FormData(form).get('edition') !== 'Teams'); };
    if (new URLSearchParams(location.search).get('edition') === 'teams') {
      form.querySelector<HTMLInputElement>('input[value="Teams"]')!.checked = true;
    }
    sync();
    form.addEventListener('change', sync);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const edition = String(d.get('edition'));
      const lines = [
        `Name: ${d.get('name')}`,
        `Edition: Vekrun ${edition}`,
        `Computer: ${d.get('platform')}`,
        edition === 'Teams' && d.get('engineers') ? `Engineers: ${d.get('engineers')}` : '',
        d.get('first') ? `\nFirst thing I'd hand Vekrun:\n${d.get('first')}` : '',
      ].filter(Boolean);
      form.dataset.mailto = `mailto:${form.dataset.to}?subject=${encodeURIComponent(`Vekrun ${edition} early access`)}&body=${encodeURIComponent(lines.join('\n'))}`;
      location.href = form.dataset.mailto;
    });
  }
</script>

<style>
  .ea { display: grid; gap: 1.25rem; padding: 1.5rem; border: 1px solid var(--border-strong); border-radius: var(--radius-lg); background: var(--surface); }
  @media (min-width: 40rem) { .ea { padding: 2rem; } }
  .ea-f { margin: 0; padding: 0; border: 0; min-width: 0; }
  .ea-l { display: block; margin-bottom: 0.45rem; padding: 0; font-size: 0.875rem; font-weight: 540; color: var(--text); }
  .ea-l small { font-weight: 400; color: var(--text-3); font-size: inherit; }
  .ea-seg { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
  .ea-seg label { position: relative; cursor: pointer; }
  .ea-seg input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .ea-seg span { display: grid; gap: 0.15rem; padding: 0.8rem 0.95rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-elevated); font-weight: 560; color: var(--text); transition: border-color var(--dur-fast), background-color var(--dur-fast); }
  .ea-seg small { font-size: 0.8125rem; font-weight: 400; color: var(--text-2); }
  .ea-seg input:checked + span { border-color: var(--accent-line); background: var(--accent-soft); }
  .ea-seg input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .ea-row { display: grid; gap: 1.25rem; }
  @media (min-width: 40rem) { .ea-row { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); } }
  .ea-field { display: block; min-width: 0; }
  .ea-field[hidden] { display: none; }
  .ea input:not([type='radio']), .ea select, .ea textarea { width: 100%; min-height: 2.75rem; padding: 0.6rem 0.75rem; border: 1px solid var(--border-strong); border-radius: var(--radius); background: var(--bg); color: var(--text); font: inherit; font-size: 1rem; }
  .ea textarea { resize: vertical; }
  .ea input:focus-visible, .ea select:focus-visible, .ea textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
  .ea-go { display: grid; gap: 0.75rem; justify-items: start; margin-top: 0.25rem; }
  .ea-go p { margin: 0; font-size: 0.875rem; color: var(--text-2); }
</style>
