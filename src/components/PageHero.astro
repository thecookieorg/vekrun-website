---
/**
 * The top of every page: a short headline, one supporting sentence, up to two
 * actions and an optional visual. Left-aligned by default, like an editorial
 * page; the visual enters once.
 */
import Button from '@/components/Button.astro';
interface Props {
  eyebrow?: string;
  title: string;
  /** An optional second line under the headline, set smaller. */
  subtitle?: string;
  lede: string;
  cta?: { label: string; href: string };
  secondary?: { label: string; href: string };
  align?: 'left' | 'center';
  wide?: boolean;
  id?: string;
  class?: string;
}
const { eyebrow, title, subtitle, lede, cta, secondary, align = 'left', wide = false, id = 'page-title', class: className = '' } = Astro.props;
const hasStage = Astro.slots.has('default');
---
<section class:list={['page-hero', hasStage ? 'has-stage' : 'no-stage', className]} aria-labelledby={id}>
  <div class="container-site relative">
    <div class:list={['page-hero-copy', align === 'center' ? 'is-center' : 'is-left']}>
      {eyebrow && <p class="eyebrow enter" style="--i: 0">{eyebrow}</p>}
      <h1 id={id} class:list={['display enter text-text', eyebrow && 'mt-5']} style="--i: 1">{title}</h1>
      {subtitle && <p class="page-hero-sub enter" style="--i: 2">{subtitle}</p>}
      <p class:list={['lede enter max-w-2xl', subtitle ? 'mt-4' : 'mt-6']} style="--i: 2">{lede}</p>
      {(cta || secondary) && (
        <div class="page-hero-actions enter mt-8 flex flex-wrap gap-3" style="--i: 3">
          {cta && <Button href={cta.href} size="lg">{cta.label}</Button>}
          {secondary && <Button href={secondary.href} size="lg" variant="secondary">{secondary.label}</Button>}
        </div>
      )}
      <slot name="after" />
    </div>
  </div>
  {hasStage && <div class:list={[wide ? 'container-wide' : 'container-site', 'page-hero-stage enter-stage relative']} style="--i: 4"><slot /></div>}
</section>

<style>
  .page-hero { position: relative; overflow: clip; padding-top: 4.5rem; padding-bottom: 4.5rem; }
  /* A faint green light behind the hero in dark; almost nothing on white. */
  .page-hero::before { content: ''; position: absolute; inset: -18rem -10rem auto; height: 38rem; pointer-events: none; background: radial-gradient(ellipse 42% 48% at 32% 50%, var(--hero-light), transparent 70%); }
  :global(:root[data-theme='light']) .page-hero::before { display: none; }
  @media (min-width: 64rem) { .page-hero { padding-top: 6.5rem; padding-bottom: 6rem; } }
  .page-hero-sub { margin: 1.1rem 0 0; font-size: clamp(1.35rem, 1.1rem + 1vw, 1.9rem); line-height: 1.25; font-weight: 560; letter-spacing: -0.025em; color: var(--foreground-secondary); }
  .page-hero-copy.is-center { max-width: 56rem; margin-inline: auto; text-align: center; }
  .page-hero-copy.is-center .lede, .page-hero-copy.is-center .page-hero-actions { margin-inline: auto; justify-content: center; }
  .page-hero-copy.is-left { max-width: 52rem; }
  .page-hero-stage { margin-top: 3.5rem; }
  @media (min-width: 64rem) { .page-hero-stage { margin-top: 4.5rem; } }
</style>
