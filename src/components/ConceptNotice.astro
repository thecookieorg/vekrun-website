---
/** Marks a product mockup as a concept until real recordings exist. Always visible, never hidden behind hover. */
interface Props { class?: string; text?: string }
const { class: className = '', text = 'Product preview. An illustration of the intended experience, not a recording of the application.' } = Astro.props;
---
<p class:list={['flex items-start gap-2 text-[0.8125rem] leading-snug text-text-3', className]}>
  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="mt-[2px] shrink-0 text-text-3"><circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.3"/><path d="M8 7v4M8 5v.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  <span>{text}</span>
</p>
