---
/**
 * A logo tile for a catalog entry. Uses simple-icons (CC0 SVG paths) where the
 * vendor is available there, or an official SVG from the vendor in
 * src/assets/brand (for marks simple-icons doesn't carry); otherwise a monogram. Very dark brand colours are
 * rendered in the text colour so they stay visible on dark surfaces, and very
 * light ones are deepened in the light theme so they stay visible on white.
 */
import {
  siClaude, siGooglegemini, siOllama, siLmstudio, siOpenrouter, siLinear, siJira, siAsana, siGithub, siGitlab,
  siConfluence, siNotion, siSentry, siDatadog, siFigma, siPostgresql, siCloudflare, siSupabase, siStripe, siGit,
  siHoneybadger, siAppsignal, siPagerduty, siGithubactions, siDocker, siVercel, siShopify, siFirebase, siFlutter,
  siTauri, siExpo, siRubyonrails, siNextdotjs, siSwift, siKotlin, siAnthropic, siObsidian, siModelcontextprotocol,
  siLaravel, siDjango, siNodedotjs, siReact, siPython, siTypescript, siRuby, siPhp, siGo, siRust, siVuedotjs, siSvelte,
  siElectron, siMysql, siRedis, siApple, siAndroid, siHetzner, siDigitalocean, siVultr, siAkamai, siOkta, siGoogle } from 'simple-icons';
import awsLogo from '@/assets/brand/aws.svg?raw';
import entraLogo from '@/assets/brand/microsoft-entra-id.svg?raw';
import antigravityLogo from '@/assets/brand/antigravity-icon.svg?raw';
import grokOnDark from '@/assets/brand/grok-logomark-light.svg?raw';
import grokOnLight from '@/assets/brand/grok-logomark-dark.svg?raw';
import spacexaiOnDark from '@/assets/brand/spacexai-symbol-white.svg?raw';
import spacexaiOnLight from '@/assets/brand/spacexai-symbol-black.svg?raw';

interface Props { id: string; name: string; monogram: string; size?: 'sm' | 'md' | 'lg'; class?: string }
const { id, name, monogram, size = 'md', class: className = '' } = Astro.props;

type Icon = { title: string; hex: string; path: string };
const map: Record<string, Icon> = {
  anthropic: siAnthropic, 'claude-code': siClaude, gemini: siGooglegemini, 'gemini-cli': siGooglegemini, 'github-cli': siGithub,
  ollama: siOllama, 'lm-studio': siLmstudio, openrouter: siOpenrouter,
  linear: siLinear, jira: siJira, asana: siAsana, 'github-issues': siGithub, github: siGithub,
  'gitlab-issues': siGitlab, gitlab: siGitlab, confluence: siConfluence, notion: siNotion,
  sentry: siSentry, datadog: siDatadog, honeybadger: siHoneybadger, appsignal: siAppsignal, figma: siFigma, postgres: siPostgresql, cloudflare: siCloudflare,
  supabase: siSupabase, stripe: siStripe, git: siGit, pagerduty: siPagerduty, 'github-actions': siGithubactions,
  'gitlab-ci': siGitlab, docker: siDocker, vercel: siVercel, shopify: siShopify, firebase: siFirebase, flutter: siFlutter,
  tauri: siTauri, obsidian: siObsidian, mcp: siModelcontextprotocol, expo: siExpo, rails: siRubyonrails, nextjs: siNextdotjs, swift: siSwift, kotlin: siKotlin,
  laravel: siLaravel, django: siDjango, nodejs: siNodedotjs, react: siReact, 'react-native': siReact, python: siPython,
  typescript: siTypescript, ruby: siRuby, php: siPhp, go: siGo, rust: siRust, vue: siVuedotjs, svelte: siSvelte,
  electron: siElectron, mysql: siMysql, redis: siRedis, ios: siApple, android: siAndroid,
  hetzner: siHetzner, digitalocean: siDigitalocean, vultr: siVultr, akamai: siAkamai,
  okta: siOkta, 'google-workspace': siGoogle,
};
/** Vendor-supplied SVGs, inlined so `currentColor` parts follow the theme. */
const raw: Record<string, string> = { aws: awsLogo, 'microsoft-entra-id': entraLogo, antigravity: antigravityLogo };
const vendor = raw[id]?.replace(/<!--[\s\S]*?-->/g, '').trim();
/**
 * Official marks whose owner forbids any alteration (x.ai brand guidelines):
 * each file is inlined exactly as provided, and the theme picks the white or
 * the black version rather than recolouring one.
 */
const themed: Record<string, { dark: string; light: string; wide?: boolean }> = {
  xai: { dark: spacexaiOnDark, light: spacexaiOnLight, wide: true },
  'grok-build': { dark: grokOnDark, light: grokOnLight },
};
const pair = themed[id];
const icon = map[id];
const luminance = (hex: string) => {
  const n = parseInt(hex, 16);
  const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((v) => { const c = v / 255; return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4; }) as [number, number, number];
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const dark = icon ? luminance(icon.hex) < 0.12 : false;
const fill = icon ? (dark ? 'var(--text)' : `#${icon.hex}`) : undefined;
const pale = icon ? luminance(icon.hex) > 0.4 : false;
const fillLight = icon && pale ? `color-mix(in srgb, #${icon.hex} 62%, #202129)` : fill;
const tint = icon && !dark ? `color-mix(in srgb, #${icon.hex} 14%, var(--surface-2))` : 'var(--surface-2)';
const dims = size === 'lg' ? 'h-12 w-12' : size === 'sm' ? 'h-6 w-6' : 'h-10 w-10';
const glyph = size === 'lg' ? 'h-6 w-6' : size === 'sm' ? 'h-3.5 w-3.5' : 'h-5 w-5';
---
<span class:list={['inline-flex shrink-0 items-center justify-center rounded-lg border border-border', dims, className]} style={`background:${tint}`} aria-hidden="true" title={name}>
  {pair ? (
    <>
      <span class:list={['vendor-glyph', 'on-dark', glyph, pair.wide && 'is-wide']} set:html={pair.dark} />
      <span class:list={['vendor-glyph', 'on-light', glyph, pair.wide && 'is-wide']} set:html={pair.light} />
    </>
  ) : vendor ? (
    <span class:list={['vendor-glyph', glyph, id === 'aws' && 'is-wide']} set:html={vendor} />
  ) : icon ? (
    <svg viewBox="0 0 24 24" class:list={['logo-glyph', glyph]} style={`--fill:${fill};--fill-light:${fillLight}`} role="img"><path d={icon.path} /></svg>
  ) : (
    <span class="font-mono text-[0.8125rem] font-[560] text-text-2">{monogram}</span>
  )}
</span>

<style>
  .logo-glyph { fill: var(--fill); opacity: 0.9; }
  .vendor-glyph { display: inline-flex; align-items: center; justify-content: center; color: var(--text); }
  .vendor-glyph.is-wide { width: 80%; }
  .vendor-glyph :global(svg) { width: 100%; height: 100%; }
  .on-light { display: none; }
  :global(:root[data-theme='light']) .on-light { display: inline-flex; }
  :global(:root[data-theme='light']) .on-dark { display: none; }
  :global(:root[data-theme='light']) .logo-glyph { fill: var(--fill-light); opacity: 1; }
</style>
