---
/**
 * Teams Remote Factory as an illustrative concept: people wherever they are,
 * one shared Factory on infrastructure the organization controls. Work keeps
 * running on the execution hosts whether or not anyone's laptop is open.
 * Static markup, demonstration data. `compact` trims detail for the homepage.
 */
import Avatar from '@/components/org/Avatar.astro';
import ConceptNotice from '@/components/ConceptNotice.astro';
import { Lock } from '@lucide/astro';
interface Props { compact?: boolean; class?: string }
const { compact = false, class: className = '' } = Astro.props;

const team = [
  { who: 'priya', where: 'At home, laptop', verb: 'Submitted', what: 'Add saved carts to the mobile app and API', tone: 'accent' },
  { who: 'sam', where: 'Travelling, phone', verb: 'Approved', what: 'Staging migration for billing', tone: 'mint' },
  { who: 'dana', where: 'Browser, between meetings', verb: 'Reviewing', what: 'Proof Pack for PR #482', tone: 'plain' },
] as const;
const hosts = [
  { name: 'build-01', jobs: [{ t: 'shop-mobile · Testing', p: 72 }, { t: 'shop-api · Verifying', p: 88 }] },
  { name: 'build-02', jobs: [{ t: 'storefront · Building', p: 40 }] },
];
---
<figure class:list={['rf', compact && 'is-compact', className]}>
  <div class="rf-grid">
    <ul class="rf-team" aria-label="Your team, wherever they are">
      {team.map((m) => (
        <li class="rf-person">
          <Avatar who={m.who} size="sm" />
          <div class="min-w-0">
            <p class="rf-where">{m.where}</p>
            <p class="rf-act"><span class:list={['rf-verb', `is-${m.tone}`]}>{m.verb}</span>{m.what}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="rf-wire" aria-hidden="true"><span></span></div>

    <div class="rf-infra" role="group" aria-label="Infrastructure your organization controls">
      <p class="rf-k">Your infrastructure</p>
      <div class="rf-coord">
        <p class="rf-coord-t">Vekrun Coordinator</p>
        <ul class="rf-chips">{['Board', 'Inbox', 'Memory', 'Policies'].map((c) => <li>{c}</li>)}</ul>
      </div>
      <div class="rf-hosts">
        {hosts.map((h) => (
          <div class="rf-host">
            <p class="rf-host-n"><span class="live" aria-hidden="true"></span>{h.name}</p>
            {h.jobs.map((j) => (
              <div class="rf-job"><span>{j.t}</span><i style={`--p:${j.p}%`}></i></div>
            ))}
          </div>
        ))}
      </div>
      {!compact && <p class="rf-keep"><Lock class="h-3.5 w-3.5" aria-hidden="true" />Code, credentials and execution policies stay here.</p>}
    </div>
  </div>
  <ConceptNotice class="mt-4" text="Illustrative product concept with demonstration data." />
</figure>

<style>
  .rf { margin: 0; }
  .rf-grid { display: grid; gap: 0.75rem; align-items: center; }
  @media (min-width: 56rem) { .rf-grid { grid-template-columns: minmax(0, 5fr) 3rem minmax(0, 6fr); gap: 0; } }

  .rf-team { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.6rem; }
  .rf-person { display: flex; gap: 0.7rem; align-items: flex-start; padding: 0.8rem 0.9rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .rf-where { margin: 0; font-size: 0.75rem; color: var(--text-3); }
  .rf-act { margin: 0.2rem 0 0; font-size: 0.88rem; line-height: 1.4; color: var(--text); }
  .rf-verb { display: inline-block; margin-right: 0.45rem; padding: 0 0.4rem; border-radius: var(--radius-sm); font-size: 0.72rem; border: 1px solid var(--border-strong); color: var(--text-2); }
  .rf-verb.is-accent { color: var(--accent-text); border-color: var(--accent-line); background: var(--accent-soft); }
  .rf-verb.is-mint { color: var(--mint); border-color: color-mix(in srgb, var(--mint) 40%, transparent); }

  /* The connection: vertical on phones, horizontal beside the team on wide screens. */
  .rf-wire { display: flex; justify-content: center; height: 1.5rem; }
  .rf-wire span { width: 1px; height: 100%; background: repeating-linear-gradient(to bottom, var(--accent-line) 0 4px, transparent 4px 8px); }
  @media (min-width: 56rem) {
    .rf-wire { height: auto; align-items: center; }
    .rf-wire span { width: 100%; height: 1px; background: repeating-linear-gradient(to right, var(--accent-line) 0 4px, transparent 4px 8px); }
  }

  /* Beside homepage copy the compact version needs more room before it goes horizontal. */
  @media (min-width: 56rem) and (max-width: 79.99rem) {
    .rf.is-compact .rf-grid { grid-template-columns: minmax(0, 1fr); gap: 0.75rem; }
    .rf.is-compact .rf-wire { height: 1.5rem; }
    .rf.is-compact .rf-wire span { width: 1px; height: 100%; background: repeating-linear-gradient(to bottom, var(--accent-line) 0 4px, transparent 4px 8px); }
  }

  .rf-infra { padding: 1rem; border: 1px dashed var(--accent-line); border-radius: var(--radius-lg); background: color-mix(in srgb, var(--accent-text) 3%, var(--bg-elevated)); display: grid; gap: 0.7rem; }
  .rf-k { margin: 0; font-size: 0.75rem; color: var(--accent-text); }
  .rf-coord { padding: 0.85rem 0.95rem; border: 1px solid var(--border-strong); border-radius: var(--radius); background: var(--surface-2); }
  .rf-coord-t { margin: 0; font-size: 0.95rem; font-weight: 600; color: var(--text); }
  .rf-chips { margin: 0.55rem 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .rf-chips li { padding: 0.12rem 0.5rem; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 0.75rem; color: var(--text-2); background: var(--surface); }
  .rf-hosts { display: grid; gap: 0.6rem; }
  @media (min-width: 30rem) { .rf-hosts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .rf-host { padding: 0.75rem 0.85rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); display: grid; gap: 0.5rem; align-content: start; }
  .rf-host-n { margin: 0; display: flex; align-items: center; gap: 0.45rem; font-family: var(--font-mono); font-size: 0.78rem; color: var(--text); }
  .rf-job span { display: block; font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-2); }
  .rf-job i { display: block; margin-top: 0.3rem; height: 3px; border-radius: 3px; background: linear-gradient(to right, var(--accent-text) var(--p), var(--surface-3) var(--p)); }
  .rf-keep { margin: 0; display: flex; align-items: center; gap: 0.45rem; font-size: 0.8125rem; color: var(--text-2); }
  .rf-keep :global(svg) { color: var(--accent-text); flex-shrink: 0; }
</style>
