---
/** A section introduction: an optional short label, one heading, one sentence. */
interface Props {
  id?: string;
  title: string;
  kicker?: string;
  lede?: string;
  class?: string;
  align?: 'left' | 'center';
}
const { id, title, kicker, lede, class: className = '', align = 'left' } = Astro.props;
---
<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center', className]}>
  {kicker && <p class="kicker">{kicker}</p>}
  <h2 id={id} class:list={['heading-2 text-text', kicker && 'mt-3']}>{title}</h2>
  {lede && <p class:list={['lede mt-4 max-w-2xl', align === 'center' && 'mx-auto']}>{lede}</p>}
  <slot />
</div>
