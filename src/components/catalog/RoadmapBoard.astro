---
/**
 * The public roadmap: seven groups, each with a segmented rail of counts by
 * status and compact rows. Counts come from the data; nothing is estimated.
 */
import { getCollection } from 'astro:content';
import { roadmapStatuses, type RoadmapStatus } from '@/data/site';

const entries = await getCollection('roadmap');
/** Tracker, service and sync items live under the Board area in the data but read better as their own group. */
const integrationIds = new Set(['board-trackers', 'board-sync', 'board-services']);

type Group = { key: string; label: string; items: typeof entries };
const groups: Group[] = [
  { key: 'terminal', label: 'Terminal', items: entries.filter((e) => e.data.area === 'terminal') },
  { key: 'ai-coding', label: 'AI coding', items: entries.filter((e) => e.data.area === 'ai-coding') },
  { key: 'board', label: 'Board', items: entries.filter((e) => e.data.area === 'board' && !integrationIds.has(e.id)) },
  { key: 'ai-teams', label: 'AI Teams', items: entries.filter((e) => e.data.area === 'ai-teams') },
  { key: 'code-review', label: 'Code reviews', items: entries.filter((e) => e.data.area === 'code-review') },
  { key: 'integrations', label: 'Integrations', items: entries.filter((e) => integrationIds.has(e.id)) },
  { key: 'release', label: 'Release', items: entries.filter((e) => e.data.area === 'releases') },
].filter((g) => g.items.length > 0);

const statusOrder: RoadmapStatus[] = ['implemented', 'in-progress', 'planned', 'released'];
const shownStatuses = statusOrder.filter((s) => s !== 'released' || entries.some((e) => e.data.status === 'released'));
const rank = (s: RoadmapStatus) => statusOrder.indexOf(s);
const counts = (items: typeof entries) => shownStatuses.map((s) => ({ s, n: items.filter((e) => e.data.status === s).length })).filter((c) => c.n > 0);
const railLabel = (items: typeof entries) => counts(items).map((c) => `${c.n} ${roadmapStatuses[c.s].label.toLowerCase()}`).join(' · ');
const dot: Record<string, string> = { ok: 'bg-ok', warn: 'bg-warn', muted: 'bg-text-3', info: 'bg-info' };
---
<div data-roadmap>
  <form class="flex flex-col gap-3" aria-label="Filter the roadmap" onsubmit="return false">
    <fieldset>
      <legend class="sr-only">Show</legend>
      <div class="flex flex-wrap gap-1.5">
        {shownStatuses.map((s) => (
          <label class="pill"><input type="checkbox" name="status" value={s} class="sr-only" data-roadmap-status /><span class:list={['h-1.5 w-1.5 rounded-full', dot[roadmapStatuses[s].tone]]} aria-hidden="true"></span>{roadmapStatuses[s].label}</label>
        ))}
      </div>
    </fieldset>
    <p class="text-[0.8125rem] text-text-3" aria-live="polite" data-roadmap-count>Showing all {entries.length} items.</p>
  </form>

  <div class="reveal-group mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    {groups.map((g) => (
      <section class="card flex flex-col p-5" aria-labelledby={`area-${g.key}`} data-roadmap-group>
        <div class="flex items-baseline justify-between gap-3">
          <h2 id={`area-${g.key}`} class="heading-3">{g.label}</h2>
          <span class="text-[0.75rem] text-text-3" data-group-count>{g.items.length} items</span>
        </div>
        <div class="rail mt-3" role="img" aria-label={`${g.label}: ${railLabel(g.items)}`}>
          {counts(g.items).map((c) => <span class:list={['rail-seg', dot[roadmapStatuses[c.s].tone]]} style={`flex:${c.n}`}></span>)}
        </div>
        <p class="mt-1.5 text-[0.75rem] text-text-3">{railLabel(g.items)}</p>
        <ul class="mt-4 divide-y divide-border" role="list">
          {[...g.items].sort((a, b) => rank(a.data.status) - rank(b.data.status)).map((e) => (
            <li class="py-2.5" data-roadmap-item data-status={e.data.status}>
              <div class="flex items-start gap-2.5">
                <span class:list={['mt-[0.45em] h-1.5 w-1.5 shrink-0 rounded-full', dot[roadmapStatuses[e.data.status].tone]]} aria-hidden="true"></span>
                <div class="min-w-0">
                  <h3 class="text-[0.9375rem] font-[540] leading-snug text-text">{e.data.title}</h3>
                  <p class="mt-0.5 text-[0.8125rem] leading-relaxed text-text-2">{e.data.description}</p>
                  <p class="sr-only">{roadmapStatuses[e.data.status].label}</p>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <div class="card mt-6 hidden p-8 text-center" data-roadmap-empty>
    <p class="text-[1rem] font-[560] text-text">Nothing matches that filter.</p>
    <button type="button" class="mt-4 inline-flex h-10 items-center rounded-md border border-border-strong bg-surface px-4 text-[0.9375rem] text-text hover:bg-surface-2" data-roadmap-clear>Show everything</button>
  </div>
</div>

<style>
  .pill { display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer; border: 1px solid var(--border); border-radius: 999px; padding: 0.35rem 0.75rem; font-size: 0.8125rem; color: var(--text-2); transition: border-color var(--dur-fast), color var(--dur-fast), background-color var(--dur-fast); user-select: none; }
  .pill:hover { border-color: var(--border-strong); color: var(--text); }
  .pill:has(:checked) { border-color: var(--accent); color: var(--text); background: var(--accent-soft); }
  .pill:has(:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .rail { display: flex; gap: 2px; height: 4px; border-radius: 999px; overflow: hidden; background: var(--surface-2); }
  .rail-seg { display: block; height: 100%; opacity: 0.85; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-roadmap]');
  if (root) {
    const statuses = Array.from(root.querySelectorAll<HTMLInputElement>('[data-roadmap-status]'));
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-roadmap-item]'));
    const groups = Array.from(root.querySelectorAll<HTMLElement>('[data-roadmap-group]'));
    const count = root.querySelector<HTMLElement>('[data-roadmap-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-roadmap-empty]')!;
    const clear = root.querySelector<HTMLButtonElement>('[data-roadmap-clear]')!;
    const apply = () => {
      const s = statuses.filter((c) => c.checked).map((c) => c.value);
      let shown = 0;
      for (const el of items) { const ok = s.length === 0 || s.includes(el.dataset.status ?? ''); el.hidden = !ok; if (ok) shown++; }
      for (const g of groups) {
        const visible = g.querySelectorAll('[data-roadmap-item]:not([hidden])').length;
        g.hidden = visible === 0;
        const c = g.querySelector<HTMLElement>('[data-group-count]');
        if (c) c.textContent = `${visible} item${visible === 1 ? '' : 's'}`;
      }
      empty.classList.toggle('hidden', shown > 0);
      count.textContent = s.length ? `Showing ${shown} of ${items.length} items.` : `Showing all ${items.length} items.`;
    };
    statuses.forEach((c) => c.addEventListener('change', apply));
    clear.addEventListener('click', () => { statuses.forEach((c) => (c.checked = false)); apply(); });
  }
</script>
