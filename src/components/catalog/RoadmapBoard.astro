---
/**
 * The public roadmap: an area index on the left, one section per area on the
 * right. Each section has a segmented rail of counts by status and a ruled list
 * of entries with their status badge. Counts come from the data; nothing is
 * estimated, and no percentage is invented.
 */
import { getCollection } from 'astro:content';
import StatusBadge from '@/components/StatusBadge.astro';
import { roadmapStatuses, type RoadmapStatus, roadmapAreas, type RoadmapArea } from '@/data/site';

const entries = await getCollection('roadmap');

type Group = { key: string; label: string; items: typeof entries };
const groups: Group[] = (Object.entries(roadmapAreas) as [RoadmapArea, string][])
  .map(([key, label]) => ({ key, label, items: entries.filter((e) => e.data.area === key) }))
  .filter((g) => g.items.length > 0);

const statusOrder: RoadmapStatus[] = ['implemented', 'in-progress', 'planned', 'proposed', 'released'];
const shownStatuses = statusOrder.filter((s) => s !== 'released' || entries.some((e) => e.data.status === 'released'));
const rank = (s: RoadmapStatus) => statusOrder.indexOf(s);
const counts = (items: typeof entries) => shownStatuses.map((s) => ({ s, n: items.filter((e) => e.data.status === s).length })).filter((c) => c.n > 0);
const railLabel = (items: typeof entries) => counts(items).map((c) => `${c.n} ${roadmapStatuses[c.s].label.toLowerCase()}`).join(' · ');
const dot: Record<string, string> = { ok: 'bg-ok', warn: 'bg-warn', muted: 'bg-text-3', info: 'bg-info', faint: 'bg-border-strong' };
const totals = shownStatuses.map((s) => ({ s, n: entries.filter((e) => e.data.status === s).length }));
---
<div class="rm" data-roadmap>
  <aside class="rm-side">
    <form class="rm-filter" aria-label="Filter the roadmap" onsubmit="return false">
      <fieldset>
        <legend class="kicker mb-3">Show</legend>
        <div class="flex flex-wrap gap-1.5">
          {shownStatuses.map((s) => (
            <label class="filter-pill"><input type="checkbox" name="status" value={s} class="sr-only" data-roadmap-status /><span class:list={['h-1.5 w-1.5 rounded-full', dot[roadmapStatuses[s].tone]]} aria-hidden="true"></span>{roadmapStatuses[s].label}<span class="rm-n">{totals.find((t) => t.s === s)?.n}</span></label>
          ))}
        </div>
      </fieldset>
      <p class="mt-3 text-[0.8125rem] text-text-3" aria-live="polite" data-roadmap-count>Showing all {entries.length} items.</p>
    </form>
    <nav class="rm-nav" aria-label="Roadmap areas">
      <p class="kicker mb-3">Areas</p>
      <ul>
        {groups.map((g) => (
          <li><a href={`#${g.key}`} class="rm-nav-a" data-roadmap-nav={g.key}><span>{g.label}</span><span class="rm-nav-n" data-group-count-nav={g.key}>{g.items.length}</span></a></li>
        ))}
      </ul>
    </nav>
  </aside>

  <div class="rm-main">
    {groups.map((g) => (
      <section id={g.key} class="rm-group scroll-mt-24" aria-labelledby={`area-${g.key}`} data-roadmap-group={g.key}>
        <header class="rm-head">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h2 id={`area-${g.key}`} class="heading-3">{g.label}</h2>
            <span class="text-[0.8125rem] text-text-3" data-group-count>{g.items.length} items</span>
          </div>
          <div class="rm-rail-wrap">
            <div class="rail" role="img" aria-label={`${g.label}: ${railLabel(g.items)}`}>
              {counts(g.items).map((c) => <span class:list={['rail-seg', dot[roadmapStatuses[c.s].tone]]} style={`flex:${c.n}`}></span>)}
            </div>
            <p class="rm-rail-t">{railLabel(g.items)}</p>
          </div>
        </header>
        <ul class="rm-list" role="list">
          {[...g.items].sort((a, b) => rank(a.data.status) - rank(b.data.status)).map((e) => (
            <li class="rm-item" data-roadmap-item data-status={e.data.status}>
              <div class="min-w-0">
                <h3 class="rm-item-t">{e.data.title}</h3>
                <p class="rm-item-d">{e.data.description}</p>
                {e.data.note && <p class="rm-item-n">{e.data.note}</p>}
              </div>
              <StatusBadge status={e.data.status} kind="roadmap" compact class="rm-badge" />
            </li>
          ))}
        </ul>
      </section>
    ))}

    <div class="card mt-6 hidden p-8 text-center" data-roadmap-empty>
      <p class="text-[1rem] font-[560] text-text">Nothing matches that filter.</p>
      <button type="button" class="mt-4 inline-flex h-10 items-center rounded-md border border-border-strong bg-surface px-4 text-[0.9375rem] text-text hover:bg-surface-2" data-roadmap-clear>Show everything</button>
    </div>
  </div>
</div>

<style>
  .rm { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
  @media (min-width: 64rem) { .rm { grid-template-columns: 16rem minmax(0, 1fr); gap: 4rem; align-items: start; } .rm-side { position: sticky; top: 5.5rem; } }
  .rm-side { display: grid; gap: 1.75rem; }
  .rm-n { font-family: var(--font-mono); font-size: 0.66rem; color: var(--text-3); }
  .rm-nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.1rem; }
  @media (max-width: 63.9rem) { .rm-nav { display: none; } }
  .rm-nav-a { display: flex; justify-content: space-between; gap: 0.75rem; padding: 0.4rem 0.6rem; border-radius: 6px; font-size: 0.875rem; color: var(--text-2); transition: background-color var(--dur-fast), color var(--dur-fast); }
  .rm-nav-a:hover { color: var(--text); background: var(--surface); }
  .rm-nav-a.is-current { color: var(--text); background: var(--surface-2); }
  .rm-nav-n { font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-3); }
  .rm-main { display: grid; gap: 3rem; }
  .rm-group[hidden] { display: none; }
  .rm-head { display: grid; gap: 0.8rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border); }
  @media (min-width: 48rem) { .rm-head { grid-template-columns: minmax(0, 1fr) 18rem; align-items: end; } }
  .rm-rail-wrap { display: grid; gap: 0.35rem; }
  .rail { display: flex; gap: 2px; height: 5px; border-radius: 999px; overflow: hidden; background: var(--surface-2); }
  .rail-seg { display: block; height: 100%; opacity: 0.85; }
  .rm-rail-t { margin: 0; font-size: 0.75rem; color: var(--text-3); }
  @media (min-width: 48rem) { .rm-rail-t { text-align: right; } }
  .rm-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .rm-item { display: flex; align-items: flex-start; justify-content: space-between; gap: 1.25rem; padding: 0.9rem 0; border-bottom: 1px solid var(--border); }
  .rm-item[hidden] { display: none; }
  .rm-item-t { margin: 0; font-size: 0.9875rem; font-weight: 560; line-height: 1.35; color: var(--text); }
  .rm-item-d { margin: 0.2rem 0 0; font-size: 0.875rem; line-height: 1.55; color: var(--text-2); max-width: 64ch; }
  .rm-item-n { margin: 0.35rem 0 0; font-size: 0.78rem; line-height: 1.45; color: var(--text-3); max-width: 64ch; }
  .rm-item :global(.rm-badge) { flex: 0 0 auto; margin-top: 0.15rem; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-roadmap]');
  if (root) {
    const statuses = Array.from(root.querySelectorAll<HTMLInputElement>('[data-roadmap-status]'));
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-roadmap-item]'));
    const groups = Array.from(root.querySelectorAll<HTMLElement>('[data-roadmap-group]'));
    const count = root.querySelector<HTMLElement>('[data-roadmap-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-roadmap-empty]')!;
    const clear = root.querySelector<HTMLButtonElement>('[data-roadmap-clear]')!;
    const navLinks = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-roadmap-nav]'));
    const apply = () => {
      const s = statuses.filter((c) => c.checked).map((c) => c.value);
      let shown = 0;
      for (const el of items) { const ok = s.length === 0 || s.includes(el.dataset.status ?? ''); el.hidden = !ok; if (ok) shown++; }
      for (const g of groups) {
        const visible = g.querySelectorAll('[data-roadmap-item]:not([hidden])').length;
        g.hidden = visible === 0;
        const c = g.querySelector<HTMLElement>('[data-group-count]');
        if (c) c.textContent = `${visible} item${visible === 1 ? '' : 's'}`;
        const n = root.querySelector<HTMLElement>(`[data-group-count-nav="${g.dataset.roadmapGroup}"]`);
        if (n) n.textContent = String(visible);
        const link = navLinks.find((l) => l.dataset.roadmapNav === g.dataset.roadmapGroup);
        if (link) link.parentElement!.hidden = visible === 0;
      }
      empty.classList.toggle('hidden', shown > 0);
      count.textContent = s.length ? `Showing ${shown} of ${items.length} items.` : `Showing all ${items.length} items.`;
    };
    statuses.forEach((c) => c.addEventListener('change', apply));
    clear.addEventListener('click', () => { statuses.forEach((c) => (c.checked = false)); apply(); });

    // Highlight the area in view.
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const key = (e.target as HTMLElement).dataset.roadmapGroup;
          navLinks.forEach((l) => l.classList.toggle('is-current', l.dataset.roadmapNav === key));
        }
      }, { rootMargin: '-20% 0px -70% 0px', threshold: 0 });
      groups.forEach((g) => io.observe(g));
    }
  }
</script>
