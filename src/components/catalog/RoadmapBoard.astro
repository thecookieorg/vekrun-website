---
import { getCollection } from 'astro:content';
import { roadmapStatuses, roadmapAreas, type RoadmapStatus, type RoadmapArea } from '@/data/site';

const entries = await getCollection('roadmap');
const statusOrder: RoadmapStatus[] = ['implemented', 'in-progress', 'planned', 'released'];
const shownStatuses = statusOrder.filter((s) => s !== 'released' || entries.some((e) => e.data.status === 'released'));
const areas = (Object.keys(roadmapAreas) as RoadmapArea[])
  .map((key) => ({
    key,
    label: roadmapAreas[key],
    items: entries.filter((e) => e.data.area === key),
  }))
  .filter((a) => a.items.length > 0);
const dot: Record<string, string> = { ok: 'bg-ok', warn: 'bg-warn', muted: 'bg-text-3', info: 'bg-info' };
---
<div data-roadmap>
  <form class="flex flex-col gap-3" aria-label="Filter the roadmap" onsubmit="return false">
    <fieldset>
      <legend class="mb-2 text-[0.8125rem] font-[560] text-text">Show</legend>
      <div class="flex flex-wrap gap-2">
        {shownStatuses.map((s) => (
          <label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-border px-3 py-1.5 text-[0.8125rem] text-text-2 has-[:checked]:border-border-strong has-[:checked]:bg-surface-2 has-[:checked]:text-text">
            <input type="checkbox" name="status" value={s} class="h-3.5 w-3.5 accent-[var(--accent)]" data-roadmap-status />
            {roadmapStatuses[s].label}
          </label>
        ))}
      </div>
    </fieldset>
    <p class="text-[0.875rem] text-text-2" aria-live="polite" data-roadmap-count>Showing all {entries.length} items.</p>
  </form>

  <div class="mt-8 space-y-12">
    {areas.map((a) => (
      <section aria-labelledby={`area-${a.key}`} data-roadmap-group>
        <h2 id={`area-${a.key}`} class="heading-3">{a.label}</h2>
        <ul class="mt-4 divide-y divide-border border-y border-border" role="list">
          {a.items.map((e) => (
            <li class="grid gap-x-6 gap-y-1 py-4 sm:grid-cols-[minmax(0,1fr)_11rem]" data-roadmap-item data-status={e.data.status}>
              <div class="min-w-0">
                <h3 class="text-[1rem] font-[560] leading-snug text-text">{e.data.title}</h3>
                <p class="mt-1 text-[0.9rem] leading-relaxed text-text-2">{e.data.description}</p>
              </div>
              <p class="inline-flex items-start gap-2 text-[0.8125rem] text-text-2 sm:justify-self-end sm:pt-1" title={roadmapStatuses[e.data.status].description}>
                <span class:list={['mt-[0.4em] h-1.5 w-1.5 shrink-0 rounded-full', dot[roadmapStatuses[e.data.status].tone]]} aria-hidden="true"></span>
                <span>{roadmapStatuses[e.data.status].label}</span>
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <div class="mt-6 hidden rounded-lg border border-border p-8 text-center" data-roadmap-empty>
    <p class="text-[1rem] font-[560] text-text">Nothing matches that filter.</p>
    <button type="button" class="mt-4 inline-flex h-10 items-center rounded-md border border-border-strong bg-surface px-4 text-[0.9375rem] text-text hover:bg-surface-2" data-roadmap-clear>Show everything</button>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-roadmap]');
  if (root) {
    const statuses = Array.from(root.querySelectorAll<HTMLInputElement>('[data-roadmap-status]'));
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-roadmap-item]'));
    const groups = Array.from(root.querySelectorAll<HTMLElement>('[data-roadmap-group]'));
    const count = root.querySelector<HTMLElement>('[data-roadmap-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-roadmap-empty]')!;
    const clear = root.querySelector<HTMLButtonElement>('[data-roadmap-clear]')!;
    const apply = () => {
      const s = statuses.filter((c) => c.checked).map((c) => c.value);
      let shown = 0;
      for (const el of items) {
        const ok = s.length === 0 || s.includes(el.dataset.status ?? '');
        el.hidden = !ok;
        if (ok) shown++;
      }
      for (const g of groups) g.hidden = g.querySelectorAll('[data-roadmap-item]:not([hidden])').length === 0;
      empty.classList.toggle('hidden', shown > 0);
      count.textContent = s.length ? `Showing ${shown} of ${items.length} items.` : `Showing all ${items.length} items.`;
    };
    statuses.forEach((c) => c.addEventListener('change', apply));
    clear.addEventListener('click', () => { statuses.forEach((c) => (c.checked = false)); apply(); });
  }
</script>
