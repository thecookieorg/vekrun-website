---
import { getCollection } from 'astro:content';
import { Search, ExternalLink, BookOpen, X } from '@lucide/astro';
import IntegrationLogo from './IntegrationLogo.astro';
import { availability, integrationCategories, connectionMethods, type IntegrationCategory, type Availability } from '@/data/site';

const entries = await getCollection('integrations');
const categoryOrder = Object.keys(integrationCategories) as IntegrationCategory[];
const statusOrder = Object.keys(availability) as Availability[];
const rank = (s: Availability) => statusOrder.indexOf(s);
const byCategory = categoryOrder
  .map((key) => ({
    key,
    ...integrationCategories[key],
    items: entries
      .filter((e) => e.data.category === key && e.data.status !== 'proposed')
      .sort((a, b) => rank(a.data.status) - rank(b.data.status) || a.data.name.localeCompare(b.data.name)),
    /** Candidates that are not approved or scheduled. Listed compactly so they never look like committed support. */
    proposed: entries.filter((e) => e.data.category === key && e.data.status === 'proposed').sort((a, b) => a.data.name.localeCompare(b.data.name)),
  }))
  .filter((c) => c.items.length > 0 || c.proposed.length > 0);
const searchText = (e: (typeof entries)[number]) =>
  [e.data.name, e.data.enables, ...e.data.connection.map((c) => connectionMethods[c]), e.data.note ?? ''].join(' ').toLowerCase();
const dot: Record<string, string> = { ok: 'bg-ok', warn: 'bg-warn', muted: 'bg-text-3', faint: 'bg-border-strong' };
/** Connection methods worth a footer line. "Built in" says nothing to a visitor. */
const footer = (e: (typeof entries)[number]) => e.data.connection.filter((c) => c !== 'built-in').map((c) => connectionMethods[c]);
---
<div data-catalog>
  <form class="catalog-bar" role="search" aria-label="Filter integrations" onsubmit="return false">
    <div class="container-site py-3">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <label class="relative block w-full sm:max-w-xs">
          <span class="sr-only">Search integrations</span>
          <Search class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-text-3" aria-hidden="true" />
          <input type="search" name="q" placeholder="Search integrations" autocomplete="off" class="h-10 w-full rounded-md border border-border bg-surface pl-10 pr-3 text-[0.9375rem] text-text placeholder:text-text-3 transition-colors focus:border-accent" data-catalog-search />
        </label>
        <fieldset class="min-w-0">
          <legend class="sr-only">Status</legend>
          <div class="flex flex-wrap gap-1.5">
            {statusOrder.map((s) => (
              <label class="pill pill-status"><input type="checkbox" name="status" value={s} class="sr-only" data-catalog-status /><span class:list={['h-1.5 w-1.5 rounded-full', dot[availability[s].tone]]} aria-hidden="true"></span>{availability[s].label}</label>
            ))}
          </div>
        </fieldset>
      </div>
      <fieldset class="mt-3 min-w-0">
        <legend class="sr-only">Category</legend>
        <div class="catalog-cats" data-pills>
          <label class="pill pill-cat"><input type="radio" name="category" value="" class="sr-only" data-catalog-category-all checked />All</label>
          {byCategory.map((c) => (
            <label class="pill pill-cat"><input type="radio" name="category" value={c.key} class="sr-only" data-catalog-category />{c.label}</label>
          ))}
        </div>
      </fieldset>
      <p class="mt-2 text-[0.8125rem] text-text-3" aria-live="polite" data-catalog-count>Showing all {entries.length} integrations.</p>
    </div>
  </form>

  <div class="container-site mt-10 space-y-14">
    {byCategory.map((c) => (
      <section aria-labelledby={`cat-${c.key}`} data-catalog-group={c.key}>
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <h2 id={`cat-${c.key}`} class="heading-3">{c.label}</h2>
          <p class="text-[0.9rem] text-text-3">{c.description}</p>
        </div>
        <ul class="reveal-group mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {c.items.map((e) => (
            <li class="card card-hover group flex flex-col p-4" data-catalog-item data-status={e.data.status} data-category={e.data.category} data-text={searchText(e)}>
              <div class="flex items-start gap-3">
                <IntegrationLogo id={e.id} name={e.data.name} monogram={e.data.monogram} />
                <div class="min-w-0 flex-1">
                  <h3 class="text-[1rem] font-[560] leading-tight text-text">{e.data.name}</h3>
                  <p class="mt-1 inline-flex items-center gap-1.5 text-[0.75rem] text-text-2" title={availability[e.data.status].description}>
                    <span class:list={['h-1.5 w-1.5 rounded-full', dot[availability[e.data.status].tone]]} aria-hidden="true"></span>{availability[e.data.status].label}
                  </p>
                </div>
              </div>
              <p class="mt-3 text-[0.9rem] leading-relaxed text-text-2">{e.data.enables}</p>
              {e.data.note && <p class="mt-1.5 text-[0.8125rem] text-text-3">{e.data.note}</p>}
              <div class="mt-auto flex items-end justify-between gap-3 pt-4">
                {footer(e).length > 0 ? <p class="text-[0.75rem] text-text-3">{footer(e).join(' · ')}</p> : <span></span>}
                {(e.data.docs || e.data.vendorUrl) && (
                  <p class="flex shrink-0 gap-3 text-[0.8125rem] opacity-70 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100">
                    {e.data.docs && <a href={e.data.docs} class="inline-flex items-center gap-1 text-accent link-slide"><BookOpen class="h-3.5 w-3.5" aria-hidden="true" /> Docs</a>}
                    {e.data.vendorUrl && <a href={e.data.vendorUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-text-2 hover:text-text" aria-label={`${e.data.name} website`}><ExternalLink class="h-3.5 w-3.5" aria-hidden="true" /> Site</a>}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
        {c.proposed.length > 0 && (
          <div class="mt-5 rounded-lg border border-dashed border-border px-4 py-3" data-catalog-proposed>
            <p class="text-[0.8125rem] text-text-3">Under consideration, not yet approved or scheduled:</p>
            <ul class="mt-2 flex flex-wrap gap-2" role="list">
              {c.proposed.map((e) => (
                <li class="inline-flex items-center gap-2 rounded-md border border-border bg-surface px-2.5 py-1.5 text-[0.8125rem] text-text-2" data-catalog-item data-status={e.data.status} data-category={e.data.category} data-text={searchText(e)} title={e.data.enables}>
                  <IntegrationLogo id={e.id} name={e.data.name} monogram={e.data.monogram} size="sm" />
                  {e.data.name}
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    ))}
  </div>

  <div class="container-site">
    <div class="card mt-10 hidden p-8 text-center" data-catalog-empty>
      <p class="text-[1rem] font-[560] text-text">No integrations match.</p>
      <p class="mt-1 text-[0.9rem] text-text-2">Try a different word, or clear the filters.</p>
      <button type="button" class="mt-4 inline-flex h-10 items-center gap-2 rounded-md border border-border-strong bg-surface px-4 text-[0.9375rem] text-text hover:bg-surface-2" data-catalog-clear><X class="h-4 w-4" aria-hidden="true" /> Clear filters</button>
    </div>
  </div>
</div>

<style>
  .catalog-bar { position: sticky; top: 4rem; z-index: 20; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--bg) 86%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .pill { display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer; border: 1px solid var(--border); border-radius: 999px; padding: 0.35rem 0.75rem; font-size: 0.8125rem; color: var(--text-2); background: transparent; transition: border-color var(--dur-fast), color var(--dur-fast), background-color var(--dur-fast); user-select: none; }
  .pill:hover { border-color: var(--border-strong); color: var(--text); }
  .pill:has(:checked) { border-color: var(--accent); color: var(--text); background: var(--accent-soft); }
  .pill:has(:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* Fieldsets refuse to shrink below their content; let the category row scroll instead. */
  .catalog-bar fieldset { min-width: 0; min-inline-size: 0; max-width: 100%; }
  /* One scrollable row of categories; never a tall stack inside the sticky bar. */
  .catalog-cats { position: relative; display: flex; max-width: 100%; gap: 0.375rem; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; -webkit-overflow-scrolling: touch; mask-image: linear-gradient(90deg, black 92%, transparent); -webkit-mask-image: linear-gradient(90deg, black 92%, transparent); }
  .catalog-cats::-webkit-scrollbar { display: none; }
  .pill-cat { flex: 0 0 auto; white-space: nowrap; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-catalog]');
  if (root) {
    const search = root.querySelector<HTMLInputElement>('[data-catalog-search]')!;
    const statuses = Array.from(root.querySelectorAll<HTMLInputElement>('[data-catalog-status]'));
    const categories = Array.from(root.querySelectorAll<HTMLInputElement>('[data-catalog-category]'));
    const categoryAll = root.querySelector<HTMLInputElement>('[data-catalog-category-all]');
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-catalog-item]'));
    const groups = Array.from(root.querySelectorAll<HTMLElement>('[data-catalog-group]'));
    const count = root.querySelector<HTMLElement>('[data-catalog-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-catalog-empty]')!;
    const clear = root.querySelector<HTMLButtonElement>('[data-catalog-clear]')!;
    const total = items.length;

    const apply = () => {
      const q = search.value.trim().toLowerCase();
      const s = statuses.filter((c) => c.checked).map((c) => c.value);
      const cats = categories.filter((c) => c.checked).map((c) => c.value);
      let shown = 0;
      for (const el of items) {
        const ok = (!q || (el.dataset.text ?? '').includes(q)) && (s.length === 0 || s.includes(el.dataset.status ?? '')) && (cats.length === 0 || cats.includes(el.dataset.category ?? ''));
        el.hidden = !ok;
        if (ok) shown++;
      }
      for (const g of groups) {
        g.hidden = g.querySelectorAll('[data-catalog-item]:not([hidden])').length === 0;
        // Revealed groups that were hidden on first paint still need to show.
        g.querySelector('.reveal-group')?.classList.add('is-visible');
      }
      empty.classList.toggle('hidden', shown > 0);
      count.textContent = q || s.length || cats.length ? `Showing ${shown} of ${total} integrations.` : `Showing all ${total} integrations.`;
    };

    // Deep links: /integrations/?category=project-management&status=available&q=linear
    const params = new URLSearchParams(location.search);
    const q0 = params.get('q');
    if (q0) search.value = q0;
    for (const v of params.getAll('category')) { const c = categories.find((x) => x.value === v); if (c) { c.checked = true; c.parentElement?.scrollIntoView({ block: 'nearest', inline: 'center' }); } }
    for (const v of params.getAll('status')) { const c = statuses.find((x) => x.value === v); if (c) c.checked = true; }
    if (q0 || params.has('category') || params.has('status')) {
      apply();
      root.querySelector<HTMLElement>('[data-catalog-group]:not([hidden])')?.scrollIntoView({ block: 'start' });
    }

    search.addEventListener('input', apply);
    [...statuses, ...categories].forEach((c) => c.addEventListener('change', apply));
    categoryAll?.addEventListener('change', apply);
    clear.addEventListener('click', () => { search.value = ''; [...statuses, ...categories].forEach((c) => (c.checked = false)); if (categoryAll) categoryAll.checked = true; apply(); search.focus(); });
  }
</script>
