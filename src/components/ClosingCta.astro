---
/**
 * The end of every content page: one line, then the two ways in. Early access
 * to Vekrun Free first, pricing second. Availability is stated honestly.
 */
import Button from '@/components/Button.astro';
import { personalCta, pricingCta } from '@/data/site';
interface Props { title: string; line?: string; class?: string }
const { title, line = 'Vekrun Free runs the whole engineering workflow on your machine, with the models you choose.', class: className = '' } = Astro.props;
---
<section class:list={['section-pad rule', className]} aria-labelledby="next-title">
  <div class="container-site text-center">
    <h2 id="next-title" class="heading-2 text-text">{title}</h2>
    <p class="lede mx-auto mt-4 max-w-2xl">{line}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href={personalCta.href} size="lg">{personalCta.label}</Button>
      <Button href={pricingCta.href} size="lg" variant="secondary">{pricingCta.label}</Button>
    </div>
    <p class="mt-5 text-[0.8125rem] text-text-3">No public download yet. Early access is by email.</p>
  </div>
</section>
