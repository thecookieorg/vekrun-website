---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  class?: string;
  external?: boolean;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'md', class: className = '', external = false, ...rest } = Astro.props;
const base = 'btn inline-flex items-center justify-center gap-2 font-[540] tracking-[-0.005em]';
const sizes = { md: 'h-10 px-4 text-[0.9375rem]', lg: 'h-12 px-5 text-base' };
const variants = { primary: 'btn-primary', secondary: 'btn-secondary', ghost: 'btn-ghost' };
const Tag = href ? 'a' : 'button';
const extra = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---
<Tag href={href} class:list={[base, sizes[size], variants[variant], className]} {...extra} {...rest}><slot /></Tag>

<style is:global>
  /* Three variants, one geometry: primary (lime fill), secondary (bordered surface), ghost (tertiary). */
  .btn { position: relative; border: 1px solid transparent; border-radius: var(--radius-md); white-space: nowrap; transition: background-color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), box-shadow var(--dur) var(--ease-out); }
  .btn:active { transform: translateY(1px); }
  .btn:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .btn[aria-disabled='true'], .btn:disabled { opacity: 0.5; pointer-events: none; }
  .btn :global(svg) { flex: 0 0 auto; }
  .btn-primary { background: var(--accent); color: var(--accent-foreground); font-weight: 580; }
  .btn-primary:hover { background: var(--accent-hover); box-shadow: var(--glow-accent); }
  .btn-secondary { border-color: var(--border-strong); background: var(--surface); color: var(--foreground); }
  .btn-secondary:hover { border-color: var(--border-control); background: var(--surface-hover); }
  .btn-ghost { color: var(--foreground-secondary); }
  .btn-ghost:hover { color: var(--foreground); background: var(--surface-hover); }
  @media (prefers-reduced-motion: reduce) { .btn { transition: none; } .btn:active { transform: none; } }
</style>
