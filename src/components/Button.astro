---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  class?: string;
  external?: boolean;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'md', class: className = '', external = false, ...rest } = Astro.props;
const base =
  'inline-flex items-center justify-center gap-2 rounded-md font-[540] tracking-[-0.005em] transition-[background-color,border-color,color,transform] duration-150 active:translate-y-px';
const sizes = { md: 'h-10 px-4 text-[0.9375rem]', lg: 'h-12 px-5 text-base' };
const variants = {
  primary: 'bg-accent text-accent-ink hover:bg-accent-strong',
  secondary: 'border border-border-strong bg-surface text-text hover:border-text-3 hover:bg-surface-2',
  ghost: 'text-text-2 hover:text-text hover:bg-surface-2',
};
const classes = [base, sizes[size], variants[variant], className];
const Tag = href ? 'a' : 'button';
const extra = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---
<Tag href={href} class:list={classes} {...extra} {...rest}><slot /></Tag>
