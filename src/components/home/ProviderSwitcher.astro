---
/**
 * "Bring your own AI": a working provider picker. Selecting a provider updates
 * the status bar and re-streams a reply. Opens with a gentle two-step cycle, then
 * waits for the visitor. No vendor logos; monogram tiles only.
 */
import Window from '@/components/mock/Window.astro';
import ConceptNotice from '@/components/ConceptNotice.astro';

const providers = [
  { id: 'claude', mono: 'Cl', name: 'Claude', model: 'Claude · Sonnet', mode: 'key', billed: 'Billed by Anthropic' },
  { id: 'openai', mono: 'Op', name: 'OpenAI', model: 'OpenAI · GPT', mode: 'key', billed: 'Billed by OpenAI' },
  { id: 'gemini', mono: 'Ge', name: 'Gemini', model: 'Gemini · Pro', mode: 'key', billed: 'Billed by Google' },
  { id: 'compat', mono: '{}', name: 'OpenAI-compatible', model: 'Your endpoint', mode: 'key', billed: 'Billed by your provider' },
  { id: 'ollama', mono: 'Ol', name: 'Ollama', model: 'Ollama · local model', mode: 'local', billed: 'Free' },
  { id: 'lmstudio', mono: 'LM', name: 'LM Studio', model: 'LM Studio · local model', mode: 'local', billed: 'Free' },
];
---
<figure class="ps" data-demo-root="providers">
  <Window title="Providers" crumbs={['acme-api']}>
    <span slot="status" class="hidden sm:inline">No Vekrun account</span>

    <div class="ps-body">
      <div class="ps-pick" role="radiogroup" aria-label="Choose a provider">
        {providers.map((p, i) => (
          <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="ps-opt" data-provider={p.id} data-model={p.model} data-mode={p.mode} data-billed={p.billed}>
            <span class="ps-mono" aria-hidden="true">{p.mono}</span>
            <span class="ps-name">{p.name}</span>
          </button>
        ))}
        <span class="ps-opt ps-opt-planned" aria-disabled="true" title="Planned">
          <span class="ps-mono" aria-hidden="true">Ac</span>
          <span class="ps-name">Coding-agent accounts</span>
          <span class="ps-planned">Planned</span>
        </span>
      </div>

      <div class="ps-status" aria-live="polite">
        <span class="ps-status-item"><span class="live-dot" aria-hidden="true"></span><span data-field="model">Claude · Sonnet</span></span>
        <span class="ps-status-item" data-field="where">Your key, in the OS keychain</span>
        <span class="ps-status-item" data-field="billed">Billed by Anthropic</span>
      </div>

      <div class="ps-chat window-mono">
        <p class="ps-user"><span class="dim">you</span> Why does the export route skip the rate limiter?</p>
        <p class="ps-reply"><span class="dim" data-field="who">claude</span> <span data-field="reply">Reading src/api/export.ts and src/app.ts. The limiter is registered after the export router, so requests to /v1/export are handled before it runs. Moving app.use(rateLimit()) above the router fixes it; I can prepare the diff.</span><span class="term-cursor" data-cursor hidden></span></p>
      </div>
    </div>
  </Window>
  <figcaption class="mt-4 flex flex-col gap-2">
    <ConceptNotice text="Product preview. Claude, OpenAI, Gemini and OpenAI-compatible keys, and Ollama and LM Studio detection, work in the development build on macOS. Coding-agent accounts are planned." />
    <p class="text-[0.8125rem] text-text-3">No Vekrun subscription. Hosted providers bill you directly; local models are free to run.</p>
  </figcaption>
</figure>

<style>
  .ps-body { padding: 0.9rem; display: flex; flex-direction: column; gap: 0.9rem; }
  .ps-pick { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .ps-opt { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.7rem 0.35rem 0.4rem; border: 1px solid var(--border); border-radius: 999px; background: var(--surface-2); color: var(--text-2); font-size: 0.8125rem; cursor: pointer; transition: border-color var(--dur-fast), color var(--dur-fast), box-shadow var(--dur), transform var(--dur-fast) var(--ease-out); }
  .ps-opt:hover { color: var(--text); border-color: var(--border-strong); transform: translateY(-1px); }
  .ps-opt[aria-checked='true'] { color: var(--text); border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), 0 8px 24px -12px color-mix(in srgb, var(--accent) 60%, transparent); background: var(--accent-soft); }
  .ps-opt-planned { cursor: default; opacity: 0.6; }
  .ps-opt-planned:hover { transform: none; border-color: var(--border); color: var(--text-2); }
  .ps-mono { display: inline-flex; width: 1.5rem; height: 1.5rem; align-items: center; justify-content: center; border-radius: 6px; background: var(--surface-3); border: 1px solid var(--border); font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-2); }
  .ps-opt[aria-checked='true'] .ps-mono { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 50%, transparent); }
  .ps-planned { font-size: 0.66rem; color: var(--text-3); border: 1px solid var(--border-strong); border-radius: 999px; padding: 0.05rem 0.4rem; }
  .ps-status { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; padding: 0.55rem 0.8rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface-2); font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-2); min-height: 2.25rem; }
  .ps-status-item { display: inline-flex; align-items: center; gap: 0.45rem; }
  .ps-chat { padding: 0.8rem 0.9rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--term-bg); color: var(--term-fg); display: flex; flex-direction: column; gap: 0.5rem; min-height: 7.5rem; }
  .ps-chat .dim { color: var(--term-dim); margin-right: 0.4rem; }
  .ps-chat p { margin: 0; line-height: 1.55; }
  .ps-reply [data-field='reply'] { color: var(--term-fg); }
  @media (prefers-reduced-motion: reduce) { .ps-opt { transition: none; } .ps-opt:hover { transform: none; } }
</style>

<script>
  import { createSequence, typeSteps, reducedMotion, type Step } from '@/scripts/sequence';

  const root = document.querySelector<HTMLElement>('[data-demo-root="providers"]');
  if (root) {
    const options = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="radio"]'));
    const field = (n: string) => root.querySelector<HTMLElement>(`[data-field="${n}"]`);
    const replyEl = field('reply')!;
    const replyText = replyEl.textContent ?? '';
    const cursor = root.querySelector<HTMLElement>('[data-cursor]')!;
    let typing: number[] = [];

    const stream = (instant: boolean) => {
      typing.forEach((id) => clearTimeout(id)); typing = [];
      if (instant) { replyEl.textContent = replyText; cursor.hidden = true; return; }
      replyEl.textContent = ''; cursor.hidden = false;
      const { steps, end } = typeSteps(() => replyEl, replyText, 0, 90);
      for (const s of steps) typing.push(window.setTimeout(s.run, s.t));
      typing.push(window.setTimeout(() => { cursor.hidden = true; }, end + 50));
    };

    const select = (btn: HTMLButtonElement, instant = false, focus = false) => {
      options.forEach((o) => { const on = o === btn; o.setAttribute('aria-checked', String(on)); o.tabIndex = on ? 0 : -1; });
      const local = btn.dataset.mode === 'local';
      field('model')!.textContent = btn.dataset.model ?? '';
      field('where')!.textContent = local ? 'Runs on your machine' : 'Your key, in the OS keychain';
      field('billed')!.textContent = btn.dataset.billed ?? '';
      field('who')!.textContent = btn.dataset.provider ?? '';
      stream(instant || reducedMotion());
      if (focus) btn.focus();
    };

    options.forEach((o, i) => {
      o.addEventListener('click', () => { seq.pause(); select(o); });
      o.addEventListener('keydown', (e) => {
        const n = options.length;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); seq.pause(); select(options[(i + 1) % n]!, false, true); }
        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); seq.pause(); select(options[(i - 1 + n) % n]!, false, true); }
      });
    });

    // Opening cycle: Claude, then Ollama, then rest on Claude.
    const byId = (id: string) => options.find((o) => o.dataset.provider === id)!;
    const steps: Step[] = [
      { t: 400, run: () => select(byId('claude')) },
      { t: 4200, run: () => select(byId('ollama')) },
      { t: 8200, run: () => select(byId('claude'), true) },
    ];
    const seq = createSequence(root, steps, { reset: () => select(byId('claude'), true) });
  }
</script>
