---
/**
 * The hero: an animated preview of the Vekrun desktop. Sidebar with the project,
 * a centre area that switches between the terminal and a diff, an agent panel on
 * the right and a status bar. Plays a six-beat workflow:
 *   1 request typed · 2 planning · 3 agent reads the project · 4 diff appears ·
 *   5 tests run · 6 review ready. Final state is in the markup for no-JS readers.
 */
import Window from '@/components/mock/Window.astro';
import DemoControls from '@/components/mock/DemoControls.astro';
---
<figure class="app-preview enter-scale" style="--i: 4" data-demo-root data-app>
  <Window title="acme-api" crumbs={['feat/vek-142-github-oauth']} class="app-window">
    <span slot="status" class="hidden items-center gap-1.5 md:inline-flex"><span class="live-dot" aria-hidden="true"></span><span data-model>Claude · your key</span></span>
    <span slot="status" class="hidden sm:inline" data-approvals>1 waiting</span>

    <div class="app-body">
      <aside class="app-side" aria-label="Project">
        <div class="app-side-group">
          <span class="app-side-title">Project</span>
          <ul class="app-tree">
            <li class="is-dir">src</li>
            <li class="is-nested">auth</li>
            <li class="is-nested2 is-changed" data-file="github">github.rs <i class="app-badge" data-file-badge>new</i></li>
            <li class="is-nested2 is-changed" data-file="mod">mod.rs <i class="app-badge" data-file-badge>M</i></li>
            <li class="is-nested">routes.rs</li>
            <li class="is-dir">migrations</li>
            <li class="is-nested is-changed" data-file="mig">0007_oauth.sql <i class="app-badge" data-file-badge>new</i></li>
            <li class="is-dir">tests</li>
            <li class="is-nested is-changed" data-file="test">auth_github.rs <i class="app-badge" data-file-badge>new</i></li>
          </ul>
        </div>
        <div class="app-side-group">
          <span class="app-side-title">Task</span>
          <ol class="app-steps" data-steps>
            <li data-step="plan" data-state="done">Plan</li>
            <li data-step="build" data-state="done">Build</li>
            <li data-step="test" data-state="done">Test</li>
            <li data-step="verify" data-state="done">Verify</li>
            <li data-step="review" data-state="running">Review</li>
          </ol>
        </div>
      </aside>

      <section class="app-main" aria-label="Workspace">
        <div class="app-main-tabs" role="presentation">
          <span class="window-tab is-active" data-main-tab="terminal">Terminal</span>
          <span class="window-tab" data-main-tab="diff">src/auth/github.rs <i class="app-badge" data-diff-count>+118</i></span>
        </div>
        <div class="app-main-panes">
          <pre class="term app-term" data-term data-pane="terminal"><span class="term-line"><span class="dim">$</span> git worktree add .worktrees/vek-142 -b feat/vek-142-github-oauth</span><span class="term-line">Preparing worktree (new branch 'feat/vek-142-github-oauth')</span><span class="term-line"><span class="dim">$</span> cargo test --test auth_github</span><span class="term-line"><span class="ok">   Compiling</span> acme-api v0.4.2</span><span class="term-line">running 5 tests</span><span class="term-line">test redirect_includes_state ... <span class="ok">ok</span></span><span class="term-line">test callback_rejects_bad_state ... <span class="ok">ok</span></span><span class="term-line">test callback_links_existing_user ... <span class="ok">ok</span></span><span class="term-line">test callback_creates_account ... <span class="ok">ok</span></span><span class="term-line">test token_never_logged ... <span class="ok">ok</span></span><span class="term-line"></span><span class="term-line">test result: <span class="ok">ok</span>. 5 passed; 0 failed</span><span class="term-line"><span class="dim">$</span> cargo test</span><span class="term-line">test result: <span class="ok">ok</span>. 41 passed; 0 failed</span><span class="term-line term-cursor"><span class="dim">$</span> </span></pre>
          <div class="app-diff" data-pane="diff" hidden>
            <div class="diff-row diff-ctx"><span>12</span><span>pub async fn callback(State(app): State&lt;App&gt;, Query(q): Query&lt;Callback&gt;) -&gt; Result&lt;Redirect&gt; &#123;</span></div>
            <div class="diff-row diff-add"><span>13</span><span>+    let expected = app.sessions.take_oauth_state(&amp;q.state).await?;</span></div>
            <div class="diff-row diff-add"><span>14</span><span>+    if expected.is_none() &#123; return Err(AuthError::BadState.into()); &#125;</span></div>
            <div class="diff-row diff-add"><span>15</span><span>+    let token = github::exchange_code(&amp;app.http, &amp;q.code).await?;</span></div>
            <div class="diff-row diff-add"><span>16</span><span>+    let profile = github::profile(&amp;app.http, &amp;token).await?;</span></div>
            <div class="diff-row diff-add"><span>17</span><span>+    let user = app.users.link_or_create_github(profile).await?;</span></div>
            <div class="diff-row diff-add"><span>18</span><span>+    app.sessions.start(user.id).await?;</span></div>
            <div class="diff-row diff-ctx"><span>19</span><span>     Ok(Redirect::to("/"))</span></div>
          </div>
        </div>
      </section>

      <aside class="app-agent" aria-label="Agent">
        <div class="window-pane-head"><span>Agent</span><span data-mode>Build</span></div>
        <div class="app-ask">
          <span class="app-ask-label">You</span>
          <p class="app-ask-text"><span data-ask>Add GitHub OAuth login to the API, with tests.</span><span class="term-cursor" data-ask-cursor hidden></span></p>
        </div>
        <ol class="app-timeline" data-timeline aria-live="polite">
          <li data-state="done"><span class="ic" aria-hidden="true"></span><div><strong>Planning</strong> reading the repository<small>axum 0.8 · sqlx · session middleware found</small></div></li>
          <li data-state="done"><span class="ic" aria-hidden="true"></span><div><strong>Plan ready</strong> 3 steps · 4 files · 1 migration<small>Waiting for your approval</small></div></li>
          <li data-state="done"><span class="ic" aria-hidden="true"></span><div><strong>Approved by you</strong><small>Branch feat/vek-142-github-oauth, own worktree</small></div></li>
          <li data-state="done"><span class="ic" aria-hidden="true"></span><div><strong>Reading</strong> src/auth, src/routes.rs, tests/<small>What is sent is shown before it is sent</small></div></li>
          <li data-state="done"><span class="ic" aria-hidden="true"></span><div><strong>Writing</strong> src/auth/github.rs<small>Shown as a diff before it is written</small></div></li>
          <li data-state="done"><span class="ic" aria-hidden="true"></span><div><strong>Running tests</strong> cargo test --test auth_github<small>An approved command, in the worktree</small></div></li>
          <li data-state="done"><span class="ic" aria-hidden="true"></span><div><strong>Independent check</strong> a different agent, same goal<small>Build, full suite, diff read against the acceptance criteria</small></div></li>
          <li data-state="approval"><span class="ic" aria-hidden="true"></span><div><strong>Ready for your review</strong> 4 files · +212 −2<small>Nothing merges until you approve</small></div></li>
        </ol>
      </aside>
    </div>

    <div class="app-status" aria-label="Status bar">
      <span data-status-branch>feat/vek-142-github-oauth</span>
      <span class="hidden sm:inline" data-status-files>4 files · +212 −2</span>
      <span class="ml-auto is-ok" data-status-right>Review ready</span>
    </div>
  </Window>
  <DemoControls notice="Product preview. A scripted walkthrough of the intended experience, not a recording of the application." />
</figure>

<style is:global>
  /* Global on purpose: the timeline and terminal rows are created at runtime and would miss scoped selectors. */
  .app-window { font-size: 0.78rem; }
  .app-body { display: grid; grid-template-columns: 1fr; grid-template-areas: 'agent' 'main'; min-height: 22rem; }
  @media (min-width: 48rem) { .app-body { grid-template-columns: 1.2fr 1fr; grid-template-areas: 'main agent'; } }
  @media (min-width: 64rem) { .app-body { grid-template-columns: 11rem 1.35fr 1fr; grid-template-areas: 'side main agent'; } }
  .app-side { grid-area: side; display: none; border-right: 1px solid var(--border); background: var(--surface-2); padding: 0.6rem 0; }
  @media (min-width: 64rem) { .app-side { display: block; } }
  .app-side-group + .app-side-group { margin-top: 0.9rem; }
  .app-side-title { display: block; padding: 0 0.85rem 0.35rem; font-family: var(--font-mono); font-size: 0.66rem; color: var(--text-3); }
  .app-tree { list-style: none; margin: 0; padding: 0; font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-2); }
  .app-tree li { padding: 0.18rem 0.85rem; display: flex; align-items: center; gap: 0.4rem; }
  .app-tree .is-dir { color: var(--text); }
  .app-tree .is-nested { padding-left: 1.6rem; } .app-tree .is-nested2 { padding-left: 2.35rem; }
  .app-tree li.is-changed { color: var(--text); }
  .app-badge { font-style: normal; font-family: var(--font-mono); font-size: 0.6rem; color: var(--ok); border: 1px solid color-mix(in srgb, var(--ok) 50%, transparent); border-radius: 4px; padding: 0 0.3rem; line-height: 1.4; }
  .app-steps { list-style: none; margin: 0; padding: 0 0.85rem; display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.72rem; color: var(--text-3); }
  .app-steps li { position: relative; padding-left: 1rem; }
  .app-steps li::before { content: ''; position: absolute; left: 0; top: 0.42em; width: 0.5rem; height: 0.5rem; border-radius: 50%; border: 1.5px solid currentColor; }
  .app-steps li[data-state='running'] { color: var(--warn); } .app-steps li[data-state='running']::before { border-top-color: transparent; animation: spin 0.9s linear infinite; }
  .app-steps li[data-state='done'] { color: var(--ok); } .app-steps li[data-state='done']::before { background: currentColor; }
  .app-main { grid-area: main; display: flex; flex-direction: column; min-width: 0; border-right: 1px solid var(--border); }
  @media (max-width: 47.9rem) { .app-main { border-right: 0; border-top: 1px solid var(--border); } }
  .app-main-tabs { display: flex; gap: 0.15rem; padding: 0.35rem 0.5rem; border-bottom: 1px solid var(--border); background: var(--surface-2); font-family: var(--font-mono); font-size: 0.7rem; overflow: hidden; }
  .app-main-tabs .window-tab { display: inline-flex; align-items: center; gap: 0.35rem; }
  .app-main-panes { position: relative; flex: 1; min-height: 14rem; }
  @media (min-width: 48rem) { .app-main-panes { min-height: 19rem; } }
  .app-term { margin: 0; padding: 0.7rem 0.85rem; height: 100%; max-height: 19rem; overflow: hidden; }
  @media (max-width: 47.9rem) { .app-term { max-height: 14rem; } }
  .app-diff { padding: 0.6rem 0.5rem; background: var(--term-bg); height: 100%; overflow: hidden; animation: fade var(--dur) var(--ease-out); }
  .app-agent { grid-area: agent; display: flex; flex-direction: column; min-width: 0; background: var(--surface); }
  .app-ask { padding: 0.65rem 0.85rem; border-bottom: 1px solid var(--border); }
  .app-ask-label { display: block; color: var(--text-3); font-family: var(--font-mono); font-size: 0.66rem; margin-bottom: 0.2rem; }
  .app-ask-text { color: var(--text); font-size: 0.8125rem; line-height: 1.45; min-height: 2.3em; }
  .app-timeline { list-style: none; margin: 0; padding: 0.55rem 0.85rem 0.7rem; display: flex; flex-direction: column; gap: 0.45rem; min-height: 9rem; }
  @media (min-width: 48rem) { .app-timeline { min-height: 14.5rem; } }
  .app-timeline li { display: grid; grid-template-columns: 0.9rem 1fr; gap: 0.5rem; align-items: start; color: var(--text-2); font-size: 0.78rem; animation: rise-sm 320ms var(--ease-out) both; }
  .app-timeline .ic { width: 0.75rem; height: 0.75rem; margin-top: 0.22rem; border-radius: 50%; border: 1.5px solid var(--border-strong); display: block; }
  .app-timeline li[data-state='running'] .ic { border-color: var(--warn); border-top-color: transparent; animation: spin 0.9s linear infinite; }
  .app-timeline li[data-state='done'] .ic { border-color: var(--ok); background: var(--ok); box-shadow: inset 0 0 0 2px var(--surface); }
  .app-timeline li[data-state='approval'] .ic { border-color: var(--info); background: var(--info); border-radius: 2px; box-shadow: inset 0 0 0 2px var(--surface); }
  .app-timeline strong { color: var(--text); font-weight: 560; }
  .app-timeline small { display: block; color: var(--text-3); font-size: 0.7rem; }
  .app-status { display: flex; gap: 1rem; padding: 0.4rem 0.85rem; border-top: 1px solid var(--border); background: var(--surface-2); font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-3); }
  .app-status .is-ok { color: var(--ok); } .app-status .is-warn { color: var(--warn); }
  @media (prefers-reduced-motion: reduce) { .app-timeline li, .app-diff { animation: none; } .app-steps li[data-state='running']::before, .app-timeline li[data-state='running'] .ic { animation: none; } }
</style>

<script>
  import { createSequence, typeSteps, appendLine, type Step } from '@/scripts/sequence';

  document.querySelectorAll<HTMLElement>('[data-app]').forEach((root) => {
    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel);
    const term = q<HTMLElement>('[data-term]')!;
    const timeline = q<HTMLElement>('[data-timeline]')!;
    const ask = q<HTMLElement>('[data-ask]')!;
    const askCursor = q<HTMLElement>('[data-ask-cursor]')!;
    const setText = (sel: string, text: string, cls?: string) => { const el = q<HTMLElement>(sel); if (!el) return; el.textContent = text; el.classList.remove('is-ok', 'is-warn'); if (cls) el.classList.add(cls); };
    const step = (id: string, state: string) => { const el = q<HTMLElement>(`[data-step="${id}"]`); if (el) el.dataset.state = state; };
    const item = (id: string, html: string, state: string) => { const li = document.createElement('li'); li.dataset.id = id; li.dataset.state = state; li.innerHTML = `<span class="ic" aria-hidden="true"></span><div>${html}</div>`; timeline.appendChild(li); };
    const itemState = (id: string, state: string) => { const li = timeline.querySelector<HTMLElement>(`[data-id="${id}"]`); if (li) li.dataset.state = state; };
    const showPane = (name: string) => {
      root.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => { p.hidden = p.dataset.pane !== name; });
      root.querySelectorAll<HTMLElement>('[data-main-tab]').forEach((t) => t.classList.toggle('is-active', t.dataset.mainTab === name));
    };
    const fileBadge = (id: string) => { const li = q<HTMLElement>(`[data-file="${id}"]`); li?.classList.add('is-changed'); li?.querySelector<HTMLElement>('[data-file-badge]')?.removeAttribute('hidden'); };

    const request = 'Add GitHub OAuth login to the API, with tests.';
    const typed = typeSteps(() => ask, request, 400, 30);

    const steps: Step[] = [
      { t: 0, run: () => { appendLine(term, '<span class="dim">~/code/acme-api</span> <span class="ok">main</span>'); appendLine(term, '<span class="dim">$</span> git status', ''); appendLine(term, 'nothing to commit, working tree clean'); } },
      ...typed.steps,
      { t: typed.end + 300, run: () => { askCursor.hidden = true; step('plan', 'running'); item('plan', '<strong>Planning</strong> reading the repository<small>axum 0.8 · sqlx · session middleware found</small>', 'running'); setText('[data-status-right]', 'Agent: planning', 'is-warn'); } },
      { t: typed.end + 1900, run: () => { itemState('plan', 'done'); item('plan-out', '<strong>Plan ready</strong> 3 steps · 4 files · 1 migration<small>Waiting for your approval</small>', 'approval'); setText('[data-approvals]', '1 waiting'); } },
      { t: typed.end + 3100, run: () => { itemState('plan-out', 'done'); step('plan', 'done'); step('build', 'running'); item('approved', '<strong>Approved by you</strong><small>Branch feat/vek-142-github-oauth, own worktree</small>', 'done'); setText('[data-approvals]', '0 waiting'); setText('[data-status-branch]', 'feat/vek-142-github-oauth'); appendLine(term, '<span class="dim">$</span> git worktree add .worktrees/vek-142 -b feat/vek-142-github-oauth'); appendLine(term, "Preparing worktree (new branch 'feat/vek-142-github-oauth')"); } },
      { t: typed.end + 3700, run: () => { item('read', '<strong>Reading</strong> src/auth, src/routes.rs, tests/<small>What is sent is shown before it is sent</small>', 'running'); setText('[data-status-right]', 'Agent: reading project', 'is-warn'); } },
      { t: typed.end + 4900, run: () => { itemState('read', 'done'); item('write', '<strong>Writing</strong> src/auth/github.rs<small>Shown as a diff before it is written</small>', 'running'); showPane('diff'); q<HTMLElement>('[data-diff-count]')?.removeAttribute('hidden'); fileBadge('github'); setText('[data-status-files]', '1 file · +118'); setText('[data-status-right]', 'Agent: building', 'is-warn'); } },
      { t: typed.end + 5900, run: () => { fileBadge('mod'); fileBadge('mig'); setText('[data-status-files]', '3 files · +153 −2'); } },
      { t: typed.end + 6700, run: () => { fileBadge('test'); itemState('write', 'done'); step('build', 'done'); step('test', 'running'); setText('[data-status-files]', '4 files · +212 −2'); item('tests', '<strong>Running tests</strong> cargo test --test auth_github<small>An approved command, in the worktree</small>', 'running'); showPane('terminal'); appendLine(term, '<span class="dim">$</span> cargo test --test auth_github'); appendLine(term, '<span class="ok">   Compiling</span> acme-api v0.4.2'); setText('[data-status-right]', 'Tests running', 'is-warn'); } },
      { t: typed.end + 7900, run: () => { appendLine(term, 'running 5 tests'); appendLine(term, 'test redirect_includes_state ... <span class="ok">ok</span>'); appendLine(term, 'test callback_rejects_bad_state ... <span class="ok">ok</span>'); } },
      { t: typed.end + 8500, run: () => { appendLine(term, 'test callback_links_existing_user ... <span class="ok">ok</span>'); appendLine(term, 'test callback_creates_account ... <span class="ok">ok</span>'); appendLine(term, 'test token_never_logged ... <span class="ok">ok</span>'); appendLine(term, ''); appendLine(term, 'test result: <span class="ok">ok</span>. 5 passed; 0 failed'); itemState('tests', 'done'); step('test', 'done'); step('verify', 'running'); item('verify', '<strong>Independent check</strong> a different agent, same goal<small>Build, full suite, diff read against the acceptance criteria</small>', 'running'); setText('[data-status-right]', 'Verifying', 'is-warn'); } },
      { t: typed.end + 10300, run: () => { appendLine(term, '<span class="dim">$</span> cargo test'); appendLine(term, 'test result: <span class="ok">ok</span>. 41 passed; 0 failed'); itemState('verify', 'done'); step('verify', 'done'); step('review', 'running'); item('review', '<strong>Ready for your review</strong> 4 files · +212 −2<small>Nothing merges until you approve</small>', 'approval'); setText('[data-approvals]', '1 waiting'); setText('[data-status-right]', 'Review ready', 'is-ok'); appendLine(term, '<span class="dim">$</span> ', 'term-cursor'); } },
    ];

    createSequence(root, steps, {
      reset: () => {
        term.innerHTML = ''; timeline.innerHTML = ''; ask.textContent = ''; askCursor.hidden = false;
        root.querySelectorAll<HTMLElement>('[data-step]').forEach((s) => s.removeAttribute('data-state'));
        root.querySelectorAll<HTMLElement>('[data-file]').forEach((f) => { f.classList.remove('is-changed'); f.querySelector<HTMLElement>('[data-file-badge]')?.setAttribute('hidden', ''); });
        q<HTMLElement>('[data-diff-count]')?.setAttribute('hidden', '');
        showPane('terminal');
        setText('[data-status-branch]', 'main'); setText('[data-status-files]', 'No changes'); setText('[data-status-right]', 'Idle'); setText('[data-approvals]', '0 waiting');
      },
    });
  });
</script>
