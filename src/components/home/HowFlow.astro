---
/**
 * Describe → Plan and compare → Build → Verify → Deliver → Remember, with the part of Vekrun that does
 * each step. The script walks a highlight through the stages and fills the
 * rail; the markup's final state shows every stage complete.
 */
import { MessageSquareText, Users, Hammer, ShieldCheck, GitPullRequest, Brain } from '@lucide/astro';
const steps = [
  { i: MessageSquareText, t: 'Describe', d: 'Say what should be true when it’s done. Vekrun already understands the project.', c: 'Your outcome' },
  { i: Users, t: 'Plan and compare', d: 'A Council challenges the plan, and competing approaches can be built and compared.', c: 'Council · Competitive' },
  { i: Hammer, t: 'Build', d: 'The Factory builds coordinated Work Items in isolated environments.', c: 'Factory · Work Items' },
  { i: ShieldCheck, t: 'Verify', d: 'Tests, browser checks and optional mutation challenges, with the evidence kept.', c: 'Proof Pack' },
  { i: GitPullRequest, t: 'Deliver', d: 'Pull requests inside your Git rules. PR Guardian handles CI failures and review changes.', c: 'Git · PR Guardian' },
  { i: Brain, t: 'Remember', d: 'Engineering Memory and architecture intelligence grow with every task.', c: 'Memory · Architecture' },
];
---
<ol class="hf" data-howflow aria-label="How Vekrun works">
  {steps.map((s, n) => (
    <li class="hf-step is-done" data-hf={n}>
      <div class="hf-top">
        <span class="hf-icon"><s.i class="h-4 w-4" aria-hidden="true" /></span>
        <span class="hf-n" aria-hidden="true">{n + 1}</span>
      </div>
      <h3>{s.t}</h3>
      <p>{s.d}</p>
      <span class="hf-chip">{s.c}</span>
    </li>
  ))}
</ol>

<style>
  .hf { position: relative; margin: 0; padding: 0; list-style: none; display: grid; gap: 0.75rem; }
  @media (min-width: 40rem) { .hf { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 60rem) { .hf { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .hf-step { position: relative; display: flex; flex-direction: column; padding: 1.25rem 1.35rem 0; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); transition: border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out), opacity var(--dur) var(--ease-out); }
  .hf-step.is-todo { opacity: 0.55; }
  .hf-step.is-now { border-color: var(--border-interactive); box-shadow: var(--glow-accent); opacity: 1; }
  .hf-top { display: flex; align-items: center; justify-content: space-between; }
  .hf-icon { display: inline-flex; width: 2rem; height: 2rem; align-items: center; justify-content: center; border-radius: var(--radius-sm); background: var(--surface-elevated); color: var(--foreground-secondary); transition: background-color var(--dur), color var(--dur); }
  .hf-step.is-done .hf-icon, .hf-step.is-now .hf-icon { background: var(--accent-subtle); color: var(--accent-text); }
  .hf-n { font-size: 0.85rem; font-weight: 560; font-variant-numeric: tabular-nums; color: var(--foreground-muted); }
  .hf-step.is-now .hf-n { color: var(--accent-text); }
  .hf-step h3 { margin: 0.9rem 0 0; font-size: 1.1rem; font-weight: 600; letter-spacing: -0.015em; color: var(--foreground); }
  .hf-step p { margin: 0.35rem 0 1.1rem; font-size: 0.92rem; line-height: 1.5; color: var(--foreground-secondary); }
  .hf-chip { margin: auto -1.35rem 0; padding: 0.7rem 1.35rem; border-top: 1px solid var(--border); font-size: 0.8rem; font-weight: 520; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--foreground-secondary); transition: color var(--dur); }
  .hf-step.is-now .hf-chip, .hf-step.is-done .hf-chip { color: var(--accent-text); }
  @media (prefers-reduced-motion: reduce) { .hf-step, .hf-icon, .hf-chip { transition: none; } }
</style>

<script>
  import { createSequence, type Step } from '@/scripts/sequence';
  for (const root of document.querySelectorAll<HTMLElement>('[data-howflow]')) {
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-hf]'));
    const show = (n: number) => items.forEach((el, i) => {
      el.classList.toggle('is-done', i < n || n === items.length);
      el.classList.toggle('is-now', i === n);
      el.classList.toggle('is-todo', i > n && n < items.length);
    });
    const steps: Step[] = [...items.map((_, n) => ({ t: 300 + n * 1600, run: () => show(n) })), { t: 300 + items.length * 1600, run: () => show(items.length) }];
    createSequence(root, steps, { reset: () => show(-1), loopAfter: 3000 });
  }
</script>
