---
/**
 * The Board story, animated: a ticket lands on the Board, gets selected,
 * Start Work opens, a way of working is chosen, a workspace opens, work begins.
 * Final state is in the markup; the script replays it from the start.
 */
import Window from '@/components/mock/Window.astro';
import Kanban, { type Column } from '@/components/mock/Kanban.astro';
import DemoControls from '@/components/mock/DemoControls.astro';

const columns: Column[] = [
  { id: 'todo', name: 'To do', cards: [
    { id: 'API-88', title: 'Rate-limit the export endpoint', src: 'Ji' },
    { id: 'WEB-311', title: 'Fix the dark-mode flash on load', src: 'Gh' },
  ] },
  { id: 'progress', name: 'In progress', cards: [
    { id: 'VEK-142', title: 'Add GitHub OAuth login', src: 'Li', selected: true, chips: [{ text: 'Agent working', tone: 'warn' }, { text: 'feat/vek-142', tone: 'muted' }] },
    { id: 'VEK-137', title: 'Migrate sessions to signed cookies', src: 'Li', chips: [{ text: 'You', tone: 'ok' }] },
  ] },
  { id: 'review', name: 'In review', cards: [
    { id: 'VEK-129', title: 'Replace the retry queue', src: 'Li', chips: [{ text: 'AI team', tone: 'info' }, { text: 'Ready for review', tone: 'ok' }] },
  ] },
  { id: 'done', name: 'Done', cards: [
    { id: 'API-80', title: 'Return 429 with a Retry-After header', src: 'Ji' },
  ] },
];
---
<figure class="board-demo" data-demo-root data-board>
  <Window title="Board" crumbs={['Assigned to you']} class="board-window">
    <span slot="status" class="hidden items-center gap-1.5 sm:inline-flex"><span class="live-dot" aria-hidden="true"></span>Linear · Jira · GitHub</span>
    <div class="board-stage">
      <Kanban columns={columns} compact />

      <div class="board-sheet" data-sheet hidden role="presentation">
        <div class="board-sheet-head">
          <span class="kanban-id">VEK-142</span>
          <strong>Add GitHub OAuth login</strong>
        </div>
        <p class="board-sheet-q">Start Work. How do you want to work on it?</p>
        <ul class="board-choices">
          <li data-choice="manual"><strong>Manually</strong><span>Branch, worktree and a terminal. You code.</span></li>
          <li data-choice="agent"><strong>With an AI agent</strong><span>The ticket becomes the agent’s brief.</span></li>
          <li data-choice="team"><strong>Delegate to an AI team</strong><span>Plan, parallel agents, a separate check.</span></li>
        </ul>
      </div>

      <div class="board-workspace" data-workspace hidden>
        <div class="window-pane-head"><span>Terminal · feat/vek-142-github-oauth</span><span>Agent · Build</span></div>
        <pre class="term board-term" data-board-term></pre>
      </div>
    </div>
  </Window>
  <DemoControls notice="Product preview. The Board works with local tickets in the development build; connecting Linear, Jira, Asana, GitHub and GitLab is planned." />
</figure>

<style is:global>
  .board-window { font-size: 0.8rem; }
  .board-stage { position: relative; }
  .board-sheet { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(26rem, calc(100% - 2rem)); background: var(--bg-elevated); border: 1px solid var(--border-strong); border-radius: var(--radius-lg); box-shadow: 0 40px 100px -30px rgba(0, 0, 0, 0.8), 0 0 0 1px color-mix(in srgb, var(--accent) 15%, transparent); padding: 1rem 1.1rem 1.1rem; z-index: 3; animation: scale-in 360ms var(--ease-out) both; }
  .board-sheet-head { display: flex; align-items: center; gap: 0.6rem; color: var(--text); font-size: 0.875rem; }
  .board-sheet-q { color: var(--text-2); font-size: 0.8125rem; margin: 0.6rem 0 0.75rem; }
  .board-choices { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .board-choices li { border: 1px solid var(--border); border-radius: 8px; padding: 0.55rem 0.7rem; display: flex; flex-direction: column; gap: 0.1rem; transition: border-color var(--dur-fast), background-color var(--dur-fast); }
  .board-choices li strong { color: var(--text); font-weight: 560; font-size: 0.8125rem; }
  .board-choices li span { color: var(--text-3); font-size: 0.75rem; }
  .board-choices li.is-hover { border-color: var(--border-strong); background: var(--surface-2); }
  .board-choices li.is-chosen { border-color: var(--accent); background: var(--accent-soft); }
  .board-workspace { position: absolute; inset: 0; z-index: 2; background: var(--surface); display: flex; flex-direction: column; animation: rise 420ms var(--ease-out) both; }
  .board-term { margin: 0; padding: 0.7rem 0.85rem; flex: 1; overflow: hidden; }
  .board-stage[data-dim='true'] .kanban { filter: blur(1px) saturate(0.8); opacity: 0.55; transition: filter var(--dur), opacity var(--dur); }
  @media (prefers-reduced-motion: reduce) { .board-sheet, .board-workspace { animation: none; } }
</style>

<script>
  import { createSequence, appendLine, type Step } from '@/scripts/sequence';

  document.querySelectorAll<HTMLElement>('[data-board]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('.board-stage')!;
    const card = root.querySelector<HTMLElement>('[data-card="VEK-142"]')!;
    const chips = card.querySelector<HTMLElement>('[data-chips]')!;
    const todo = root.querySelector<HTMLElement>('[data-column="todo"] .kanban-cards')!;
    const progress = root.querySelector<HTMLElement>('[data-column="progress"] .kanban-cards')!;
    const sheet = root.querySelector<HTMLElement>('[data-sheet]')!;
    const workspace = root.querySelector<HTMLElement>('[data-workspace]')!;
    const term = root.querySelector<HTMLElement>('[data-board-term]')!;
    const choice = (id: string) => root.querySelector<HTMLElement>(`[data-choice="${id}"]`)!;
    const counts = () => root.querySelectorAll<HTMLElement>('[data-column]').forEach((c) => { const n = c.querySelectorAll('.kanban-card:not([hidden])').length; const el = c.querySelector<HTMLElement>('[data-count]'); if (el) el.textContent = String(n); });

    const steps: Step[] = [
      { t: 300, run: () => { card.hidden = false; card.classList.add('is-entering'); counts(); } },
      { t: 1500, run: () => card.classList.add('is-selected') },
      { t: 2300, run: () => { stage.dataset.dim = 'true'; sheet.hidden = false; } },
      { t: 3200, run: () => choice('manual').classList.add('is-hover') },
      { t: 3800, run: () => { choice('manual').classList.remove('is-hover'); choice('agent').classList.add('is-hover'); } },
      { t: 4500, run: () => { choice('agent').classList.remove('is-hover'); choice('agent').classList.add('is-chosen'); } },
      { t: 5300, run: () => { sheet.hidden = true; stage.dataset.dim = 'false'; progress.prepend(card); card.classList.add('is-entering'); chips.hidden = false; counts(); } },
      { t: 6300, run: () => { workspace.hidden = false; appendLine(term, '<span class="dim">~/code/acme-api/.worktrees/vek-142</span> <span class="ok">feat/vek-142-github-oauth</span>'); appendLine(term, '<span class="dim">$</span> vekrun agent run --ticket VEK-142'); } },
      { t: 7200, run: () => { appendLine(term, '<span class="info">agent</span> Reading VEK-142 and the repository…'); } },
      { t: 8300, run: () => { appendLine(term, '<span class="info">agent</span> Plan: 3 steps, 4 files, 1 migration. <span class="warn">Approve?</span>'); appendLine(term, '<span class="dim">$</span> ', 'term-cursor'); } },
    ];

    createSequence(root, steps, {
      reset: () => {
        workspace.hidden = true; sheet.hidden = true; stage.dataset.dim = 'false'; term.innerHTML = '';
        root.querySelectorAll<HTMLElement>('[data-choice]').forEach((c) => c.classList.remove('is-hover', 'is-chosen'));
        card.classList.remove('is-selected', 'is-entering'); chips.hidden = true; todo.prepend(card); card.hidden = true; counts();
      },
    });
  });
</script>
