---
/**
 * The homepage's Cloud moment: a developer's desktop on the left, the organization
 * dashboard in a browser on the right, one wire between them carrying a finished
 * job to the people who manage the work. Static markup; the packet travels once
 * when the block scrolls into view. Everything here is demonstration data.
 */
import Window from '@/components/mock/Window.astro';
import Browser from '@/components/cloud/Browser.astro';
import Avatar from '@/components/cloud/Avatar.astro';
import { org } from '@/data/cloud-demo';
---
<div class="cp" aria-label="How a developer's Vekrun connects to the organization dashboard (illustration)">
  <svg class="cp-wire" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <defs><linearGradient id="wire-grad" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="var(--accent)"/><stop offset="1" stop-color="var(--cloud)"/></linearGradient></defs>
    <path class="wire" d="M0 50 C 30 50, 70 50, 100 50" pathLength="100"/>
    <path class="wire-packet" d="M0 50 C 30 50, 70 50, 100 50" pathLength="100"/>
  </svg>

  <div class="cp-desk">
    <Window title="Alex · Vekrun" crumbs={['Factory', 'VEK-140']} class="cp-win">
      <span slot="status" class="cp-mono">personal · acme</span>
      <div class="cp-job">
        <div class="cp-job-head"><span>Retry failed exports</span><span class="cp-mono">worker build-2</span></div>
        <span class="bar" style="--w: 100%"><i></i></span>
        <ul class="cp-agents">
          <li><Avatar kind="agent" label="D" size="sm" /><span>Developer agent</span><span class="cp-mono">done · 4 files</span></li>
          <li><Avatar kind="agent" label="T" size="sm" /><span>Testing agent</span><span class="cp-mono">18 passed</span></li>
        </ul>
        <p class="cp-pr"><span class="pill is-info">#216</span>Pull request opened · review requested</p>
      </div>
    </Window>
    <p class="cp-cap"><i class="is-mint"></i>Your desktop, your projects, your keys</p>
  </div>

  <div class="cp-dash">
    <Browser path="/acme/overview" class="cp-browser is-compact">
      <span slot="status" class="live is-on"><i></i>Up to date</span>
      <span slot="status" class="cp-who"><Avatar who="dana" size="sm" /><span>Dana</span></span>
      <div class="cp-stats" aria-hidden="true">
        <div><b>11</b><span>In progress</span></div>
        <div><b>3</b><span>Awaiting review</span></div>
        <div><b>1</b><span>AI jobs running</span></div>
        <div><b class="is-ok">9</b><span>Delivered this week</span></div>
      </div>
      <ul class="cp-feed" aria-hidden="true">
        <li><span class="pill is-ok">Merged</span><span>#216 Retry failed exports · approved by Priya</span></li>
        <li><span class="pill is-cloud">Factory</span><span>VEK-140 · build-2 finished · verified</span></li>
        <li><span class="pill is-warn">Approval</span><span>VEK-145 plan · waiting on Sam</span></li>
      </ul>
    </Browser>
    <p class="cp-cap"><i class="is-blue"></i>{org.name} in a browser, for the people who manage the work</p>
  </div>
</div>

<style>
  .cp { position: relative; display: grid; gap: 1.5rem; }
  @media (min-width: 64rem) { .cp { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 3.5rem; align-items: center; } }
  .cp-wire { display: none; }
  @media (min-width: 64rem) { .cp-wire { display: block; position: absolute; left: calc(41.6% - 1rem); width: calc(3.5rem + 2rem); top: 0; height: 100%; overflow: visible; z-index: 1; } }
  :global(.is-visible) .cp .wire-packet, :global(.is-visible) .cp-wire .wire-packet { animation: wire-travel 1100ms var(--ease-out) 700ms both; }
  .cp-win, .cp-browser { font-size: 0.74rem; }
  .cp-win { box-shadow: var(--shadow-window); }
  .cp-mono { font-family: var(--font-mono); font-size: 0.64rem; color: var(--text-3); }
  .cp-job { padding: 0.75rem 0.85rem; display: grid; gap: 0.55rem; }
  .cp-job-head { display: flex; justify-content: space-between; gap: 0.5rem; color: var(--text); font-weight: 560; }
  .cp-agents { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; color: var(--text-2); }
  .cp-agents li { display: flex; align-items: center; gap: 0.5rem; }
  .cp-agents li .cp-mono { margin-left: auto; }
  .cp-pr { margin: 0; display: flex; align-items: center; gap: 0.5rem; color: var(--text-2); padding-top: 0.4rem; border-top: 1px solid var(--border); }
  .cp-who { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--text-2); }
  .cp-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--border); border-bottom: 1px solid var(--border); }
  @media (max-width: 30rem) { .cp-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .cp-stats > div { display: flex; flex-direction: column; gap: 0.1rem; padding: 0.6rem 0.75rem; background: var(--surface); min-width: 0; font-size: 0.66rem; color: var(--text-3); }
  .cp-stats b { font-size: 1.35rem; font-weight: 600; letter-spacing: -0.02em; color: var(--text); line-height: 1.1; }
  .cp-stats b.is-ok { color: var(--ok); }
  .cp-feed { list-style: none; margin: 0; padding: 0.6rem 0.75rem; display: grid; gap: 0.4rem; color: var(--text-2); }
  .cp-feed li { display: flex; align-items: center; gap: 0.5rem; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cp-feed li > span:last-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .cp-cap { margin: 0.7rem 0 0; display: flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem; color: var(--text-3); }
  .cp-cap i { width: 0.5rem; height: 0.5rem; border-radius: 2px; }
  .cp-cap i.is-mint { background: var(--accent); } .cp-cap i.is-blue { background: var(--cloud); }
</style>
