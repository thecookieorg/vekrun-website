---
/**
 * AI Teams: Idea → Plan → Review → Build → Test → Deliver. A real sequence, so stages are numbered.
 * Selecting a stage shows what happens and what you decide there. Review (Council) is optional.
 */
interface Stage { id: string; title: string; what: string; you: string[]; optional?: boolean }
const stages: Stage[] = [
  { id: 'idea', title: 'Idea', what: 'Start from a ticket on your Board or a sentence of your own. Say what done looks like.', you: ['Edit the goal and acceptance criteria', 'Pick which models to use and how much to spend'] },
  { id: 'plan', title: 'Plan', what: 'An agent reads the project and drafts a plan: steps, files, dependencies, risks and the tests that will prove it.', you: ['Edit any step', 'Approve the plan, or send it back'] },
  { id: 'review', title: 'Review', what: 'Optional. Several models evaluate the plan independently and challenge each other’s recommendations. Disagreements are shown, not hidden.', you: ['Choose the members, models and rounds', 'Skip it for routine work'], optional: true },
  { id: 'build', title: 'Build', what: 'Agents implement the approved steps in parallel, each on its own branch and worktree, so nothing collides.', you: ['Approve diffs and commands as they come', 'Pause, redirect or take over any task'] },
  { id: 'test', title: 'Test', what: 'The tests you allow run in each worktree. Then a different agent checks the result against the goal, with the commands and output as evidence.', you: ['Decide which commands run without asking', 'Accept the check or ask for more'] },
  { id: 'deliver', title: 'Deliver', what: 'You see a merge preview with any conflicts. Nothing is merged, pushed or updated on your tracker until you approve.', you: ['Approve the merge, or not'] },
];
---
<div class="factory-flow" data-flow>
  <div class="factory-rail" role="tablist" aria-label="AI Teams stages">
    {stages.map((s, i) => (
      <button
        type="button"
        role="tab"
        id={`flow-tab-${s.id}`}
        aria-controls={`flow-panel-${s.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class="factory-stage"
        data-stage={s.id}
      >
        <span class="factory-stage-num" aria-hidden="true">{i + 1}</span>
        <span class="factory-stage-title">{s.title}{s.optional && <span class="factory-stage-opt"> optional</span>}</span>
      </button>
    ))}
  </div>

  {stages.map((s, i) => (
    <div
      role="tabpanel"
      id={`flow-panel-${s.id}`}
      aria-labelledby={`flow-tab-${s.id}`}
      class="factory-panel"
      hidden={i !== 0}
    >
      <p class="factory-what">{s.what}</p>
      <div class="factory-cols factory-cols-one">
        <div>
          <h4 class="factory-col-title">What you decide</h4>
          <ul class="factory-list">{s.you.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  .factory-flow { border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); overflow: hidden; }
  .factory-rail { display: flex; overflow-x: auto; scrollbar-width: none; border-bottom: 1px solid var(--border); background: var(--surface-2); }
  .factory-rail::-webkit-scrollbar { display: none; }
  .factory-stage {
    flex: 1 0 auto; display: flex; align-items: center; gap: 0.6rem; padding: 0.85rem 1rem; min-width: 8.5rem;
    border: 0; border-right: 1px solid var(--border); background: transparent; color: var(--text-2); text-align: left; cursor: pointer;
    position: relative; transition: color var(--dur-fast), background-color var(--dur-fast);
  }
  .factory-stage:last-child { border-right: 0; }
  .factory-stage:hover { color: var(--text); }
  .factory-stage[aria-selected='true'] { color: var(--text); background: var(--surface); }
  .factory-stage[aria-selected='true']::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--accent); }
  .factory-stage:focus-visible { outline-offset: -3px; border-radius: 0; }
  .factory-stage-num { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-3); width: 1.25rem; height: 1.25rem; border: 1px solid var(--border-strong); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .factory-stage[aria-selected='true'] .factory-stage-num { border-color: var(--accent); color: var(--accent); }
  .factory-stage-title { font-size: 0.9375rem; font-weight: 540; white-space: nowrap; }
  .factory-stage-opt { font-weight: 400; color: var(--text-3); font-size: 0.8rem; }
  .factory-panel { padding: 1.5rem; }
  @media (min-width: 48rem) { .factory-panel { padding: 2rem; } }
  .factory-what { font-size: 1.0625rem; color: var(--text); max-width: 58ch; }
  .factory-cols { display: grid; gap: 1.5rem; margin-top: 1.5rem; }
  .factory-cols-one { grid-template-columns: 1fr; }
  .factory-col-title { font-size: 0.8125rem; font-weight: 560; color: var(--text-3); margin-bottom: 0.5rem; }
  .factory-list { list-style: none; margin: 0; padding: 0; color: var(--text-2); font-size: 0.9375rem; }
  .factory-list li { padding: 0.4rem 0 0.4rem 1rem; position: relative; border-top: 1px solid var(--border); }
  .factory-list li:first-child { border-top: 0; }
  .factory-list li::before { content: ''; position: absolute; left: 0; top: 1.05em; width: 0.35rem; height: 0.35rem; border-radius: 50%; background: var(--accent); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-flow]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      panels.forEach((p, j) => { p.hidden = i !== j; });
      if (focus) { tabs[i]?.focus(); tabs[i]?.scrollIntoView({ block: 'nearest', inline: 'nearest' }); }
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        if (e.key === 'ArrowRight') { e.preventDefault(); select((i + 1) % n, true); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); select((i - 1 + n) % n, true); }
        if (e.key === 'Home') { e.preventDefault(); select(0, true); }
        if (e.key === 'End') { e.preventDefault(); select(n - 1, true); }
      });
    });
  });
</script>
