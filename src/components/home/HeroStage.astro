---
/**
 * The homepage stage: the Vekrun desktop in the centre, playing its scripted
 * workflow, with the Board and the Review Inbox layered at either side so the
 * three parts of one piece of work are visible at once. On phones and tablets
 * the side windows stack beneath the desktop.
 */
import AppPreview from './AppPreview.astro';
import Window from '@/components/mock/Window.astro';
import DemoControls from '@/components/mock/DemoControls.astro';
---
<figure class="hst-wrap" data-demo-root data-app>
<div class="hst">
  <div class="hst-main"><AppPreview /></div>

  <div class="hst-side hst-side-l" aria-hidden="true">
    <Window title="Board" crumbs={['Assigned to you']} class="hst-win">
      <ul class="hst-list">
        <li class="is-hot"><span class="hst-id">VEK-142</span><span class="hst-t">Add GitHub OAuth login</span><span class="pill is-warn">Agent working</span></li>
        <li><span class="hst-id">VEK-137</span><span class="hst-t">Migrate sessions to signed cookies</span><span class="pill is-ok">You</span></li>
        <li><span class="hst-id">VEK-129</span><span class="hst-t">Replace the retry queue</span><span class="pill is-info">AI team · review</span></li>
      </ul>
    </Window>
  </div>

  <div class="hst-side hst-side-r" aria-hidden="true">
    <Window title="Reviews" crumbs={['Waiting for you']} class="hst-win">
      <ul class="hst-list">
        <li class="is-hot"><span class="hst-id">#88</span><span class="hst-t">Add GitHub OAuth login</span><span class="pill is-warn">2 findings</span></li>
        <li><span class="hst-id">#86</span><span class="hst-t">Retry failed provider calls</span><span class="pill is-muted">Priya</span></li>
      </ul>
    </Window>
  </div>
</div>
  <DemoControls notice="Product preview. A scripted walkthrough of the intended experience, not a recording of the application." />
</figure>

<style>
  .hst-wrap { margin: 0; }
  .hst { position: relative; }
  .hst-main { position: relative; z-index: 2; min-width: 0; }
  .hst-side { position: relative; z-index: 3; min-width: 0; margin-top: 1rem; }
  .hst-win { font-size: 0.72rem; box-shadow: var(--shadow-window); }
  .hst-list { list-style: none; margin: 0; padding: 0.5rem; display: grid; gap: 0.35rem; }
  .hst-list li { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.5rem; padding: 0.45rem 0.6rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface-2); min-width: 0; }
  .hst-list li.is-hot { border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); }
  .hst-id { font-family: var(--font-mono); font-size: 0.64rem; color: var(--text-3); }
  .hst-t { color: var(--text); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (min-width: 40rem) and (max-width: 63.9rem) {
    .hst { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .hst-main { grid-column: 1 / -1; }
    .hst-side { margin-top: 0; }
  }
  @media (min-width: 64rem) {
    .hst { padding-bottom: 5.5rem; }
    .hst-main { margin-inline: 10%; }
    .hst-side { position: absolute; bottom: 0; width: 24%; margin-top: 0; }
    .hst-side-l { left: 0; bottom: 1rem; animation: slide-l 800ms var(--ease-out) both; animation-delay: 700ms; }
    .hst-side-r { right: 0; animation: slide-r 800ms var(--ease-out) both; animation-delay: 840ms; }
  }
  @media (min-width: 80rem) { .hst-main { margin-inline: 11%; } .hst-side { width: 23%; } }
  @media (prefers-reduced-motion: reduce) { .hst-side-l, .hst-side-r { animation: none; } }
</style>
