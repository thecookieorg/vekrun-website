---
/**
 * Verified engineering as a progression: code → tests → independent review →
 * Proof Pack → pull request review → delivered. Each stop says what was
 * checked. Demonstration data. The markup is the final state (every stop
 * complete); the script fills the track one stop at a time, once.
 */
import DemoControls from '@/components/mock/DemoControls.astro';
import { Code2, FlaskConical, Eye, FileCheck2, GitPullRequest, Rocket, Check } from '@lucide/astro';
const stops = [
  { i: Code2, t: 'Code', d: 'Implemented on fix/cart-sync in an isolated environment' },
  { i: FlaskConical, t: 'Tests', d: '52 of 52 pass, plus a browser check on web and iOS' },
  { i: Eye, t: 'Independent review', d: 'A model from another family checks it against your request' },
  { i: FileCheck2, t: 'Proof Pack', d: 'Evidence pinned to 9c41a7e, with one known gap listed' },
  { i: GitPullRequest, t: 'PR review', d: 'PR Guardian repairs a failing check; you approve' },
  { i: Rocket, t: 'Delivered', d: 'Merged under your branch rules, evidence attached' },
];
---
<figure class="pt" data-prooftrack data-step="6" aria-label="Example: a change moves from code through tests, independent review, a Proof Pack and pull request review to delivery">
  <ol class="pt-track">
    {stops.map((s, n) => (
      <li class="pt-s" data-pt={n}>
        <span class="pt-ic"><s.i class="pt-i h-4 w-4" aria-hidden="true" /><Check class="pt-ok h-4 w-4" aria-hidden="true" /></span>
        <p class="pt-t">{s.t}</p>
        <p class="pt-d">{s.d}</p>
      </li>
    ))}
  </ol>
  <div class="pt-foot"><span class="pt-tag">Example</span><DemoControls class="pt-ctl" /></div>
</figure>

<style>
  .pt { margin: 0; }
  .pt-track { position: relative; margin: 0; padding: 0; list-style: none; display: grid; gap: 0; }
  @media (min-width: 60rem) { .pt-track { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0.75rem; } }
  .pt-s { position: relative; display: grid; grid-template-columns: 2.75rem minmax(0, 1fr); column-gap: 0.9rem; padding-bottom: 1.4rem; }
  @media (min-width: 60rem) { .pt-s { display: block; padding-bottom: 0; } }
  /* The line to the next stop: vertical on phones, horizontal from 60rem. */
  .pt-s:not(:last-child)::before, .pt-s:not(:last-child)::after { content: ''; position: absolute; left: 1.33rem; top: 2.75rem; bottom: 0.15rem; width: 2px; border-radius: 2px; background: var(--border); }
  .pt-s:not(:last-child)::after { background: var(--accent); transform-origin: top; transform: scaleY(0); transition: transform 700ms var(--ease-out); }
  .pt-s.is-done:not(:last-child)::after { transform: scaleY(1); }
  @media (min-width: 60rem) {
    .pt-s:not(:last-child)::before, .pt-s:not(:last-child)::after { left: 3.1rem; right: -0.6rem; top: 1.33rem; bottom: auto; width: auto; height: 2px; }
    .pt-s:not(:last-child)::after { transform-origin: left; transform: scaleX(0); }
    .pt-s.is-done:not(:last-child)::after { transform: scaleX(1); }
  }
  .pt-ic { position: relative; z-index: 1; grid-row: span 2; display: inline-grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); color: var(--foreground-muted); transition: background-color var(--dur), color var(--dur), border-color var(--dur), box-shadow var(--dur); }
  .pt-ok { display: none; }
  .pt-s.is-now .pt-ic { border-color: var(--accent); color: var(--accent-text); box-shadow: 0 0 0 6px var(--accent-subtle); }
  .pt-s.is-done .pt-ic { border-color: var(--accent); background: var(--accent); color: #12140f; }
  .pt-s.is-done .pt-i { display: none; }
  .pt-s.is-done .pt-ok { display: block; }
  .pt-t { margin: 0.2rem 0 0; font-size: 1rem; font-weight: 620; letter-spacing: -0.01em; color: var(--foreground); }
  @media (min-width: 60rem) { .pt-t { margin-top: 1rem; } }
  .pt-d { margin: 0.25rem 0 0; font-size: 0.86rem; line-height: 1.45; color: var(--foreground-secondary); transition: opacity var(--dur); }
  .pt-s.is-todo .pt-t, .pt-s.is-todo .pt-d { opacity: 0.45; }
  .pt-foot { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; }
  .pt-tag { margin-top: 1.25rem; padding: 0.05rem 0.45rem; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); font-size: 0.7rem; color: var(--foreground-secondary); }
  .pt-foot :global(.pt-ctl) { margin-top: 1rem; }
  @media (prefers-reduced-motion: reduce) { .pt-s::after, .pt-ic, .pt-d { transition: none !important; } }
</style>

<script>
  import { createSequence, type Step } from '@/scripts/sequence';
  for (const root of document.querySelectorAll<HTMLElement>('[data-prooftrack]')) {
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-pt]'));
    const show = (n: number) => {
      root.dataset.step = String(n);
      items.forEach((el, i) => {
        el.classList.toggle('is-done', i < n);
        el.classList.toggle('is-now', i === n);
        el.classList.toggle('is-todo', i > n);
      });
    };
    const steps: Step[] = [...items.map((_, n) => ({ t: 250 + n * 1100, run: () => show(n) })), { t: 250 + items.length * 1100, run: () => show(items.length) }];
    show(items.length);
    createSequence(root, steps, { reset: () => show(-1) });
  }
</script>
