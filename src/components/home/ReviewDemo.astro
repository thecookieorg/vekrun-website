---
/**
 * "Review without leaving your workspace": a pull-request list, a diff that
 * appears progressively, two AI findings, a typed comment and your approval.
 * Final state is in the markup; the script replays it.
 */
import Window from '@/components/mock/Window.astro';
import DemoControls from '@/components/mock/DemoControls.astro';

const prs = [
  { id: 'pr-88', num: '#88', title: 'Add GitHub OAuth login', who: 'Requested from you', by: 'Mira', tone: 'warn' },
  { id: 'pr-86', num: '#86', title: 'Retry failed provider calls', who: 'Teammate', by: 'Priya', tone: 'muted' },
  { id: 'pr-85', num: '#85', title: 'Paginate the activity feed', who: 'Teammate', by: 'Tom', tone: 'muted' },
];
---
<figure class="rd" data-demo-root="review">
  <Window title="Reviews" crumbs={['acme-api']}>
    <span slot="status" class="hidden sm:inline" data-field="state">Approved by you</span>

    <div class="rd-split">
      <aside class="rd-list" aria-label="Pull requests (simulated)">
        <div class="window-pane-head"><span>Waiting for you</span><span>3</span></div>
        <ul>
          {prs.map((p, i) => (
            <li class:list={['rd-pr', i === 0 && 'is-selected']} data-pr={p.id}>
              <span class="rd-pr-top"><span class="rd-pr-num">{p.num}</span><span class:list={['rd-pr-who', `tone-${p.tone}`]}>{p.who}</span></span>
              <span class="rd-pr-title">{p.title}</span>
              <span class="rd-pr-by">{p.by}</span>
            </li>
          ))}
        </ul>
      </aside>

      <section class="rd-main" aria-label="Review (simulated)">
        <div class="window-pane-head"><span>#88 · src/auth/github.ts</span><span class="text-text-3">+42 −3</span></div>
        <div class="rd-diff window-mono">
          <div class="diff-row diff-ctx" data-t="900"><span>41</span><span>  const token = await exchangeCode(code);</span></div>
          <div class="diff-row diff-del" data-t="1200"><span>42</span><span>- log.debug('oauth token', token);</span></div>
          <div class="diff-row diff-add" data-t="1500"><span>42</span><span>+ log.debug('oauth exchange ok');</span></div>
          <div class="diff-row diff-ctx" data-t="1800"><span>43</span><span>  const profile = await fetchProfile(token);</span></div>
          <div class="diff-row diff-add" data-t="2100"><span>44</span><span>+ const account = await linkOrCreate(profile);</span></div>
          <div class="diff-row diff-add" data-t="2400"><span>45</span><span>+ session.set(account.id);</span></div>
          <div class="diff-row diff-ctx" data-t="2700"><span>46</span><span>  return redirect('/');</span></div>
        </div>

        <div class="rd-findings">
          <p class="rd-findings-head" data-t="3600"><span class="live-dot" aria-hidden="true"></span>AI findings · Claude, Gemini agree</p>
          <div class="rd-finding tone-err" data-t="4200">
            <span class="rd-finding-kind">Security</span>
            <span class="rd-finding-text">The token was logged at debug level before this change; make sure older log lines are purged too.</span>
            <span class="rd-finding-loc">src/auth/github.ts:42</span>
          </div>
          <div class="rd-finding tone-warn" data-t="5100">
            <span class="rd-finding-kind">Correctness</span>
            <span class="rd-finding-text">The callback does not compare the state parameter with the one issued at redirect.</span>
            <span class="rd-finding-loc">src/auth/github.ts:38</span>
          </div>
        </div>

        <div class="rd-comment" data-t="6400">
          <span class="rd-comment-who">You</span>
          <p class="rd-comment-text" data-t="6700" data-type data-cps="48">Please add the state check before merge. The token logging fix looks good.</p>
          <div class="rd-actions">
            <span class="rd-btn rd-btn-request" data-t="9400">Request changes</span>
            <span class="rd-btn rd-btn-approve is-lit" data-t="9400" data-approve>Approve with comment</span>
          </div>
          <span class="rd-done" data-t="10600">Approved by you · comment posted to the pull request</span>
        </div>
      </section>
    </div>
  </Window>
  <DemoControls notice="Product preview. AI review of local branches works in the development build; the pull-request inbox and GitHub/GitLab sync are planned." />
</figure>

<style>
  .rd-split { display: grid; grid-template-columns: 1fr; gap: 1px; background: var(--border); }
  @media (min-width: 48rem) { .rd-split { grid-template-columns: 15rem 1fr; } }
  .rd-list { background: var(--surface); min-width: 0; }
  .rd-list ul { list-style: none; margin: 0; padding: 0.5rem; display: flex; flex-direction: column; gap: 0.4rem; }
  @media (max-width: 47.9rem) { .rd-list ul { flex-direction: row; overflow-x: auto; scrollbar-width: thin; } .rd-pr { min-width: 13rem; } }
  .rd-pr { display: flex; flex-direction: column; gap: 0.2rem; padding: 0.5rem 0.6rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface-2); font-size: 0.75rem; transition: border-color var(--dur), box-shadow var(--dur); }
  .rd-pr.is-selected { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .rd-pr-top { display: flex; justify-content: space-between; gap: 0.5rem; align-items: center; }
  .rd-pr-num { font-family: var(--font-mono); color: var(--text-3); font-size: 0.68rem; }
  .rd-pr-who { font-size: 0.64rem; border-radius: 999px; padding: 0.05rem 0.4rem; border: 1px solid var(--border-strong); color: var(--text-3); }
  .rd-pr-who.tone-warn { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 50%, transparent); }
  .rd-pr-title { color: var(--text); font-weight: 540; }
  .rd-pr-by { color: var(--text-3); font-size: 0.68rem; }
  .rd-main { background: var(--surface); min-width: 0; display: flex; flex-direction: column; }
  .rd-diff { padding: 0.5rem 0.6rem; min-height: 9.5rem; display: flex; flex-direction: column; gap: 0.05rem; background: var(--term-bg); }
  .rd [data-t][hidden] { display: none; }
  .rd-findings { padding: 0.7rem 0.85rem; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 0.45rem; min-height: 7.5rem; }
  .rd-findings-head { margin: 0; display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.72rem; color: var(--text-2); }
  .rd-finding { display: grid; grid-template-columns: auto 1fr; gap: 0.15rem 0.6rem; align-items: baseline; font-size: 0.75rem; padding: 0.45rem 0.6rem; border: 1px solid var(--border); border-left-width: 3px; border-radius: var(--radius-sm); background: var(--surface-2); animation: rise-sm 360ms var(--ease-out) both; }
  .rd-finding.tone-err { border-left-color: var(--danger); } .rd-finding.tone-warn { border-left-color: var(--warn); }
  .rd-finding-kind { font-size: 0.66rem; font-weight: 560; color: var(--text-2); grid-row: span 2; align-self: start; padding-top: 0.15rem; }
  .rd-finding-text { color: var(--text); line-height: 1.4; }
  .rd-finding-loc { font-family: var(--font-mono); font-size: 0.66rem; color: var(--text-3); }
  .rd-comment { padding: 0.7rem 0.85rem; border-top: 1px solid var(--border); background: var(--surface-2); min-height: 6.75rem; display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.78rem; animation: rise-sm 360ms var(--ease-out) both; }
  .rd-comment-who { font-size: 0.68rem; color: var(--text-3); }
  .rd-comment-text { margin: 0; color: var(--text); min-height: 1.4em; }
  .rd-actions { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.2rem; }
  .rd-btn { display: inline-flex; align-items: center; height: 1.7rem; padding: 0 0.65rem; border-radius: 6px; font-size: 0.72rem; font-weight: 540; border: 1px solid var(--border-strong); color: var(--text-2); background: var(--surface); }
  .rd-btn-approve.is-lit { background: var(--accent); color: var(--accent-ink); border-color: transparent; box-shadow: 0 8px 24px -10px color-mix(in srgb, var(--accent) 70%, transparent); animation: scale-in 320ms var(--ease-spring) both; }
  .rd-done { font-size: 0.72rem; color: var(--ok); animation: fade 400ms both; }
  @media (prefers-reduced-motion: reduce) { .rd-finding, .rd-comment, .rd-btn-approve.is-lit, .rd-done { animation: none; } }
</style>

<script>
  import { createSequence, typeSteps, type Step } from '@/scripts/sequence';

  const root = document.querySelector<HTMLElement>('[data-demo-root="review"]');
  if (root) {
    const nodes = Array.from(root.querySelectorAll<HTMLElement>('[data-t]'));
    const originals = new Map(nodes.map((n) => [n, n.textContent ?? '']));
    const prs = Array.from(root.querySelectorAll<HTMLElement>('[data-pr]'));
    const state = root.querySelector<HTMLElement>('[data-field="state"]')!;

    const reset = () => {
      nodes.forEach((n) => { n.hidden = true; if (n.dataset.type !== undefined) n.textContent = ''; });
      prs.forEach((p) => p.classList.remove('is-selected'));
      state.textContent = '3 waiting for you';
    };

    const steps: Step[] = [
      { t: 400, run: () => { prs[0]?.classList.add('is-selected'); state.textContent = 'Reviewing #88'; } },
      { t: 10600, run: () => { state.textContent = 'Approved by you'; } },
    ];
    for (const n of nodes) {
      const t = Number(n.dataset.t);
      steps.push({ t, run: () => { n.hidden = false; } });
      if (n.dataset.type !== undefined) steps.push(...typeSteps(() => n, originals.get(n)!, t, Number(n.dataset.cps ?? 36)).steps);
    }
    createSequence(root, steps, { reset });
  }
</script>
