---
/**
 * Before & After rows: the old way and the Vekrun way, side by side. Rows
 * animate in as they scroll into view, the After card a beat after the
 * Before card. Without JavaScript, or with reduced motion, everything shows.
 */
import { comparisons, type Comparison } from '@/data/capabilities';
import { BookOpen, Users, Layers, ShieldCheck, GitPullRequest, MessageSquareText, ScrollText, Cpu, Check, X } from '@lucide/astro';
interface Props { ids?: string[]; compact?: boolean }
const { ids, compact = false } = Astro.props;
const items: Comparison[] = ids ? ids.map((id) => comparisons.find((c) => c.id === id)!) : comparisons;
const icons = { starting: BookOpen, planning: Users, implementation: Layers, verification: ShieldCheck, git: GitPullRequest, feedback: MessageSquareText, knowledge: ScrollText, models: Cpu } as const;
---
<ul class:list={['ba', compact && 'is-compact']} data-ba>
  {items.map((c) => {
    const I = icons[c.id as keyof typeof icons];
    return (
      <li class="ba-row" id={compact ? undefined : `ba-${c.id}`}>
        <h3 class="ba-t"><span class="ba-ic"><I class="h-4 w-4" aria-hidden="true" /></span>{c.title}</h3>
        <div class="ba-before">
          <p class="ba-tag"><X class="h-3.5 w-3.5" aria-hidden="true" />Before</p>
          <p class="ba-h">{c.before}</p>
          {!compact && <p class="ba-d">{c.beforeDetail}</p>}
        </div>
        <div class="ba-after">
          <p class="ba-tag"><Check class="h-3.5 w-3.5" aria-hidden="true" />With Vekrun</p>
          <p class="ba-h">{c.after}</p>
          {!compact && <p class="ba-d">{c.afterDetail}</p>}
        </div>
      </li>
    );
  })}
</ul>

<style>
  .ba { margin: 0; padding: 0; list-style: none; display: grid; gap: 2rem; }
  @media (min-width: 56rem) { .ba { gap: 1rem; } }
  .ba-row { display: grid; gap: 0.75rem; }
  @media (min-width: 56rem) { .ba-row { grid-template-columns: 13rem minmax(0, 1fr) minmax(0, 1fr); gap: 1rem; align-items: stretch; } }
  .ba-t { margin: 0; display: flex; align-items: center; gap: 0.6rem; font-size: 1.05rem; font-weight: 600; color: var(--foreground); }
  @media (min-width: 56rem) { .ba-t { align-self: center; } }
  .ba-ic { display: inline-flex; width: 2rem; height: 2rem; flex-shrink: 0; align-items: center; justify-content: center; border-radius: var(--radius-sm); background: var(--surface-elevated); color: var(--foreground-secondary); }
  .ba-before, .ba-after { padding: 1.1rem 1.2rem; border: 1px solid var(--border); border-radius: var(--radius-lg); }
  .ba-before { background: var(--background-secondary); }
  .ba-after { background: var(--surface); border-color: var(--border-interactive); }
  .ba-tag { margin: 0; display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.75rem; font-weight: 600; color: var(--foreground-secondary); }
  .ba-after .ba-tag { color: var(--accent-text); }
  .ba-h { margin: 0.4rem 0 0; font-size: 1rem; font-weight: 600; line-height: 1.4; color: var(--foreground); }
  .ba-before .ba-h { color: var(--foreground-secondary); }
  .ba-d { margin: 0.35rem 0 0; font-size: 0.9rem; line-height: 1.5; color: var(--foreground-secondary); }
  .is-compact .ba-row { gap: 0.6rem; }
  @media (min-width: 56rem) { .is-compact .ba-row { grid-template-columns: 11rem minmax(0, 1fr) minmax(0, 1fr); } }
  .ba-before, .ba-after { transition: opacity 500ms var(--ease-out), transform 500ms var(--ease-out); }
  .ba-after { transition-delay: 220ms; }
  [data-ba-anim] .ba-row:not(.is-in) .ba-before { opacity: 0; transform: translateY(6px); }
  [data-ba-anim] .ba-row:not(.is-in) .ba-after { opacity: 0; transform: translateX(-10px); }
  @media (prefers-reduced-motion: reduce) { .ba-before, .ba-after { transition: none; } }
</style>

<script>
  import { reducedMotion } from '@/scripts/sequence';
  for (const root of document.querySelectorAll<HTMLElement>('[data-ba]')) {
    if (reducedMotion() || !('IntersectionObserver' in window)) continue;
    root.dataset.baAnim = '';
    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
    }, { threshold: 0.3 });
    root.querySelectorAll('.ba-row').forEach((r) => io.observe(r));
  }
</script>
