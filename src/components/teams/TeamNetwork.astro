---
/**
 * The Teams hero: engineers' own Vekrun installations around Shared
 * Engineering Memory, which runs with the Coordinator and Factory workers on
 * the customer's infrastructure. Records travel only along permitted paths;
 * the Billing engineer's path carries nothing from Checkout.
 *
 * Markup is the final state. The script reveals nodes and paths once, then
 * runs the travelling records only while the figure is on screen. Under
 * reduced motion the records don't move and everything is shown at once.
 */
type W = { id: string; x: number; y: number; name: string; team: string; flow: 'in' | 'out' | 'none' };
const ws: W[] = [
  { id: 'alex', x: 85, y: 52, name: 'Alex', team: 'Checkout', flow: 'in' },
  { id: 'priya', x: 475, y: 52, name: 'Priya', team: 'Checkout', flow: 'in' },
  { id: 'sam', x: 85, y: 348, name: 'Sam', team: 'Checkout', flow: 'out' },
  { id: 'jordan', x: 475, y: 348, name: 'Jordan', team: 'Billing', flow: 'none' },
];
const hub = { x: 280, y: 175 };
const path = (w: W) => {
  const hx = hub.x + (w.x < hub.x ? -60 : 60), hy = hub.y + (w.y < hub.y ? -14 : 14);
  return `M${w.x},${w.y + (w.y < hub.y ? 24 : -24)} C${w.x},${(w.y + hy) / 2} ${hx},${(w.y + hy) / 2} ${hx},${hy}`;
};
const chips = [
  { x: 280, y: 110, t: 'Decision · verified' },
  { x: 280, y: 132, t: 'Fix · verified · 7d0b3f1' },
];
---
<figure class="tn" data-teamnet aria-label="Example: four engineers' Vekrun installations connected through Shared Engineering Memory on the organization's own infrastructure">
  <svg viewBox="0 0 560 400" class="tn-svg" role="img" aria-label="Alex and Priya, on the Checkout team, add a verified decision and a verified fix to Shared Engineering Memory. Sam, also on Checkout, receives that context for new work. Jordan, on Billing, doesn't receive Checkout records. Shared Engineering Memory, the Coordinator and Factory workers run inside the organization's infrastructure.">
    <g class="tn-infra" data-tn="infra">
      <rect x="140" y="92" width="280" height="216" rx="18" />
      <text x="158" y="292" class="tn-infra-t">Your infrastructure</text>
    </g>
    <g class="tn-paths">
      {ws.map((w, i) => <path id={`tn-p-${w.id}`} d={path(w)} class:list={['tn-path', w.flow === 'none' && 'is-quiet']} pathLength="1" data-tn={`p${i}`} />)}
    </g>
    <g class="tn-hub" data-tn="hub">
      <rect x={hub.x - 112} y={hub.y - 24} width="224" height="48" rx="12" />
      <circle cx={hub.x - 92} cy={hub.y} r="5" class="tn-hub-dot" />
      <text x={hub.x - 78} y={hub.y + 5}>Shared Engineering Memory</text>
    </g>
    <g class="tn-svc" data-tn="svc">
      <rect x="160" y="226" width="114" height="34" rx="9" /><text x="217" y="248" text-anchor="middle">Coordinator</text>
      <rect x="286" y="226" width="114" height="34" rx="9" /><text x="343" y="248" text-anchor="middle">Factory workers</text>
    </g>
    <g class="tn-chips" data-tn="chips">
      {chips.map((c) => <g><rect x={c.x - 82} y={c.y - 10} width="164" height="20" rx="6" /><text x={c.x} y={c.y + 4} text-anchor="middle">{c.t}</text></g>)}
    </g>
    <g class="tn-ws">
      {ws.map((w, i) => (
        <g class:list={['tn-w', w.flow === 'none' && 'is-other']} transform={`translate(${w.x - 66},${w.y - 24})`} data-tn={`w${i}`}>
          <rect width="132" height="48" rx="11" />
          <circle cx="22" cy="24" r="11" class="tn-av" />
          <text x="22" y="28.5" text-anchor="middle" class="tn-av-t">{w.name[0]}</text>
          <text x="40" y="21" class="tn-name">{w.name}</text>
          <text x="40" y="37" class="tn-team">{w.team} team</text>
        </g>
      ))}
    </g>
    <g class="tn-records" aria-hidden="true">
      {ws.filter((w) => w.flow !== 'none').map((w, i) => (
        <circle r="4.5" class:list={['tn-rec', w.flow === 'out' && 'is-out']}>
          <animateMotion dur="3.2s" begin={`${i * 1.1}s`} repeatCount="indefinite" keyPoints={w.flow === 'out' ? '1;0' : '0;1'} keyTimes="0;1" calcMode="linear"><mpath href={`#tn-p-${w.id}`} /></animateMotion>
        </circle>
      ))}
    </g>
  </svg>
  <figcaption class="tn-cap">
    <span><i class="is-in" aria-hidden="true"></i>Knowledge shared by permitted teammates</span>
    <span><i class="is-off" aria-hidden="true"></i>No access outside a person’s scope</span>
  </figcaption>
</figure>

<style>
  .tn { margin: 0 auto; max-width: 46rem; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-md); }
  .tn-svg { display: block; width: 100%; height: auto; overflow: visible; }
  .tn-infra rect { fill: var(--accent-subtle); stroke: var(--border-interactive); stroke-width: 1.2; stroke-dasharray: 6 5; }
  .tn-infra-t { font-size: 13px; font-weight: 560; fill: var(--accent-text); }
  .tn-path { fill: none; stroke: var(--border-interactive); stroke-width: 1.6; stroke-dasharray: 1; stroke-dashoffset: 0; transition: stroke-dashoffset 900ms var(--ease-out); }
  .tn-path.is-quiet { stroke: var(--border-strong); stroke-dasharray: 0.02 0.02; transition: opacity 600ms var(--ease-out); }
  .tn-hub rect { fill: var(--surface); stroke: var(--accent-text); stroke-width: 1.5; }
  .tn-hub-dot { fill: var(--accent); }
  .tn-hub text { font-size: 13.5px; font-weight: 620; fill: var(--foreground); }
  .tn-svc rect { fill: var(--surface); stroke: var(--border); }
  .tn-svc text { font-size: 13px; font-weight: 540; fill: var(--foreground-secondary); }
  .tn-chips rect { fill: var(--background); stroke: var(--border); }
  .tn-chips text { font-size: 11.5px; font-weight: 540; fill: var(--foreground-secondary); }
  .tn-w rect { fill: var(--background); stroke: var(--border-strong); }
  .tn-w.is-other rect { stroke: var(--border); }
  .tn-av { fill: var(--surface-elevated); }
  .tn-av-t { font-size: 12px; font-weight: 640; fill: var(--foreground); }
  .tn-name { font-size: 15px; font-weight: 600; fill: var(--foreground); }
  .tn-team { font-size: 12px; fill: var(--foreground-secondary); }
  .tn-rec { fill: var(--accent); stroke: var(--surface); stroke-width: 2; }
  .tn-rec.is-out { fill: var(--accent-text); }
  [data-tn] { transition: opacity 600ms var(--ease-out), transform 600ms var(--ease-out); }
  .tn .is-hidden { opacity: 0; }
  .tn .tn-path.is-hidden { opacity: 1; stroke-dashoffset: 1; }
  .tn .tn-path.is-quiet.is-hidden { opacity: 0; }
  .tn-cap { margin-top: 0.75rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 1.2rem; font-size: 0.78rem; color: var(--foreground-secondary); }
  .tn-cap span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .tn-cap i { width: 1.1rem; height: 0; border-top: 2px solid var(--border-interactive); }
  .tn-cap i.is-off { border-top: 2px dashed var(--border-strong); }
  .tn-ex { margin-left: auto; padding: 0.05rem 0.45rem; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); font-size: 0.7rem; }
  @media (prefers-reduced-motion: reduce) { .tn-records { display: none; } [data-tn], .tn-path { transition: none; } }
</style>

<script>
  import { createSequence, reducedMotion, type Step } from '@/scripts/sequence';
  for (const root of document.querySelectorAll<HTMLElement>('[data-teamnet]')) {
    const svg = root.querySelector('svg')!;
    const parts = (sel: string) => Array.from(root.querySelectorAll<SVGElement>(`[data-tn${sel}]`));
    const all = parts('');
    svg.pauseAnimations();
    const show = (sel: string) => parts(sel).forEach((el) => el.classList.remove('is-hidden'));
    const steps: Step[] = [
      { t: 100, run: () => show('="infra"') },
      { t: 450, run: () => show('="hub"') },
      { t: 750, run: () => show('="svc"') },
      ...[0, 1, 2, 3].map((i) => ({ t: 1000 + i * 180, run: () => { show(`="w${i}"`); show(`="p${i}"`); } })),
      { t: 2100, run: () => { show('="chips"'); if (!reducedMotion()) svg.unpauseAnimations(); } },
    ];
    createSequence(root, steps, { reset: () => all.forEach((el) => el.classList.add('is-hidden')) });
    // Records only travel while the figure is visible.
    new IntersectionObserver(([e]) => {
      if (!e || reducedMotion()) return;
      if (e.isIntersecting && !root.querySelector('[data-tn="chips"].is-hidden')) svg.unpauseAnimations();
      else svg.pauseAnimations();
    }, { threshold: 0.1 }).observe(root);
  }
</script>
