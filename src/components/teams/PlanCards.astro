---
/**
 * The two packages, side by side. Personal is free; Teams is one self-hosted
 * plan with planned launch pricing. No Enterprise card and no Cloud card exist.
 * `compact` drops the lists for the homepage.
 */
import { Check, Minus } from '@lucide/astro';
import Button from '@/components/Button.astro';
import { personal, teams, pricing, usd } from '@/data/site';
interface Props { compact?: boolean; class?: string }
const { compact = false, class: className = '' } = Astro.props;
const t = pricing.teams;
---
<div class:list={['plans', compact && 'is-compact', className]}>
  <article class="plan" aria-labelledby="plan-personal">
    <p class="plan-k">For individual engineers</p>
    <h3 id="plan-personal" class="plan-n">{personal.name}</h3>
    <p class="plan-price"><b>{personal.price}</b><span>{personal.priceNote}</span></p>
    <p class="plan-p">{personal.summary}</p>
    <ul class="plan-list">{(compact ? personal.includes.slice(0, 4) : personal.includes).map((i) => <li><Check class="h-4 w-4" aria-hidden="true" />{i}</li>)}</ul>
    <p class="plan-note">{personal.bring}</p>
  </article>
  <article class="plan is-teams" aria-labelledby="plan-teams">
    <p class="plan-k">For engineering organizations · self-hosted</p>
    <h3 id="plan-teams" class="plan-n">{teams.name}</h3>
    <p class="plan-price"><b>{usd(t.base)}</b><span>a month, up to {t.includedEngineers} engineers</span></p>
    <p class="plan-sub">+{usd(t.perAdditionalEngineer)} a month for each additional engineer. SSO included.</p>
    <p class="plan-p">{teams.summary}</p>
    <ul class="plan-list">{(compact ? teams.includes.slice(0, 4) : teams.includes).map((i) => <li><Check class="h-4 w-4" aria-hidden="true" />{i}</li>)}</ul>
    {!compact && <ul class="plan-list is-out" aria-label="Paid to others">{teams.notIncluded.map((i) => <li><Minus class="h-4 w-4" aria-hidden="true" />{i}</li>)}</ul>}
    <p class="plan-flag"><span aria-hidden="true"></span>{pricing.notForSale}</p>
    {compact && <Button href="/teams/#pricing" variant="secondary" class="mt-5 self-start">See Teams pricing</Button>}
  </article>
</div>

<style>
  .plans { display: grid; gap: 1.25rem; }
  @media (min-width: 52rem) { .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .plan { display: flex; flex-direction: column; padding: 1.6rem 1.6rem 1.5rem; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); }
  .plan.is-teams { border-color: color-mix(in srgb, var(--cloud) 45%, var(--border)); background: linear-gradient(160deg, color-mix(in srgb, var(--cloud) 9%, var(--surface)), var(--surface) 60%); }
  .plan-k { margin: 0; font-size: 0.8125rem; color: var(--text-3); }
  .plan-n { margin: 0.35rem 0 0; font-size: 1.35rem; font-weight: 600; letter-spacing: -0.02em; color: var(--text); }
  .plan-price { margin: 1rem 0 0; display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.25rem 0.6rem; }
  .plan-price b { font-size: 2.6rem; font-weight: 640; letter-spacing: -0.045em; line-height: 1; color: var(--text); font-variant-numeric: tabular-nums; }
  .plan-price span { font-size: 0.9rem; color: var(--text-2); }
  .plan-sub { margin: 0.5rem 0 0; font-size: 0.875rem; color: var(--text-2); }
  .plan-p { margin: 1rem 0 0; font-size: 0.95rem; line-height: 1.55; color: var(--text-2); }
  .plan-list { margin: 1.1rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.45rem; font-size: 0.9rem; color: var(--text); }
  .plan-list li { display: flex; gap: 0.55rem; align-items: flex-start; }
  .plan-list :global(svg) { margin-top: 0.15rem; flex-shrink: 0; color: var(--accent); }
  .plan.is-teams .plan-list :global(svg) { color: var(--cloud-strong); }
  .plan-list.is-out { margin-top: 0.8rem; padding-top: 0.8rem; border-top: 1px solid var(--border); color: var(--text-3); }
  .plan-list.is-out :global(svg) { color: var(--text-3) !important; }
  .plan-note { margin: auto 0 0; padding-top: 1.1rem; font-size: 0.8125rem; line-height: 1.5; color: var(--text-3); }
  .plan-flag { margin: 1.1rem 0 0; display: inline-flex; align-items: center; gap: 0.5rem; align-self: flex-start; padding: 0.35rem 0.75rem; border: 1px solid color-mix(in srgb, var(--warn) 40%, var(--border)); border-radius: 999px; font-size: 0.8125rem; color: var(--text-2); }
  .plan-flag span { width: 0.4rem; height: 0.4rem; border-radius: 50%; background: var(--warn); }
  .plans.is-compact .plan-p { font-size: 0.9rem; }
</style>
