---
/**
 * How Vekrun Teams is meant to run: engineers' own installations, shared
 * services on the customer's infrastructure, and the tools they already use.
 * A simple picture, not an installation guide. Columns stack on small
 * screens. The markup is the final state; the script reveals the columns and
 * runs the connector pulses only while the diagram is visible and motion is
 * allowed.
 */
import { Laptop, Server, Brain, Cpu, GitBranch, Sparkles, Plug } from '@lucide/astro';
const cols = [
  { id: 'ws', title: 'Engineer workspaces', sub: 'Vekrun on each developer’s computer', items: [
    { i: Laptop, t: 'Alex’s Mac', d: 'Personal memory, local work' },
    { i: Laptop, t: 'Priya’s Mac', d: 'Personal memory, local work' },
    { i: Laptop, t: 'Sam’s Mac', d: 'Personal memory, local work' },
  ] },
  { id: 'infra', title: 'Your infrastructure', sub: 'Your servers, private cloud or VPS', items: [
    { i: Server, t: 'Coordinator', d: 'Keeps shared engineering state the team is allowed to see' },
    { i: Brain, t: 'Shared Engineering Memory', d: 'Shared by permission and repository scope' },
    { i: Cpu, t: 'Factory workers', d: 'Run approved work on machines you control' },
  ] },
  { id: 'tools', title: 'Your existing tools', sub: 'Connected under your policies', items: [
    { i: GitBranch, t: 'Git repositories', d: 'GitHub, GitLab and your branch rules' },
    { i: Sparkles, t: 'Model providers', d: 'OpenRouter, local models, your accounts' },
    { i: Plug, t: 'Engineering tools', d: 'Trackers, monitoring, docs' },
  ] },
];
---
<figure class="sh" data-selfhost aria-label="Planned Vekrun Teams architecture: engineer workspaces connect to shared services on your infrastructure, which connect to your existing tools">
  <div class="sh-row">
    {cols.map((c, n) => (
      <>
        {n > 0 && <div class="sh-link" aria-hidden="true" data-sh={`l${n}`}><span></span></div>}
        <section class:list={['sh-col', `is-${c.id}`]} data-sh={`c${n}`} aria-label={c.title}>
          <h4>{c.title}</h4>
          <p class="sh-sub">{c.sub}</p>
          <ul>
            {c.items.map((it) => <li><span class="sh-ic"><it.i class="h-4 w-4" aria-hidden="true" /></span><div><p>{it.t}</p><span>{it.d}</span></div></li>)}
          </ul>
        </section>
      </>
    ))}
  </div>
  <figcaption class="sh-cap">Planned architecture. No Vekrun-operated cloud service is required.</figcaption>
</figure>

<style>
  .sh { margin: 0; }
  .sh-row { display: grid; gap: 0; }
  @media (min-width: 60rem) { .sh-row { grid-template-columns: minmax(0, 1fr) 3rem minmax(0, 1.15fr) 3rem minmax(0, 1fr); align-items: center; } }
  .sh-col { padding: 1.1rem; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); transition: opacity 550ms var(--ease-out), transform 550ms var(--ease-out); }
  .sh-col.is-infra { border: 1.5px dashed var(--border-interactive); background: var(--accent-subtle); box-shadow: var(--glow-accent); }
  .sh-col h4 { margin: 0; font-size: 1rem; font-weight: 620; color: var(--foreground); }
  .sh-sub { margin: 0.2rem 0 0; font-size: 0.8rem; color: var(--foreground-secondary); }
  .is-infra .sh-sub { color: var(--accent-text); font-weight: 560; }
  .sh-col ul { margin: 0.9rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.5rem; }
  .sh-col li { display: flex; gap: 0.6rem; align-items: flex-start; padding: 0.6rem 0.7rem; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--background); }
  .sh-ic { display: inline-grid; place-items: center; flex-shrink: 0; width: 1.9rem; height: 1.9rem; border-radius: var(--radius-sm); background: var(--surface-elevated); color: var(--foreground-secondary); }
  .is-infra .sh-ic { background: var(--accent-subtle); color: var(--accent-text); }
  .sh-col li p { margin: 0; font-size: 0.86rem; font-weight: 600; color: var(--foreground); }
  .sh-col li span:not(.sh-ic) { font-size: 0.76rem; line-height: 1.4; color: var(--foreground-secondary); }
  .sh-link { position: relative; height: 2.25rem; display: grid; place-items: center; transition: opacity 550ms var(--ease-out); }
  .sh-link span { position: relative; width: 2px; height: 100%; overflow: hidden; background: var(--border-interactive); }
  @media (min-width: 60rem) { .sh-link { height: auto; } .sh-link span { width: 100%; height: 2px; } }
  .sh-link span::after { content: ''; position: absolute; width: 6px; height: 6px; border-radius: 999px; background: var(--accent); left: -2px; top: -6px; opacity: 0; }
  @media (min-width: 60rem) { .sh-link span::after { left: -6px; top: -2px; } }
  .sh[data-live] .sh-link span::after { opacity: 1; animation: sh-v 1.8s var(--ease-out) infinite; }
  @media (min-width: 60rem) { .sh[data-live] .sh-link span::after { animation-name: sh-h; } }
  .sh[data-live] [data-sh='l2'] span::after { animation-delay: 0.9s; }
  @keyframes sh-v { from { transform: translateY(0); } to { transform: translateY(2.6rem); } }
  @keyframes sh-h { from { transform: translateX(0); } to { transform: translateX(3.4rem); } }
  .sh .is-hidden { opacity: 0; transform: translateY(8px); }
  .sh-link.is-hidden { transform: none; }
  .sh-cap { margin-top: 0.9rem; font-size: 0.8rem; color: var(--foreground-secondary); }
  @media (prefers-reduced-motion: reduce) { .sh-col, .sh-link { transition: none; } .sh-link span::after { display: none; } }
</style>

<script>
  import { createSequence, reducedMotion, type Step } from '@/scripts/sequence';
  for (const root of document.querySelectorAll<HTMLElement>('[data-selfhost]')) {
    const parts = Array.from(root.querySelectorAll<HTMLElement>('[data-sh]'));
    const order = ['c0', 'l1', 'c1', 'l2', 'c2'];
    let visible = false, revealed = false;
    const live = () => { if (visible && revealed && !reducedMotion()) root.dataset.live = ''; else delete root.dataset.live; };
    const steps: Step[] = [
      ...order.map((id, i) => ({ t: 150 + i * 280, run: () => root.querySelector(`[data-sh="${id}"]`)?.classList.remove('is-hidden') })),
      { t: 1500, run: () => { revealed = true; live(); } },
    ];
    createSequence(root, steps, { reset: () => { revealed = false; live(); parts.forEach((p) => p.classList.add('is-hidden')); }, onFinish: () => { revealed = true; live(); } });
    new IntersectionObserver(([e]) => { visible = !!e?.isIntersecting; live(); }).observe(root);
  }
</script>
