---
/**
 * Competitive Engineering, as an example on a fictional Rails checkout: two
 * approaches built by different agents from the same commit, checked against
 * the same criteria, then compared. Every check is passed, failed or not
 * checked, and says so. A second scenario shows that when nothing qualifies,
 * Vekrun doesn't pick one. All data is illustrative. The markup holds the
 * final state; the script replays building, checking and the verdict,
 * switches scenarios and records the visitor's choice.
 */
import { Check, X, GitBranch, CircleDashed, GitCommitHorizontal } from '@lucide/astro';

type State = 'pass' | 'fail' | 'none';
type Approach = { id: string; name: string; agent: string; ok: boolean; checks: { k: string; s: State; v: string }[]; meta: { k: string; v: string }[]; note?: string };
type Scenario = { id: string; tab: string; goal: string; criteria: string; approaches: Approach[]; verdict: { title: string; text: string }; choose: boolean };

const scenarios: Scenario[] = [
  {
    id: 'retries', tab: 'One approach qualifies', goal: 'Make payment retries idempotent', criteria: '4 acceptance criteria',
    approaches: [
      { id: 'A', name: 'Idempotency key in the database', agent: 'Codex', ok: true, checks: [
        { k: 'Request and unit tests', s: 'pass', v: '52 of 52' },
        { k: '200 duplicate webhooks at once', s: 'pass', v: 'No double charges' },
        { k: 'Retry after a worker crash', s: 'pass', v: 'Charged once' },
        { k: 'Peak-traffic load', s: 'none', v: 'No load profile' },
      ], meta: [{ k: 'Change', v: '+180 −30, 5 files' }, { k: 'New infrastructure', v: 'None' }] },
      { id: 'B', name: 'Lock in Redis', agent: 'Grok Build', ok: false, checks: [
        { k: 'Request and unit tests', s: 'pass', v: '52 of 52' },
        { k: '200 duplicate webhooks at once', s: 'fail', v: '3 double charges' },
        { k: 'Retry after a worker crash', s: 'fail', v: 'Lock lost on restart' },
        { k: 'Peak-traffic load', s: 'none', v: 'No load profile' },
      ], meta: [{ k: 'Change', v: '+240 −20, 7 files' }, { k: 'New infrastructure', v: 'A Redis lock' }], note: 'A race between two webhook deliveries slips past the lock.' },
    ],
    verdict: { title: 'Recommended: A', text: 'A meets every criterion that was checked, with nothing new to run. B passes its tests but double-charges under concurrency. Load wasn’t checked for either, and the Proof Pack says so.' },
    choose: true,
  },
  {
    id: 'uploads', tab: 'Neither qualifies', goal: 'Speed up photo uploads on mobile', criteria: '3 acceptance criteria',
    approaches: [
      { id: 'A', name: 'Resize in the browser', agent: 'Claude Code', ok: false, checks: [
        { k: 'Upload tests', s: 'fail', v: '31 of 32' },
        { k: 'Large HEIC photos in Safari', s: 'fail', v: 'Upload fails' },
        { k: 'Upload p95 not worse', s: 'pass', v: '1.8 → 0.9 s' },
      ], meta: [{ k: 'Change', v: '+140 −20, 4 files' }] },
      { id: 'B', name: 'Resize in a background queue', agent: 'Vekrun agent', ok: false, checks: [
        { k: 'Upload tests', s: 'pass', v: '32 of 32' },
        { k: 'Large HEIC photos in Safari', s: 'pass', v: 'Uploads' },
        { k: 'Upload p95 not worse', s: 'fail', v: '1.8 → 2.3 s' },
      ], meta: [{ k: 'Change', v: '+260 −30, 6 files' }] },
    ],
    verdict: { title: 'No recommendation', text: 'Neither approach met every requirement, so Vekrun doesn’t pick one. Both attempts and their evidence are kept, and you decide what to try next.' },
    choose: false,
  },
];
const stateIcon = { pass: Check, fail: X, none: CircleDashed } as const;
const stateLabel = { pass: 'Passed', fail: 'Failed', none: 'Not checked' } as const;
---
<figure class="cx" data-compete data-phase="done" aria-label="Example: two approaches built from the same commit, checked against the same criteria and compared">
  <div class="cx-top">
    <div class="cx-tabs" role="tablist" aria-label="Competitive Engineering examples">
      {scenarios.map((s, i) => <button type="button" role="tab" id={`cx-t-${s.id}`} aria-controls={`cx-p-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={s.id}>{s.tab}</button>)}
    </div>
    <span class="cx-tag">Example data</span>
  </div>

  {scenarios.map((s, i) => (
    <div class="cx-panel" role="tabpanel" id={`cx-p-${s.id}`} aria-labelledby={`cx-t-${s.id}`} hidden={i !== 0} data-panel={s.id}>
      <div class="cx-goal">
        <p class="cx-goal-t">{s.goal}</p>
        <p class="cx-goal-m"><span><GitBranch class="h-3.5 w-3.5" aria-hidden="true" />shop-rails</span><span><GitCommitHorizontal class="h-3.5 w-3.5" aria-hidden="true" />Both start from a41c9e2</span><span>{s.criteria}, the same for each</span></p>
      </div>
      <ol class="cx-grid" aria-label="Approaches">
        {s.approaches.map((a) => (
          <li class:list={['cx-a', a.ok ? 'is-ok' : 'is-no']} data-a={a.id}>
            <div class="cx-a-head">
              <span class="cx-id" aria-hidden="true">{a.id}</span>
              <h4>{a.name}</h4>
              <span class="cx-agent">{a.agent}</span>
            </div>
            <p class="cx-status">
              <span class="cx-s cx-s-build">Building on its own branch…</span>
              <span class="cx-s cx-s-test">Checking against the criteria…</span>
              <span class="cx-s cx-s-done">{a.ok ? <><Check class="h-3.5 w-3.5" aria-hidden="true" />Qualifies</> : <><X class="h-3.5 w-3.5" aria-hidden="true" />Doesn’t qualify</>}</span>
            </p>
            <ul class="cx-checks" aria-label={`Checks for approach ${a.id}`}>
              {a.checks.map((c) => { const I = stateIcon[c.s]; return (
                <li class={`is-${c.s}`}><I class="h-3.5 w-3.5" aria-hidden="true" /><span class="cx-ck">{c.k}</span><span class="cx-cv"><span class="sr-only">{stateLabel[c.s]}: </span>{c.v}</span></li>
              ); })}
            </ul>
            <dl class="cx-rows">
              {a.meta.map((r) => <div><dt>{r.k}</dt><dd>{r.v}</dd></div>)}
            </dl>
            {a.note && <p class="cx-note">{a.note}</p>}
          </li>
        ))}
      </ol>
      <ul class="cx-legend" aria-hidden="true"><li class="is-pass"><Check class="h-3 w-3" />Passed</li><li class="is-fail"><X class="h-3 w-3" />Failed</li><li class="is-none"><CircleDashed class="h-3 w-3" />Not checked</li></ul>
      <div class:list={['cx-verdict', !s.choose && 'is-none']}>
        <div>
          <p class="cx-v-t">{s.verdict.title}</p>
          <p class="cx-v-p">{s.verdict.text}</p>
        </div>
        {s.choose && (
          <div class="cx-choose" role="group" aria-label="Decide what happens next">
            {s.approaches.filter((a) => a.ok).map((a) => <button type="button" class="cx-btn" data-choose={a.id} aria-pressed="false">Choose {a.id}</button>)}
            <button type="button" class="cx-btn" data-choose="retry" aria-pressed="false">Try a third approach</button>
          </div>
        )}
        {s.choose && <p class="cx-chosen" data-chosen aria-live="polite">You decide. The approach you don’t choose is kept, with its evidence and reasoning.</p>}
      </div>
    </div>
  ))}
</figure>

<style>
  .cx { margin: 0; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); overflow: hidden; }
  .cx-top { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.7rem 0.9rem; border-bottom: 1px solid var(--border); }
  .cx-tabs { display: inline-flex; flex-wrap: wrap; gap: 0.25rem; padding: 0.2rem; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--background); }
  .cx-tabs button { padding: 0.35rem 0.75rem; border-radius: var(--radius-sm); font-size: 0.85rem; font-weight: 540; color: var(--foreground-secondary); transition: background-color var(--dur-fast), color var(--dur-fast); }
  .cx-tabs button:hover { color: var(--foreground); }
  .cx-tabs button[aria-selected='true'] { background: var(--surface-elevated); color: var(--foreground); box-shadow: var(--shadow-sm); }
  .cx-tabs button:focus-visible, .cx-btn:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .cx-tag { flex-shrink: 0; padding: 0.05rem 0.4rem; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); font-size: 0.7rem; color: var(--foreground-secondary); }
  .cx-panel { padding: 1.1rem; }
  @media (min-width: 64rem) { .cx-panel { padding: 1.5rem 1.6rem 1.6rem; } }
  .cx-goal-t { margin: 0; font-size: 1.15rem; font-weight: 640; letter-spacing: -0.015em; color: var(--foreground); }
  .cx-goal-m { margin: 0.4rem 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 1rem; font-size: 0.82rem; color: var(--foreground-secondary); }
  .cx-goal-m span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .cx-grid { margin: 1rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.6rem; }
  @media (min-width: 48rem) { .cx-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem; } }
  .cx-a { display: grid; align-content: start; gap: 0.7rem; padding: 1.05rem; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--background); transition: border-color var(--dur), opacity var(--dur); }
  .cx-a-head { display: flex; align-items: center; gap: 0.5rem; }
  .cx-id { display: inline-grid; place-items: center; flex-shrink: 0; width: 1.4rem; height: 1.4rem; border-radius: var(--radius-sm); background: var(--surface-elevated); font-size: 0.75rem; font-weight: 640; color: var(--foreground); }
  .cx-agent { margin-left: auto; flex-shrink: 0; padding: 0.05rem 0.45rem; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); font-size: 0.72rem; font-weight: 560; color: var(--foreground-secondary); }
  .cx-a h4 { margin: 0; min-width: 0; font-size: 1rem; font-weight: 600; line-height: 1.3; color: var(--foreground); }
  .cx-status { margin: 0; min-height: 1.4rem; font-size: 0.8rem; font-weight: 560; }
  .cx-s { display: none; align-items: center; gap: 0.3rem; }
  [data-phase='build'] .cx-s-build, [data-phase='test'] .cx-s-test, [data-phase='done'] .cx-s-done { display: inline-flex; }
  .cx-s-build, .cx-s-test { color: var(--foreground-secondary); }
  .is-ok .cx-s-done { color: var(--accent-text); }
  .is-no .cx-s-done { color: var(--danger, #e5484d); }
  .cx-checks { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.15rem; transition: opacity var(--dur) var(--ease-out); }
  .cx-checks li { display: grid; grid-template-columns: 1rem minmax(0, 1fr) auto; gap: 0.5rem; align-items: center; padding: 0.4rem 0.5rem; border-radius: var(--radius-sm); font-size: 0.86rem; }
  .cx-checks li:nth-child(odd) { background: color-mix(in srgb, var(--surface) 70%, transparent); }
  .cx-ck { color: var(--foreground); }
  .cx-cv { text-align: right; font-weight: 560; font-variant-numeric: tabular-nums; color: var(--foreground-secondary); }
  .cx-checks .is-pass > :global(svg) { color: var(--accent-text); }
  .cx-checks .is-fail > :global(svg), .cx-checks .is-fail .cx-cv { color: var(--danger, #e5484d); }
  .cx-checks .is-none > :global(svg) { color: var(--foreground-muted); }
  .cx-checks .is-none .cx-cv { font-style: italic; }
  .cx-legend { margin: 0.75rem 0 0; padding: 0; list-style: none; display: flex; gap: 1rem; font-size: 0.75rem; color: var(--foreground-secondary); }
  .cx-legend li { display: inline-flex; align-items: center; gap: 0.3rem; }
  .cx-legend .is-pass :global(svg) { color: var(--accent-text); } .cx-legend .is-fail :global(svg) { color: var(--danger, #e5484d); }
  .cx-rows { margin: 0; padding-top: 0.6rem; border-top: 1px solid var(--border); display: grid; gap: 0.3rem; font-size: 0.8rem; transition: opacity var(--dur) var(--ease-out); }
  .cx-rows div { display: flex; justify-content: space-between; gap: 0.5rem; }
  .cx-rows dt { color: var(--foreground-secondary); }
  .cx-rows dd { margin: 0; text-align: right; font-weight: 560; font-variant-numeric: tabular-nums; color: var(--foreground); }
  .cx-rows .is-bad dd { color: var(--danger, #e5484d); }
  .cx-note { margin: 0; padding-top: 0.45rem; border-top: 1px solid var(--border); font-size: 0.76rem; line-height: 1.45; color: var(--foreground-secondary); }
  [data-phase='done'] .cx-a.is-ok { border-color: var(--border-interactive); }
  [data-phase='done'] .cx-a.is-no { border-style: dashed; }
  [data-phase='build'] .cx-rows, [data-phase='build'] .cx-note, [data-phase='build'] .cx-checks, [data-phase='test'] .cx-rows, [data-phase='test'] .cx-note { opacity: 0.15; }
  .cx-a.is-chosen { box-shadow: var(--glow-accent); }
  .cx-verdict { margin-top: 0.9rem; display: grid; gap: 0.75rem; padding: 0.95rem 1rem; border: 1px solid var(--border-interactive); border-radius: var(--radius-md); background: var(--accent-subtle); transition: opacity var(--dur) var(--ease-out), transform var(--dur) var(--ease-out); }
  .cx-verdict.is-none { border-color: var(--border-strong); background: var(--surface-elevated); }
  @media (min-width: 48rem) { .cx-verdict { grid-template-columns: minmax(0, 1fr) auto; align-items: center; } .cx-chosen { grid-column: 1 / -1; } }
  [data-phase='build'] .cx-verdict, [data-phase='test'] .cx-verdict { opacity: 0; transform: translateY(6px); }
  .cx-v-t { margin: 0; font-size: 0.95rem; font-weight: 640; color: var(--foreground); }
  .cx-v-p { margin: 0.25rem 0 0; font-size: 0.85rem; line-height: 1.5; color: var(--foreground-secondary); }
  .cx-choose { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .cx-btn { padding: 0.4rem 0.8rem; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); background: var(--surface); font-size: 0.82rem; font-weight: 560; color: var(--foreground); transition: background-color var(--dur-fast), border-color var(--dur-fast); }
  .cx-btn:hover { background: var(--surface-hover); }
  .cx-btn[aria-pressed='true'] { border-color: var(--accent); background: var(--accent); color: #12140f; }
  .cx-chosen { margin: 0; font-size: 0.8rem; color: var(--foreground-secondary); }
  @media (prefers-reduced-motion: reduce) { .cx-a, .cx-rows, .cx-checks, .cx-verdict { transition: none; } }
</style>

<script>
  import { createSequence, type Step } from '@/scripts/sequence';
  for (const root of document.querySelectorAll<HTMLElement>('[data-compete]')) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const phase = (p: string) => { root.dataset.phase = p; };
    const seq = createSequence(root, [
      { t: 200, run: () => phase('build') },
      { t: 1600, run: () => phase('test') },
      { t: 3200, run: () => phase('done') },
    ] as Step[], { reset: () => phase('build') });

    const select = (i: number, focus = false) => {
      tabs.forEach((t, n) => { t.setAttribute('aria-selected', String(n === i)); t.tabIndex = n === i ? 0 : -1; });
      panels.forEach((p, n) => { p.hidden = n !== i; });
      if (focus) tabs[i]!.focus();
      seq.replay();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        select((i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length, true);
      });
    });

    for (const panel of panels) {
      const btns = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-choose]'));
      const out = panel.querySelector<HTMLElement>('[data-chosen]');
      btns.forEach((b) => b.addEventListener('click', () => {
        seq.finish();
        const id = b.dataset.choose!;
        btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        panel.querySelectorAll<HTMLElement>('[data-a]').forEach((a) => a.classList.toggle('is-chosen', a.dataset.a === id));
        if (out) out.textContent = id === 'retry'
          ? 'Vekrun will design a third approach from the same commit. A and B stay on record with their evidence.'
          : `You chose ${id}. The other approach is kept with its evidence and reasoning, in case you revisit the decision.`;
      }));
    }
  }
</script>
