---
/**
 * "Your organization. Your rules." Organization settings as a real settings
 * interface: nine sections behind a vertical tablist. Motion only answers a
 * click. Demonstration data; Enterprise identity is marked planned.
 */
import Browser from './Browser.astro';
import Avatar from './Avatar.astro';
import ConceptNotice from '@/components/ConceptNotice.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { people, workers } from '@/data/cloud-demo';

const tabs = [
  { id: 'members', label: 'Members' },
  { id: 'roles', label: 'Roles' },
  { id: 'models', label: 'AI model policies' },
  { id: 'budgets', label: 'Budgets' },
  { id: 'approvals', label: 'Approvals' },
  { id: 'workers', label: 'Shared workers' },
  { id: 'audit', label: 'Audit log' },
  { id: 'data', label: 'Data sharing' },
  { id: 'identity', label: 'Identity' },
];
const members = [
  { who: 'dana', teams: 'Management', last: 'now' },
  { who: 'sam', teams: 'Platform', last: '4 min ago' },
  { who: 'alex', teams: 'Platform', last: '12 min ago' },
  { who: 'priya', teams: 'Web', last: '1 h ago' },
] as const;
const perms = ['Start Factory work', 'Approve plans', 'Approve merges', 'Run production commands', 'Manage budgets', 'Manage members and policies'];
const roleMatrix: Record<string, boolean[]> = {
  Developer: [true, false, false, false, false, false],
  'Engineering lead': [true, true, true, true, true, false],
  'Project manager': [false, false, false, false, true, false],
  Administrator: [true, true, true, true, true, true],
};
const providers = [
  { name: 'Anthropic', how: 'company key', on: true, note: 'approved models only' },
  { name: 'OpenAI', how: 'company key', on: true, note: 'approved models only' },
  { name: 'Local models', how: 'on developer machines', on: true, note: 'any' },
  { name: 'OpenRouter', how: 'personal keys', on: false, note: 'not allowed for organization work' },
];
const budgets = [{ t: 'Platform team', used: 112, total: 300 }, { t: 'Web team', used: 38, total: 150 }, { t: 'Factory queues', used: 34, total: 150 }, { t: 'Per developer', used: 0, total: 200, note: 'weekly cap, each' }];
const approvalRules = [
  { r: 'Plans before Factory runs them', who: 'engineering lead', on: true },
  { r: 'Merges', who: 'a person, never an agent', on: true },
  { r: 'Production-related commands', who: 'engineering lead', on: true },
  { r: 'AI operations over $25', who: 'engineering lead', on: true },
  { r: 'New shared workers', who: 'administrator', on: true },
  { r: 'Reviews of agent-written changes', who: 'any developer', on: false },
];
const audit = [
  { t: '14:02', who: 'sam', s: 'approved plan VEK-152 · 3 steps · $9' },
  { t: '13:48', who: 'alex', s: 'approved "add idempotency key" on VEK-145' },
  { t: '13:40', who: 'dana', s: 'added VEK-152 to the Platform queue' },
  { t: '11:15', who: 'sam', s: 'changed the weekly Factory budget from $120 to $150' },
  { t: 'Tue', who: 'dana', s: 'invited Priya to the Web team' },
] as const;
const data = [
  { k: 'Tickets, assignments and priorities', v: 'shared with the project', on: true },
  { k: 'Plans and approvals', v: 'shared with the project', on: true },
  { k: 'Review status and AI findings', v: 'shared with reviewers', on: true },
  { k: 'Factory job progress, cost and results', v: 'shared with the team', on: true },
  { k: 'Insights investigations', v: 'shared with the project', on: true },
  { k: 'Source code', v: 'stays on developer machines and in your repositories', on: false },
  { k: 'API keys, tokens and secrets', v: 'never leave the machine they are on', on: false },
  { k: 'Personal projects', v: 'never part of an organization', on: false },
];
---
<figure class="gv" data-governance>
  <Browser path="/acme/settings" class="gv-browser">
    <span slot="status" class="hidden sm:inline">Administrator · Sam</span>
    <div class="gv-body">
      <div role="tablist" aria-orientation="vertical" aria-label="Organization settings" class="gv-tabs">
        {tabs.map((t, i) => <button type="button" role="tab" id={`gv-tab-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`gv-panel-${t.id}`} tabindex={i === 0 ? 0 : -1} class="gv-tab" data-gv-tab={t.id}>{t.label}{t.id === 'identity' && <StatusBadge status="planned" kind="roadmap" compact class="ml-auto" />}</button>)}
      </div>

      <div class="gv-main">
        <section role="tabpanel" id="gv-panel-members" aria-labelledby="gv-tab-members" class="gv-panel" data-gv-panel="members">
          <header class="gv-h"><h4>Members</h4><p>5 people, 3 teams, 2 shared workers</p></header>
          <ul class="gv-rows">
            {members.map((m) => <li class="gv-member"><Avatar who={m.who} /><span><b>{people[m.who].name}</b><small>{people[m.who].where}</small></span><span class="gv-role">{people[m.who].role}</span><span class="gv-dim">{m.teams}</span><span class="gv-dim gv-hide-sm">{m.last}</span></li>)}
            <li class="gv-member"><Avatar kind="worker" label="W" /><span><b>build-2, build-3</b><small>company build machines</small></span><span class="gv-role">Shared workers</span><span class="gv-dim">Platform</span><span class="gv-dim gv-hide-sm">busy · idle</span></li>
          </ul>
        </section>

        <section role="tabpanel" id="gv-panel-roles" aria-labelledby="gv-tab-roles" class="gv-panel" data-gv-panel="roles" hidden>
          <header class="gv-h"><h4>Roles</h4><p>What each role may do. Project access is granted per project on top of this.</p></header>
          <div class="gv-scroll"><table class="gv-matrix">
            <thead><tr><th scope="col">Permission</th>{Object.keys(roleMatrix).map((r) => <th scope="col">{r}</th>)}</tr></thead>
            <tbody>{perms.map((p, i) => <tr><th scope="row">{p}</th>{Object.values(roleMatrix).map((row) => <td>{row[i] ? <span class="gv-yes" aria-label="allowed">✓</span> : <span class="gv-no" aria-label="not allowed">–</span>}</td>)}</tr>)}</tbody>
          </table></div>
        </section>

        <section role="tabpanel" id="gv-panel-models" aria-labelledby="gv-tab-models" class="gv-panel" data-gv-panel="models" hidden>
          <header class="gv-h"><h4>AI model policies</h4><p>Which providers organization work may use, and whose keys pay for it.</p></header>
          <ul class="gv-rows">
            {providers.map((p) => <li class="gv-provider"><span class:list={['gv-switch', p.on && 'is-on']} role="img" aria-label={p.on ? 'allowed' : 'not allowed'}><i></i></span><span><b>{p.name}</b><small>{p.how}</small></span><span class="gv-dim">{p.note}</span></li>)}
          </ul>
          <p class="gv-note">Personal work on a developer's machine keeps using their own providers and keys. This policy applies only inside the organization workspace.</p>
        </section>

        <section role="tabpanel" id="gv-panel-budgets" aria-labelledby="gv-tab-budgets" class="gv-panel" data-gv-panel="budgets" hidden>
          <header class="gv-h"><h4>Budgets</h4><p>Weekly AI spending limits. Every job shows its estimate before it starts and its cost when it ends.</p></header>
          <ul class="gv-budgets">
            {budgets.map((b) => <li><span class="gv-budget-l"><b>{b.t}</b><small>{b.note ?? `$${b.used} of $${b.total}`}</small></span><span class="cl-bar" style={`--w: ${Math.round((b.used / b.total) * 100)}%`}><i></i></span><span class="gv-dim">${b.total}</span></li>)}
          </ul>
        </section>

        <section role="tabpanel" id="gv-panel-approvals" aria-labelledby="gv-tab-approvals" class="gv-panel" data-gv-panel="approvals" hidden>
          <header class="gv-h"><h4>Approvals</h4><p>Which steps need a person, and which person.</p></header>
          <ul class="gv-rows">
            {approvalRules.map((a) => <li class="gv-rule"><span class:list={['gv-switch', a.on && 'is-on']} role="img" aria-label={a.on ? 'required' : 'not required'}><i></i></span><span><b>{a.r}</b></span><span class="gv-dim">{a.who}</span></li>)}
          </ul>
        </section>

        <section role="tabpanel" id="gv-panel-workers" aria-labelledby="gv-tab-workers" class="gv-panel" data-gv-panel="workers" hidden>
          <header class="gv-h"><h4>Shared workers</h4><p>Machines the organization runs Factory work on, and what each may do.</p></header>
          <ul class="gv-rows">
            {workers.map((w) => <li class="gv-worker"><Avatar kind="worker" label={w.kind === 'shared' ? 'W' : 'P'} /><span><b>{w.id}</b><small>{w.where} · {w.kind}</small></span><span class="gv-dim">{w.kind === 'shared' ? 'tests, pull requests · never merge, never production' : 'owner decides · personal keys stay personal'}</span></li>)}
          </ul>
        </section>

        <section role="tabpanel" id="gv-panel-audit" aria-labelledby="gv-tab-audit" class="gv-panel" data-gv-panel="audit" hidden>
          <header class="gv-h"><h4>Audit log</h4><p>Who approved what, when. Exportable on Enterprise.</p></header>
          <ul class="gv-rows">
            {audit.map((a) => <li class="gv-audit"><span class="gv-mono">{a.t}</span><Avatar who={a.who} size="sm" /><span><b>{people[a.who].short}</b> {a.s}</span></li>)}
          </ul>
        </section>

        <section role="tabpanel" id="gv-panel-data" aria-labelledby="gv-tab-data" class="gv-panel" data-gv-panel="data" hidden>
          <header class="gv-h"><h4>Data sharing</h4><p>What an organization workspace synchronizes. Source code and credentials stay local.</p></header>
          <ul class="gv-rows">
            {data.map((d) => <li class="gv-data"><span class:list={['gv-switch', d.on && 'is-on', !d.on && 'is-locked']} role="img" aria-label={d.on ? 'shared' : 'never shared'}><i></i></span><span><b>{d.k}</b></span><span class:list={['gv-dim', !d.on && 'is-local']}>{d.v}</span></li>)}
          </ul>
        </section>

        <section role="tabpanel" id="gv-panel-identity" aria-labelledby="gv-tab-identity" class="gv-panel" data-gv-panel="identity" hidden>
          <header class="gv-h"><h4>Identity <StatusBadge status="planned" kind="roadmap" compact /></h4><p>Enterprise identity management, planned after the Teams capabilities.</p></header>
          <ul class="gv-rows">
            <li class="gv-rule"><span class="gv-switch" role="img" aria-label="planned"><i></i></span><span><b>Enterprise SSO</b><small>SAML and OIDC, with enforcement</small></span><span class="gv-dim">planned</span></li>
            <li class="gv-rule"><span class="gv-switch" role="img" aria-label="planned"><i></i></span><span><b>SCIM provisioning</b><small>members and teams from your directory</small></span><span class="gv-dim">planned</span></li>
            <li class="gv-rule"><span class="gv-switch" role="img" aria-label="planned"><i></i></span><span><b>Advanced access control</b><small>custom roles and per-repository rules</small></span><span class="gv-dim">planned</span></li>
            <li class="gv-rule"><span class="gv-switch" role="img" aria-label="planned"><i></i></span><span><b>Audit export and private deployment</b></span><span class="gv-dim">planned</span></li>
          </ul>
          <p class="gv-note">No compliance certification or security guarantee is claimed on this page. The security page will describe the service precisely when it exists.</p>
        </section>
      </div>
    </div>
  </Browser>
  <ConceptNotice class="mt-4" text="Conceptual preview with demonstration data. Organization roles, policies, budgets, shared workers, audit history and data-sharing controls are planned Cloud capabilities." />
</figure>

<style>
  .gv { margin: 0; }
  .gv-browser { font-size: 0.76rem; }
  .gv-body { display: grid; grid-template-columns: 12.5rem minmax(0, 1fr); min-height: 26rem; }
  @media (max-width: 47.9rem) { .gv-body { grid-template-columns: 1fr; min-height: 0; } .gv-tabs { flex-direction: row !important; overflow-x: auto; scrollbar-width: none; border-right: 0 !important; border-bottom: 1px solid var(--border); mask-image: linear-gradient(90deg, black 90%, transparent); } .gv-tab { white-space: nowrap; } }
  .gv-tabs { display: flex; flex-direction: column; gap: 0.15rem; padding: 0.7rem; border-right: 1px solid var(--border); background: var(--bg-elevated); }
  .gv-tab { display: flex; align-items: center; gap: 0.5rem; flex: 0 0 auto; text-align: left; border: 0; background: transparent; color: var(--text-2); font-size: 0.8rem; padding: 0.42rem 0.6rem; border-radius: 6px; cursor: pointer; transition: color var(--dur-fast), background-color var(--dur-fast); }
  .gv-tab:hover { color: var(--text); background: var(--surface-2); }
  .gv-tab[aria-selected='true'] { background: var(--surface-2); color: var(--text); box-shadow: inset 0 0 0 1px var(--border), inset 3px 0 0 var(--accent); }
  .gv-main { min-width: 0; }
  .gv-panel { padding: 1rem; display: grid; gap: 0.8rem; align-content: start; animation: fade 240ms both; }
  .gv-panel[hidden] { display: none; }
  .gv-h h4 { margin: 0; font-size: 0.98rem; font-weight: 580; color: var(--text); letter-spacing: -0.01em; display: flex; align-items: center; gap: 0.5rem; }
  .gv-h p { margin: 0.2rem 0 0; color: var(--text-3); }
  .gv-rows { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: hidden; }
  .gv-rows li { display: grid; align-items: center; gap: 0.7rem; background: var(--surface); padding: 0.55rem 0.7rem; color: var(--text-2); min-width: 0; }
  .gv-rows li > span { min-width: 0; }
  .gv-rows b { color: var(--text); font-weight: 540; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .gv-rows small { display: block; color: var(--text-3); font-size: 0.64rem; }
  .gv-member { grid-template-columns: auto minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 0.8fr) auto; }
  .gv-role { color: var(--text-2); }
  .gv-dim { color: var(--text-3); font-size: 0.7rem; }
  .gv-dim.is-local { color: var(--accent); }
  .gv-mono { font-family: var(--font-mono); font-size: 0.66rem; color: var(--text-3); }
  @media (max-width: 40rem) { .gv-member { grid-template-columns: auto minmax(0, 1fr) auto; } .gv-member > :nth-child(4) { display: none; } .gv-hide-sm { display: none !important; } }
  .gv-provider, .gv-rule, .gv-data { grid-template-columns: auto minmax(0, 1.3fr) minmax(0, 1fr); }
  .gv-worker { grid-template-columns: auto minmax(0, 1fr) minmax(0, 1.4fr); }
  .gv-audit { grid-template-columns: 2.6rem auto minmax(0, 1fr); }
  .gv-audit b { display: inline; }
  @media (max-width: 30rem) { .gv-provider, .gv-rule, .gv-data, .gv-worker { grid-template-columns: auto minmax(0, 1fr); } .gv-provider > :last-child, .gv-rule > :last-child, .gv-data > :last-child, .gv-worker > :last-child { grid-column: 2; } }
  .gv-switch { display: inline-block; width: 1.7rem; height: 1rem; border-radius: 999px; background: var(--surface-3); position: relative; flex: 0 0 auto; box-shadow: inset 0 0 0 1px var(--border-strong); }
  .gv-switch i { position: absolute; top: 2px; left: 2px; width: calc(1rem - 4px); height: calc(1rem - 4px); border-radius: 50%; background: var(--text-3); transition: transform var(--dur-fast); }
  .gv-switch.is-on { background: color-mix(in srgb, var(--accent) 35%, var(--surface-3)); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 60%, transparent); }
  .gv-switch.is-on i { transform: translateX(0.7rem); background: var(--accent); }
  .gv-switch.is-locked { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent); }
  .gv-switch.is-locked i { background: var(--accent); opacity: 0.5; }
  .gv-note { margin: 0; color: var(--text-3); font-size: 0.7rem; line-height: 1.45; }
  .gv-scroll { overflow-x: auto; }
  .gv-matrix { width: 100%; border-collapse: collapse; min-width: 30rem; }
  .gv-matrix th { font-weight: 540; color: var(--text-3); font-size: 0.66rem; text-align: left; padding: 0.4rem 0.5rem; border-bottom: 1px solid var(--border); }
  .gv-matrix thead th:not(:first-child) { text-align: center; }
  .gv-matrix tbody th { color: var(--text); font-weight: 500; font-size: 0.74rem; border-bottom: 1px solid var(--border); }
  .gv-matrix td { text-align: center; padding: 0.4rem 0.5rem; border-bottom: 1px solid var(--border); }
  .gv-matrix tr:last-child th, .gv-matrix tr:last-child td { border-bottom: 0; }
  .gv-yes { color: var(--accent); font-weight: 600; } .gv-no { color: var(--text-3); }
  .gv-budgets { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .gv-budgets li { display: grid; grid-template-columns: 10rem minmax(0, 1fr) auto; align-items: center; gap: 0.7rem; }
  @media (max-width: 30rem) { .gv-budgets li { grid-template-columns: 1fr auto; } .gv-budgets .cl-bar { grid-column: 1 / -1; } }
  .gv-budget-l b { display: block; color: var(--text); font-weight: 540; }
  .gv-budget-l small { display: block; color: var(--text-3); font-size: 0.64rem; }
  @media (prefers-reduced-motion: reduce) { .gv-panel { animation: none; } .gv-switch i { transition: none; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-governance]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-gv-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-gv-panel]'));
    const select = (id: string, focus = false) => {
      tabs.forEach((t) => { const on = t.dataset.gvTab === id; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; if (on && focus) t.focus(); });
      panels.forEach((p) => { p.hidden = p.dataset.gvPanel !== id; });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.gvTab!));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); select(tabs[(i + 1) % tabs.length]!.dataset.gvTab!, true); }
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); select(tabs[(i - 1 + tabs.length) % tabs.length]!.dataset.gvTab!, true); }
      });
    });
  }
</script>
