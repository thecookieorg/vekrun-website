---
/**
 * "Join your organization in three screens." Welcome → sign in → choose an
 * organization, as a filmstrip. Nothing here is a control: the sign-in methods
 * are rows of text, marked planned. The script walks the three screens.
 * Final state in markup: the organization chosen. Conceptual.
 */
import Window from '@/components/mock/Window.astro';
import DemoControls from '@/components/mock/DemoControls.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { Mail, Building2 } from '@lucide/astro';

const methods = [
  { t: 'Continue with email', k: 'email' },
  { t: 'Continue with Google', k: 'google' },
  { t: 'Continue with GitHub', k: 'github' },
  { t: 'Continue with GitLab', k: 'gitlab' },
  { t: 'Continue with Enterprise SSO', k: 'sso' },
];
---
<figure class="si" data-demo-root="sign-in" data-signin>
  <div class="si-strip">
    <!-- 1 Welcome -->
    <div class="si-screen" data-screen="1">
      <p class="si-cap"><b>1</b> First run, or any time later</p>
      <Window title="Vekrun" class="si-win">
        <div class="si-pane">
          <p class="si-title">Welcome to Vekrun</p>
          <div class="si-choice" data-choice="continue"><b>Continue with Vekrun</b><small>No account required. Your terminal, your models, your projects.</small></div>
          <div class="si-choice is-hot" data-choice="join"><b>Join your organization</b><small>Connect your team’s workspace. You can also do this later, from the workspace menu.</small></div>
        </div>
      </Window>
    </div>
    <span class="si-arrow" aria-hidden="true" data-arrow="1"></span>

    <!-- 2 Sign in -->
    <div class="si-screen" data-screen="2">
      <p class="si-cap"><b>2</b> One account, several organizations</p>
      <Window title="Vekrun Cloud" class="si-win">
        <div class="si-pane">
          <p class="si-title">Sign in to Vekrun Cloud <StatusBadge status="planned" kind="roadmap" compact /></p>
          <ul class="si-methods" aria-label="Planned sign-in methods">
            {methods.map((m) => <li class:list={['si-method', m.k === 'github' && 'is-hot']} data-method={m.k}>{m.k === 'email' ? <Mail class="h-3.5 w-3.5" aria-hidden="true" /> : m.k === 'sso' ? <Building2 class="h-3.5 w-3.5" aria-hidden="true" /> : <i class="si-glyph" aria-hidden="true">{m.k[0]!.toUpperCase()}</i>}{m.t}</li>)}
          </ul>
          <p class="si-fine">Signing in to Cloud grants no access to repositories, trackers or any other service. Each is authorized separately, as today.</p>
        </div>
      </Window>
    </div>
    <span class="si-arrow" aria-hidden="true" data-arrow="2"></span>

    <!-- 3 Choose organization -->
    <div class="si-screen" data-screen="3">
      <p class="si-cap"><b>3</b> The organization workspace appears in the app</p>
      <Window title="Vekrun Cloud" class="si-win">
        <div class="si-pane">
          <p class="si-title">Choose an organization</p>
          <ul class="si-orgs">
            <li class="si-org is-hot" data-org="acme"><span class="si-org-i" aria-hidden="true"></span><span><b>Acme Engineering</b><small>5 members · invited by Dana</small></span><span class="cl-pill is-ok" data-org-state>joined</span></li>
            <li class="si-org"><span class="si-org-i is-alt" aria-hidden="true"></span><span><b>Open Source Team</b><small>12 members</small></span><span class="cl-pill is-muted">member</span></li>
            <li class="si-org is-new"><span class="si-org-i is-dash" aria-hidden="true"></span><span><b>Create an organization</b><small>invite your team</small></span></li>
          </ul>
          <p class="si-fine">Your personal workspace stays exactly as it was.</p>
        </div>
      </Window>
    </div>
  </div>
  <DemoControls notice="Conceptual preview. Accounts, sign-in methods and organization membership are planned Cloud capabilities. Nothing above is a working control." />
</figure>

<style>
  .si { margin: 0; }
  .si-strip { display: grid; gap: 1rem; align-items: start; }
  @media (min-width: 64rem) { .si-strip { grid-template-columns: minmax(0, 1fr) 2.5rem minmax(0, 1fr) 2.5rem minmax(0, 1fr); gap: 0; } }
  .si-screen { display: grid; gap: 0.7rem; min-width: 0; transition: opacity var(--dur) var(--ease-out); }
  .si-screen:not(.is-on) { opacity: 0.55; }
  .si-win { font-size: 0.76rem; transition: border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out); }
  .si-screen.is-on .si-win { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); box-shadow: var(--glow); }
  .si-arrow { display: none; }
  @media (min-width: 64rem) { .si-arrow { display: block; position: relative; height: 1px; margin-top: 8.6rem; background: var(--border-strong); } .si-arrow::after { content: ''; position: absolute; right: -1px; top: -3px; width: 7px; height: 7px; border-top: 1px solid var(--border-strong); border-right: 1px solid var(--border-strong); transform: rotate(45deg); } .si-arrow.is-on { background: linear-gradient(90deg, var(--accent), var(--cloud)); } .si-arrow.is-on::after { border-color: var(--cloud); } }
  .si-pane { padding: 1rem; display: grid; gap: 0.6rem; min-height: 13.5rem; align-content: start; }
  .si-title { margin: 0 0 0.2rem; font-size: 0.95rem; font-weight: 580; color: var(--text); letter-spacing: -0.01em; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .si-choice { display: grid; gap: 0.15rem; padding: 0.65rem 0.75rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-2); transition: border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out); }
  .si-choice b { color: var(--text); font-weight: 560; }
  .si-choice small { color: var(--text-3); font-size: 0.68rem; line-height: 1.4; }
  .si-choice.is-hot, .si-method.is-hot, .si-org.is-hot { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .si-methods { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .si-method { display: flex; align-items: center; gap: 0.5rem; padding: 0.45rem 0.65rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface-2); color: var(--text); transition: border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out); }
  .si-glyph { font-style: normal; font-family: var(--font-mono); font-size: 0.6rem; width: 0.95rem; height: 0.95rem; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--border-strong); border-radius: 4px; color: var(--text-2); }
  .si-fine { margin: 0.2rem 0 0; color: var(--text-3); font-size: 0.66rem; line-height: 1.4; }
  .si-orgs { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .si-org { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 0.6rem; padding: 0.5rem 0.65rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface-2); color: var(--text); transition: border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out); }
  .si-org b { display: block; font-weight: 560; } .si-org small { display: block; color: var(--text-3); font-size: 0.66rem; }
  .si-org.is-new { color: var(--text-2); border-style: dashed; }
  .si-org-i { width: 1.5rem; height: 1.5rem; border-radius: 6px; background: var(--accent-gradient); }
  .si-org-i.is-alt { background: linear-gradient(120deg, var(--warn), var(--danger)); }
  .si-org-i.is-dash { background: transparent; border: 1px dashed var(--border-strong); }
  .si-cap { margin: 0; display: flex; align-items: center; gap: 0.5rem; color: var(--text-3); font-size: 0.8rem; }
  .si-cap b { display: inline-flex; align-items: center; justify-content: center; width: 1.4rem; height: 1.4rem; border-radius: 50%; border: 1px solid var(--border-strong); font-family: var(--font-mono); font-size: 0.64rem; font-weight: 400; color: var(--text-2); }
  .si-screen.is-on .si-cap { color: var(--text-2); } .si-screen.is-on .si-cap b { border-color: var(--accent); color: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .si-screen, .si-win, .si-choice, .si-method, .si-org { transition: none; } }
</style>

<script>
  import { createSequence, type Step } from '@/scripts/sequence';

  const root = document.querySelector<HTMLElement>('[data-signin]');
  if (root) {
    const screen = (n: number) => root.querySelector<HTMLElement>(`[data-screen="${n}"]`)!;
    const arrow = (n: number) => root.querySelector<HTMLElement>(`[data-arrow="${n}"]`)!;
    const hot = (sel: string, on: boolean) => root.querySelector<HTMLElement>(sel)?.classList.toggle('is-hot', on);
    const orgState = root.querySelector<HTMLElement>('[data-org-state]')!;
    const focus = (n: number) => [1, 2, 3].forEach((k) => { screen(k).classList.toggle('is-on', k === n); if (k < 3) arrow(k).classList.toggle('is-on', k < n); });

    const reset = () => { focus(0); hot('[data-choice="join"]', false); hot('[data-method="github"]', false); hot('[data-org="acme"]', false); orgState.textContent = 'invited'; orgState.classList.remove('is-ok'); orgState.classList.add('is-muted'); };
    const steps: Step[] = [
      { t: 400, run: () => focus(1) },
      { t: 1300, run: () => hot('[data-choice="join"]', true) },
      { t: 2300, run: () => focus(2) },
      { t: 3200, run: () => hot('[data-method="github"]', true) },
      { t: 4300, run: () => focus(3) },
      { t: 5200, run: () => hot('[data-org="acme"]', true) },
      { t: 6000, run: () => { orgState.textContent = 'joined'; orgState.classList.remove('is-muted'); orgState.classList.add('is-ok'); } },
    ];
    createSequence(root, steps, { reset });
  }
</script>
