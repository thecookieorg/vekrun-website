---
/**
 * "Connected engineering workflows": three chains, one lit at a time.
 *   A ticket → delivery · B production error → fix · C team pull-request review.
 * The chain tabs are real; the demo plays A, B and C in turn, lighting each node.
 * Final state in markup: chain C active, every node lit. Conceptual.
 */
import Window from '@/components/mock/Window.astro';
import DemoControls from '@/components/mock/DemoControls.astro';

type Node = { t: string; s: string; src?: string };
const chains: { id: string; label: string; title: string; nodes: Node[] }[] = [
  { id: 'a', label: 'From ticket to delivery', title: 'A Jira ticket becomes merged work', nodes: [
    { t: 'Jira ticket', s: 'VEK-131 assigned by Dana', src: 'Ji' },
    { t: 'Shared Board', s: 'appears on Alex’s Board' },
    { t: 'Developer or Factory', s: 'Alex starts work · a worker helps' },
    { t: 'Pull request', s: '#214 · 12 tests passed', src: 'Gh' },
    { t: 'Review', s: 'Priya · AI findings: none' },
    { t: 'Completed', s: 'Dana sees it delivered' },
  ] },
  { id: 'b', label: 'From production error to fix', title: 'An AppSignal error becomes a verified fix', nodes: [
    { t: 'AppSignal error', s: 'NoMethodError · 142 in 24 h', src: 'Ap' },
    { t: 'Insights investigation', s: 'likely cause 0.8 · shared' },
    { t: 'Shared plan', s: 'nil guard + test · approved by Sam' },
    { t: 'Factory repair', s: 'build-2 · 6 tests passed' },
    { t: 'Code review', s: 'Alex · approved' },
    { t: 'Production check', s: '0 occurrences after deploy' },
  ] },
  { id: 'c', label: 'Team pull-request reviews', title: 'A pull request finds its reviewer', nodes: [
    { t: 'Developer opens PR', s: 'Priya · #216 export retries', src: 'Gl' },
    { t: 'Review request', s: 'routed to Alex by team rule' },
    { t: 'AI-assisted review', s: '2 findings · 1 confirmed' },
    { t: 'Human approval', s: 'Alex approves with one change' },
    { t: 'Project status', s: 'VEK-140 done · dashboard updated' },
  ] },
];
---
<figure class="wc" data-demo-root="workflows" data-workflows>
  <Window title="Workflows" crumbs={['Acme Engineering']} class="wc-win">
    <span slot="status" class="hidden sm:inline" data-wc-title>{chains[2]!.title}</span>
    <div class="wc-tabs" role="tablist" aria-label="Workflow examples">
      {chains.map((c, i) => <button type="button" role="tab" id={`wc-tab-${c.id}`} aria-selected={i === 2 ? 'true' : 'false'} aria-controls={`wc-panel-${c.id}`} tabindex={i === 2 ? 0 : -1} class="wc-tab" data-wc-tab={c.id}><span class="wc-tab-k">{String.fromCharCode(65 + i)}</span>{c.label}</button>)}
    </div>
    {chains.map((c, i) => (
      <div role="tabpanel" id={`wc-panel-${c.id}`} aria-labelledby={`wc-tab-${c.id}`} class="wc-panel" data-wc-panel={c.id} hidden={i !== 2}>
        <ol class="wc-chain">
          {c.nodes.map((n, j) => (
            <li class="wc-node is-lit" data-node={`${c.id}-${j}`}>
              <span class="wc-node-dot" aria-hidden="true">{n.src ? <i class="wc-src">{n.src}</i> : <i class="wc-pip"></i>}</span>
              <span class="wc-node-t">{n.t}</span>
              <span class="wc-node-s">{n.s}</span>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </Window>
  <DemoControls notice="Conceptual preview. The pieces inside the desktop app exist or are planned as described on their feature pages; sharing them across an organization is a planned Cloud capability." />
</figure>

<style>
  .wc { margin: 0; }
  .wc-win { font-size: 0.78rem; }
  .wc-tabs { display: flex; gap: 0.15rem; padding: 0.45rem 0.6rem; border-bottom: 1px solid var(--border); background: var(--surface); overflow-x: auto; scrollbar-width: none; }
  @media (max-width: 40rem) { .wc-tabs { mask-image: linear-gradient(90deg, black 88%, transparent); } }
  .wc-tab { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 0.45rem; border: 0; background: transparent; color: var(--text-3); font-size: 0.76rem; padding: 0.3rem 0.65rem; border-radius: 6px; cursor: pointer; white-space: nowrap; transition: color var(--dur-fast), background-color var(--dur-fast); }
  .wc-tab:hover { color: var(--text); }
  .wc-tab[aria-selected='true'] { background: var(--surface-2); color: var(--text); box-shadow: inset 0 0 0 1px var(--border); }
  .wc-tab-k { font-family: var(--font-mono); font-size: 0.64rem; color: var(--accent); }
  .wc-panel { padding: 1rem 0.9rem 1.1rem; }
  .wc-panel[hidden] { display: none; }
  .wc-chain { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 0.5rem; position: relative; }
  @media (min-width: 48rem) { .wc-chain { grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); gap: 0.6rem; } }
  .wc-node { position: relative; display: flex; flex-direction: column; gap: 0.2rem; padding: 0.6rem 0.65rem 0.65rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface-2); min-width: 0; opacity: 0.45; transition: opacity var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out); }
  .wc-node.is-lit { opacity: 1; border-color: color-mix(in srgb, var(--accent) 50%, var(--border)); }
  .wc-node.is-now { box-shadow: 0 0 0 1px var(--accent), 0 10px 30px -14px color-mix(in srgb, var(--accent) 50%, transparent); }
  @media (min-width: 48rem) {
    .wc-node + .wc-node::before { content: ''; position: absolute; left: -0.6rem; top: 1.2rem; width: 0.6rem; height: 1px; background: var(--border-strong); }
    .wc-node.is-lit + .wc-node.is-lit::before { background: var(--accent); }
  }
  @media (max-width: 47.9rem) {
    .wc-node + .wc-node::before { content: ''; position: absolute; left: 1.15rem; top: -0.5rem; width: 1px; height: 0.5rem; background: var(--border-strong); }
    .wc-node.is-lit + .wc-node.is-lit::before { background: var(--accent); }
  }
  .wc-node-dot { display: flex; align-items: center; height: 1.1rem; }
  .wc-pip { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--border-strong); display: block; }
  .wc-node.is-lit .wc-pip { background: var(--accent); }
  .wc-src { font-style: normal; font-family: var(--font-mono); font-size: 0.6rem; border: 1px solid var(--border-strong); border-radius: 4px; padding: 0 0.3rem; color: var(--text-2); }
  .wc-node.is-lit .wc-src { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 55%, transparent); }
  .wc-node-t { color: var(--text); font-weight: 540; font-size: 0.76rem; line-height: 1.25; }
  .wc-node-s { color: var(--text-3); font-size: 0.66rem; line-height: 1.35; }
  @media (prefers-reduced-motion: reduce) { .wc-node { transition: none; } }
</style>

<script>
  import { createSequence, type Step } from '@/scripts/sequence';

  const root = document.querySelector<HTMLElement>('[data-workflows]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-wc-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-wc-panel]'));
    const title = root.querySelector<HTMLElement>('[data-wc-title]')!;
    const chainTitles: Record<string, string> = { a: 'A Jira ticket becomes merged work', b: 'An AppSignal error becomes a verified fix', c: 'A pull request finds its reviewer' };
    const nodesOf = (id: string) => Array.from(root.querySelectorAll<HTMLElement>(`[data-wc-panel="${id}"] .wc-node`));
    let manualTimers: number[] = [];

    const select = (id: string, focus = false) => {
      tabs.forEach((t) => { const on = t.dataset.wcTab === id; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; if (on && focus) t.focus(); });
      panels.forEach((p) => { p.hidden = p.dataset.wcPanel !== id; });
      title.textContent = chainTitles[id] ?? '';
    };
    const light = (id: string, i: number) => {
      const nodes = nodesOf(id);
      nodes.forEach((n, j) => { n.classList.toggle('is-lit', j <= i); n.classList.toggle('is-now', j === i); });
    };
    const lightAll = (id: string) => nodesOf(id).forEach((n) => { n.classList.add('is-lit'); n.classList.remove('is-now'); });

    // Build the scripted sequence: A, then B, then C, 480 ms per node.
    const steps: Step[] = [];
    let t = 200;
    for (const id of ['a', 'b', 'c']) {
      const n = nodesOf(id).length;
      steps.push({ t, run: () => { select(id); light(id, -1); } });
      for (let i = 0; i < n; i++) steps.push({ t: t + 400 + i * 480, run: () => light(id, i) });
      t += 400 + n * 480 + 1400;
      steps.push({ t: t - 600, run: () => lightAll(id) });
    }
    const reset = () => { manualTimers.forEach(clearTimeout); manualTimers = []; ['a', 'b', 'c'].forEach((id) => light(id, -1)); select('a'); };
    const seq = createSequence(root, steps, { reset });

    // A click on a tab takes over: pause the script and light that chain.
    tabs.forEach((tab, k) => {
      const play = (id: string) => {
        seq.pause(); manualTimers.forEach(clearTimeout); manualTimers = [];
        select(id); light(id, -1);
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) { lightAll(id); return; }
        nodesOf(id).forEach((_, i) => manualTimers.push(window.setTimeout(() => light(id, i), 200 + i * 380)));
        manualTimers.push(window.setTimeout(() => lightAll(id), 200 + nodesOf(id).length * 380 + 500));
      };
      tab.addEventListener('click', () => play(tab.dataset.wcTab!));
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); const n = tabs[(k + 1) % tabs.length]!; n.focus(); play(n.dataset.wcTab!); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); const n = tabs[(k - 1 + tabs.length) % tabs.length]!; n.focus(); play(n.dataset.wcTab!); }
      });
    });
  }
</script>
