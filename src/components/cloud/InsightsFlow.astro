---
/**
 * "Know what's broken. See who's fixing it." A production error travels from a
 * monitoring tool through a shared investigation, a repair plan, a Factory fix,
 * a review and a confirmed deploy into monitoring. Resolution stays a human
 * decision: the demo never presses "Mark as resolved". Final state in markup.
 */
import Browser from './Browser.astro';
import Avatar from './Avatar.astro';
import DemoControls from '@/components/mock/DemoControls.astro';

const nodes = [
  { t: 500, k: 'Error appears in Insights', s: 'Honeybadger · NoMethodError in ExportsController · 142 in 24 h', src: 'Hb' },
  { t: 1700, k: 'Priya starts an investigation', s: 'in Vekrun on her machine · shared with the team', who: 'priya' },
  { t: 3000, k: 'Repair plan created', s: 'nil guard on customer + regression test · approved by Sam', who: 'sam' },
  { t: 4200, k: 'Factory prepares the fix', s: 'worker build-2 · 6 tests passed · verified', ag: 'D' },
  { t: 5400, k: 'Pull request #221 opened', s: 'review requested from Alex', src: 'Gh' },
  { t: 6600, k: 'Alex approves · merged', s: 'AI findings: none · 1 human note', who: 'alex' },
  { t: 7800, k: 'Deploy confirmed', s: 'v2.14.3 · production monitoring starts', src: 'Dd' },
  { t: 9400, k: 'Monitoring', s: '0 occurrences in 2 h · resolution is still a person’s call', ag: 'T' },
];
const sources = ['Honeybadger', 'AppSignal', 'Sentry', 'Datadog'];
const spark = [12, 18, 22, 30, 41, 38, 46, 52, 47, 55, 61, 58, 64, 20, 4, 1, 0, 0];
---
<figure class="in" data-demo-root="insights" data-insights>
  <div class="in-grid">
    <ol class="in-timeline" aria-label="From error to monitoring">
      {nodes.map((n) => (
        <li data-t={n.t}>
          <span class="in-dot" aria-hidden="true">{n.who ? <Avatar who={n.who as 'sam'} size="sm" /> : n.ag ? <Avatar kind="agent" label={n.ag} size="sm" /> : <i class="in-src">{n.src}</i>}</span>
          <span><b>{n.k}</b><small>{n.s}</small></span>
        </li>
      ))}
    </ol>

    <Browser path="/acme/insights/exports-controller" class="in-browser">
      <span slot="status" class="cl-live"><i></i><span data-in-live>monitoring</span></span>
      <div class="in-body">
        <header class="in-head">
          <div><span class="in-src-l"><i class="in-src">Hb</i>Honeybadger · acme-api · production</span><h4>NoMethodError in ExportsController#create</h4><p>undefined method `email' for nil · first seen 26 h ago</p></div>
          <span class="cl-pill is-ok in-status" data-in-status>Deployed · monitoring</span>
        </header>
        <div class="in-two">
          <div class="in-card">
            <h5>Occurrences <small>per hour</small></h5>
            <svg class="in-spark" viewBox="0 0 180 50" preserveAspectRatio="none" aria-hidden="true">
              <path class="in-area" d={`M0 50 ${spark.map((v, i) => `L${(i / (spark.length - 1)) * 180} ${48 - (v / 64) * 44}`).join(' ')} L180 50 Z`} />
              <path class="in-line" d={`M${spark.map((v, i) => `${(i / (spark.length - 1)) * 180} ${48 - (v / 64) * 44}`).join(' L')}`} />
              <line x1="130" y1="0" x2="130" y2="50" class="in-deploy" data-t="7800" />
            </svg>
            <p class="in-legend"><span>yesterday</span><span data-in-now>now · <b>0</b></span></p>
          </div>
          <div class="in-card">
            <h5>Investigation <small>shared</small></h5>
            <ul class="in-rows">
              <li data-t="1700"><span>Likely cause</span><b>customer is nil when an export is retried after deletion · confidence 0.8</b></li>
              <li data-t="3000"><span>Plan</span><b>nil guard + regression test · approved by Sam</b></li>
              <li data-t="5400"><span>Pull request</span><b>#221 · 6 tests passed · <span data-in-pr>merged</span></b></li>
              <li data-t="7800"><span>Deploy</span><b>v2.14.3 · confirmed 2 h ago</b></li>
            </ul>
          </div>
        </div>
        <div class="in-foot">
          <p class="in-dash"><span class="cl-pill is-cloud">Dashboard</span>Quality &amp; Insights · 1 investigation · <span data-in-dash>deployed, monitoring</span></p>
          <div class="in-resolve">
            <button type="button" class="in-btn" data-in-resolve>Mark as resolved</button>
            <span class="in-resolve-note" data-in-resolve-note>A merged fix or a deploy never closes an error. A person does, when the signal is quiet.</span>
          </div>
        </div>
        <p class="in-sources" aria-label="Monitoring tools Vekrun connects to">{sources.map((s) => <span>{s}</span>)}</p>
      </div>
    </Browser>
  </div>
  <DemoControls notice="Conceptual preview with demonstration data. Insights investigations exist in the desktop app as described on the Insights page; sharing them across a team and the dashboard view are planned Cloud capabilities. The resolve button is yours to press." />
</figure>

<style>
  .in { margin: 0; }
  .in-grid { display: grid; gap: 1.25rem; }
  @media (min-width: 64rem) { .in-grid { grid-template-columns: 19rem minmax(0, 1fr); gap: 2rem; align-items: start; } }
  .in-timeline { list-style: none; margin: 0; padding: 0; position: relative; display: flex; flex-direction: column; gap: 0.7rem; min-height: 22rem; }
  .in-timeline::before { content: ''; position: absolute; left: 0.6rem; top: 0.8rem; bottom: 0.8rem; width: 1px; background: linear-gradient(var(--accent), var(--cloud)); opacity: 0.6; }
  .in-timeline li { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.65rem; align-items: start; animation: rise-sm 380ms var(--ease-out) both; }
  .in-timeline li[hidden] { display: none; }
  .in-dot { display: inline-flex; width: 1.2rem; height: 1.2rem; align-items: center; justify-content: center; background: var(--bg); border-radius: 50%; }
  .in-src { font-style: normal; font-family: var(--font-mono); font-size: 0.56rem; border: 1px solid var(--border-strong); border-radius: 4px; padding: 0.05rem 0.25rem; color: var(--text-2); background: var(--surface); }
  .in-timeline b { display: block; color: var(--text); font-weight: 540; font-size: 0.86rem; line-height: 1.3; }
  .in-timeline small { display: block; color: var(--text-3); font-size: 0.72rem; line-height: 1.4; }
  .in-browser { font-size: 0.76rem; min-width: 0; }
  .in-body { padding: 0.9rem; display: grid; gap: 0.8rem; }
  .in-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.8rem; }
  .in-src-l { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--text-3); font-size: 0.66rem; }
  .in-head h4 { margin: 0.25rem 0 0.1rem; font-size: 0.98rem; font-weight: 580; color: var(--text); letter-spacing: -0.01em; }
  .in-head p { margin: 0; color: var(--text-3); font-size: 0.68rem; font-family: var(--font-mono); }
  .in-status { flex: 0 0 auto; }
  .in-two { display: grid; gap: 0.8rem; }
  @media (min-width: 48rem) { .in-two { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); } }
  .in-card { border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface-2); padding: 0.65rem 0.75rem; display: grid; gap: 0.45rem; align-content: start; min-width: 0; }
  .in-card h5 { margin: 0; font-size: 0.68rem; font-weight: 560; color: var(--text-2); display: flex; gap: 0.4rem; align-items: baseline; }
  .in-card h5 small { font-weight: 400; color: var(--text-3); }
  .in-spark { width: 100%; height: 3.4rem; overflow: visible; }
  .in-area { fill: var(--danger); opacity: 0.15; }
  .in-line { fill: none; stroke: var(--danger); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .in-deploy { stroke: var(--accent); stroke-width: 1; stroke-dasharray: 3 2; vector-effect: non-scaling-stroke; }
  .in-deploy[hidden] { display: none; }
  .in-legend { margin: 0; display: flex; justify-content: space-between; font-size: 0.62rem; color: var(--text-3); }
  .in-legend b { color: var(--ok); }
  .in-rows { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; min-height: 5.6rem; }
  .in-rows li { display: grid; grid-template-columns: 5.2rem minmax(0, 1fr); gap: 0.5rem; font-size: 0.7rem; animation: rise-sm 360ms var(--ease-out) both; }
  .in-rows li[hidden] { display: none; }
  .in-rows span { color: var(--text-3); } .in-rows b { color: var(--text-2); font-weight: 400; }
  .in-foot { display: grid; gap: 0.6rem; }
  .in-dash { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; color: var(--text-2); font-size: 0.72rem; }
  .in-resolve { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; padding: 0.6rem 0.7rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); }
  .in-btn { height: 2rem; padding: 0 0.85rem; border-radius: 6px; border: 1px solid var(--border-strong); background: var(--surface-2); color: var(--text); font-size: 0.78rem; font-weight: 560; cursor: pointer; transition: border-color var(--dur-fast), background-color var(--dur-fast); }
  .in-btn:hover { border-color: var(--accent); }
  .in-btn[disabled] { opacity: 0.5; cursor: default; }
  .in-resolve-note { flex: 1 1 14rem; color: var(--text-3); font-size: 0.68rem; line-height: 1.4; }
  .in-resolve-note.is-ok { color: var(--ok); }
  .in-sources { margin: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .in-sources span { font-family: var(--font-mono); font-size: 0.62rem; border: 1px solid var(--border); border-radius: 999px; padding: 0.15rem 0.5rem; color: var(--text-3); }
  @media (prefers-reduced-motion: reduce) { .in-timeline li, .in-rows li { animation: none; } }
</style>

<script>
  import { createSequence, type Step } from '@/scripts/sequence';

  const root = document.querySelector<HTMLElement>('[data-insights]');
  if (root) {
    const timed = Array.from(root.querySelectorAll<HTMLElement>('[data-t]'));
    const status = root.querySelector<HTMLElement>('[data-in-status]')!;
    const live = root.querySelector<HTMLElement>('[data-in-live]')!;
    const dash = root.querySelector<HTMLElement>('[data-in-dash]')!;
    const pr = root.querySelector<HTMLElement>('[data-in-pr]')!;
    const now = root.querySelector<HTMLElement>('[data-in-now]')!;
    const resolve = root.querySelector<HTMLButtonElement>('[data-in-resolve]')!;
    const note = root.querySelector<HTMLElement>('[data-in-resolve-note]')!;
    const pill = (text: string, tone: string) => { status.textContent = text; status.classList.remove('is-ok', 'is-warn', 'is-info', 'is-cloud', 'is-muted', 'is-danger'); status.classList.add(`is-${tone}`); };
    const show = (t: number) => timed.filter((n) => Number(n.dataset.t) === t).forEach((n) => { n.hidden = false; });

    resolve.addEventListener('click', () => {
      resolve.disabled = true; resolve.textContent = 'Resolved by you';
      note.textContent = 'Resolved in the demonstration. In the product this is recorded with your name and the time.'; note.classList.add('is-ok');
      pill('Resolved', 'ok'); dash.textContent = 'resolved'; live.textContent = 'resolved';
    });

    const reset = () => {
      timed.forEach((n) => { n.hidden = true; });
      pill('New', 'danger'); live.textContent = '142 in 24 h'; dash.textContent = 'new error'; pr.textContent = 'open'; now.innerHTML = 'now · <b>64</b>';
      resolve.disabled = false; resolve.textContent = 'Mark as resolved'; note.classList.remove('is-ok');
      note.textContent = 'A merged fix or a deploy never closes an error. A person does, when the signal is quiet.';
    };
    const steps: Step[] = [
      { t: 500, run: () => show(500) },
      { t: 1700, run: () => { show(1700); pill('Investigating', 'warn'); dash.textContent = 'investigating · Priya'; } },
      { t: 3000, run: () => { show(3000); pill('Plan ready', 'info'); dash.textContent = 'plan approved'; } },
      { t: 4200, run: () => show(4200) },
      { t: 5400, run: () => { show(5400); pill('Fix in review', 'info'); dash.textContent = 'fix in review · #221'; } },
      { t: 6600, run: () => { show(6600); pill('Merged', 'info'); pr.textContent = 'merged'; dash.textContent = 'merged · awaiting deploy'; } },
      { t: 7800, run: () => { show(7800); pill('Deployed · monitoring', 'ok'); live.textContent = 'monitoring'; dash.textContent = 'deployed, monitoring'; now.innerHTML = 'now · <b>0</b>'; } },
      { t: 9400, run: () => show(9400) },
    ];
    createSequence(root, steps, { reset });
  }
</script>
