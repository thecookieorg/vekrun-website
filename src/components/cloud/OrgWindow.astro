---
/**
 * "One workspace for your whole team": the organization as its members would see it
 * in the desktop app. Four real tabs (members, teams, projects, policies); motion
 * only answers a click. Conceptual, demonstration data.
 */
import Window from '@/components/mock/Window.astro';
import ConceptNotice from '@/components/ConceptNotice.astro';

const tabs = [
  { id: 'members', label: 'Members' },
  { id: 'teams', label: 'Teams' },
  { id: 'projects', label: 'Projects' },
  { id: 'policies', label: 'Policies' },
];
const members = [
  { name: 'Dana Whitfield', role: 'Project manager', where: 'browser only', ini: 'DW' },
  { name: 'Sam Okafor', role: 'Engineering lead', where: 'Vekrun · Linux', ini: 'SO' },
  { name: 'Alex Moreau', role: 'Developer', where: 'Vekrun · macOS', ini: 'AM' },
  { name: 'Priya Natarajan', role: 'Developer', where: 'Vekrun · Windows', ini: 'PN' },
  { name: 'build-2', role: 'Factory worker', where: 'company build machine', ini: 'F', worker: true },
];
const teams = [
  { name: 'Platform', people: 'Sam, Alex, build-2', owns: 'acme-api, infra' },
  { name: 'Web', people: 'Priya', owns: 'acme-web' },
  { name: 'Management', people: 'Dana', owns: 'dashboard, reports' },
];
const projects = [
  { name: 'acme-api', team: 'Platform', shared: '3 plans · Factory queue on · 2 investigations' },
  { name: 'acme-web', team: 'Web', shared: '1 plan · 4 open reviews' },
  { name: 'infra', team: 'Platform', shared: 'rate-limit plan · approval required for production commands' },
];
const policies = [
  { k: 'AI providers', v: 'Anthropic and OpenAI through company keys; local models allowed' },
  { k: 'Spending', v: '$200 per developer per week, $400 for Factory queues' },
  { k: 'Approvals', v: 'Plans, merges and production-related commands need a lead' },
  { k: 'Shared workers', v: 'build-2 may run tests and open pull requests, never merge' },
  { k: 'Data sharing', v: 'Tickets, plans, review status and job results. Source code and credentials stay local' },
];
---
<figure class="org" data-org>
  <Window title="Acme Engineering" crumbs={['Organization']} class="org-win">
    <span slot="status" class="hidden sm:inline">5 members · 3 teams</span>
    <div class="org-tabs" role="tablist" aria-label="Organization sections">
      {tabs.map((t, i) => <button type="button" role="tab" id={`org-tab-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`org-panel-${t.id}`} tabindex={i === 0 ? 0 : -1} class="org-tab" data-org-tab={t.id}>{t.label}</button>)}
    </div>

    <div role="tabpanel" id="org-panel-members" aria-labelledby="org-tab-members" class="org-panel" data-org-panel="members">
      <ul class="org-rows">
        {members.map((m) => (
          <li class="org-row">
            <span class:list={['org-ini', m.worker && 'is-worker']} aria-hidden="true">{m.ini}</span>
            <span class="org-name">{m.name}</span>
            <span class="org-role">{m.role}</span>
            <span class="org-where">{m.where}</span>
          </li>
        ))}
      </ul>
    </div>
    <div role="tabpanel" id="org-panel-teams" aria-labelledby="org-tab-teams" class="org-panel" data-org-panel="teams" hidden>
      <ul class="org-rows">
        {teams.map((t) => <li class="org-row org-row-3"><span class="org-name">{t.name}</span><span class="org-role">{t.people}</span><span class="org-where">{t.owns}</span></li>)}
      </ul>
    </div>
    <div role="tabpanel" id="org-panel-projects" aria-labelledby="org-tab-projects" class="org-panel" data-org-panel="projects" hidden>
      <ul class="org-rows">
        {projects.map((p) => <li class="org-row org-row-3"><span class="org-name org-mono">{p.name}</span><span class="org-role">{p.team}</span><span class="org-where">{p.shared}</span></li>)}
      </ul>
    </div>
    <div role="tabpanel" id="org-panel-policies" aria-labelledby="org-tab-policies" class="org-panel" data-org-panel="policies" hidden>
      <dl class="org-dl">
        {policies.map((p) => <div><dt>{p.k}</dt><dd>{p.v}</dd></div>)}
      </dl>
    </div>
  </Window>
  <ConceptNotice class="mt-4" text="Conceptual preview with demonstration data. Organization membership, roles, shared projects and policies are planned Cloud capabilities." />
</figure>

<style>
  .org { margin: 0; }
  .org-tabs { display: flex; gap: 0.15rem; padding: 0.45rem 0.6rem; border-bottom: 1px solid var(--border); background: var(--surface); overflow-x: auto; scrollbar-width: none; }
  @media (max-width: 40rem) { .org-tabs { mask-image: linear-gradient(90deg, black 88%, transparent); } }
  .org-tab { flex: 0 0 auto; border: 0; background: transparent; color: var(--text-3); font-family: var(--font-mono); font-size: 0.72rem; padding: 0.3rem 0.65rem; border-radius: 6px; cursor: pointer; transition: color var(--dur-fast), background-color var(--dur-fast); }
  .org-tab:hover { color: var(--text); }
  .org-tab[aria-selected='true'] { background: var(--surface-2); color: var(--text); box-shadow: inset 0 0 0 1px var(--border); }
  .org-panel { padding: 0.6rem; min-height: 15rem; animation: fade 240ms both; }
  .org-panel[hidden] { display: none; }
  .org-rows { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: hidden; }
  .org-row { display: grid; grid-template-columns: 1.6rem minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 1.4fr); align-items: center; gap: 0.6rem; background: var(--surface); padding: 0.5rem 0.65rem; font-size: 0.78rem; min-width: 0; }
  .org-row-3 { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.6fr); }
  .org-row > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .org-ini { display: inline-flex; align-items: center; justify-content: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--surface-3); color: var(--text-2); font-size: 0.62rem; font-weight: 560; }
  .org-ini.is-worker { background: color-mix(in srgb, var(--accent) 18%, var(--surface-3)); color: var(--accent); border-radius: 6px; }
  .org-name { color: var(--text); font-weight: 540; }
  .org-mono { font-family: var(--font-mono); font-size: 0.74rem; }
  .org-role { color: var(--text-2); }
  .org-where { color: var(--text-3); font-size: 0.72rem; }
  @media (max-width: 40rem) { .org-row { grid-template-columns: 1.6rem minmax(0, 1fr) minmax(0, 1fr); } .org-row .org-where { display: none; } .org-row-3 { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); } .org-row-3 .org-role { display: none; } }
  .org-dl { margin: 0; display: flex; flex-direction: column; gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: hidden; }
  .org-dl > div { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 0.6rem; background: var(--surface); padding: 0.5rem 0.65rem; font-size: 0.78rem; }
  .org-dl dt { color: var(--text-3); } .org-dl dd { margin: 0; color: var(--text-2); }
  @media (max-width: 40rem) { .org-dl > div { grid-template-columns: 1fr; gap: 0.1rem; } }
  @media (prefers-reduced-motion: reduce) { .org-panel { animation: none; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-org]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-org-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-org-panel]'));
    const select = (id: string, focus = false) => {
      tabs.forEach((t) => { const on = t.dataset.orgTab === id; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; if (on && focus) t.focus(); });
      panels.forEach((p) => { p.hidden = p.dataset.orgPanel !== id; });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.orgTab!));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); select(tabs[(i + 1) % tabs.length]!.dataset.orgTab!, true); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); select(tabs[(i - 1 + tabs.length) % tabs.length]!.dataset.orgTab!, true); }
      });
    });
  }
</script>
