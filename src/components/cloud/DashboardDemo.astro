---
/**
 * The project manager's browser dashboard. Six real sections behind a tablist;
 * the Overview counts up and its activity feed arrives when the demo plays.
 * Every number is demonstration data and the window says so. Conceptual.
 */
import Window from '@/components/mock/Window.astro';
import DemoControls from '@/components/mock/DemoControls.astro';

const sections = [
  { id: 'overview', label: 'Overview' },
  { id: 'projects', label: 'Projects' },
  { id: 'work', label: 'Work' },
  { id: 'ai', label: 'AI Operations' },
  { id: 'quality', label: 'Quality & Insights' },
  { id: 'reports', label: 'Reports' },
];
const stats = [
  { k: 'projects', n: 3, l: 'Active projects' },
  { k: 'wip', n: 11, l: 'Work in progress' },
  { k: 'blocked', n: 2, l: 'Blocked', tone: 'warn' },
  { k: 'reviews', n: 4, l: 'Pending reviews', tone: 'info' },
  { k: 'done', n: 9, l: 'Completed this week', tone: 'ok' },
];
const activity = [
  { t: 'Merged', tone: 'ok', s: '#214 Rate-limit the webhook endpoint · acme-api · approved by Priya' },
  { t: 'Blocked', tone: 'warn', s: 'VEK-139 Checkout redesign · waiting on a design review since Tuesday' },
  { t: 'Factory', tone: 'info', s: 'VEK-140 Export retries · tests passed · verification in progress' },
  { t: 'Approval', tone: 'warn', s: 'Plan for VEK-145 Payment webhooks · waiting on Sam' },
  { t: 'Investigation', tone: 'info', s: 'NoMethodError in ExportsController · likely cause found · fix plan drafted' },
];
const projects = [
  { name: 'acme-api', ms: 'Webhooks v2', pct: 72, owner: 'Sam', dep: 'infra · rate limits', state: 'On track', tone: 'ok' },
  { name: 'acme-web', ms: 'Checkout redesign', pct: 41, owner: 'Priya', dep: 'design review', state: 'At risk', tone: 'warn' },
  { name: 'infra', ms: 'Rate limits', pct: 90, owner: 'Alex', dep: 'none', state: 'Due this week', tone: 'info' },
];
const work = [
  { id: 'VEK-131', t: 'Rate-limit the webhook endpoint', who: 'Alex', pri: 'High', how: 'AI-assisted', pr: '#214 merged' },
  { id: 'VEK-140', t: 'Retry failed exports', who: 'Factory · build-2', pri: 'High', how: 'AI-executed', pr: '#216 draft' },
  { id: 'VEK-128', t: 'Fix the dark-mode flash', who: 'Priya', pri: 'Medium', how: 'Manual', pr: '—' },
  { id: 'VEK-139', t: 'Checkout redesign', who: 'Priya', pri: 'High', how: 'Manual', pr: 'blocked' },
  { id: 'VEK-122', t: 'Audit log pagination', who: 'Unassigned', pri: 'Low', how: '—', pr: '—' },
];
const reports = [
  { l: 'Completed work', v: '9 this week', s: '7 last week' },
  { l: 'Median review wait', v: '1.4 days', s: 'bottleneck: acme-web' },
  { l: 'Changes with agent-written code', v: '38%', s: 'all human-approved' },
  { l: 'Engineering spending on AI', v: '$84', s: 'of $400 this week' },
];
const trend = [4, 6, 5, 7, 7, 9];
---
<figure class="db" data-demo-root="dashboard" data-dashboard>
  <Window title="Vekrun Cloud" crumbs={['Acme Engineering', 'Dashboard']} class="db-win">
    <span slot="status" class="db-demo-flag">Demonstration data</span>
    <span slot="status" class="hidden sm:inline">Dana · project manager</span>
    <div class="db-body">
      <nav class="db-side" aria-label="Dashboard sections">
        <div role="tablist" aria-orientation="vertical" class="db-tabs">
          {sections.map((s, i) => <button type="button" role="tab" id={`db-tab-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`db-panel-${s.id}`} tabindex={i === 0 ? 0 : -1} class="db-tab" data-db-tab={s.id}>{s.label}</button>)}
        </div>
      </nav>

      <div class="db-main">
        <!-- Overview -->
        <section role="tabpanel" id="db-panel-overview" aria-labelledby="db-tab-overview" class="db-panel" data-db-panel="overview">
          <div class="db-stats">
            {stats.map((s) => <div class="db-stat"><span class:list={['db-stat-n', s.tone && `is-${s.tone}`]} data-count={s.n}>{s.n}</span><span class="db-stat-l">{s.l}</span></div>)}
          </div>
          <h3 class="db-h">Recent activity</h3>
          <ul class="db-feed" data-feed>
            {activity.map((a, i) => <li data-t={1800 + i * 450}><span class:list={['db-tag', `is-${a.tone}`]}>{a.t}</span><span>{a.s}</span></li>)}
          </ul>
        </section>

        <!-- Projects -->
        <section role="tabpanel" id="db-panel-projects" aria-labelledby="db-tab-projects" class="db-panel" data-db-panel="projects" hidden>
          <table class="db-table">
            <thead><tr><th>Project</th><th>Milestone</th><th>Progress</th><th class="db-hide-sm">Owner</th><th class="db-hide-sm">Depends on</th><th>Delivery</th></tr></thead>
            <tbody>
              {projects.map((p) => (
                <tr><td class="db-mono">{p.name}</td><td>{p.ms}</td><td><span class="db-bar" role="img" aria-label={`${p.pct}% complete`}><i style={`width:${p.pct}%`}></i></span><span class="db-pct">{p.pct}%</span></td><td class="db-hide-sm">{p.owner}</td><td class="db-hide-sm">{p.dep}</td><td><span class:list={['db-tag', `is-${p.tone}`]}>{p.state}</span></td></tr>
              ))}
            </tbody>
          </table>
        </section>

        <!-- Work -->
        <section role="tabpanel" id="db-panel-work" aria-labelledby="db-tab-work" class="db-panel" data-db-panel="work" hidden>
          <table class="db-table">
            <thead><tr><th>Ticket</th><th>Assigned</th><th class="db-hide-sm">Priority</th><th>How</th><th>Pull request</th></tr></thead>
            <tbody>
              {work.map((w) => <tr><td><span class="db-mono">{w.id}</span> {w.t}</td><td>{w.who}</td><td class="db-hide-sm">{w.pri}</td><td><span class:list={['db-tag', w.how.startsWith('AI') ? 'is-info' : 'is-muted']}>{w.how}</span></td><td class="db-mono">{w.pr}</td></tr>)}
            </tbody>
          </table>
        </section>

        <!-- AI Operations -->
        <section role="tabpanel" id="db-panel-ai" aria-labelledby="db-tab-ai" class="db-panel" data-db-panel="ai" hidden>
          <div class="db-two">
            <div>
              <h3 class="db-h">Running Factory jobs</h3>
              <ul class="db-rows">
                <li><span class="db-mono">VEK-140</span><span>Retry failed exports · worker build-2 · step 3 of 5, tests</span><span class="db-tag is-info">running</span></li>
                <li><span class="db-mono">VEK-145</span><span>Payment webhooks · waiting for an approved plan</span><span class="db-tag is-warn">queued</span></li>
              </ul>
              <h3 class="db-h">Approval requests</h3>
              <ul class="db-rows">
                <li><span class="db-mono">Plan</span><span>VEK-145 Payment webhooks · 4 steps · estimated $12</span><span class="db-tag is-warn">Sam</span></li>
                <li><span class="db-mono">Command</span><span>Run the exports migration in staging</span><span class="db-tag is-warn">Alex</span></li>
              </ul>
            </div>
            <div>
              <h3 class="db-h">This week</h3>
              <dl class="db-dl">
                <div><dt>Agent jobs</dt><dd>14 · 11 verified · 2 repaired · 1 returned to a person</dd></div>
                <div><dt>Assigned workers</dt><dd>build-2 (shared), Alex’s machine, Priya’s machine</dd></div>
                <div><dt>Budget</dt><dd><span class="db-bar db-bar-wide" role="img" aria-label="21% of the weekly budget used"><i style="width:21%"></i></span>$84 of $400</dd></div>
                <div><dt>Verification</dt><dd>every merged job re-ran its tests on a different agent</dd></div>
              </dl>
            </div>
          </div>
        </section>

        <!-- Quality & Insights -->
        <section role="tabpanel" id="db-panel-quality" aria-labelledby="db-tab-quality" class="db-panel" data-db-panel="quality" hidden>
          <ul class="db-rows">
            <li><span class="db-tag is-warn">CI failed</span><span>acme-web · main · lint, 2 hours ago · Priya is looking</span><span class="db-mono">1</span></li>
            <li><span class="db-tag is-info">Reviews</span><span>#209, #211, #216 waiting · oldest 2 days</span><span class="db-mono">3</span></li>
            <li><span class="db-tag is-warn">Production</span><span>NoMethodError in ExportsController · 142 in 24 h · Honeybadger</span><span class="db-mono">1</span></li>
            <li><span class="db-tag is-info">Investigations</span><span>ExportsController (likely cause 0.8) · slow /search (in progress)</span><span class="db-mono">2</span></li>
            <li><span class="db-tag is-ok">Pending fixes</span><span>Exports nil guard · plan approved · Factory queued</span><span class="db-mono">1</span></li>
          </ul>
        </section>

        <!-- Reports -->
        <section role="tabpanel" id="db-panel-reports" aria-labelledby="db-tab-reports" class="db-panel" data-db-panel="reports" hidden>
          <div class="db-two">
            <dl class="db-dl">
              {reports.map((r) => <div><dt>{r.l}</dt><dd><strong>{r.v}</strong> <span class="db-dim">{r.s}</span></dd></div>)}
            </dl>
            <div>
              <h3 class="db-h">Delivered per week</h3>
              <div class="db-trend" role="img" aria-label="Six weeks of delivered work, rising from 4 to 9">
                {trend.map((v) => <i style={`height:${(v / 9) * 100}%`}><b>{v}</b></i>)}
              </div>
              <h3 class="db-h">Project progress</h3>
              {projects.map((p) => <p class="db-prog"><span class="db-mono">{p.name}</span><span class="db-bar db-bar-wide"><i style={`width:${p.pct}%`}></i></span><span class="db-pct">{p.pct}%</span></p>)}
            </div>
          </div>
        </section>
      </div>
    </div>
  </Window>
  <DemoControls notice="Conceptual preview with demonstration data. No real organization is shown; the dashboard is a planned Vekrun Cloud capability." />
</figure>

<style>
  .db { margin: 0; }
  .db-win { font-size: 0.78rem; }
  .db-demo-flag { font-family: var(--font-mono); color: var(--warn); border: 1px solid color-mix(in srgb, var(--warn) 45%, transparent); border-radius: 999px; padding: 0.05rem 0.45rem; font-size: 0.64rem; }
  .db-body { display: grid; grid-template-columns: 11rem minmax(0, 1fr); min-height: 22rem; }
  @media (max-width: 47.9rem) { .db-body { grid-template-columns: 1fr; } }
  .db-side { border-right: 1px solid var(--border); background: var(--bg-elevated); padding: 0.6rem; min-width: 0; }
  @media (max-width: 47.9rem) { .db-side { border-right: 0; border-bottom: 1px solid var(--border); padding: 0.45rem 0.6rem; } .db-tabs { flex-direction: row !important; overflow-x: auto; scrollbar-width: none; mask-image: linear-gradient(90deg, black 88%, transparent); } }
  .db-tabs { display: flex; flex-direction: column; gap: 0.15rem; }
  .db-tab { flex: 0 0 auto; text-align: left; border: 0; background: transparent; color: var(--text-2); font-size: 0.8rem; padding: 0.4rem 0.6rem; border-radius: 6px; cursor: pointer; white-space: nowrap; transition: color var(--dur-fast), background-color var(--dur-fast); }
  .db-tab:hover { color: var(--text); }
  .db-tab[aria-selected='true'] { background: var(--surface-2); color: var(--text); box-shadow: inset 0 0 0 1px var(--border); }
  .db-main { min-width: 0; }
  .db-panel { padding: 0.9rem; animation: fade 240ms both; }
  .db-panel[hidden] { display: none; }
  .db-h { margin: 1rem 0 0.4rem; font-size: 0.72rem; font-weight: 540; color: var(--text-3); }
  .db-h:first-child { margin-top: 0; }
  .db-stats { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: hidden; }
  @media (max-width: 47.9rem) { .db-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); } .db-stats > :nth-child(5) { grid-column: span 2; } }
  .db-stat { background: var(--surface); padding: 0.6rem 0.7rem; display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .db-stat-n { font-size: 1.5rem; font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; color: var(--text); font-variant-numeric: tabular-nums; }
  .db-stat-n.is-warn { color: var(--warn); } .db-stat-n.is-info { color: var(--info); } .db-stat-n.is-ok { color: var(--ok); }
  .db-stat-l { font-size: 0.66rem; color: var(--text-3); }
  .db-feed { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; min-height: 8.5rem; }
  .db-feed li { display: flex; gap: 0.5rem; align-items: flex-start; color: var(--text-2); animation: rise-sm 400ms var(--ease-out) both; }
  .db-feed li[hidden] { display: none; }
  .db-tag { flex: 0 0 auto; display: inline-flex; align-items: center; font-family: var(--font-mono); font-size: 0.62rem; border-radius: 4px; padding: 0.08rem 0.4rem; border: 1px solid var(--border-strong); color: var(--text-2); white-space: nowrap; }
  .db-tag.is-ok { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 50%, transparent); }
  .db-tag.is-warn { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 50%, transparent); }
  .db-tag.is-info { color: var(--info); border-color: color-mix(in srgb, var(--info) 50%, transparent); }
  .db-tag.is-muted { color: var(--text-3); }
  .db-table { width: 100%; border-collapse: collapse; }
  .db-table th { text-align: left; font-weight: 540; font-size: 0.66rem; color: var(--text-3); padding: 0.35rem 0.5rem; border-bottom: 1px solid var(--border); }
  .db-table td { padding: 0.5rem; border-bottom: 1px solid var(--border); color: var(--text-2); vertical-align: middle; }
  .db-table tr:last-child td { border-bottom: 0; }
  .db-mono { font-family: var(--font-mono); font-size: 0.72rem; color: var(--text); }
  .db-bar { display: inline-block; vertical-align: middle; width: 4.5rem; height: 5px; border-radius: 999px; background: var(--surface-3); overflow: hidden; margin-right: 0.4rem; }
  .db-bar i { display: block; height: 100%; background: var(--accent-gradient); border-radius: inherit; }
  .db-bar-wide { width: 8rem; }
  .db-pct { font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-3); }
  @media (max-width: 47.9rem) { .db-hide-sm { display: none; } }
  .db-two { display: grid; gap: 1rem; }
  @media (min-width: 48rem) { .db-two { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 1.5rem; } }
  .db-rows { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: hidden; }
  .db-rows li { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 0.6rem; background: var(--surface); padding: 0.45rem 0.6rem; color: var(--text-2); }
  .db-rows li > span:nth-child(2) { min-width: 0; }
  .db-dl { margin: 0; display: flex; flex-direction: column; gap: 0.55rem; }
  .db-dl > div { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: 0.5rem; align-items: baseline; }
  .db-dl dt { color: var(--text-3); font-size: 0.72rem; } .db-dl dd { margin: 0; color: var(--text-2); }
  .db-dl strong { color: var(--text); font-weight: 580; }
  .db-dim { color: var(--text-3); font-size: 0.72rem; }
  @media (max-width: 40rem) { .db-dl > div { grid-template-columns: 1fr; gap: 0.1rem; } }
  .db-trend { display: flex; align-items: flex-end; gap: 0.35rem; height: 4.5rem; padding: 0 0.2rem; border-bottom: 1px solid var(--border); }
  .db-trend i { flex: 1; position: relative; background: color-mix(in srgb, var(--accent) 35%, var(--surface-3)); border-radius: 3px 3px 0 0; min-height: 3px; }
  .db-trend i:last-child { background: var(--accent); }
  .db-trend b { position: absolute; top: -1rem; left: 0; right: 0; text-align: center; font-family: var(--font-mono); font-weight: 400; font-size: 0.6rem; color: var(--text-3); }
  .db-prog { margin: 0.35rem 0 0; display: flex; align-items: center; gap: 0.5rem; }
  .db-prog .db-mono { width: 4.5rem; }
  @media (prefers-reduced-motion: reduce) { .db-panel, .db-feed li { animation: none; } }
</style>

<script>
  import { createSequence, reducedMotion, type Step } from '@/scripts/sequence';

  const root = document.querySelector<HTMLElement>('[data-dashboard]');
  if (root) {
    // Tabs.
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-db-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-db-panel]'));
    const select = (id: string, focus = false) => {
      tabs.forEach((t) => { const on = t.dataset.dbTab === id; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; if (on && focus) t.focus(); });
      panels.forEach((p) => { p.hidden = p.dataset.dbPanel !== id; });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.dbTab!));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); select(tabs[(i + 1) % tabs.length]!.dataset.dbTab!, true); }
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); select(tabs[(i - 1 + tabs.length) % tabs.length]!.dataset.dbTab!, true); }
      });
    });

    // Overview: counts rise and the feed arrives.
    const counters = Array.from(root.querySelectorAll<HTMLElement>('[data-count]'));
    const feed = Array.from(root.querySelectorAll<HTMLElement>('[data-feed] > li'));
    const reduce = reducedMotion();
    const reset = () => { counters.forEach((c) => { c.textContent = '0'; }); feed.forEach((f) => { f.hidden = true; }); };
    const steps: Step[] = [];
    counters.forEach((c, ci) => {
      const target = Number(c.dataset.count);
      const frames = reduce ? 1 : 12;
      for (let f = 1; f <= frames; f++) steps.push({ t: 300 + ci * 120 + f * 60, run: () => { c.textContent = String(Math.round((target * f) / frames)); } });
    });
    feed.forEach((f) => steps.push({ t: Number(f.dataset.t), run: () => { f.hidden = false; } }));
    createSequence(root, steps, { reset });
  }
</script>
