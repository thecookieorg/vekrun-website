---
/**
 * The browser chrome every Cloud dashboard view shares. A desktop mockup uses
 * Window.astro; anything that lives in Vekrun Cloud lives in this.
 */
import { org } from '@/data/cloud-demo';
interface Props { title?: string; path?: string; class?: string; [key: string]: unknown }
const { title = org.name, path = `/${org.slug}`, class: className = '', ...rest } = Astro.props;
---
<div class:list={['browser', className]} {...rest}>
  <div class="browser-bar">
    <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="browser-tab"><svg viewBox="0 0 32 32" width="12" height="12" aria-hidden="true"><path d="M5 7h5.2l5.8 13.4L21.8 7H27L18.1 27h-4.2Z" fill="currentColor"/></svg>{title}</span>
    <span class="browser-url"><svg width="10" height="10" viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="1.5" fill="currentColor"/><path d="M5 7V5a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="1.6"/></svg><b>{org.host}</b>{path}</span>
    <span class="browser-status"><slot name="status" /></span>
  </div>
  <slot />
</div>
