  .is-human { background: var(--text-2); } .is-assist { background: var(--accent); } .is-exec { background: var(--cloud); }
  .db-keys { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.3rem 0.9rem; font-size: 0.64rem; color: var(--text-2); }
