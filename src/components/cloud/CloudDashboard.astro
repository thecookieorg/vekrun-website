  .db-feed li[hidden] { display: none; }
  .db-table { width: 100%; border-collapse: collapse; }
  .db-table th { text-align: left; font-weight: 540; font-size: 0.64rem; color: var(--text-3); padding: 0.35rem 0.5rem; border-bottom: 1px solid var(--border); white-space: nowrap; }
