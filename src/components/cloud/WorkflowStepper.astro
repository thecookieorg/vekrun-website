---
/**
 * "Work moves forward. Everyone stays in sync." Eight steps from assignment to
 * delivery across three actors: Dana's dashboard, Alex's Vekrun, Priya's Vekrun.
 * The rail is a list of real buttons, so a reader can step manually; the script
 * advances one step every 1.5 s. Final state in markup: step 8. Conceptual.
 */
import Window from '@/components/mock/Window.astro';
import Browser from './Browser.astro';
import Avatar from './Avatar.astro';
import DemoControls from '@/components/mock/DemoControls.astro';
import { ChevronLeft, ChevronRight } from '@lucide/astro';

const steps = [
  { n: 1, t: 'Assign', who: 'Dana assigns the ticket', actor: 'dash' },
  { n: 2, t: 'On the Board', who: 'It appears on Alex’s Board', actor: 'alex' },
  { n: 3, t: 'Start Work', who: 'Alex starts work', actor: 'alex' },
  { n: 4, t: 'Factory runs', who: 'Factory executes the approved plan', actor: 'alex' },
  { n: 5, t: 'Tests pass', who: 'Tests pass and a second agent verifies', actor: 'alex' },
  { n: 6, t: 'Pull request', who: 'A pull request is opened', actor: 'alex' },
  { n: 7, t: 'Review', who: 'Priya gets the review request', actor: 'priya' },
  { n: 8, t: 'Delivered', who: 'Dana sees it delivered', actor: 'dash' },
];
---
<figure class="wf" data-demo-root="workflow" data-workflow data-current="8">
  <div class="wf-head">
    <ol class="wf-rail" aria-label="Workflow steps">
      {steps.map((s) => (
        <li class="wf-rail-i">
          <button type="button" class="wf-step" data-step-btn={s.n} aria-current={s.n === 8 ? 'step' : undefined} aria-label={`Step ${s.n} of 8: ${s.who}`}><i>{s.n}</i><span>{s.t}</span></button>
        </li>
      ))}
      <span class="wf-line" aria-hidden="true"><i data-wf-line style="--p: 100%"></i></span>
    </ol>
    <div class="wf-nav">
      <p class="wf-now" aria-live="polite"><span class="kicker">Step <b data-wf-n>8</b> of 8</span><span data-wf-who>Dana sees it delivered</span></p>
      <div class="wf-btns">
        <button type="button" class="wf-btn" data-wf-prev aria-label="Previous step"><ChevronLeft class="h-4 w-4" aria-hidden="true" /></button>
        <button type="button" class="wf-btn" data-wf-next aria-label="Next step"><ChevronRight class="h-4 w-4" aria-hidden="true" /></button>
      </div>
    </div>
  </div>

  <div class="wf-stage">
    <!-- Dana's dashboard -->
    <div class="wf-actor" data-actor="dash">
      <p class="wf-actor-h"><Avatar who="dana" size="sm" /> Dana · project manager · browser</p>
      <Browser path="/acme/work" class="wf-browser is-compact">
        <div class="wf-ticket">
          <div class="wf-ticket-row"><span class="wf-id">VEK-152</span><span class="wf-t">Audit log pagination</span><span class="pill is-ok" data-wf-status>Delivered</span></div>
          <ul class="wf-log">
            <li data-step="1"><span class="pill is-cloud">Assigned</span>to Alex · priority high</li>
            <li data-step="3"><span class="pill is-info">In progress</span>Alex started work · branch feat/audit-pagination</li>
            <li data-step="6"><span class="pill is-info">In review</span>#218 opened · 24 tests passed</li>
            <li data-step="8"><span class="pill is-ok">Delivered</span>#218 merged · approved by Priya</li>
          </ul>
        </div>
      </Browser>
    </div>

    <!-- Alex's desktop -->
    <div class="wf-actor" data-actor="alex">
      <p class="wf-actor-h"><Avatar who="alex" size="sm" /> Alex · developer · Vekrun on macOS</p>
      <Window title="Alex · Vekrun" crumbs={['Board']} class="wf-win">
        <div class="wf-board">
          <div class="wf-col"><span class="wf-col-h">To do</span>
            <div class="wf-card" data-step="2" data-step-until="2"><span class="wf-id">VEK-152</span>Audit log pagination<span class="pill is-cloud">from Dana</span></div>
            <div class="wf-card is-quiet"><span class="wf-id">VEK-139</span>Checkout redesign</div>
          </div>
          <div class="wf-col"><span class="wf-col-h">In progress</span>
            <div class="wf-card is-hot" data-step="3" data-step-until="7"><span class="wf-id">VEK-152</span>Audit log pagination<span class="wf-start" data-step="3" data-step-until="3">Start Work</span><span class="pill is-info" data-step="4">Factory · build-3</span></div>
            <span class="wf-empty" data-step="8">Nothing in progress</span>
          </div>
          <div class="wf-col"><span class="wf-col-h">Done</span>
            <div class="wf-card is-ok" data-step="8"><span class="wf-id">VEK-152</span>Audit log pagination<span class="pill is-ok">merged</span></div>
          </div>
        </div>
        <pre class="term wf-term"><span class="term-line" data-step="4"><span class="dim">›</span> Factory · plan approved by Sam · worker <span class="mag">build-3</span> · 3 steps</span><span class="term-line" data-step="4">step 1 of 3 · add cursor pagination to AuditLogsController</span><span class="term-line" data-step="5">24 tests … <span class="ok">24 passed</span> · verified by a second agent</span><span class="term-line" data-step="6">pull request <span class="info">#218</span> opened · review requested from Priya</span></pre>
      </Window>
    </div>

    <!-- Priya's desktop -->
    <div class="wf-actor" data-actor="priya">
      <p class="wf-actor-h"><Avatar who="priya" size="sm" /> Priya · developer · Vekrun on Windows</p>
      <Window title="Priya · Vekrun" crumbs={['Reviews']} class="wf-win">
        <ul class="wf-reviews">
          <li class="wf-review" data-step="7"><span><span class="wf-id">#218</span>Audit log pagination</span><span class="wf-meta">from Factory via Alex · AI findings: none</span><span class="pill is-ok" data-step="8">Approved by Priya</span></li>
          <li class="wf-review is-quiet"><span><span class="wf-id">#211</span>Replace the retry queue</span><span class="wf-meta">from Sam · 2 notes</span></li>
          <li class="wf-review is-quiet" data-step-until="6"><span class="wf-meta">No new review requests</span></li>
        </ul>
      </Window>
    </div>
  </div>
  <DemoControls notice="Conceptual preview. Each piece exists or is planned as described on its feature page; carrying work across a team is a planned Cloud capability. Use the arrows or click any step." />
</figure>

<style>
  .wf { margin: 0; }
  .wf-head { display: grid; min-width: 0; gap: 0.9rem; margin-bottom: 1.25rem; }
  .wf-rail { position: relative; min-width: 0; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 0.25rem; }
  .wf-line { position: absolute; left: calc(100% / 16); right: calc(100% / 16); top: 0.8rem; height: 2px; background: var(--border); z-index: 0; border-radius: 2px; overflow: hidden; }
  .wf-line i { display: block; height: 100%; width: var(--p, 0%); background: var(--accent-gradient); transition: width 500ms var(--ease-out); }
  .wf-step { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 0.45rem; width: 100%; border: 0; background: transparent; color: var(--text-3); font-size: 0.74rem; padding: 0; cursor: pointer; transition: color var(--dur-fast); }
  .wf-step i { display: inline-flex; align-items: center; justify-content: center; width: 1.65rem; height: 1.65rem; border-radius: 50%; border: 1px solid var(--border-strong); background: var(--bg); font-style: normal; font-family: var(--font-mono); font-size: 0.66rem; transition: background-color var(--dur-fast), border-color var(--dur-fast), color var(--dur-fast), box-shadow var(--dur-fast); }
  .wf-step span { white-space: nowrap; }
  .wf-step:hover { color: var(--text); }
  .wf-step.is-done i { border-color: var(--accent); color: var(--accent); }
  .wf-step[aria-current='step'] { color: var(--text); }
  .wf-step[aria-current='step'] i { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  @media (max-width: 47.9rem) {
    .wf-rail { display: flex; overflow-x: auto; scrollbar-width: none; gap: 0; padding-bottom: 0.25rem; }
    .wf-rail-i { flex: 0 0 5.2rem; }
    .wf-line { left: 2.6rem; right: 2.6rem; }
  }
  .wf-nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .wf-now { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.8rem; color: var(--text); font-size: 0.95rem; font-weight: 540; }
  .wf-now b { color: var(--text); font-weight: 600; }
  .wf-btns { display: flex; gap: 0.35rem; }
  .wf-btn { display: inline-flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.25rem; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text-2); cursor: pointer; transition: border-color var(--dur-fast), color var(--dur-fast); }
  .wf-btn:hover { border-color: var(--border-strong); color: var(--text); }

  .wf-stage { display: grid; gap: 1rem; }
  @media (min-width: 64rem) { .wf-stage { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr) minmax(0, 5fr); align-items: start; } }
  @media (min-width: 40rem) and (max-width: 63.9rem) { .wf-stage { grid-template-columns: 1fr 1fr; } .wf-actor[data-actor='alex'] { grid-column: 1 / -1; grid-row: 1; } }
  .wf-actor { min-width: 0; display: grid; gap: 0.5rem; transition: opacity var(--dur) var(--ease-out); }
  .wf-actor:not(.is-active) { opacity: 0.62; }
  .wf-actor-h { margin: 0; display: flex; align-items: center; gap: 0.45rem; font-size: 0.78rem; color: var(--text-2); }
  .wf-actor.is-active .wf-actor-h { color: var(--text); }
  .wf-browser, .wf-win { font-size: 0.74rem; transition: box-shadow var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out); }
  .wf-actor.is-active .wf-browser, .wf-actor.is-active .wf-win { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); box-shadow: var(--glow); }
  .wf-id { font-family: var(--font-mono); font-size: 0.64rem; color: var(--text-3); margin-right: 0.35rem; }
  .wf-ticket { padding: 0.7rem; display: grid; gap: 0.6rem; min-height: 11rem; }
  .wf-ticket-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 0.5rem; color: var(--text); font-weight: 540; }
  .wf-t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .wf-log { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; color: var(--text-2); font-size: 0.7rem; }
  .wf-log li { display: flex; align-items: center; gap: 0.45rem; animation: rise-sm 360ms var(--ease-out) both; }
  .wf-board { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--border); }
  .wf-col { background: var(--surface); padding: 0.5rem; display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; min-height: 6.6rem; }
  .wf-col-h { font-size: 0.64rem; color: var(--text-3); }
  .wf-card { position: relative; display: flex; flex-direction: column; gap: 0.2rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.4rem 0.5rem; color: var(--text); font-size: 0.7rem; line-height: 1.3; animation: scale-in 360ms var(--ease-out) both; }
  .wf-card.is-quiet { color: var(--text-2); animation: none; }
  .wf-card.is-hot { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .wf-card.is-ok { border-color: color-mix(in srgb, var(--ok) 55%, transparent); }
  .wf-card .pill { align-self: flex-start; }
  .wf-start { align-self: flex-start; background: var(--accent); color: var(--accent-ink); border-radius: 4px; padding: 0.12rem 0.45rem; font-size: 0.64rem; font-weight: 600; animation: scale-in 300ms var(--ease-spring) both; }
  .wf-empty { font-size: 0.64rem; color: var(--text-3); border: 1px dashed var(--border); border-radius: var(--radius-sm); padding: 0.45rem; text-align: center; }
  .wf-term { margin: 0; padding: 0.55rem 0.7rem; min-height: 5.8rem; font-size: 0.68rem; border-top: 1px solid var(--border); }
  .wf-reviews { list-style: none; margin: 0; padding: 0.55rem; display: flex; flex-direction: column; gap: 0.4rem; min-height: 11rem; }
  .wf-review { display: flex; flex-direction: column; gap: 0.15rem; padding: 0.45rem 0.55rem; border: 1px solid color-mix(in srgb, var(--info) 45%, transparent); border-radius: var(--radius-sm); background: var(--surface-2); color: var(--text); font-size: 0.7rem; animation: scale-in 360ms var(--ease-out) both; }
  .wf-review.is-quiet { border-color: var(--border); animation: none; color: var(--text-2); }
  .wf-review .pill { align-self: flex-start; margin-top: 0.15rem; animation: scale-in 300ms var(--ease-spring) both; }
  .wf-meta { font-size: 0.64rem; color: var(--text-3); }
  .wf [data-step][hidden], .wf [data-step-until][hidden] { display: none; }
  @media (prefers-reduced-motion: reduce) { .wf-log li, .wf-card, .wf-start, .wf-review, .wf-review .pill { animation: none; } .wf-line i, .wf-actor { transition: none; } }
</style>

<script>
  import { createSequence, type Step } from '@/scripts/sequence';

  const root = document.querySelector<HTMLElement>('[data-workflow]');
  if (root) {
    const TOTAL = 8;
    const actorOf = ['', 'dash', 'alex', 'alex', 'alex', 'alex', 'alex', 'priya', 'dash'];
    const whoOf = ['Backlog', 'Dana assigns the ticket', 'It appears on Alex’s Board', 'Alex starts work', 'Factory executes the approved plan', 'Tests pass and a second agent verifies', 'A pull request is opened', 'Priya gets the review request', 'Dana sees it delivered'];
    const statusOf: [string, string][] = [['Backlog', 'muted'], ['Assigned · Alex', 'cloud'], ['Assigned · Alex', 'cloud'], ['In progress', 'info'], ['In progress · Factory', 'info'], ['Tests passed', 'info'], ['In review · #218', 'info'], ['In review · Priya', 'info'], ['Delivered', 'ok']];
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-step], [data-step-until]'));
    const btns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-step-btn]'));
    const actors = Array.from(root.querySelectorAll<HTMLElement>('[data-actor]'));
    const line = root.querySelector<HTMLElement>('[data-wf-line]')!;
    const nEl = root.querySelector<HTMLElement>('[data-wf-n]')!;
    const whoEl = root.querySelector<HTMLElement>('[data-wf-who]')!;
    const status = root.querySelector<HTMLElement>('[data-wf-status]')!;
    let current = 0;

    const go = (n: number) => {
      current = Math.max(0, Math.min(TOTAL, n));
      root.dataset.current = String(current);
      items.forEach((el) => {
        const from = Number(el.dataset.step ?? 0);
        const until = el.dataset.stepUntil ? Number(el.dataset.stepUntil) : Infinity;
        el.hidden = !(current >= from && current <= until);
      });
      btns.forEach((b) => { const k = Number(b.dataset.stepBtn); b.classList.toggle('is-done', k < current); if (k === current) b.setAttribute('aria-current', 'step'); else b.removeAttribute('aria-current'); });
      actors.forEach((a) => a.classList.toggle('is-active', a.dataset.actor === actorOf[current]));
      line.style.setProperty('--p', `${(Math.max(1, current) - 1) / (TOTAL - 1) * 100}%`);
      nEl.textContent = String(Math.max(1, current)); whoEl.textContent = whoOf[current]!;
      const [label, tone] = statusOf[current]!;
      status.textContent = label; status.classList.remove('is-ok', 'is-info', 'is-cloud', 'is-muted', 'is-warn'); status.classList.add(`is-${tone}`);
    };

    const steps: Step[] = [];
    for (let n = 1; n <= TOTAL; n++) steps.push({ t: 500 + (n - 1) * 1500, run: () => go(n) });
    const seq = createSequence(root, steps, { reset: () => go(0) });

    const manual = (n: number) => { seq.pause(); go(n); };
    btns.forEach((b) => b.addEventListener('click', () => manual(Number(b.dataset.stepBtn))));
    root.querySelector('[data-wf-prev]')?.addEventListener('click', () => manual(Math.max(1, current - 1)));
    root.querySelector('[data-wf-next]')?.addEventListener('click', () => manual(Math.min(TOTAL, current + 1)));
  }
</script>
