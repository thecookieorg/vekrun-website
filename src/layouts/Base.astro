---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';

interface Props {
  title: string;
  description: string;
  /** Path of the Open Graph image under /public. */
  image?: string;
  /** JSON-LD structured data, serialised as-is. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Full title override; otherwise "{title} · Vekrun". */
  fullTitle?: string;
  /**
   * Lock the page to one theme. The page renders in that theme before first paint,
   * the stored preference is neither read nor written, and the toggle is not shown.
   * Available for a dark-by-design page; no page uses it today.
   */
  lockTheme?: 'dark';
  /** A page identity hook (`[data-page='…']`) for the few page-specific rules. */
  page?: string;
}
const { title, description, image = '/og/default.png', structuredData, noindex = false, fullTitle, lockTheme, page } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const pageTitle = fullTitle ?? (Astro.url.pathname === '/' ? title : `${title} · ${site.name}`);
const ogImage = new URL(image, site.url).href;
const ld = structuredData
  ? Array.isArray(structuredData) ? structuredData : [structuredData]
  : [];
---
<!doctype html>
<html lang="en" class="no-js" data-theme={lockTheme} data-theme-locked={lockTheme ? '' : undefined} data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#080b12" data-theme-color />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}

    <script is:inline>
      // Resolve the theme before first paint. Dark is the default; an explicit choice
      // ('dark' or 'light') wins, and 'auto' (an empty stored value, as the docs write it)
      // follows the system. Shares the storage key with the docs (Starlight).
      (function () {
        var html = document.documentElement;
        html.classList.remove('no-js');
        if (html.hasAttribute('data-theme-locked')) return;
        var stored = null;
        try { stored = localStorage.getItem('starlight-theme'); } catch (e) {}
        var theme = stored === 'dark' || stored === 'light'
          ? stored
          : stored === '' || stored === 'auto'
            ? (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
            : 'dark';
        html.dataset.theme = theme;
        var meta = document.querySelector('meta[data-theme-color]');
        if (meta) meta.setAttribute('content', theme === 'light' ? '#f5f7fb' : '#080b12');
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header themeToggle={!lockTheme} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // One reveal observer for the blocks that opt in with `.reveal` or `.reveal-group`.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll<HTMLElement>('.reveal, .reveal-group');
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
