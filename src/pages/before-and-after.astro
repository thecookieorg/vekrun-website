---
/**
 * Before & After: seven moments from an ordinary engineering day, before and
 * after Vekrun. Three compositions alternate so the page never becomes a wall of
 * cards: a full-width versus, a shift (the old way struck small above the new
 * way), and paired illustrations. Illustrative comparisons, not customer quotes.
 */
import Base from '@/layouts/Base.astro';
import ClosingCta from '@/components/ClosingCta.astro';
import PageHero from '@/components/PageHero.astro';
import { Check, X, RotateCw, Copy, ArrowRight } from '@lucide/astro';
---
<Base title="Before & After" fullTitle="Before & After: engineering with and without Vekrun · Vekrun" description="What an engineering day looks like before and after Vekrun: from managing agents to directing outcomes, from hoping a plan is right to having it challenged, from 'it says it's done' to proof." image="/og/before-and-after.png">
  <PageHero eyebrow="Before & After" title="Before Vekrun. After Vekrun." lede="Seven moments from an ordinary engineering day, and how each one changes.">
    <p slot="after" class="mt-6 text-[0.875rem] text-text-3">Illustrative comparisons, not customer quotes.</p>
  </PageHero>

  <!-- 1. Versus -->
  <section class="vs rule" aria-labelledby="c1">
    <h2 id="c1" class="sr-only">Managing agents, or directing the outcome</h2>
    <div class="vs-half is-before">
      <div class="vs-in">
        <p class="tag">Before</p>
        <p class="vs-big">You’re managing the agents.</p>
        <ol class="vs-loop" aria-label="The loop">
          <li>Write prompts.</li><li>Check progress.</li><li>Fix mistakes.</li><li class="is-repeat"><RotateCw class="h-4 w-4" aria-hidden="true" />Repeat.</li>
        </ol>
      </div>
    </div>
    <div class="vs-half is-after">
      <div class="vs-in">
        <p class="tag">After</p>
        <p class="vs-big">You’re directing the outcome.</p>
        <p class="vs-small">Tell Vekrun what needs to happen. It coordinates the work.</p>
      </div>
    </div>
  </section>

  <!-- 2. Shift -->
  <section class="shift rule" aria-labelledby="c2">
    <div class="container-site shift-in">
      <div class="reveal">
        <p class="was"><span class="tag">Before</span><s>One AI makes a plan. You hope it’s right.</s></p>
        <h2 id="c2" class="now"><span class="tag">After</span>A Council challenges the plan before anyone starts building.</h2>
      </div>
      <div class="ill ill-council reveal" aria-hidden="true">
        <span class="ic-seat is-for">Supports<b>Queue the webhooks</b></span>
        <span class="ic-seat">Objects<b>Poll every minute</b></span>
        <span class="ic-seat is-amend">Amends<b>Make retries idempotent</b></span>
        <span class="ic-dec">Decision recorded, objection kept</span>
      </div>
    </div>
  </section>

  <!-- 3. Paired illustrations -->
  <section class="pair rule" aria-labelledby="c3">
    <div class="container-site">
      <h2 id="c3" class="pair-h reveal">“Done” should mean done.</h2>
      <div class="pair-grid reveal-group">
        <div class="pair-card is-before">
          <p class="tag">Before</p>
          <p class="pair-t">The agent says it’s done. Now you test everything.</p>
          <div class="ill ill-chat" aria-hidden="true">
            <p class="bubble">All done! Everything should work now ✓</p>
            <p class="todo"><X class="h-4 w-4" />Run the tests yourself</p>
            <p class="todo"><X class="h-4 w-4" />Click through checkout</p>
            <p class="todo"><X class="h-4 w-4" />Hope nothing else broke</p>
          </div>
        </div>
        <div class="pair-card is-after">
          <p class="tag">After</p>
          <p class="pair-t">Tests run. Evidence is collected. You review the result.</p>
          <div class="ill ill-proof" aria-hidden="true">
            <p class="pp-h">Proof Pack · PR #482</p>
            <p><Check class="h-4 w-4" />148 tests passed</p>
            <p><Check class="h-4 w-4" />Checkout verified in a browser</p>
            <p><Check class="h-4 w-4" />Independent verifier agrees</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Shift, mirrored -->
  <section class="shift is-mirror rule bg-bg-elevated" aria-labelledby="c4">
    <div class="container-site shift-in">
      <div class="reveal">
        <p class="was"><span class="tag">Before</span><s>Every project means another context to manage.</s></p>
        <h2 id="c4" class="now"><span class="tag">After</span>One Factory keeps engineering work moving across projects.</h2>
      </div>
      <div class="ill ill-tabs reveal" aria-hidden="true">
        <div class="tabs-pile">
          <span>claude · shop-api</span><span>codex · mobile</span><span>notes-final-2.md</span><span>ENG-418</span><span>terminal 4</span><span>staging logs</span>
        </div>
        <ArrowRight class="tabs-arrow h-5 w-5" />
        <ul class="tabs-one">
          <li><b>shop-mobile</b><span>Testing</span></li>
          <li><b>shop-api</b><span>Verifying</span></li>
          <li><b>storefront</b><span>Building</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. Versus -->
  <section class="vs rule" aria-labelledby="c5">
    <h2 id="c5" class="sr-only">Copying between tools, or connected work</h2>
    <div class="vs-half is-before">
      <div class="vs-in">
        <p class="tag">Before</p>
        <p class="vs-big">You spend your day copying between tools.</p>
        <p class="vs-chain"><span>Jira</span><Copy class="h-4 w-4" /><span>Agent</span><Copy class="h-4 w-4" /><span>GitHub</span><Copy class="h-4 w-4" /><span>Slack</span></p>
      </div>
    </div>
    <div class="vs-half is-after">
      <div class="vs-in">
        <p class="tag">After</p>
        <p class="vs-big">Work moves through your tools on its own.</p>
        <p class="vs-chain is-on"><span>Jira</span><i></i><span>Vekrun</span><i></i><span>GitHub</span><i></i><span>Jira, updated</span></p>
      </div>
    </div>
  </section>

  <!-- 6. Shift -->
  <section class="shift rule" aria-labelledby="c6">
    <div class="container-site shift-in">
      <div class="reveal">
        <p class="was"><span class="tag">Before</span><s>A failed approach means starting the conversation over.</s></p>
        <h2 id="c6" class="now"><span class="tag">After</span>Vekrun revisits the decision and adapts the plan.</h2>
      </div>
      <div class="ill ill-plan reveal" aria-hidden="true">
        <p class="plan-v is-old"><span>Plan v1</span><s>Poll the payment provider</s></p>
        <p class="plan-why">Tests show a minute of lag at checkout.</p>
        <p class="plan-v is-new"><span>Plan v2</span>Queue webhooks with retries</p>
      </div>
    </div>
  </section>

  <!-- 7. Paired illustrations -->
  <section class="pair rule bg-bg-elevated" aria-labelledby="c7">
    <div class="container-site">
      <h2 id="c7" class="pair-h reveal">The why doesn’t get lost.</h2>
      <div class="pair-grid reveal-group">
        <div class="pair-card is-before">
          <p class="tag">Before</p>
          <p class="pair-t">You remember why the code changed. Until you don’t.</p>
          <div class="ill ill-blame" aria-hidden="true">
            <p><code>a91f3c2</code> fix stuff</p>
            <p><code>7d02e1b</code> wip</p>
            <p><code>c44ba90</code> try again</p>
          </div>
        </div>
        <div class="pair-card is-after">
          <p class="tag">After</p>
          <p class="pair-t">Decisions and evidence stay with the work.</p>
          <div class="ill ill-mem" aria-hidden="true">
            <p class="mem-q">Why does checkout queue its webhooks?</p>
            <p class="mem-a">Polling lagged by a minute; the Council chose a queue with idempotent retries.</p>
            <p class="mem-src"><span>Decision</span><span>PR #220</span><span>Proof Pack</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ClosingCta title="Spend your day on the after." />
</Base>

<style>
  .tag { margin: 0 0 0.75rem; font-size: 0.8125rem; font-weight: 560; letter-spacing: 0; color: var(--text-3); }
  .is-after .tag, .now .tag { color: var(--accent); }

  /* Versus: two full-bleed halves. */
  .vs { display: grid; }
  @media (min-width: 64rem) { .vs { grid-template-columns: 1fr 1fr; } }
  .vs-half { padding: 4rem 1.25rem; }
  @media (min-width: 40rem) { .vs-half { padding: 5rem 2rem; } }
  @media (min-width: 64rem) { .vs-half { padding: 6.5rem 3.5rem; } .vs-half.is-before { display: flex; justify-content: flex-end; } }
  .vs-in { max-width: 34rem; }
  .vs-half.is-before { background: var(--bg); }
  .vs-half.is-after { background: var(--accent-soft); border-top: 1px solid var(--accent-line); }
  @media (min-width: 64rem) { .vs-half.is-after { border-top: 0; } }
  .vs-big { margin: 0; font-size: clamp(2rem, 1.3rem + 2.6vw, 3.3rem); line-height: 1.04; letter-spacing: -0.04em; font-weight: 640; }
  .is-before .vs-big { color: var(--text-2); }
  .is-after .vs-big { color: var(--text); }
  .vs-small { margin: 1.25rem 0 0; font-size: 1.15rem; line-height: 1.5; color: var(--text); }
  .vs-loop { margin: 1.5rem 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .vs-loop li { padding: 0.45rem 0.8rem; border: 1px solid var(--border); border-radius: 999px; font-size: 0.95rem; color: var(--text-2); }
  .vs-loop .is-repeat { display: inline-flex; gap: 0.4rem; align-items: center; color: var(--warn); border-style: dashed; }
  .vs-chain { margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: 0.92rem; color: var(--text-2); }
  .vs-chain span { padding: 0.4rem 0.7rem; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--surface); }
  .vs-chain :global(svg) { color: var(--warn); }
  .vs-chain.is-on span { color: var(--text); border-color: var(--accent-line); }
  .vs-chain.is-on i { width: 1.25rem; height: 1px; background: var(--accent); }

  /* Shift: the old way small and struck, the new way large. */
  .shift { padding-block: 5rem; }
  @media (min-width: 64rem) { .shift { padding-block: 7rem; } }
  .shift-in { display: grid; gap: 2.5rem; }
  @media (min-width: 64rem) { .shift-in { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 4.5rem; align-items: center; } .shift.is-mirror .shift-in > :first-child { order: 2; } .shift.is-mirror .shift-in { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } }
  .was { margin: 0; font-size: 1.15rem; line-height: 1.45; color: var(--text-3); }
  .was .tag { display: block; }
  .was s { text-decoration-thickness: 1px; text-decoration-color: color-mix(in srgb, var(--text-3) 70%, transparent); }
  .now { margin: 2rem 0 0; font-size: clamp(1.9rem, 1.2rem + 2.4vw, 3rem); line-height: 1.06; letter-spacing: -0.038em; font-weight: 640; color: var(--text); }
  .now .tag { display: block; letter-spacing: 0; font-weight: 560; }

  /* Paired illustrations. */
  .pair { padding-block: 5rem; }
  @media (min-width: 64rem) { .pair { padding-block: 7rem; } }
  .pair-h { margin: 0; font-size: clamp(1.9rem, 1.2rem + 2.4vw, 3rem); letter-spacing: -0.038em; font-weight: 640; color: var(--text); }
  .pair-grid { margin-top: 2.5rem; display: grid; gap: 1.25rem; }
  @media (min-width: 64rem) { .pair-grid { grid-template-columns: 1fr 1fr; } }
  .pair-card { padding: 1.75rem; border-radius: var(--radius-lg); border: 1px solid var(--border); display: flex; flex-direction: column; }
  .pair-card.is-before { background: var(--bg); }
  .pair-card.is-after { background: var(--accent-soft); border-color: var(--accent-line); }
  .pair-t { margin: 0 0 1.5rem; font-size: 1.3rem; line-height: 1.3; letter-spacing: -0.02em; font-weight: 600; }
  .is-before .pair-t { color: var(--text-2); }
  .is-after .pair-t { color: var(--text); }

  /* Illustrations. */
  .ill { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); padding: 1.1rem; font-size: 0.9rem; min-width: 0; }
  .pair-card .ill { margin-top: auto; }
  .ill p { margin: 0; }
  .ill-council { display: grid; gap: 0.5rem; }
  @media (min-width: 30rem) { .ill-council { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .ic-seat { display: grid; gap: 0.3rem; padding: 0.7rem; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--surface-2); font-size: 0.75rem; color: var(--text-3); }
  .ic-seat b { font-size: 0.85rem; font-weight: 540; color: var(--text); }
  .ic-seat.is-for { color: var(--accent); border-color: var(--accent-line); }
  .ic-seat.is-amend { color: var(--mint); }
  .ic-dec { grid-column: 1 / -1; padding: 0.7rem 0.8rem; border-radius: var(--radius-sm); background: var(--accent-soft); border: 1px solid var(--accent-line); font-weight: 560; color: var(--text); }
  .ill-chat .bubble { display: inline-block; padding: 0.6rem 0.85rem; border-radius: 12px 12px 12px 4px; background: var(--surface-2); color: var(--text); margin-bottom: 0.9rem; }
  .todo { display: flex; gap: 0.5rem; align-items: center; color: var(--text-2); padding-block: 0.2rem; }
  .todo :global(svg) { color: var(--danger); flex: 0 0 auto; }
  .ill-proof p { display: flex; gap: 0.5rem; align-items: center; color: var(--text); padding-block: 0.2rem; }
  .ill-proof :global(svg) { color: var(--accent); flex: 0 0 auto; }
  .ill-proof .pp-h { color: var(--text-3); font-size: 0.78rem; margin-bottom: 0.4rem; }
  .ill-tabs { display: grid; gap: 1rem; align-items: center; }
  @media (min-width: 30rem) { .ill-tabs { grid-template-columns: 1fr auto 1fr; } }
  .tabs-pile { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .tabs-pile span { padding: 0.3rem 0.55rem; border-radius: 6px; border: 1px solid var(--border); background: var(--surface-2); font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-3); }
  .tabs-pile span:nth-child(odd) { transform: rotate(-2deg); }
  .tabs-pile span:nth-child(3n) { transform: rotate(2.5deg); }
  .ill-tabs :global(.tabs-arrow) { color: var(--accent); justify-self: center; }
  .tabs-one { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.4rem; }
  .tabs-one li { display: flex; justify-content: space-between; gap: 0.5rem; padding: 0.5rem 0.7rem; border-radius: 6px; border: 1px solid var(--accent-line); background: var(--accent-soft); font-size: 0.8rem; }
  .tabs-one b { font-family: var(--font-mono); font-weight: 500; color: var(--text); }
  .tabs-one span { color: var(--accent); }
  .ill-plan { display: grid; gap: 0.6rem; }
  .plan-v { display: flex; gap: 0.7rem; align-items: baseline; padding: 0.7rem 0.8rem; border-radius: var(--radius-sm); border: 1px solid var(--border); }
  .plan-v span { font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-3); }
  .plan-v.is-old { color: var(--text-3); }
  .plan-v.is-new { color: var(--text); font-weight: 560; border-color: var(--accent-line); background: var(--accent-soft); }
  .plan-v.is-new span { color: var(--accent); }
  .plan-why { padding-left: 0.8rem; font-size: 0.82rem; color: var(--warn); }
  .ill-blame p { font-family: var(--font-mono); font-size: 0.82rem; color: var(--text-2); padding-block: 0.25rem; }
  .ill-blame code { color: var(--text-3); margin-right: 0.6rem; }
  .mem-q { font-weight: 560; color: var(--text); }
  .mem-a { margin-top: 0.4rem !important; color: var(--text-2); line-height: 1.5; }
  .mem-src { margin-top: 0.8rem !important; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .mem-src span { padding: 0.2rem 0.55rem; border-radius: 6px; background: var(--surface-2); border: 1px solid var(--border); font-size: 0.78rem; color: var(--mint); }

  .display-sm { font-size: clamp(2.2rem, 1.3rem + 3.4vw, 4rem); line-height: 1; letter-spacing: -0.045em; font-weight: 640; }
</style>
