---
/**
 * Benefits: what a developer or a team actually gains. Not a feature list.
 * Six benefits, each one sentence and one small illustrative visual, then the
 * two audiences in short lists. Visuals use demonstration content.
 */
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Button from '@/components/Button.astro';
import IntegrationLogo from '@/components/brand/IntegrationLogo.astro';
import ConceptNotice from '@/components/ConceptNotice.astro';
import { toolById } from '@/data/integrations';
import { Check } from '@lucide/astro';

const logos = ['claude-code', 'codex', 'gemini-cli', 'openrouter', 'github', 'jira', 'linear', 'sentry'].map((id) => toolById(id)!);
const devs = ['Less time supervising agents', 'Less context to juggle', 'More finished work each week', 'Proof instead of guesswork', 'Control over complex changes'];
const leads = ['Engineering work that runs in step', 'Progress you can see without asking', 'The same quality bar on every change', 'Fewer handoffs between people and tools', 'A record of who decided what, and why'];
---
<Base title="Benefits" fullTitle="Benefits: what changes when Vekrun runs the engineering · Vekrun" description="What developers and engineering teams gain from Vekrun: no more babysitting AI agents, better decisions before code is written, more work in flight, proof that it works, and a record of why." image="/og/benefits.png">
  <PageHero eyebrow="Benefits" title="Get your day back from your AI agents." lede="Vekrun takes the coordinating, checking and re-explaining off your plate, so you spend your time on decisions." />

  <section class="rule" aria-label="Benefits">
    <div class="container-site">
      <article class="bn reveal">
        <div class="bn-copy"><h2>Stop babysitting AI agents.</h2><p>Hand over the outcome, not a stream of prompts. Vekrun checks in only when it needs you.</p></div>
        <div class="bn-vis vis-compose" aria-hidden="true">
          <p class="vc-k">Outcome</p>
          <p class="vc-t">Add saved carts to the mobile app and the API.</p>
          <p class="vc-s"><i></i>Working on it. You’ll hear from Vekrun if a decision needs you.</p>
        </div>
      </article>

      <article class="bn reveal">
        <div class="bn-copy"><h2>Better decisions before code gets written.</h2><p>The Council tests the approach while changing course is still cheap.</p></div>
        <div class="bn-vis vis-council" aria-hidden="true">
          <span class="vco is-for">Claude · supports</span>
          <span class="vco">Gemini · objects</span>
          <span class="vco is-amend">Local model · amends</span>
          <span class="vco-d">Decision: queue with retries, idempotent handler</span>
        </div>
      </article>

      <article class="bn reveal">
        <div class="bn-copy"><h2>More work moving at once.</h2><p>Several projects progress while you think about one. No tab for each agent.</p></div>
        <div class="bn-vis vis-lanes" aria-hidden="true">
          <p><b>shop-mobile</b><span class="bar" style="--w: 64%"><i></i></span></p>
          <p><b>shop-api</b><span class="bar" style="--w: 82%"><i></i></span></p>
          <p><b>storefront</b><span class="bar" style="--w: 40%"><i></i></span></p>
        </div>
      </article>

      <article class="bn reveal">
        <div class="bn-copy"><h2>Know it works before you review it.</h2><p>Tests, browser checks and a Proof Pack come with every result. An agent’s word isn’t evidence.</p></div>
        <div class="bn-vis vis-proof" aria-hidden="true">
          <p><Check class="h-4 w-4" />Tests passed on this revision</p>
          <p><Check class="h-4 w-4" />Checkout works in a real browser</p>
          <p><Check class="h-4 w-4" />Independent verifier agrees</p>
        </div>
      </article>

      <article class="bn reveal">
        <div class="bn-copy"><h2>Keep the tools you already like.</h2><p>Claude Code, Codex, Gemini, GitHub, Jira. Vekrun works through them, not around them.</p></div>
        <div class="bn-vis vis-logos" aria-hidden="true">
          {logos.map((t) => <IntegrationLogo id={t.id} name={t.name} monogram={t.mono} size="lg" />)}
        </div>
      </article>

      <article class="bn reveal">
        <div class="bn-copy"><h2>Know what happened and why.</h2><p>Decisions, changes and evidence stay attached to the work, long after everyone forgot.</p></div>
        <div class="bn-vis vis-memory" aria-hidden="true">
          <p class="vm-q">Why do payment retries use an idempotency key?</p>
          <p class="vm-a">Council decision on the webhooks change. Duplicates were the risk.</p>
          <p class="vm-src"><span>Decision</span><span>PR #220</span><span>Proof Pack</span></p>
        </div>
      </article>
      <ConceptNotice class="pb-4" text="Illustrations use demonstration content." />
    </div>
  </section>

  <section class="section-pad rule bg-bg-elevated" aria-labelledby="who-title">
    <div class="container-site">
      <h2 id="who-title" class="heading-2 max-w-3xl text-text reveal">Good for you. Better for your team.</h2>
      <div class="who reveal-group">
        <div>
          <h3>For developers</h3>
          <ul>{devs.map((d) => <li><Check class="h-4 w-4" aria-hidden="true" />{d}</li>)}</ul>
        </div>
        <div>
          <h3>For engineering teams</h3>
          <ul>{leads.map((d) => <li><Check class="h-4 w-4" aria-hidden="true" />{d}</li>)}</ul>
        </div>
      </div>
      <p class="mt-10 max-w-2xl text-[0.95rem] text-text-2 reveal">You still review what ships. Vekrun makes sure what reaches you is worth reviewing.</p>
    </div>
  </section>

  <section class="section-pad rule" aria-labelledby="next-title">
    <div class="container-site text-center reveal">
      <h2 id="next-title" class="heading-2 text-text">See it in an ordinary day.</h2>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/before-and-after/" size="lg">Before & After</Button>
        <Button href="/teams/" size="lg" variant="secondary">Teams & Pricing</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .bn { display: grid; gap: 1.75rem; padding-block: 3.5rem; border-bottom: 1px solid var(--border); }
  @media (min-width: 64rem) { .bn { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 4rem; align-items: center; padding-block: 4.5rem; } }
  .bn-copy h2 { margin: 0; font-size: clamp(1.75rem, 1.2rem + 2vw, 2.6rem); line-height: 1.08; letter-spacing: -0.035em; font-weight: 630; color: var(--text); }
  .bn-copy p { margin: 1rem 0 0; max-width: 34rem; font-size: 1.125rem; line-height: 1.5; color: var(--text-2); }
  .bn-vis { padding: 1.25rem; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); min-width: 0; }

  .vc-k { margin: 0; font-size: 0.75rem; color: var(--text-3); }
  .vc-t { margin: 0.35rem 0 0; font-size: 1.05rem; font-weight: 560; color: var(--text); }
  .vc-s { margin: 1rem 0 0; display: flex; gap: 0.55rem; align-items: center; font-size: 0.85rem; color: var(--text-2); }
  .vc-s i { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--accent); flex: 0 0 auto; }

  .vis-council { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .vco { padding: 0.4rem 0.7rem; border-radius: 999px; border: 1px solid var(--border-strong); font-size: 0.85rem; color: var(--text-2); }
  .vco.is-for { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); }
  .vco.is-amend { color: var(--mint); border-color: color-mix(in srgb, var(--mint) 40%, transparent); }
  .vco-d { flex-basis: 100%; margin-top: 0.4rem; padding: 0.75rem 0.9rem; border-radius: var(--radius); background: var(--accent-soft); border: 1px solid var(--accent-line); font-size: 0.92rem; font-weight: 560; color: var(--text); }

  .vis-lanes { display: grid; gap: 0.9rem; }
  .vis-lanes p { margin: 0; display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.9rem; align-items: center; font-size: 0.85rem; }
  .vis-lanes b { font-weight: 540; color: var(--text); font-family: var(--font-mono); font-size: 0.8rem; }

  .vis-proof { display: grid; gap: 0.6rem; }
  .vis-proof p { margin: 0; display: flex; gap: 0.6rem; align-items: center; font-size: 0.95rem; color: var(--text); }
  .vis-proof :global(svg) { color: var(--accent); flex: 0 0 auto; }

  .vis-logos { display: grid; grid-template-columns: repeat(4, max-content); gap: 0.6rem; justify-content: start; }

  .vm-q { margin: 0; font-size: 1rem; font-weight: 560; color: var(--text); }
  .vm-a { margin: 0.5rem 0 0; font-size: 0.9rem; line-height: 1.5; color: var(--text-2); }
  .vm-src { margin: 0.9rem 0 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .vm-src span { padding: 0.2rem 0.55rem; border-radius: 6px; background: var(--surface-2); border: 1px solid var(--border); font-size: 0.78rem; color: var(--mint); }

  .who { margin-top: 3rem; display: grid; gap: 2.5rem; }
  @media (min-width: 48rem) { .who { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4rem; } }
  .who h3 { margin: 0 0 1rem; font-size: 1.25rem; font-weight: 620; color: var(--text); }
  .who ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.75rem; }
  .who li { display: flex; gap: 0.65rem; align-items: baseline; font-size: 1.05rem; color: var(--text-2); }
  .who li :global(svg) { color: var(--accent); flex: 0 0 auto; transform: translateY(2px); }
</style>
