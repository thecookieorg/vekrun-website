---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
---
<Base title="Page not found" description="That page does not exist on vekrunapp.com." noindex>
  <section class="container-site py-28">
    <p class="font-mono text-sm text-text-3">404</p>
    <h1 class="heading-1 mt-3">There is nothing at this address.</h1>
    <p class="lede mt-4 max-w-xl">The page may have moved, or the link was never published. Everything that exists is reachable from the navigation.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/">Go to the homepage</Button>
      <Button href="/docs/" variant="secondary">Open the docs</Button>
    </div>
  </section>
</Base>
