---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
---
<Base title="Page not found" description="That page does not exist on vekrunapp.com." noindex>
  <section class="container-site py-28">
    <p class="eyebrow">Page not found</p>
    <h1 class="display mt-5">There is nothing at this address.</h1>
    <p class="lede mt-4 max-w-xl">It may have moved. Everything that exists is in the navigation above.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/">Go to the homepage</Button>
      <Button href="/product/" variant="secondary">See the product</Button>
    </div>
  </section>
</Base>
