---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import Steps from '@/components/features/Steps.astro';
import WhereThisStands from '@/components/features/WhereThisStands.astro';
import CloudCallout from '@/components/cloud/CloudCallout.astro';
import InsightsWalkthrough from '@/components/features/InsightsWalkthrough.astro';
import IntegrationLogo from '@/components/catalog/IntegrationLogo.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { getCollection } from 'astro:content';
import { Search, Ticket, ListChecks, Users, ShieldCheck, Activity, ArrowUpRight } from '@lucide/astro';

const providers = (await getCollection('integrations')).filter((i) => i.data.category === 'monitoring' && ['honeybadger', 'sentry', 'datadog', 'appsignal'].includes(i.id));

const steps = [
  { title: 'Connect your monitoring', body: 'Honeybadger, Sentry, Datadog or AppSignal with a read-only token. The provider stays the source of truth.' },
  { title: 'See what is broken', body: 'Errors and slow requests from every provider in one list, with occurrences, a timeline and the stack trace.' },
  { title: 'Investigate & Fix', body: 'A read-only agent reads the trace, the repository and the occurrences, and reports likely causes with its evidence.' },
  { title: 'Choose what happens next', body: 'Create a ticket in your tracker, generate a fix plan, or hand the whole incident to an AI team.' },
  { title: 'Review the fix', body: 'A diff, the tests that ran and a separate check land on your desk. Nothing merges or deploys without you.' },
  { title: 'Check production', body: 'Mark the deploy. Vekrun compares the same window before and after and tells you if it improved, regressed or is inconclusive.' },
];
const controls = [
  { icon: ShieldCheck, title: 'Read-only by default', body: 'Connections only read. Changing an issue on the provider is a separate switch that is off until you turn it on.' },
  { icon: Search, title: 'Nothing sensitive leaves unseen', body: 'Messages, headers, cookies, emails and tokens are redacted when data arrives, and you see what will be sent before an agent sees it.' },
  { icon: Users, title: 'Council for the hard ones', body: 'Investigator, architect, performance, security and challenger roles weigh in on an incident, with the disagreements kept.' },
  { icon: Activity, title: 'Your status stays yours', body: 'A finished fix never marks the provider issue resolved. The investigation has its own stages; only you close it.' },
];
---
<Base title="Insights" description="Connect Honeybadger, Sentry, Datadog or AppSignal, investigate errors and performance problems, and turn findings into tickets or AI-assisted fixes, all from Vekrun.">
  <PageHero eyebrow="Insights" title="From production error" accent="to verified fix." lede="Connect your monitoring tools, investigate errors and performance problems, and turn findings into tickets or AI-assisted fixes, all from Vekrun." cta={{ label: 'See the monitoring providers', href: '/integrations/?category=monitoring' }} secondary={{ label: 'Insights docs', href: '/docs/insights/overview/' }} wide>
    <InsightsWalkthrough />
  </PageHero>

  <section class="section-pad rule bg-bg-elevated" aria-labelledby="flow-title">
    <div class="container-site">
      <SectionHeading id="flow-title" kicker="Problem to fix" title="Six steps. The first three are reading." lede="The last three happen only when you say so." class="reveal" />
      <Steps steps={steps} columns={3} class="reveal-group mt-12" />
    </div>
  </section>

  <section class="section-pad rule" aria-labelledby="providers-title">
    <div class="container-site">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <SectionHeading id="providers-title" kicker="Monitoring providers" title="Your monitoring, not ours." lede="Vekrun does not replace your error tracker or APM. It reads what they already know and turns it into engineering work." class="reveal">
          <a href="/integrations/?category=monitoring" class="group link-slide mt-6 inline-flex items-center gap-1.5 text-[0.9375rem] font-[540] text-accent">All monitoring integrations<ArrowUpRight class="icon-nudge h-4 w-4" aria-hidden="true" /></a>
        </SectionHeading>
        <ul class="reveal-group grid gap-4 sm:grid-cols-2">
          {providers.map((p) => (
            <li class="card card-hover flex gap-4 p-5">
              <IntegrationLogo id={p.id} name={p.data.name} monogram={p.data.monogram} />
              <div class="min-w-0">
                <h3 class="flex flex-wrap items-center gap-2 text-[1rem] font-[580] text-text">{p.data.name}<StatusBadge status={p.data.status} compact /></h3>
                <p class="mt-1 text-[0.9rem] leading-relaxed text-text-2">{p.data.enables}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <p class="mt-6 text-[0.8125rem] text-text-3">New Relic, Bugsnag, Rollbar, Grafana and Elastic are candidates through the same connection layer. Logos are trademarks of their owners and indicate compatibility, not endorsement.</p>
    </div>
  </section>

  <section class="section-pad rule bg-bg-elevated" aria-labelledby="actions-title">
    <div class="container-site">
      <SectionHeading id="actions-title" kicker="Three ways to act" title="Every path starts from the same investigation." lede="And every one ends with something you review." class="reveal" />
      <div class="ruled-grid reveal-group mt-10 md:grid-cols-3">
        <div class="p-6">
          <Ticket class="h-5 w-5 text-accent" aria-hidden="true" />
          <h3 class="mt-4 text-[1.0625rem] font-[580] text-text">Create a ticket</h3>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-text-2">One ticket per issue in Linear, Jira, Asana, GitHub or GitLab, with the investigation attached and a duplicate check first. It lands on your <a href="/features/board/" class="text-accent underline underline-offset-2">Board</a> showing its investigation stage.</p>
        </div>
        <div class="p-6">
          <ListChecks class="h-5 w-5 text-accent" aria-hidden="true" />
          <h3 class="mt-4 text-[1.0625rem] font-[580] text-text">Generate a fix plan</h3>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-text-2">A plan with the issue as context: steps, files and the tests that will prove it. Edit it, approve it, or ask a Council to weigh in first.</p>
        </div>
        <div class="p-6">
          <Users class="h-5 w-5 text-accent" aria-hidden="true" />
          <h3 class="mt-4 text-[1.0625rem] font-[580] text-text">Delegate to Factory</h3>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-text-2">The incident workflow on an <a href="/ai-teams/" class="text-accent underline underline-offset-2">AI team</a>: investigate, reproduce, plan, implement, test, verify, review. You get a reviewable change. Nothing deploys.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad rule" aria-labelledby="control-title">
    <div class="container-site">
      <SectionHeading id="control-title" kicker="What you control" title="Monitoring data is sensitive. Insights treats it that way." class="reveal" />
      <ul class="reveal-group mt-10 grid gap-x-10 gap-y-7 sm:grid-cols-2">
        {controls.map((c) => (
          <li class="flex gap-3.5">
            <c.icon class="mt-0.5 h-5 w-5 shrink-0 text-accent" aria-hidden="true" />
            <div><h3 class="text-[1.0625rem] font-[580] text-text">{c.title}</h3><p class="mt-1 text-[0.9375rem] leading-relaxed text-text-2">{c.body}</p></div>
          </li>
        ))}
      </ul>
      <div class="mt-8"><Button href="/docs/insights/security/" variant="secondary">How monitoring data is handled</Button></div>
    </div>
  </section>

  <CloudCallout class="py-12 sm:py-14" text="Investigations and fix plans shared with the team, and production checks the whole organization can see." />

  <WhereThisStands>Insights, the four provider connections, investigations with structured reports, tickets with a duplicate check, fix plans, the incident workflow on Factory, the incident Council and deployment observation exist in the development build on macOS. The providers are tested against recorded responses and have not yet been run against live accounts, and the hosted sign-in for Honeybadger and AppSignal is not built. Automation is off by default; supervised triage can start an investigation on its own but never creates tickets or changes code without you.</WhereThisStands>
</Base>
