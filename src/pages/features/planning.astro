---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import FeatureHero from '@/components/features/FeatureHero.astro';
import CapabilityGrid, { type Capability } from '@/components/features/CapabilityGrid.astro';
import CouncilMock from '@/components/features/CouncilMock.astro';
import WhereThisStands from '@/components/features/WhereThisStands.astro';

const plan: Capability[] = [
  { title: 'Requirements generation', description: 'A plain-language objective becomes structured requirements with acceptance criteria you can read line by line.', status: 'available' },
  { title: 'Architecture proposals', description: 'Repository-aware technical discovery and proposed decisions, recorded so they can be argued with later.', status: 'in-development', note: 'Plans carry structure for this; the dedicated architecture role is being built.' },
  { title: 'Milestones', description: 'Milestones and workstreams with the order they depend on.', status: 'available' },
  { title: 'Dependencies', description: 'A task graph that rejects cycles and will not start a dependent task early.', status: 'available' },
  { title: 'Acceptance criteria', description: 'Every task carries criteria the independent verifier checks against. Not optional.', status: 'available' },
  { title: 'Factory execution plans', description: 'An approved revision materialises into Factory tasks with traceability back to the plan.', status: 'available' },
  { title: 'Edit before execution', description: 'Change the generated plan in place before approving it.', status: 'in-development', note: 'Revisions are produced and compared; in-place editing is not finished.' },
  { title: 'External synchronisation', description: 'Approved plans and their tasks synchronised with Linear, Jira and Asana.', status: 'planned', note: 'M10.' },
];

const council: Capability[] = [
  { title: 'Multiple AI perspectives', description: 'Configurable members, each with its own role and its own model, from different providers if you like.', status: 'available' },
  { title: 'Independent analysis', description: 'The first round runs in isolation. No member sees another\'s position until it has committed its own.', status: 'available' },
  { title: 'Structured debate', description: 'Critique rounds examine positions, not people. Each member may revise with reasons.', status: 'available' },
  { title: 'Disagreement tracking', description: 'Unresolved disagreements are recorded as such. Consensus is not treated as proof.', status: 'available' },
  { title: 'Decision reports', description: 'A moderator synthesis that separates verified evidence, assumptions, recommendations, uncertainties and open risks.', status: 'available' },
  { title: 'Human approval', description: 'The report ends with your decision, not the council\'s.', status: 'available' },
  { title: 'Evidence from tools', description: 'Members cite read-only tool results from a ledger. Claims without evidence are labelled as claims.', status: 'in-development', note: 'The evidence rule belongs to the verification milestone, M7.' },
  { title: 'Presets and history', description: 'Quick Review, Architecture, Product, Security, Debugging and custom presets; past sessions kept for reference.', status: 'in-development' },
];
---
<Base title="Planning and Council: decide before you build" description="Vekrun Plan turns an objective into requirements, milestones, dependencies and acceptance criteria that become Factory tasks. Vekrun Council convenes several models to analyse independently, debate, record disagreement and report. Both end with your approval.">
  <FeatureHero
    area="Vekrun Plan and Vekrun Council"
    title="A plan you can read. A debate you can inspect."
    lede="Plan produces the structure Factory needs: requirements, milestones, a dependency graph and acceptance criteria. Council is the optional second opinion: several models, different roles, an isolated first round, then critique, then a report that keeps its disagreements."
    status="available"
    statusNote="Plan generation, approval, materialisation and Council orchestration are implemented on macOS."
  />

  <Section id="plan">
    <SectionHeading title="Vekrun Plan" lede="The output is a revision: structured, versioned, diffable against the previous one, and executable only after you approve it." />
    <CapabilityGrid items={plan} class="mt-10" columns={2} />
  </Section>

  <Section id="council" rule tone="elevated">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16 lg:items-start">
      <div>
        <h2 class="heading-2">Vekrun Council</h2>
        <p class="lede mt-4">Optional, and budget-controlled. Convene it for a design decision or a risky change; skip it for routine tasks. Council is never a mandatory step.</p>
        <dl class="mt-8 space-y-4 text-[0.9375rem]">
          <div class="flex gap-4 border-t border-border pt-4"><dt class="w-36 shrink-0 text-text-3">Default size</dt><dd class="text-text">3 members, 2 rounds</dd></div>
          <div class="flex gap-4 border-t border-border pt-4"><dt class="w-36 shrink-0 text-text-3">Before it starts</dt><dd class="text-text">A visible token and time estimate</dd></div>
          <div class="flex gap-4 border-t border-border pt-4"><dt class="w-36 shrink-0 text-text-3">While it runs</dt><dd class="text-text">Enforced limits, timeouts and cancellation</dd></div>
          <div class="flex gap-4 border-t border-border pt-4"><dt class="w-36 shrink-0 text-text-3">Routing</dt><dd class="text-text">Explicit provider per member; privacy-aware</dd></div>
        </dl>
      </div>
      <CouncilMock />
    </div>
    <CapabilityGrid items={council} class="mt-14" columns={2} />
  </Section>

  <Section id="flow" rule>
    <SectionHeading title="From objective to verified delivery" lede="Plan, Council and Factory share one runtime, one permission engine and one audit journal. The sequence below is the one the system is built around." />
    <ol class="mt-10 grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-2 lg:grid-cols-4">
      {[
        ['Define the objective', 'Plain language, or a ticket from the Board.'],
        ['Generate and refine the plan', 'Requirements, milestones, dependencies, criteria. Revise until it reads right.'],
        ['Optionally convene a Council', 'Independent positions, critique, a report with its disagreements intact.'],
        ['Approve execution', 'Your decision closes the planning stage.'],
        ['Create Factory tasks', 'Dependency-aware, each traceable to the approved revision.'],
        ['Assign agents and worktrees', 'Parallel work in isolation under a concurrency cap.'],
        ['Verify independently', 'A different agent, evidence required, bounded repairs.'],
        ['Review and integrate', 'Merge preview, conflicts surfaced, your approval before protected state changes.'],
      ].map(([t, b], i) => (
        <li class="bg-bg p-5">
          <span class="font-mono text-xs text-accent">{i + 1}</span>
          <p class="mt-1 font-[560] text-text">{t}</p>
          <p class="mt-1 text-[0.875rem] text-text-2">{b}</p>
        </li>
      ))}
    </ol>
    <div class="mt-10 flex flex-wrap gap-3">
      <Button href="/factory/" variant="secondary">What happens in Factory</Button>
      <Button href="/features/board/" variant="ghost">Starting from a ticket</Button>
    </div>
  </Section>

  <WhereThisStands milestones="M6 Native Factory orchestration (in progress), M7 council evidence, M10 external sync, M11 UI polish">
    <p>Plan and Council contracts with validation, versioning and property tests are merged. Plan mode produces a validated plan revision that is reviewed and approved with an audit trail, and an approved plan materialises into Factory tasks with intrinsic traceability. Council orchestration runs: isolated first round, critique on positions only, moderator synthesis, limits enforced, your decision recorded.</p>
    <p>Not finished: editing a plan in place, the full preset catalogue, session history views, the evidence-from-ledgers rule (M7), external synchronisation (M10) and the polished Plan and Council workspaces (M11).</p>
  </WhereThisStands>
</Base>
