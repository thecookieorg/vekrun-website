---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import CopyCode from '@/components/CopyCode.astro';
import FeatureHero from '@/components/features/FeatureHero.astro';
import CapabilityGrid, { type Capability } from '@/components/features/CapabilityGrid.astro';
import WhereThisStands from '@/components/features/WhereThisStands.astro';

const capabilities: Capability[] = [
  { title: 'Vekrun Control Plane', description: 'Task and team records, queues, a fourteen-state machine, leases, deadlines, approvals, policies, worker registry, event journal, budgets and audit, in one Rust crate.', status: 'available', note: 'Contracts and the store exist and run in-process. The durable daemon is M8.' },
  { title: 'Native Rust agent runtime', description: 'The model and tool loop, instructions, scoped memory, context, planning, delegation, typed inputs and outputs, retries and cancellation.', status: 'available' },
  { title: 'Durable tasks', description: 'Every transition is a journal row written in the same transaction. The journal is append-only at the database; triggers reject updates and deletes.', status: 'available', note: 'Durability across a daemon restart without unsafe replay is the M8 gate.' },
  { title: 'Background execution', description: 'Jobs that outlive the window, in a local daemon or on a remote host. Vekrun states what survives window close, sleep, reboot and network loss.', status: 'planned', note: 'M8.' },
  { title: 'Scheduling', description: 'One-time, recurring and cron-compatible schedules with time zones, event triggers, standing orders and a missed-run policy.', status: 'planned', note: 'M9.' },
  { title: 'Agent memory', description: 'User, project, team, agent, task and council scopes with enforced access, provenance, edit and delete, and retention.', status: 'available' },
  { title: 'Model routing', description: 'Explicit, quality, latency, cost, balanced and custom profiles; capability gating; fallbacks only when policy allows; a usage ledger.', status: 'available', note: 'Baseline. Model pools and cost dashboards are M9.' },
  { title: 'Remote workers', description: 'First-party Rust workers on an SSH-reachable machine you own: registration, leases, heartbeats, streamed logs, reconnect and reconciliation.', status: 'planned', note: 'M8. SSH port-forward to a localhost-bound worker by default; TLS opt-in with a pinned certificate.' },
  { title: 'Agent APIs', description: 'Define deployable agents with typed input and output, capabilities, tools and policies. Invoke them over authenticated, versioned APIs.', status: 'planned', note: 'M8. Private bind by default; external exposure needs explicit configuration, authentication and TLS.' },
  { title: 'Native MCP support', description: 'Remote (Streamable HTTP) and local (stdio) MCP servers as a client, through the policy engine, and a Vekrun MCP server that is off by default.', status: 'planned', note: 'M10.' },
  { title: 'Headless CLI', description: 'The vekrun CLI drives the same store, state machine and policy engine as the desktop app. No shadow implementation.', status: 'available' },
  { title: 'Self-hosting', description: 'Run the control plane and workers on your own machines. No Vekrun cloud exists to depend on.', status: 'planned', note: 'M8. The desktop-only and desktop-plus-local-worker modes need nothing hosted.' },
];

const modes = [
  ['Desktop-only terminal', 'desktop + core, in process', 'No AI jobs exist'],
  ['Desktop + local worker', 'desktop + a local Rust daemon', 'Yes, in the daemon'],
  ['Desktop managing remote workers', 'desktop + control plane and workers on your host', 'Yes, on the remote host'],
  ['Headless', 'CLI + daemon, no desktop', 'Yes'],
];
---
<Base title="Agent platform: a control plane you can run yourself" description="Underneath Vekrun is a Rust control plane with one state machine per task, a deny-by-default policy engine, scoped memory, model routing, and a headless CLI. Remote workers, agent APIs and MCP are on the roadmap. Nothing requires a hosted service.">
  <FeatureHero
    area="Agent platform"
    title="The runtime under the workspace, built to be self-hosted."
    lede="Everything the desktop app does goes through a Rust control plane: typed tasks, explicit state transitions, leases, a policy decision and an audit row for every side effect. The same crates power the headless CLI today and will power remote workers and agent APIs."
    status="in-development"
    statusNote="Contracts, runtime, memory, routing and the CLI are implemented; the daemon, workers, APIs and MCP are not."
  />

  <Section id="invariants">
    <SectionHeading title="Invariants" lede="Rules the architecture enforces, not guidelines it hopes for. Each one has tests behind it." />
    <ol class="mt-10 ruled-grid sm:grid-cols-2">
      {[
        ['One state machine owns each task.', 'Workers execute leased work and report events; the control plane resolves state. The legal transitions are a single table in one crate.'],
        ['Deny is the default.', 'Every capability is denied until a policy allows it, and every decision writes an audit event. There is no model-controlled permission escalation.'],
        ['Secrets never cross into the webview.', 'Credentials live in the OS keychain, are redacted from logs and UI, and are not injected into tools or remote hosts by default.'],
        ['The terminal path has no AI on it.', 'Opening a shell never depends on a model, a network or a daemon.'],
        ['Nothing is replayed blindly.', 'A lost lease returns the task to the queue. Non-idempotent shell actions are reconciled under a documented per-tool policy, never re-run on faith.'],
        ['Rust decides; the UI renders.', 'No authorisation, scheduling, state transition or filesystem change originates in TypeScript. The IPC types are generated from the Rust definitions.'],
      ].map(([t, b]) => (
        <li class="p-6">
          <p class="font-[580] text-text">{t}</p>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-text-2">{b}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="deployment-modes" rule tone="elevated">
    <SectionHeading title="Four deployment modes" lede="Which processes run, and whether a job survives closing the window. Vekrun never claims execution on a powered-off machine." />
    <div class="mt-10 overflow-x-auto">
      <table class="w-full min-w-[40rem] border-collapse text-left text-[0.9375rem]">
        <thead>
          <tr class="border-b border-border text-sm text-text-3">
            <th scope="col" class="py-3 pr-6 font-[520]">Mode</th>
            <th scope="col" class="py-3 pr-6 font-[520]">What runs</th>
            <th scope="col" class="py-3 font-[520]">Jobs survive window close?</th>
          </tr>
        </thead>
        <tbody>
          {modes.map(([m, r, s]) => (
            <tr class="border-b border-border">
              <th scope="row" class="py-3.5 pr-6 font-[560] text-text">{m}</th>
              <td class="py-3.5 pr-6 text-text-2">{r}</td>
              <td class="py-3.5 text-text-2">{s}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-text-3">Only the first mode exists in full today. The daemon that makes the second and fourth real, and the remote workers of the third, are the M8 milestone.</p>
  </Section>

  <Section id="capabilities" rule>
    <SectionHeading title="What the platform provides" lede="Each capability says whether it exists in the current source today." />
    <CapabilityGrid items={capabilities} class="mt-10" />
  </Section>

  <Section id="components" rule tone="elevated">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.3fr] lg:gap-16">
      <div>
        <h2 class="heading-2">Nine components, one crate each</h2>
        <p class="lede mt-4">Each crate states in its own documentation what it implements and what it does not. An absent module cannot be mistaken for a working one.</p>
        <div class="mt-8 space-y-3">
          <p class="text-sm text-text-3">The CLI exercises the same crates headlessly:</p>
          <CopyCode code="cargo run -p vekrun-cli -- version" />
        </div>
      </div>
      <dl class="ruled-grid sm:grid-cols-2 text-[0.9rem]">
        {[
          ['vekrun-core', 'Project and workspace, PTY, files, Git, search, credentials, the policy engine, settings, SQLite'],
          ['vekrun-control-plane', 'Task and team records, queues, state machine, leases, approvals, scheduling, registry, journal, budgets, audit'],
          ['vekrun-agent-runtime', 'Model and tool loop, instructions, scoped memory, context, planning, delegation, typed I/O'],
          ['vekrun-orchestrator', 'Task DAG execution, manager and worker hierarchy, allocation, integration, independent verification'],
          ['vekrun-worker', 'Local or remote execution, heartbeat, claiming, sandbox integration, reporting, limits, recovery'],
          ['vekrun-provider-gateway', 'Model capabilities, routing, streaming adapters, quotas, cost, fallbacks'],
          ['vekrun-agent-api', 'Service registration, authenticated invocation, deployment lifecycle, versioned interfaces'],
          ['vekrun-extension-host', 'Versioned permissions, UI contributions, tools, workflows, connectors, MCP'],
        ].map(([c, d]) => (
          <div class="p-4"><dt class="font-mono text-[0.8125rem] text-text">{c}</dt><dd class="mt-1 text-text-2">{d}</dd></div>
        ))}
      </dl>
    </div>
    <div class="mt-10 flex flex-wrap gap-3">
      <Button href="/docs/contributing/architecture/" variant="secondary">Architecture documentation</Button>
      <Button href="/open-source/" variant="ghost">Why it is open source</Button>
    </div>
  </Section>

  <WhereThisStands milestones="M1 foundation (gate open on polish items), M8 control plane and workers, M9 routing and scheduling, M10 MCP and extensions">
    <p>The task contracts, the fourteen-state machine, leases, the append-only audit journal and the deny-by-default policy engine are merged with property tests. The agent runtime, scoped memory, the routing baseline with budgets and a usage ledger, and the headless CLI are merged. All of it runs in the desktop process on macOS today.</p>
    <p>Not built yet: the durable daemon, remote workers, service registry and agent APIs (M8), the scheduler and model pools (M9), and MCP client and server plus the extension host (M10). Self-hosting becomes meaningful with M8.</p>
  </WhereThisStands>
</Base>
