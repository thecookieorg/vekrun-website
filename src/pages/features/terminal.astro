---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FeatureHero from '@/components/features/FeatureHero.astro';
import TerminalMock from '@/components/features/TerminalMock.astro';
import Controls from '@/components/features/Controls.astro';
import WhereThisStands from '@/components/features/WhereThisStands.astro';

const doing = [
  { title: 'Tabs and splits', body: 'Open a tab per project and split a pane for logs or tests. ⌘D splits right, ⌘⇧D splits down. Layouts come back after a restart.' },
  { title: 'Search your scrollback', body: '⌘F finds that error from ten minutes ago, across the whole scrollback.' },
  { title: 'Know what happened', body: 'Every command shows its exit code and how long it took. Failed commands are marked in the gutter so you can jump back to them.' },
  { title: 'SSH that stays put', body: 'Open a tab on a remote machine. Host keys are checked and shown before you connect; passwords are asked once.' },
  { title: 'Your shell, your fonts, your theme', body: 'Bash, Zsh, Fish, PowerShell or WSL. Font, cursor, scrollback and theme are settings, applied live, in dark or light.' },
  { title: 'Links that tell you where they go', body: 'A URL in output opens only after you see the real address. Nothing writes to your clipboard silently.' },
];
const controls = [
  { title: 'Everything works without AI', body: 'The terminal never waits on a model. Connect one when you want help, or never.' },
  { title: 'Ask about what is on screen', body: 'Select output and send it to an agent to explain an error or suggest a fix. Nothing leaves your machine until you say so.' },
  { title: 'Keyboard first', body: 'Tabs, splits, search and the command palette all have shortcuts you can change.' },
  { title: 'Runs on macOS, Windows and Linux', body: 'One app on all three. Today only macOS has been used by hand.' },
];
---
<Base title="Terminal" description="A modern terminal for everyday development: tabs, splits, SSH, search, session restore and themes. Works with or without AI.">
  <FeatureHero area="Terminal" title="A terminal you can live in." lede="Tabs, splits, SSH and search, with the small things done right: exit codes you can see, sessions that survive a restart, and links that show where they go." />

  <Section>
    <TerminalMock />
  </Section>

  <Section rule tone="elevated">
    <SectionHeading title="What you can do" />
    <ul class="mt-10 grid gap-x-10 gap-y-7 sm:grid-cols-2 lg:grid-cols-3">
      {doing.map((d) => (
        <li class="border-t border-border pt-4">
          <h3 class="text-[1rem] font-[580] text-text">{d.title}</h3>
          <p class="mt-1.5 text-[0.9rem] leading-relaxed text-text-2">{d.body}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section rule>
    <SectionHeading title="What you control" />
    <Controls items={controls} class="mt-10" />
  </Section>

  <WhereThisStands>Tabs, splits, search, session restore, SSH and settings work in the development build on macOS. Remote file editing and transfers are planned.</WhereThisStands>
</Base>
