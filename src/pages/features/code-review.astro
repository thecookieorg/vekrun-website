---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FeatureHero from '@/components/features/FeatureHero.astro';
import ReviewInboxMock from '@/components/features/ReviewInboxMock.astro';
import Steps from '@/components/features/Steps.astro';
import Controls from '@/components/features/Controls.astro';
import WhereThisStands from '@/components/features/WhereThisStands.astro';

const steps = [
  { title: 'See what is waiting', body: 'Pull requests requested from you, your teammates\' open changes, and your own, in one list.' },
  { title: 'Ask AI for problems', body: 'Get findings with file and line: correctness, security, missing tests. Each one has the evidence next to it.' },
  { title: 'Compare opinions', body: 'For a contested change, ask several models and see where they disagree.' },
  { title: 'Send your feedback', body: 'Accept a finding as a suggestion, dismiss it, or write your own comment. It lands on the pull request.' },
];
const controls = [
  { title: 'You are the reviewer', body: 'AI proposes; nothing is posted to a pull request until you choose to post it.' },
  { title: 'Your models', body: 'Reviews run on the providers or local models you already connected. There is no separate review service.' },
  { title: 'Findings you can check', body: 'Every finding points at lines in the diff. No finding without evidence.' },
  { title: 'GitHub and GitLab', body: 'Requests, comments and approvals stay in sync with the pull request on your host.' },
];
---
<Base title="Code reviews" description="Pull requests awaiting your review, your teammates' changes, AI findings with evidence, and your feedback, all in one place inside Vekrun.">
  <FeatureHero area="Code reviews" title="Reviews in one place." lede="See the pull requests waiting on you, ask AI what it would flag, compare answers from more than one model, and send your feedback without leaving Vekrun." />

  <Section>
    <ReviewInboxMock />
  </Section>

  <Section rule tone="elevated">
    <SectionHeading title="How a review goes" />
    <Steps steps={steps} columns={4} class="mt-10" />
  </Section>

  <Section rule>
    <SectionHeading title="What you control" />
    <Controls items={controls} class="mt-10" />
  </Section>

  <WhereThisStands>AI review of a local branch or diff, and comparing findings across models, work in the development build on macOS. The pull-request inbox and GitHub and GitLab sync are planned.</WhereThisStands>
</Base>
