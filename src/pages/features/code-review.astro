---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import FeatureHero from '@/components/features/FeatureHero.astro';
import ReviewDemo from '@/components/home/ReviewDemo.astro';
import Steps from '@/components/features/Steps.astro';
import WhereThisStands from '@/components/features/WhereThisStands.astro';
import CloudCallout from '@/components/cloud/CloudCallout.astro';
import { Inbox, ScanSearch, Users, CheckCircle2 } from '@lucide/astro';

const intended: { text: string; status: 'available' | 'planned' }[] = [
  { text: 'See GitHub pull requests that request your review, are assigned to you, or you opened.', status: 'planned' },
  { text: 'See GitLab merge requests the same way.', status: 'planned' },
  { text: 'Open a colleague’s change and read the diff, the linked issue and the CI result in one view.', status: 'planned' },
  { text: 'Ask AI to inspect the pull request at its exact head commit.', status: 'planned' },
  { text: 'Compare independent findings from several models with a review council.', status: 'available' },
  { text: 'Add inline comments, editing or dismissing AI findings before anything is published.', status: 'planned' },
  { text: 'Approve or request changes.', status: 'planned' },
  { text: 'Submit the review through GitHub or GitLab as yourself. No hosted bot, no mandatory GitHub App.', status: 'planned' },
];

const benefits = [
  { icon: Inbox, title: 'One inbox', body: 'Pull requests requested from you and the ones your teammates opened, in one list next to the code.' },
  { icon: ScanSearch, title: 'AI goes first', body: 'Ask a model to look for security and correctness problems before you read a line. Findings point at file and line.' },
  { icon: Users, title: 'Compare models', body: 'On a contested change, run a review council and see where Claude, Gemini and a local model agree and disagree.' },
  { icon: CheckCircle2, title: 'You decide', body: 'Accept or dismiss each finding, leave your comments, approve. Nothing is posted or merged on your behalf.' },
];
const workflow = [
  { title: 'Open the request', body: 'The diff, the ticket it came from and the test results, in one view.' },
  { title: 'Read the findings', body: 'AI findings are suggestions with a location. Each one can be accepted into a comment or dismissed.' },
  { title: 'Comment and approve', body: 'Your comments go to GitHub or GitLab as yours. Approval is a button you press.' },
];
---
<Base title="Code reviews" description="Pull requests waiting for you, the diff, AI findings and your comments in one place. Compare findings from several models when it matters, and approve without leaving your workspace.">
  <FeatureHero area="Code reviews" title="Review where" accent="you write code." lede="Pull requests waiting for you, the diff, AI findings and your comments, side by side. Compare several models when a change is contested. You approve." cta={{ label: 'How AI Teams verify work', href: '/ai-teams/' }} secondary={{ label: 'Review docs', href: '/docs/git/ai-reviews/' }} />

  <Section class="ambient ambient-low overflow-x-clip">
    <div class="reveal"><ReviewDemo /></div>
  </Section>

  <Section rule tone="elevated" aria-labelledby="why-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <SectionHeading id="why-title" title="Faster reviews, fewer tabs" lede="Reviewing a teammate’s change should not mean leaving the place you understand the code best." class="reveal">
        <p class="mt-5 flex items-center gap-2 text-[0.8125rem] text-text-3"><StatusBadge status="planned" compact /> Review Inbox and GitHub/GitLab submission: high priority.</p>
      </SectionHeading>
      <ul class="reveal-group grid gap-x-8 gap-y-7 sm:grid-cols-2">
        {benefits.map((b) => (
          <li class="flex gap-3.5">
            <b.icon class="mt-0.5 h-5 w-5 shrink-0 text-accent" aria-hidden="true" />
            <div><h3 class="text-[1.0625rem] font-[560] text-text">{b.title}</h3><p class="mt-1 text-[0.9375rem] leading-relaxed text-text-2">{b.body}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section rule aria-labelledby="intended-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <SectionHeading id="intended-title" title="What reviewing in Vekrun will look like" lede="The Review Inbox is the next high-priority piece of Code reviews. AI review of local branches and review councils already work; the inbox and provider submission are being built on top of them." class="reveal" />
      <ol class="reveal-group divide-y divide-border border-y border-border" aria-label="Intended review capabilities">
        {intended.map((i) => (
          <li class="flex items-start justify-between gap-4 py-3">
            <span class="text-[0.9375rem] text-text-2">{i.text}</span>
            <StatusBadge status={i.status} compact class="shrink-0" />
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <Section rule tone="elevated" aria-labelledby="flow-title">
    <SectionHeading id="flow-title" title="A review, start to finish" class="reveal" />
    <Steps steps={workflow} columns={3} class="reveal-group mt-10" />
    <div class="mt-10 reveal"><Button href="/features/board/" variant="secondary">Where the pull request came from: the Board</Button></div>
  </Section>

  <CloudCallout class="pb-12 sm:pb-14" text="Review requests routed to the right teammate, with AI findings beside the diff and project status updated when it merges." />

  <WhereThisStands>AI review of local branches and diffs, and review councils across several models, work in the development build on macOS. The Review Inbox for GitHub pull requests and GitLab merge requests, Review with AI on a pull request, inline comments and submitting a verdict through the provider are planned and high priority; none has started in source. GitHub and GitLab stay the source of truth for submitted reviews.</WhereThisStands>
</Base>
