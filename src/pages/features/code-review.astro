---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import ReviewInbox from '@/components/features/ReviewInbox.astro';
import Steps from '@/components/features/Steps.astro';
import { Inbox, ScanSearch, Users, CheckCircle2 } from '@lucide/astro';

const intended: string[] = [
  'See GitHub pull requests that request your review, are assigned to you, or you opened.',
  'See GitLab merge requests the same way.',
  'Open a colleague’s change and read the diff, the linked issue and the CI result in one view.',
  'Ask AI to inspect the pull request at its exact head commit.',
  'Compare independent findings from several models with a review council.',
  'Add inline comments, editing or dismissing AI findings before anything is published.',
  'Approve or request changes.',
  'Submit the review through GitHub or GitLab as yourself. No hosted bot, no mandatory GitHub App.',
];
const benefits = [
  { icon: Inbox, title: 'One inbox', body: 'Pull requests requested from you and the ones your teammates opened, in one list next to the code.' },
  { icon: ScanSearch, title: 'AI goes first', body: 'Ask a model to look for security and correctness problems before you read a line. Findings point at file and line.' },
  { icon: Users, title: 'Compare models', body: 'On a contested change, run a review council and see where Claude, Gemini and a local model agree and disagree.' },
  { icon: CheckCircle2, title: 'You decide', body: 'Accept or dismiss each finding, leave your comments, approve. Nothing is posted or merged on your behalf.' },
];
const workflow = [
  { title: 'Open the request', body: 'The diff, the ticket it came from and the test results, in one view.' },
  { title: 'Read the findings', body: 'AI findings are suggestions with a location. Each one can be accepted into a comment or dismissed.' },
  { title: 'Comment and approve', body: 'Your comments go to GitHub or GitLab as yours. Approval is a button you press.' },
];
---
<Base title="Code review" fullTitle="Code review: pull requests, findings and your verdict · Vekrun" description="An advanced tool in Vekrun: pull requests waiting for you, the diff, AI findings and your comments in one place, with findings from several models when a change is contested.">
  <PageHero eyebrow="Advanced tools · Code review" title="Review with the evidence" accent="beside the diff." lede="Pull requests waiting for you, the diff, AI findings and your comments, side by side. Factory pull requests arrive with their Proof Pack. You decide." cta={{ label: 'How verification works', href: '/features/verification/' }} secondary={{ label: 'Review docs', href: '/docs/git/ai-reviews/' }} wide>
    <ReviewInbox />
  </PageHero>

  <section class="section-pad rule bg-bg-elevated" aria-labelledby="why-title">
    <div class="container-site">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
        <SectionHeading id="why-title" kicker="Review Inbox" title="Faster reviews, fewer tabs." lede="Reviewing a teammate’s change should not mean leaving the place you understand the code best." class="reveal">
        </SectionHeading>
        <ul class="reveal-group grid gap-x-8 gap-y-7 sm:grid-cols-2">
          {benefits.map((b) => (
            <li class="flex gap-3.5">
              <b.icon class="mt-0.5 h-5 w-5 shrink-0 text-accent" aria-hidden="true" />
              <div><h3 class="text-[1.0625rem] font-[580] text-text">{b.title}</h3><p class="mt-1 text-[0.9375rem] leading-relaxed text-text-2">{b.body}</p></div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section-pad rule" aria-labelledby="intended-title">
    <div class="container-site">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
        <SectionHeading id="intended-title" kicker="Everything in one place" title="What reviewing in Vekrun looks like." lede="From the request to your submitted review, without leaving the place you understand the code best." class="reveal" />
        <ol class="reveal-group divide-y divide-border border-y border-border" aria-label="Review capabilities">
          {intended.map((i) => (
            <li class="py-3 text-[0.9375rem] text-text-2">{i}</li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section-pad rule bg-bg-elevated" aria-labelledby="flow-title">
    <div class="container-site">
      <SectionHeading id="flow-title" kicker="In order" title="A review, start to finish." class="reveal" />
      <Steps steps={workflow} columns={3} class="reveal-group mt-12" />
      <div class="mt-12 reveal"><Button href="/features/board/" variant="secondary">Where the pull request came from: the Board</Button></div>
    </div>
  </section>


</Base>
