---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import { featurePages, site } from '@/data/site';
import { ArrowUpRight } from '@lucide/astro';

const stories: Record<string, string> = {
  terminal: 'Tabs, splits, SSH, search and session restore. A terminal you can live in all day, with or without AI.',
  'ai-coding': 'Connect Claude, OpenAI, Gemini or a local model. Ask questions, plan, build and debug with every change shown before it lands.',
  board: 'Your assigned tickets in one Kanban. Pick one, click Start Work, and you have a branch, a terminal and, if you want, an agent.',
  'ai-teams': 'Hand bigger work to a team: one agent plans, others build and test on their own branches, a separate one checks the result.',
  'code-review': 'Pull requests waiting on you, your teammates\' changes, and AI findings you can accept or dismiss, in one place.',
};
---
<Base title="Features" description="Vekrun in five parts: a terminal, AI coding with your own models, a Board for your tickets, AI Teams for larger work, and code reviews in one place.">
  <Section padded="tight" class="pt-16 sm:pt-20">
    <SectionHeading level="h1" title="Five things Vekrun does" lede="Each works on its own. Together they take a ticket from assigned to merged without leaving the terminal." />
  </Section>
  <Section padded="none" class="pb-20 sm:pb-24">
    <ol class="divide-y divide-border border-y border-border">
      {featurePages.map((f) => (
        <li>
          <a href={f.href} class="group grid gap-3 py-7 sm:grid-cols-[14rem_1fr_auto] sm:items-baseline sm:gap-8">
            <h2 class="heading-3 text-text">{f.label}</h2>
            <p class="text-[1rem] leading-relaxed text-text-2 measure-wide">{stories[f.key]}</p>
            <ArrowUpRight class="hidden h-5 w-5 text-text-3 transition-colors group-hover:text-accent sm:block" aria-hidden="true" />
          </a>
        </li>
      ))}
    </ol>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <Button href="/integrations/" variant="secondary">Browse integrations</Button>
      <p class="text-[0.875rem] text-text-3">{site.status.line} <a href="/roadmap/" class="underline underline-offset-2 hover:text-text">See the roadmap.</a></p>
    </div>
  </Section>
</Base>
