---
/**
 * The capability overview. The Factory leads; the experiences around it follow
 * in the order a job uses them; advanced tools sit at the end, secondary.
 */
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import { advancedPages } from '@/data/site';
import { Factory, SquareKanban, Inbox, Box, ShieldCheck, Library, Plug, Smartphone, ArrowUpRight } from '@lucide/astro';

const items: { icon: typeof Factory; title: string; body: string; href: string }[] = [
  { icon: SquareKanban, title: 'Board', body: 'Tickets, pull requests and production incidents across repositories, each one a Factory job away from a verified fix.', href: '/features/board/' },
  { icon: Inbox, title: 'Inbox', body: 'Only the decisions that need a person: approvals, questions, reviews, exceptions and blocks.', href: '/features/inbox/' },
  { icon: Box, title: 'Isolated environments', body: 'One environment per Work Item, started from a verified recipe for Docker, native and hybrid projects.', href: '/features/factory/#env-title' },
  { icon: ShieldCheck, title: 'Verification and Proof Packs', body: 'Executable checks, browser runs and an independent verifier, attached to the pull request.', href: '/features/verification/' },
  { icon: Library, title: 'Engineering Memory and Insights', body: 'A searchable record of every decision, and delivery reporting from verifiable work.', href: '/features/engineering-memory/' },
  { icon: Plug, title: 'Connections', body: 'Coding CLIs, models, OpenRouter, trackers, monitoring and CI, discovered and kept current.', href: '/integrations/#connections' },
  { icon: Smartphone, title: 'Mobile and Host', body: 'Assign and approve from your phone, with a Host that stays reachable while it runs.', href: '/features/mobile/' },
];
---
<Base title="Product" fullTitle="Product: the AI Factory and everything around it · Vekrun" description="Vekrun's capabilities: the AI Factory, Board, Inbox, isolated environments, verification and Proof Packs, Engineering Memory and Insights, Connections and Mobile.">
  <PageHero eyebrow="Product" title="One Factory." accent="Everything a job needs around it." lede="Vekrun coordinates engineering work end to end. The Factory runs the jobs; the Board, Inbox, verification and memory make the results trustworthy and the work visible." align="left" />

  <section class="section-pad" aria-labelledby="factory-title">
    <div class="container-site">
      <a href="/features/factory/" class="lead card card-hover group reveal">
        <span class="lead-i"><Factory class="h-6 w-6" aria-hidden="true" /></span>
        <div>
          <p class="kicker">The core</p>
          <h2 id="factory-title" class="heading-2 mt-2 text-text">AI Factory</h2>
          <p class="lede mt-3 max-w-2xl">Describe the outcome. The Coordinator plans it, runs it with your signed-in coding agents in its own environment, verifies it and opens the pull request with the evidence, across several projects at once.</p>
          <p class="mt-5 flex flex-wrap items-center gap-3"><span class="inline-flex items-center gap-1.5 text-[0.9375rem] font-[540] text-accent">Explore the AI Factory<ArrowUpRight class="icon-nudge h-4 w-4" aria-hidden="true" /></span></p>
        </div>
      </a>

      <ul class="caps reveal-group" aria-label="Capabilities">
        {items.map((it) => (
          <li>
            <a href={it.href} class="cap group">
              <it.icon class="h-5 w-5 text-accent" aria-hidden="true" />
              <h3 class="cap-t">{it.title}<ArrowUpRight class="icon-nudge h-3.5 w-3.5 text-text-3" aria-hidden="true" /></h3>
              <p class="cap-d">{it.body}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-pad rule bg-bg-elevated" aria-labelledby="adv-title">
    <div class="container-site">
      <SectionHeading id="adv-title" kicker="Advanced tools" title="For troubleshooting and taking over." lede="A capable terminal, SSH, a code and diff view and review tools stay one click away when you want to step into a job yourself. Vekrun is not trying to replace your editor or your coding agent." class="reveal" />
      <ul class="ruled-grid reveal-group mt-10 sm:grid-cols-3" aria-label="Advanced tools">
        {advancedPages.map((a) => <li class="p-6"><a href={a.href} class="group block"><h3 class="heading-3 inline-flex items-center gap-1.5 text-text">{a.label}<ArrowUpRight class="icon-nudge h-3.5 w-3.5 text-text-3" aria-hidden="true" /></h3><p class="mt-2 text-[0.9375rem] leading-relaxed text-text-2">{a.description}</p></a></li>)}
      </ul>
      <div class="mt-10 reveal"><Button href="/how-it-works/" variant="secondary">See how it all works together</Button></div>
    </div>
  </section>
</Base>

<style>
  .lead { display: grid; gap: 1.25rem; padding: 2rem; }
  @media (min-width: 48rem) { .lead { grid-template-columns: auto 1fr; gap: 1.75rem; padding: 2.5rem; } }
  .lead { background: linear-gradient(140deg, color-mix(in srgb, var(--accent) 8%, var(--surface)), var(--surface) 55%); }
  .lead-i { display: inline-flex; align-items: center; justify-content: center; width: 3rem; height: 3rem; border-radius: 12px; border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border)); color: var(--accent); background: var(--bg); }
  .caps { margin: 1.5rem 0 0; padding: 0; list-style: none; display: grid; gap: 1px; border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--border); }
  @media (min-width: 40rem) { .caps { grid-template-columns: repeat(2, minmax(0, 1fr)); } .caps li:last-child { grid-column: span 2; } }
  @media (min-width: 64rem) { .caps { grid-template-columns: repeat(3, minmax(0, 1fr)); } .caps li:last-child { grid-column: span 3; } }
  .cap { display: flex; flex-direction: column; height: 100%; gap: 0.5rem; padding: 1.5rem; background: var(--surface); transition: background-color var(--dur-fast); }
  .cap:hover { background: var(--surface-2); }
  .cap-t { margin: 0.4rem 0 0; display: inline-flex; align-items: center; gap: 0.35rem; font-size: 1.05rem; font-weight: 580; color: var(--text); }
  .cap-d { margin: 0; font-size: 0.9rem; line-height: 1.55; color: var(--text-2); }
  .cap-d { flex: 1; }
</style>
