---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import FeatureHero from '@/components/features/FeatureHero.astro';
import AgentChatDemo from '@/components/features/AgentChatDemo.astro';
import ProviderSwitcher from '@/components/home/ProviderSwitcher.astro';
import Steps from '@/components/features/Steps.astro';
import WhereThisStands from '@/components/features/WhereThisStands.astro';

const modes = [
  { name: 'Ask', body: 'Read-only. Questions about the code, the repository and your terminal output.' },
  { name: 'Plan', body: 'Investigate and propose a plan you can edit before anything runs.' },
  { name: 'Build', body: 'Create and change files. Every write is a diff you approve.' },
  { name: 'Debug', body: 'Reproduce, read the failure, propose the fix, run the test you allow.' },
  { name: 'Review', body: 'Read a branch or a diff and report problems. Nothing is changed.' },
];
const workflow = [
  { title: 'Pick a model', body: 'Your Anthropic, OpenAI or Google key, any OpenAI-compatible endpoint, or Ollama and LM Studio on your machine.' },
  { title: 'Ask in the project', body: 'The agent sees the files, the Git state and the terminal output you choose to share.' },
  { title: 'Approve the change', body: 'Changes arrive as diffs. Commands wait for your yes unless you allowed them.' },
  { title: 'Keep what matters', body: 'Conversations are saved, searchable and forkable. Memory is scoped to you, the project or a task, and you can delete it.' },
];
---
<Base title="AI coding" description="Code with Claude, OpenAI, Gemini or a local model inside your terminal. Five modes, every change shown as a diff before it lands, commands only when you allow them, and you see what is sent before it is sent.">
  <FeatureHero area="AI coding" title="Any model." accent="Every change approved." lede="Connect the provider you already pay for, or a model on your machine. Ask, plan, build, debug and review in the project, with every write shown as a diff and every command waiting for your yes." cta={{ label: 'Supported providers', href: '/integrations/?category=ai-models' }} secondary={{ label: 'AI coding docs', href: '/docs/ai-coding/coding-sessions/' }} />

  <Section class="ambient overflow-x-clip">
    <div class="reveal"><AgentChatDemo /></div>
  </Section>

  <Section rule tone="elevated" aria-labelledby="modes-title">
    <SectionHeading id="modes-title" title="Five modes, five sets of permissions" lede="Switching mode changes what the agent is allowed to do, not just how it answers." class="reveal" />
    <ol class="reveal-group mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5" aria-label="Agent modes">
      {modes.map((m) => (
        <li class="card p-5"><h3 class="text-[1.0625rem] font-[560] text-text">{m.name}</h3><p class="mt-1.5 text-[0.9rem] leading-relaxed text-text-2">{m.body}</p></li>
      ))}
    </ol>
  </Section>

  <Section rule aria-labelledby="byo-title">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <SectionHeading id="byo-title" title="Switch models per task" lede="A strong hosted model for the hard change, a local model for the summary. Keys stay in your OS keychain, and you see what will be sent before it goes." class="reveal">
        <p class="mt-5 text-[0.9rem] text-text-3">Hosted providers bill you at their own rates. Local models are free to run.</p>
        <p class="mt-4 flex items-center gap-2 text-[0.8125rem] text-text-3"><StatusBadge status="planned" compact /> Signing in with a coding-agent subscription you already have.</p>
      </SectionHeading>
      <div class="reveal"><ProviderSwitcher /></div>
    </div>
  </Section>

  <Section rule tone="elevated" aria-labelledby="flow-title">
    <SectionHeading id="flow-title" title="From question to approved change" class="reveal" />
    <Steps steps={workflow} columns={4} class="reveal-group mt-10" />
    <div class="mt-10 reveal"><Button href="/ai-teams/" variant="secondary">When one agent is not enough: AI Teams</Button></div>
  </Section>

  <WhereThisStands>Anthropic, OpenAI, Gemini and OpenAI-compatible keys, Ollama and LM Studio, the five modes, diff approvals, allowed commands, the egress preview and scoped memory work in the development build on macOS. Downloading local models from inside Vekrun and coding-agent subscriptions are planned.</WhereThisStands>
</Base>
