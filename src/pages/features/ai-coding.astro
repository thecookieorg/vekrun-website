---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import CodingStudio from '@/components/features/CodingStudio.astro';
import Steps from '@/components/features/Steps.astro';
import CapabilityStatus from '@/components/CapabilityStatus.astro';

const modes = [
  { name: 'Ask', body: 'Read-only. Questions about the code, the repository and your terminal output.' },
  { name: 'Plan', body: 'Investigate and propose a plan you can edit before anything runs.' },
  { name: 'Build', body: 'Create and change files. Every write is a diff you approve.' },
  { name: 'Debug', body: 'Reproduce, read the failure, propose the fix, run the test you allow.' },
  { name: 'Review', body: 'Read a branch or a diff and report problems. Nothing is changed.' },
];
const workflow = [
  { title: 'Pick a model', body: 'Your Anthropic, OpenAI or Google key, any OpenAI-compatible endpoint, or Ollama and LM Studio on your machine.' },
  { title: 'Ask in the project', body: 'The agent sees the files, the Git state and the terminal output you choose to share.' },
  { title: 'Approve the change', body: 'Changes arrive as diffs. Commands wait for your yes unless you allowed them.' },
  { title: 'Keep what matters', body: 'Conversations are saved, searchable and forkable. Memory is scoped to you, the project or a task, and you can delete it.' },
];
---
<Base title="Coding sessions" fullTitle="Coding sessions: work directly with a model · Vekrun" description="An advanced tool in Vekrun: work directly with Claude, OpenAI, Gemini or a local model in a project, with every change shown as a diff first, commands only when you allow them, and a preview of what is sent.">
  <PageHero eyebrow="Advanced tools · Coding sessions" title="Work with a model directly." accent="Every change approved." lede="Most work goes through the Factory. When you want a hands-on session, ask, plan, build, debug and review with a model in the project, with every write shown as a diff and every command waiting for your yes." cta={{ label: 'Supported providers', href: '/integrations/?category=models' }} secondary={{ label: 'AI coding docs', href: '/docs/ai-coding/coding-sessions/' }} wide>
    <CodingStudio />
  </PageHero>

  <section class="section-pad rule bg-bg-elevated" aria-labelledby="modes-title">
    <div class="container-site">
      <SectionHeading id="modes-title" kicker="Five modes" title="Five modes, five sets of permissions." lede="Switching mode changes what the agent is allowed to do, not just how it answers." class="reveal" />
      <ol class="ruled-grid reveal-group mt-10 sm:grid-cols-2 lg:grid-cols-5" aria-label="Agent modes">
        {modes.map((m) => (
          <li class="p-5"><h3 class="text-[1.0625rem] font-[580] text-text">{m.name}</h3><p class="mt-1.5 text-[0.9rem] leading-relaxed text-text-2">{m.body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-pad rule" aria-labelledby="byo-title">
    <div class="container-site">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <SectionHeading id="byo-title" kicker="Bring your own AI" title="Switch models per task." lede="A strong hosted model for the hard change, a local model for the summary. Keys stay in your OS keychain, and you see what will be sent before it goes." class="reveal" />
        <dl class="facts facts-lg reveal-group">
          <div><dt>Hosted providers</dt><dd>Claude, OpenAI, Gemini and any OpenAI-compatible endpoint, with your own key. They bill you at their own rates.</dd></div>
          <div><dt>Local models</dt><dd>Ollama and LM Studio are detected on your machine. Free to run, nothing leaves your computer.</dd></div>
          <div><dt>Coding-agent accounts <StatusBadge status="planned" compact class="ml-2 align-middle" /></dt><dd>Signing in with a coding-agent subscription you already have is planned.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section-pad rule bg-bg-elevated" aria-labelledby="flow-title">
    <div class="container-site">
      <SectionHeading id="flow-title" kicker="In order" title="From question to approved change." class="reveal" />
      <Steps steps={workflow} columns={4} class="reveal-group mt-12" />
      <div class="mt-12 reveal"><Button href="/features/factory/" variant="secondary">Hand the whole outcome to the AI Factory</Button></div>
    </div>
  </section>

  <CapabilityStatus keys={['routing', 'failover', 'openrouter', 'codeView', 'budgets']} />
</Base>
