---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import BoardFlow from '@/components/factory/BoardFlow.astro';
import InsightsWalkthrough from '@/components/features/InsightsWalkthrough.astro';
import Steps from '@/components/features/Steps.astro';

const sources = [
  { title: 'Trackers', body: 'Jira, Linear and Asana tickets, and GitHub and GitLab issues, assigned to you or your team.' },
  { title: 'Pull requests', body: 'Review requests and changes waiting on someone, next to the work they belong to.' },
  { title: 'Production monitoring', body: 'Sentry, Honeybadger, Datadog and AppSignal errors and performance problems.' },
];
const steps = [
  { title: 'An incident arrives', body: 'Duplicate alerts from the same problem become one shared Work Item, linked to the original events.' },
  { title: 'A ticket is mapped', body: 'Your workflow creates or links the ticket in Jira, Linear or Asana, with status kept in step where the provider allows.' },
  { title: 'The Factory is authorized', body: 'Someone with permission starts the job, or your workflow does under a policy you set.' },
  { title: 'A verified pull request opens', body: 'With its Proof Pack: tests, browser checks, the revision and the verifier’s notes.' },
  { title: 'A person reviews, then Vekrun watches', body: 'Your review rules decide the merge. After the deploy, the Board shows whether the error stopped.' },
];
---
<Base title="Board" fullTitle="Board: tickets, pull requests and production incidents as one stream of work · Vekrun" description="Vekrun's Board brings Jira, Linear, Asana, GitHub and GitLab work together with production incidents from Sentry, Honeybadger, Datadog and AppSignal, and turns them into authorized Factory jobs and verified pull requests.">
  <PageHero eyebrow="Board" title="Every source of engineering work." accent="One Board." lede="Tickets, pull requests and production incidents across your repositories, in one place. Each can become a Factory job, with a verified pull request at the end and a person deciding what merges." cta={{ label: 'Follow an incident', href: '#incidents' }} secondary={{ label: 'Trackers and monitoring', href: '/integrations/?category=project-management' }} wide>
    <BoardFlow />
  </PageHero>

  <section class="section-pad rule bg-bg-elevated" aria-labelledby="sources-title">
    <div class="container-site">
      <SectionHeading id="sources-title" kicker="Shared intake" title="Work arrives from three places." lede="Your trackers stay the system of record. The Board connects what they hold to the work that resolves it." class="reveal" />
      <ul class="ruled-grid reveal-group mt-10 sm:grid-cols-3" aria-label="Sources of work">
        {sources.map((s) => (
          <li class="p-6">
            <h3 class="heading-3 text-text">{s.title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-text-2">{s.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-pad rule" aria-labelledby="flow-title">
    <div class="container-site">
      <SectionHeading id="flow-title" kicker="Incident to verified fix" title="Five steps, and the last one is yours." class="reveal" />
      <Steps steps={steps} columns={4} class="reveal-group mt-12" />
    </div>
  </section>

  <section id="incidents" class="section-pad rule bg-bg-elevated scroll-mt-16" aria-labelledby="incidents-title">
    <div class="container-site">
      <SectionHeading id="incidents-title" kicker="Production incidents" title="From production error to verified fix." lede="Open an error, see its likely cause, and choose what happens next: a ticket, a plan, or a Factory job. Try it in the demonstration." class="reveal" />
      <div class="reveal mt-10"><InsightsWalkthrough /></div>
    </div>
  </section>

  <section class="rule">
    <div class="container-site py-14 sm:py-16">
      <dl class="facts facts-grid facts-lg reveal-group">
        <div><dt>Configurable workflows</dt><dd>Decide what an incoming incident or ticket does. Mappings for status and custom fields depend on what each provider supports.</dd></div>
        <div><dt>Your identity, your permissions</dt><dd>Changes to a tracker or repository are made as the person who authorized them, within your organization’s permissions.</dd></div>
        <div><dt>Reviews stay with people</dt><dd>GitHub and GitLab review rules and branch protections apply. Vekrun never merges around them.</dd></div>
      </dl>
      <div class="mt-8 flex flex-wrap gap-3 reveal">
        <Button href="/features/factory/" variant="secondary">How the Factory runs a job</Button>
        <Button href="/teams/" variant="ghost">A shared Board for your team</Button>
      </div>
    </div>
  </section>

</Base>
