---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import FeatureHero from '@/components/features/FeatureHero.astro';
import KanbanMock from '@/components/features/KanbanMock.astro';
import Steps from '@/components/features/Steps.astro';
import Controls from '@/components/features/Controls.astro';
import WhereThisStands from '@/components/features/WhereThisStands.astro';

const steps = [
  { title: 'Connect your tracker', body: 'Linear, Jira, Asana, GitHub or GitLab. Several accounts if you have them.' },
  { title: 'See your tickets', body: 'Everything assigned to you, in one Kanban, each card linked to the original.' },
  { title: 'Pick one', body: 'Open the ticket: description, acceptance criteria, comments, linked branches.' },
  { title: 'Click Start Work', body: 'You get a branch, a separate working copy and a terminal in it. One click.' },
  { title: 'Choose how to work', body: 'Code it yourself, hand it to an AI agent, or give it to an AI team.' },
  { title: 'Review', body: 'Diffs and test results collect on the ticket. Nothing merges without you.' },
  { title: 'Deliver', body: 'The pull request links back and the ticket moves in your tracker, once you confirm.' },
];
const ways = [
  { title: 'Work manually', body: 'Branch, working copy, terminal. The ticket stays visible beside it. No AI involved.' },
  { title: 'Work with an AI agent', body: 'The ticket becomes the agent\'s brief. It plans, proposes diffs and runs the tests you allow.' },
  { title: 'Delegate to an AI team', body: 'For bigger tickets: a plan you approve, agents building in parallel, a separate check before review.' },
];
const controls = [
  { title: 'Your tracker stays in charge', body: 'Linear, Jira and Asana remain the system of record. Vekrun only changes a ticket when you confirm.' },
  { title: 'Columns that match your workflow', body: 'Map each tracker\'s statuses to To Do, In Progress, In Review and Done, or add your own columns.' },
  { title: 'Works offline', body: 'Your tickets are cached on your machine. Offline, you can see them and keep working; cached data is marked as cached.' },
  { title: 'No AI required', body: 'The Board and Start Work need no model connection.' },
];
---
<Base title="Board" description="See the tickets assigned to you from Linear, Jira, Asana, GitHub or GitLab in one Kanban, click Start Work, and code manually, with an AI agent, or with an AI team.">
  <FeatureHero area="Board" title="Your tasks, ready to build." lede="See your assigned tickets in one place. Pick one, click Start Work, and you have a branch, a terminal and, if you want, an AI agent. Your tasks, your terminal, and your AI, all connected." />

  <Section>
    <KanbanMock />
  </Section>

  <Section rule tone="elevated">
    <SectionHeading title="From ticket to delivered" lede="Seven steps. The middle one is a single click." />
    <Steps steps={steps} columns={4} class="mt-10" />
  </Section>

  <Section rule>
    <SectionHeading title="Three ways to work on a ticket" lede="Start Work asks one question: who does the work?" />
    <div class="ruled-grid mt-10 sm:grid-cols-3">
      {ways.map((w) => (
        <div class="p-6">
          <h3 class="heading-3 text-text">{w.title}</h3>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-text-2">{w.body}</p>
        </div>
      ))}
    </div>
    <div class="mt-8"><Button href="/ai-teams/" variant="secondary">How AI Teams work</Button></div>
  </Section>

  <Section rule tone="elevated">
    <SectionHeading title="What you control" />
    <Controls items={controls} class="mt-10" />
  </Section>

  <WhereThisStands>The Board, Start Work and all three ways of working run in the development build on macOS with local tickets. Connecting Linear, Jira, Asana, GitHub or GitLab, pull-request links and status updates are planned.</WhereThisStands>
</Base>
