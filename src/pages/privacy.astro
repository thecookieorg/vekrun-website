---
/** Privacy: this website, Vekrun Personal, Vekrun Teams and model providers. */
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
---
<Base title="Privacy" fullTitle="Privacy · Vekrun" description="This website uses no cookies, analytics or trackers. In Vekrun, your work stays on machines you control and you decide what reaches a model provider.">
  <PageHero eyebrow="Privacy" title="Your work stays on your machines." lede="No cookies or trackers on this site. In the product, you decide what reaches a model provider." />
  <section class="rule pb-24 pt-14">
    <div class="container-site prose-site max-w-3xl text-[1.0625rem] leading-relaxed">
      <h2 class="!mt-0">This website</h2>
      <ul>
        <li>No cookies, analytics or advertising scripts. Your browser stores only your theme choice, if you change it.</li>
        <li>Fonts load from this site. Nothing comes from third parties.</li>
        <li>The site is hosted on GitHub Pages, so GitHub may log requests under its <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener noreferrer">privacy statement</a>. Vekrun doesn’t see those logs.</li>
      </ul>

      <h2>Vekrun Personal</h2>
      <ul>
        <li>No Vekrun account, and your work passes through no Vekrun server.</li>
        <li>Projects, jobs, memory, logs and audit history stay on your machine. You can delete them at any time.</li>
        <li>Usage reporting is off unless you turn it on.</li>
      </ul>

      <h2>Vekrun Teams</h2>
      <ul>
        <li>The Coordinator, data, workers and audit history run on infrastructure your organization controls.</li>
        <li>Vekrun ships software, licences, updates and support. It doesn’t operate your servers or receive your code through them.</li>
      </ul>

      <h2>Model providers and connected services</h2>
      <ul>
        <li>An external model provider receives the prompts and code a job sends it, under your account and its terms. Local models keep that on your hardware.</li>
        <li>Your policies decide which providers are allowed.</li>
        <li>Trackers, Git hosts and monitoring services receive what the actions you authorize need.</li>
      </ul>
    </div>
  </section>
</Base>
