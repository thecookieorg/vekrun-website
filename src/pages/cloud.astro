---
/**
 * Vekrun Cloud. Dark by design (Base locks the theme), with page-scoped tokens
 * from styles/cloud.css. Every product interface on this page is a conceptual
 * demonstration built from one sample organization; nothing is a recording and
 * nothing here signs anyone up. Status comes from `cloud` in data/site.ts.
 */
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import CloudHero from '@/components/cloud/CloudHero.astro';
import DesktopSwitcher from '@/components/cloud/DesktopSwitcher.astro';
import WorkflowStepper from '@/components/cloud/WorkflowStepper.astro';
import CloudDashboard from '@/components/cloud/CloudDashboard.astro';
import FactoryOps from '@/components/cloud/FactoryOps.astro';
import ApprovalsDemo from '@/components/cloud/ApprovalsDemo.astro';
import InsightsFlow from '@/components/cloud/InsightsFlow.astro';
import GovernanceSettings from '@/components/cloud/GovernanceSettings.astro';
import RoleSwitcher from '@/components/cloud/RoleSwitcher.astro';
import SignInStrip from '@/components/cloud/SignInStrip.astro';
import PricingCalculator from '@/components/cloud/PricingCalculator.astro';
import PricingPlans from '@/components/cloud/PricingPlans.astro';
import { cloud, site } from '@/data/site';

const title = 'Vekrun Cloud — One Connected Workspace for Engineering Teams';
const description = 'Coordinate developers, AI agents, projects, code reviews and engineering workflows in one shared workspace. Vekrun Cloud brings your entire engineering organization together. In development.';
const structuredData = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: cloud.name, url: `${site.url}${cloud.href}`, description, isPartOf: { '@type': 'WebSite', name: site.name, url: site.url }, about: { '@type': 'Thing', name: cloud.name, description: 'An optional, planned team layer for the free Vekrun desktop application.' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: site.name, item: site.url }, { '@type': 'ListItem', position: 2, name: cloud.name, item: `${site.url}${cloud.href}` }] },
];

const approvalKinds = ['Task plans', 'Pull request reviews', 'Expensive AI operations', 'Permission requests', 'Sensitive actions', 'Verification reports'];
const managerDoes = ['Track project progress', 'See blocked work', 'Review milestones', 'Coordinate assignments', 'Follow Factory jobs', 'Inspect delivery reports', 'See reviews and investigations', 'Request plans', 'Start authorized workflows'];
const privacy = [
  ['Personal credentials', 'Stay in your local credential store unless you explicitly connect a service that needs another approved storage model.'],
  ['Organization-managed credentials', 'Stored and used according to the organization’s verified Cloud and worker security architecture, for organization work only.'],
  ['Shared metadata', 'Tickets, assignments, plans, approval records, review status and approved execution summaries synchronize according to organization policy. The data-sharing settings are the whole list.'],
  ['Source code', 'Not uploaded to Cloud as part of ordinary coordination. It stays in your repositories and on the machines you authorize, including the workers your organization owns.'],
  ['Personal projects', 'Sit beside the organization workspace and never join it unless you move them.'],
];
const economics = [
  'Claude, OpenAI, Gemini and OpenRouter usage is not included; organizations use their approved provider accounts.',
  'Company-owned workers run on company infrastructure, at company cost.',
  'Optional Vekrun-managed workers, if offered later, would carry separate usage-based charges.',
  'Individual Community workflows never need a Cloud subscription.',
];
const faq = [
  ['Do I need Cloud to use Vekrun?', 'No. Community remains free and fully functional, with no account.'],
  ['Do my developers need a different desktop app?', 'No. They connect the Vekrun installation they already use and gain an organization workspace beside their personal one.'],
  ['Is AI model usage included?', 'No. Organizations use their approved AI providers and pay those providers separately where applicable. The subscription pays for coordination.'],
  ['Do project managers need the desktop app?', 'No. The Cloud dashboard runs in a browser.'],
  ['Can one developer join multiple organizations?', 'Yes, that is part of the approved Cloud design: one account, several organizations, one personal workspace.'],
  ['Can we run AI workers on our own infrastructure?', 'Yes, under the planned organization worker model: machines you own and approve, with the permissions you grant.'],
  ['Is Vekrun Cloud available today?', 'Not yet. It is in development, and the pricing above is proposed launch pricing, not something you can buy.'],
];
---
<Base title={cloud.name} fullTitle={title} description={description} image="/og/cloud.png" structuredData={structuredData} lockTheme="dark" page="cloud">
  <!-- Hero -->
  <section class="hero ambient" aria-labelledby="cloud-title">
    <div class="grid-field pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-wide relative">
      <div class="hero-copy">
        <p class="eyebrow enter" style="--i: 0">Introducing Vekrun Cloud</p>
        <h1 id="cloud-title" class="display enter mt-5 text-text" style="--i: 1">Your entire engineering team.<br class="hidden sm:inline" /> <span class="text-gradient">One connected workspace.</span></h1>
        <p class="lede enter mx-auto mt-6 max-w-2xl" style="--i: 2">Connect developers, AI agents, and engineering workflows in one place. Coordinate projects, delegate work, manage approvals, and see what’s happening across your organization.</p>
        <div class="enter mt-8 flex flex-wrap justify-center gap-3" style="--i: 3">
          <Button href="#connected" size="lg">Explore Vekrun Cloud</Button>
          <Button href="#how-it-works" size="lg" variant="secondary">See How It Works</Button>
        </div>
        <p class="enter mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-[0.9rem] text-text-2" style="--i: 3">
          <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/70 px-3 py-1 text-[0.8125rem] backdrop-blur"><span class="h-1.5 w-1.5 rounded-full bg-warn" aria-hidden="true"></span>{cloud.statusLabel}</span>
          <span>{cloud.promise}</span>
        </p>
      </div>
      <div class="relative mt-12 sm:mt-14 lg:mt-16"><CloudHero /></div>
    </div>
  </section>

  <!-- One desktop, your whole team -->
  <section id="connected" class="section-pad rule scroll-mt-16" aria-labelledby="connected-title">
    <div class="container-site">
      <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-14 lg:items-start">
        <div class="reveal min-w-0 lg:sticky lg:top-24">
          <p class="kicker">One desktop, your whole team</p>
          <h2 id="connected-title" class="heading-2 mt-3 text-text">The Vekrun you already know. Now connected.</h2>
          <p class="lede mt-4">Developers keep the same Vekrun desktop application. Cloud connects the organization work they are authorized to see. No separate Teams app, nothing duplicated.</p>
          <dl class="facts mt-7">
            <div><dt>Personal projects remain personal</dt><dd>They never join an organization unless you move them.</dd></div>
            <div><dt>Organization projects are shared by permission</dt><dd>Members see what their project role allows.</dd></div>
            <div><dt>Connect at any time</dt><dd>Join from the workspace menu, later, without reinstalling. {cloud.promise}</dd></div>
          </dl>
        </div>
        <div class="reveal min-w-0"><DesktopSwitcher /></div>
      </div>
    </div>
  </section>

  <!-- Shared engineering workflows -->
  <section id="how-it-works" class="section-pad rule bg-bg-elevated scroll-mt-16" aria-labelledby="flow-title">
    <div class="container-site">
      <div class="reveal max-w-3xl">
        <p class="kicker">Shared engineering workflows</p>
        <h2 id="flow-title" class="heading-2 mt-3 text-text">Work moves forward. Everyone stays in sync.</h2>
        <p class="lede mt-4">Work travels between a manager, a developer, the AI agents and a reviewer without anyone forwarding anything. Step through it, or let it play.</p>
      </div>
      <div class="reveal mt-10"><WorkflowStepper /></div>
      <p class="reveal mt-10 text-center text-[1.15rem] font-[560] tracking-[-0.01em] text-text">From assignment to delivery, every step is connected.</p>
    </div>
  </section>

  <!-- Project manager dashboard -->
  <section id="dashboard" class="section-pad rule ambient" aria-labelledby="dash-title">
    <div class="container-wide">
      <div class="reveal mx-auto max-w-3xl text-center">
        <p class="kicker">Project manager dashboard</p>
        <h2 id="dash-title" class="heading-2 mt-3 text-text">Finally, a clear view of engineering progress.</h2>
        <p class="lede mx-auto mt-4">See what your developers and AI agents are working on, what’s blocked, what’s awaiting review, and what’s been delivered, without opening a terminal.</p>
      </div>
      <div class="reveal mt-12"><CloudDashboard /></div>
      <div class="reveal mt-10 grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-12">
        <p class="text-[0.95rem] leading-relaxed text-text-2">From a browser, with no desktop install, a project manager can do all of this. Cloud connects Jira, Linear or Asana to the work itself; it does not replace them.</p>
        <ul class="chips" aria-label="What a project manager can do">{managerDoes.map((m) => <li>{m}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- AI Factory across the organization -->
  <section id="factory" class="section-pad rule bg-bg-elevated" aria-labelledby="factory-title">
    <div class="container-wide">
      <div class="reveal max-w-3xl">
        <p class="kicker">AI Factory across your organization</p>
        <h2 id="factory-title" class="heading-2 mt-3 text-text">AI engineering work, coordinated across your entire team.</h2>
        <p class="lede mt-4">Several developers, shared queues, company-owned workers, human approvals, execution budgets, clear ownership, and progress the whole organization can see.</p>
      </div>
      <div class="reveal mt-10"><FactoryOps /></div>
      <p class="reveal mt-8 text-[0.9rem] text-text-3">The same agents that run on one machine. No proprietary model and no second engine: your organization’s provider policy decides which models run, including local ones.</p>
    </div>
  </section>

  <!-- Approvals -->
  <section id="approvals" class="section-pad rule" aria-labelledby="approvals-title">
    <div class="container-site">
      <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-14 lg:items-start">
        <div class="reveal min-w-0 lg:sticky lg:top-24">
          <p class="kicker">One place for approvals</p>
          <h2 id="approvals-title" class="heading-2 mt-3 text-text">Stay in control without slowing everyone down.</h2>
          <p class="lede mt-4">Every decision an organization wants a person to make, in one inbox, with the context to make it quickly.</p>
          <ul class="chips mt-7" aria-label="What can require approval">{approvalKinds.map((k) => <li>{k}</li>)}</ul>
          <p class="mt-6 text-[0.875rem] text-text-3">In the product, an approval requires an authenticated, authorized member of the organization. The demonstration here approves nothing.</p>
        </div>
        <div class="reveal min-w-0"><ApprovalsDemo /></div>
      </div>
    </div>
  </section>

  <!-- Insights and quality -->
  <section id="insights" class="section-pad rule bg-bg-elevated" aria-labelledby="insights-title">
    <div class="container-site">
      <div class="reveal max-w-3xl">
        <p class="kicker">Shared Insights and engineering quality</p>
        <h2 id="insights-title" class="heading-2 mt-3 text-text">Know what’s broken. See who’s fixing it.</h2>
        <p class="lede mt-4">An error from Honeybadger, AppSignal, Sentry or Datadog becomes a shared investigation, a verified fix and a confirmed deploy. Resolving it stays a person’s decision.</p>
      </div>
      <div class="reveal mt-10"><InsightsFlow /></div>
    </div>
  </section>

  <!-- Governance -->
  <section id="governance" class="section-pad rule" aria-labelledby="gov-title">
    <div class="container-site">
      <div class="reveal max-w-3xl">
        <p class="kicker">Organization governance</p>
        <h2 id="gov-title" class="heading-2 mt-3 text-text">Your organization. Your rules.</h2>
        <p class="lede mt-4">Roles, access, model policies, budgets, approvals, workers, audit history and data sharing. Decided once, for the organization.</p>
      </div>
      <div class="reveal mt-10"><GovernanceSettings /></div>
    </div>
  </section>

  <!-- Roles -->
  <section id="roles" class="section-pad rule bg-bg-elevated" aria-labelledby="roles-title">
    <div class="container-site">
      <div class="reveal max-w-3xl">
        <p class="kicker">Built for different roles</p>
        <h2 id="roles-title" class="heading-2 mt-3 text-text">One organization, four ways in.</h2>
      </div>
      <div class="reveal mt-8"><RoleSwitcher /></div>
    </div>
  </section>

  <!-- Sign in and membership -->
  <section id="join" class="section-pad rule" aria-labelledby="join-title">
    <div class="container-site">
      <div class="reveal max-w-3xl">
        <p class="kicker">Sign in and organization membership</p>
        <h2 id="join-title" class="heading-2 mt-3 text-text">Join your organization in three screens.</h2>
        <p class="lede mt-4">A developer connects the desktop application to an organization with one account. Email, Google, GitHub, GitLab and Enterprise SSO are the planned ways in.</p>
      </div>
      <div class="reveal mt-10"><SignInStrip /></div>
    </div>
  </section>

  <!-- Community, Cloud Teams, Enterprise -->
  <section id="plans" class="section-pad rule ambient ambient-low bg-bg-elevated scroll-mt-16" aria-labelledby="plans-title">
    <div class="container-site">
      <div class="reveal mx-auto max-w-3xl text-center">
        <p class="kicker">Community, Cloud Teams, Enterprise</p>
        <h2 id="plans-title" class="heading-2 mt-3 text-text">Free for developers. Connected for teams.</h2>
        <p class="lede mx-auto mt-4">Community is free. Cloud Teams connects your team. Enterprise gives larger organizations advanced control. Nothing moves behind a paywall.</p>
        <p class="price-label mt-6"><span class="h-1.5 w-1.5 rounded-full bg-warn" aria-hidden="true"></span>{cloud.pricing.label}</p>
      </div>
      <div class="reveal-group mt-12"><PricingPlans /></div>
      <p class="reveal mt-5 text-center text-[0.875rem] text-text-3">Monthly prices only; no annual pricing has been decided. Email, Google, GitHub and GitLab sign-in belong to Cloud Teams; SSO enforcement and SCIM belong to Enterprise. There is no sign-up, trial or billing yet.</p>

      <div class="reveal mt-10"><PricingCalculator /></div>

      <div class="reveal-group mt-10 grid gap-5 lg:grid-cols-2">
        <div class="def">
          <h3>Active member <small>a paid seat</small></h3>
          <p>Someone who uses Cloud to take part in organization work: a developer in a connected organization, an engineering lead managing shared Factory work, a project manager assigning and coordinating tasks, an administrator managing policies and members.</p>
        </div>
        <div class="def">
          <h3>Read-only viewer <small>no seat charge</small></h3>
          <p>Inspects the dashboards, reports, progress and project status their permissions allow. A viewer cannot start Factory jobs, modify tickets, approve consequential actions, reassign work, change organization settings, manage paid resources, or see anything beyond their assigned permissions. The Cloud service enforces this, not the website.</p>
        </div>
      </div>

      <div class="reveal mt-12 econ">
        <h3 class="heading-3">Bring your own AI. Pay for team coordination.</h3>
        <p class="mt-2 text-[0.95rem] leading-relaxed text-text-2">Vekrun Cloud connects your team and coordinates work. Your AI providers and execution infrastructure remain under your control and are billed separately where applicable.</p>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2 text-[0.875rem] text-text-2">{economics.map((e) => <li class="flex gap-2"><span class="mt-[0.55rem] h-1 w-1 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>{e}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section-pad rule" aria-labelledby="faq-title">
    <div class="container-site">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
        <div class="reveal">
          <p class="kicker">Questions before adopting Cloud</p>
          <h2 id="faq-title" class="heading-2 mt-3 text-text">Short answers.</h2>
        </div>
        <div class="reveal faq">
          {faq.map(([q, a]) => <details class="faq-i"><summary>{q}<svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></summary><p>{a}</p></details>)}
        </div>
      </div>
    </div>
  </section>

  <!-- Data ownership -->
  <section id="privacy" class="section-pad rule" aria-labelledby="privacy-title">
    <div class="container-site">
      <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <div class="reveal">
          <p class="kicker">Data ownership and privacy</p>
          <h2 id="privacy-title" class="heading-2 mt-3 text-text">Your code stays under your control.</h2>
          <p class="lede mt-4">Cloud follows the same local-first idea as the desktop app. It coordinates work; it does not become the place your code or your keys live.</p>
          <div class="flow mt-8" aria-label="What lives where">
            <div class="flow-box is-mint"><b>Your machine</b><span>source code · API keys · personal projects · local models</span></div>
            <span class="flow-link"><i>tickets, plans, review status, job results</i></span>
            <div class="flow-box is-blue"><b>Vekrun Cloud</b><span>organization, members, policies, shared work</span></div>
            <span class="flow-link"><i>approved jobs</i></span>
            <div class="flow-box is-mint"><b>Your infrastructure</b><span>shared workers · company keys · CI</span></div>
          </div>
        </div>
        <dl class="reveal-group facts facts-lg">
          {privacy.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      </div>
      <p class="reveal mt-8 text-[0.875rem] text-text-3">We do not claim zero access or end-to-end encryption, and we claim no certification. If a verified implementation supports such a guarantee later, this page will say exactly what it covers.</p>
    </div>
  </section>

  <!-- Interest and status -->
  <section id="interest" class="rule ambient bg-bg-elevated" aria-labelledby="interest-title">
    <div class="container-site relative py-16 text-center sm:py-20">
      <h2 id="interest-title" class="heading-2 text-text">Interested in Vekrun Cloud?</h2>
      <p class="lede mx-auto mt-4 max-w-2xl">Bring your engineering team together with shared AI workflows, project visibility, and organization-wide controls.</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <span class="soon"><span class="h-1.5 w-1.5 rounded-full bg-warn" aria-hidden="true"></span>Register interest · coming soon</span>
        <Button href={cloud.roadmapHref} variant="secondary">View the Cloud roadmap</Button>
      </div>
      <p class="mx-auto mt-6 max-w-2xl text-[0.875rem] leading-relaxed text-text-3">There is no way to register yet, and no sign-up, trial or billing. {site.status.line} Every interface on this page is a conceptual demonstration with invented data; the desktop application keeps the status given on its feature pages.</p>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--border); padding-top: 5rem; padding-bottom: 4rem; }
  @media (min-width: 64rem) { .hero { padding-top: 5.5rem; padding-bottom: 5rem; } }
  .hero::before { left: 10%; top: -12rem; width: 60rem; height: 34rem; }
  .hero::after { right: -5%; top: 10rem; }
  .hero-copy { max-width: 56rem; margin-inline: auto; text-align: center; }
  .price-label { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.9rem; border: 1px solid var(--border); border-radius: 999px; background: color-mix(in srgb, var(--surface) 70%, transparent); font-size: 0.8125rem; color: var(--text-2); backdrop-filter: blur(8px); }
  .def { padding: 1.25rem 1.4rem; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); }
  .def h3 { margin: 0; font-size: 1.05rem; font-weight: 580; color: var(--text); display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; }
  .def h3 small { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cloud-strong); }
  .def p { margin: 0.6rem 0 0; font-size: 0.9rem; line-height: 1.55; color: var(--text-2); }
  .econ { padding: 1.5rem 1.6rem; border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border)); border-radius: var(--radius-lg); background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 6%, var(--surface)), color-mix(in srgb, var(--cloud) 6%, var(--surface))); }
  .soon { display: inline-flex; align-items: center; gap: 0.5rem; height: 2.5rem; padding: 0 1rem; border: 1px dashed var(--border-strong); border-radius: 6px; font-size: 0.9375rem; color: var(--text-2); }
  .flow { display: grid; gap: 0.3rem; }
  .flow-box { display: grid; gap: 0.15rem; padding: 0.8rem 0.95rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .flow-box b { color: var(--text); font-weight: 560; font-size: 0.95rem; }
  .flow-box span { color: var(--text-3); font-size: 0.8rem; }
  .flow-box.is-mint { border-left: 3px solid var(--accent); }
  .flow-box.is-blue { border-left: 3px solid var(--cloud); background: color-mix(in srgb, var(--cloud) 6%, var(--surface)); }
  .flow-link { display: flex; align-items: center; gap: 0.6rem; padding-left: 1.4rem; color: var(--text-3); font-family: var(--font-mono); font-size: 0.66rem; }
  .flow-link::before { content: ''; width: 1px; height: 1.4rem; background: linear-gradient(var(--accent), var(--cloud)); }
</style>
