---
/** Licence: Vekrun is proprietary, all rights reserved. Not a contract. */
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { site, personal, teams, pricing, usd } from '@/data/site';
const t = pricing.teams;
---
<Base title="Licence" fullTitle="Licence: Vekrun is proprietary software · Vekrun" description="Vekrun is proprietary software, all rights reserved. Vekrun Personal is free to use; Vekrun Teams is a paid, self-hosted licence.">
  <PageHero eyebrow="Licence" title="Vekrun is proprietary software." lede={site.licence.summary} />
  <section class="rule pb-24 pt-14">
    <div class="container-site prose-site max-w-3xl text-[1.0625rem] leading-relaxed">
      <p class="!mt-0">Vekrun and its source code are owned by Vekrun. All rights reserved. The source code is not public.</p>
      <ul>
        <li><strong>{personal.name}</strong> is free to use. It isn’t a trial with hidden limits.</li>
        <li><strong>{teams.name}</strong> is one paid, self-hosted licence: {usd(t.base)} a month for up to {t.includedEngineers} engineers and {usd(t.perAdditionalEngineer)} a month for each additional engineer, as planned launch pricing.</li>
      </ul>
      <p>Tools and services you connect, such as coding agents, model providers and Git hosts, keep their own licences and terms.</p>
    </div>
  </section>
</Base>
