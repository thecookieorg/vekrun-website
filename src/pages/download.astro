---
/**
 * Get Vekrun. Early access comes first and is real: a plain email link to
 * `site.earlyAccess.email`, with no form. Availability must stay accurate per platform: there is no
 * installer until `site.release.downloadAvailable` is true and a signed build
 * is published.
 */
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Button from '@/components/Button.astro';
import { site, earlyAccessMailto } from '@/data/site';
const email = site.earlyAccess.email;
const platforms = [
  ['macOS', 'Alpha, by early access, on Apple Silicon and Intel Macs. No public installer yet'],
  ['Windows', 'Planned'],
  ['Linux', 'Planned'],
];
const expect = [
  ['The current alpha runs on macOS', 'On Macs with Apple Silicon or Intel processors. Windows and Linux are planned.'],
  ['It’s an alpha', 'Expect rough edges and changes between builds. Your feedback shapes what comes next.'],
  ['It’s free', 'Vekrun Free costs nothing for individual developers, now and after release.'],
  ['You bring the models', 'An OpenRouter key or a local model. No coding-agent subscription is required.'],
];
const facts = [
  ['What you need', 'A model connection (an OpenRouter key or a local model) and Git access to your projects. Coding-agent CLIs are optional.'],
  ['System requirements', 'Published with each release, per platform.'],
  ['Every release', 'A signed installer, a SHA-256 checksum and release notes, listed on this page.'],
];
---
<Base title="Get Vekrun" fullTitle="Get Vekrun: request early access · Vekrun" description={`${site.release.line} Request early access to Vekrun Free, the local-first AI engineering workspace for individual developers.`}>
  <PageHero eyebrow="Get Vekrun" title="Request early access." lede="Vekrun is in alpha on macOS, for Apple Silicon and Intel Macs. There’s no public download yet: tell us what you build and we’ll be in touch. Vekrun Free costs nothing for individual developers." />

  <section id="early-access" class="rule pb-16 pt-14 scroll-mt-16" aria-label="Request early access">
    <div class="container-site ea-wrap">
      <div class="ea-copy">
        <h2 class="heading-3 text-text">Early access is by email.</h2>
        <ul class="expect" aria-label="What to expect from early access">
          {expect.map(([k, v]) => <li><b>{k}</b><span>{v}</span></li>)}
        </ul>
        <p class="mt-6 text-text-2">Want Vekrun hosted or on your own infrastructure? <a href="/pricing/#cloud-wishlist" class="text-accent link-slide">Join the Cloud wishlist</a> or see <a href="/pricing/" class="text-accent link-slide">Enterprise</a>.</p>
      </div>
      <div class="ea">
        <p class="text-text-2">Write to us and tell us which Mac you use, which models you’d connect, and what you’d hand Vekrun first.</p>
        <Button href={earlyAccessMailto} size="lg" class="mt-6">Email {email}</Button>
      </div>
    </div>
  </section>

  <section class="rule bg-bg-elevated pb-24 pt-14" aria-labelledby="dl-facts">
    <div class="container-site">
      <h2 id="dl-facts" class="heading-3 text-text">Releases</h2>
      <ul class="plats mt-6" aria-label="Availability by platform">
        {platforms.map(([p, s]) => <li><b>{p}</b><span>{s}</span></li>)}
      </ul>
      <dl class="facts facts-grid facts-lg mt-10">
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <p class="mt-10 text-[0.9rem] text-text-3">Vekrun is proprietary software, so there is no source build. <a href="/license/" class="text-accent link-slide">Licence</a></p>
    </div>
  </section>
</Base>

<style>
  .ea-wrap { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; }
  .ea :global(.btn) { max-width: 100%; height: auto; min-height: 3rem; padding-block: 0.6rem; white-space: normal; overflow-wrap: anywhere; text-align: center; }
  @media (min-width: 64rem) { .ea-wrap { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 4rem; align-items: start; } }
  .ea { padding: 1.5rem; border: 1px solid var(--border-strong); border-radius: var(--radius-lg); background: var(--surface); }
  @media (min-width: 40rem) { .ea { padding: 2rem; } }
  .expect { margin: 1.5rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.9rem; }
  .expect li { display: grid; gap: 0.15rem; }
  .expect b { font-weight: 600; color: var(--text); }
  .expect span { font-size: 0.92rem; line-height: 1.5; color: var(--text-2); }
  .plats { margin: 0; padding: 0; list-style: none; display: grid; gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
  @media (min-width: 40rem) { .plats { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .plats li { display: grid; gap: 0.2rem; padding: 1.1rem 1.25rem; background: var(--surface); }
  .plats b { font-weight: 600; color: var(--text); }
  .plats span { font-size: 0.92rem; color: var(--text-2); }
</style>
