---
/**
 * Download. Availability must stay accurate: there is no installer until
 * `site.release.downloadAvailable` is true and a signed build is published.
 */
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { site, personal } from '@/data/site';

const facts = [
  ['Platforms', 'macOS, Windows and Linux. Each one gets a download once it has a signed installer.'],
  ['System requirements', 'Published with each release, per platform.'],
  ['What you need', 'Your own coding agent or model account, and Git access to your projects.'],
  ['Every release', 'A signed installer, a SHA-256 checksum and release notes, listed on this page.'],
];
---
<Base title="Download" fullTitle="Download Vekrun" description={`${site.release.line} ${personal.name} will be free. This page lists platforms, requirements and every release once it exists.`}>
  <PageHero eyebrow="Download" title="Vekrun isn’t ready to download yet." lede={`${personal.name} will be free. When an installer exists, it will be here.`} cta={{ label: 'See how it works', href: '/product/' }} secondary={{ label: 'Teams & Pricing', href: '/teams/' }} />
  <section class="rule pb-24 pt-14" aria-labelledby="dl-facts">
    <div class="container-site">
      <h2 id="dl-facts" class="sr-only">Release facts</h2>
      <dl class="facts facts-grid facts-lg">
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <p class="mt-10 text-[0.9rem] text-text-3">Vekrun is proprietary software, so there is no source build. <a href="/license/" class="text-accent link-slide">Licence</a></p>
    </div>
  </section>
</Base>
