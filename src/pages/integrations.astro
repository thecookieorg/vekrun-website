---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import IntegrationCatalog from '@/components/catalog/IntegrationCatalog.astro';
import IntegrationLogo from '@/components/catalog/IntegrationLogo.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { getCollection } from 'astro:content';
import { site } from '@/data/site';
import SectionHeading from '@/components/SectionHeading.astro';
import CapabilityStatus from '@/components/CapabilityStatus.astro';
import { ArrowUpRight } from '@lucide/astro';

const title = 'Integrations';
const description = 'The coding CLIs, models and API gateways, source control, trackers, monitoring, CI and local runtimes Vekrun connects to, each with its real status. Vekrun discovers your coding CLIs and keeps them current where the vendor supports it.';
const entries = await getCollection('integrations');
const byId = (id: string) => entries.find((e) => e.id === id)!;
const featured = [
  { title: 'Coding CLIs', blurb: 'Signed in on your Host. Discovered, checked and kept current.', href: '/integrations/?category=coding-clis', ids: ['claude-code', 'codex', 'gemini-cli', 'github-cli'] },
  { title: 'Models and gateways', blurb: 'Your own accounts, billed by the provider. OpenRouter is first-class.', href: '/integrations/?category=models', ids: ['openrouter', 'anthropic', 'openai', 'gemini'] },
  { title: 'Trackers and source control', blurb: 'Where work is defined and where it is reviewed.', href: '/integrations/?category=project-management', ids: ['jira', 'linear', 'asana', 'github', 'gitlab'] },
  { title: 'Monitoring', blurb: 'Production problems become shared Work Items you can fix.', href: '/integrations/?category=monitoring', ids: ['sentry', 'honeybadger', 'datadog', 'appsignal'] },
].map((g) => ({ ...g, items: g.ids.map(byId).filter(Boolean) }));
---
<Base title={title} description={description}>
  <PageHero eyebrow="Integrations and Connections" title="Connect the tools" accent="you already use." lede="Your coding CLIs, model accounts, trackers, repositories and monitoring, each connected with your own account. How each one authenticates depends on the provider; not every one has a one-click sign-in." wide>
    <Fragment slot="status"><span>Model providers bill you directly. A coding CLI subscription and paid API access are separate things.</span><a href="/docs/settings/providers/" class="text-accent link-slide">Setup steps in the docs</a></Fragment>
    <div class="feat-grid reveal-group" aria-label="Featured connections">
      {featured.map((g) => (
        <section class="feat-card card" aria-labelledby={`feat-${g.title.toLowerCase().replace(/\s+/g, '-')}`}>
          <div class="feat-head">
            <div><h2 id={`feat-${g.title.toLowerCase().replace(/\s+/g, '-')}`} class="feat-title">{g.title}</h2><p class="feat-blurb">{g.blurb}</p></div>
            <a href={g.href} class="group feat-all link-slide">All<ArrowUpRight class="icon-nudge h-3.5 w-3.5" aria-hidden="true" /></a>
          </div>
          <ul class="feat-items" role="list">
            {g.items.map((e) => (
              <li class="feat-item">
                <IntegrationLogo id={e.id} name={e.data.name} monogram={e.data.monogram} />
                <span class="feat-name">{e.data.name}</span>
                <StatusBadge status={e.data.status} compact class="feat-status" />
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <p class="mt-6 text-center text-[0.75rem] text-text-3">Logos are trademarks of their owners and indicate compatibility, not endorsement. {site.status.line}</p>
  </PageHero>

  <div class="pb-20">
    <IntegrationCatalog />
    <p class="container-site mt-14 text-[0.9375rem] text-text-2">
      Connected trackers and monitoring put work on the <a href="/features/board/" class="text-accent link-slide">Board</a>, one step from a Factory job.
    </p>
  </div>

  <section id="connections" class="section-pad rule scroll-mt-16" aria-labelledby="connections-title">
    <div class="container-site">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <div class="reveal">
          <p class="kicker">Connections and Setup</p>
          <h2 id="connections-title" class="heading-2 mt-3 text-text">Your coding CLIs, found and kept healthy.</h2>
          <p class="lede mt-4">Vekrun looks for Claude Code, Codex, Gemini CLI and GitHub CLI on your Host, shows their versions and whether they are signed in, and offers to install or update them where the vendor supports it.</p>
        </div>
        <dl class="facts facts-lg reveal-group">
          <div><dt>Version and health</dt><dd>See which CLI is installed, which version, and whether its sign-in still works, before a job depends on it.</dd></div>
          <div><dt>Install and update where supported</dt><dd>Through each vendor’s own installer and update channel. Not every tool offers one on every operating system.</dd></div>
          <div><dt>Safe restarts and Context Handoff</dt><dd>An update or a usage limit should not lose a job. The job pauses at a safe point, and Context Handoff rebuilds its state for the next worker.</dd></div>
          <div><dt>Logins stay on the Host</dt><dd>Vekrun never exports a CLI’s login or session to an environment or anywhere else.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section id="project-setup" class="section-pad rule bg-bg-elevated scroll-mt-16" aria-labelledby="setup-title">
    <div class="container-site">
      <SectionHeading id="setup-title" kicker="Project setup" title="Docker, native and hybrid projects." lede="Environment Discovery works out how a repository runs: Docker Compose services, a native Rails, Node or Python app, or a mix. It starts the project with health checks and seeds and saves a verified Environment Recipe for every job after. Most projects need no setup; some need a hint." class="reveal" />
    </div>
  </section>

  <CapabilityStatus keys={['claudeCode', 'codex', 'geminiCli', 'cliSetup', 'cliInstall', 'githubCli', 'openrouter', 'contextHandoff', 'envDiscovery', 'envRecipes']} />
</Base>

<style>
  .feat-grid { display: grid; gap: 1rem; }
  @media (min-width: 40rem) { .feat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 80rem) { .feat-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .feat-card { display: flex; flex-direction: column; gap: 1rem; padding: 1.25rem; text-align: left; }
  .feat-head { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }
  .feat-title { margin: 0; font-size: 1.05rem; font-weight: 600; letter-spacing: -0.015em; color: var(--text); }
  .feat-blurb { margin: 0.25rem 0 0; font-size: 0.85rem; line-height: 1.45; color: var(--text-3); }
  .feat-all { display: inline-flex; align-items: center; gap: 0.2rem; flex: 0 0 auto; font-size: 0.8125rem; font-weight: 540; color: var(--accent); }
  .feat-items { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
  .feat-item { display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-areas: 'logo name' 'logo status'; column-gap: 0.75rem; row-gap: 0.25rem; align-items: center; padding: 0.6rem 0.7rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-2); min-width: 0; transition: border-color var(--dur-fast), transform var(--dur) var(--ease-out); }
  .feat-item > :first-child { grid-area: logo; }
  .feat-item:hover { border-color: var(--border-strong); transform: translateY(-2px); }
  .feat-name { grid-area: name; font-size: 0.875rem; font-weight: 560; color: var(--text); line-height: 1.2; }
  .feat-item :global(.feat-status) { grid-area: status; justify-self: start; }
  @media (prefers-reduced-motion: reduce) { .feat-item { transition: none; } .feat-item:hover { transform: none; } }
</style>
