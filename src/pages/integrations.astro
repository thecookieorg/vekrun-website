---
/**
 * Integrations, split the way the product splits them: the models Vekrun's
 * native agent runs on (first, because no coding-agent CLI is required), the
 * optional coding agents, the services Vekrun connects to natively, and
 * anything else through MCP servers the customer adds. Only what ships is
 * listed as a tool; anything planned says so. Logos mean compatibility,
 * never endorsement.
 */
import Base from '@/layouts/Base.astro';
import ClosingCta from '@/components/ClosingCta.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import IntegrationLogo from '@/components/brand/IntegrationLogo.astro';
import { toolGroups, platforms, plannedConnections } from '@/data/integrations';

const agentGroups = toolGroups.filter((g) => g.kind !== 'native');
const nativeGroups = toolGroups.filter((g) => g.kind === 'native');
const mcp = [
  ['Local or remote', 'Add any MCP server. A local one starts enabled; a remote one stays off until you turn it on.'],
  ['Approval per call', 'Every tool call an agent makes asks for your approval first.'],
  ['Untrusted by default', 'What a server returns is treated as data, never as instructions.'],
];
const facts = [
  ['Your accounts, your bills', 'Model providers bill you directly, under your own account. Local models cost nothing to run beyond your hardware. Vekrun adds no markup.'],
  ['Logins stay yours', 'Optional coding agents sign in through their own official flow. Vekrun never reads or stores their credentials.'],
  ['You choose what agents can touch', 'Each connection says what it can do, and you decide what agents may use.'],
];
---
<Base title="Integrations" fullTitle="Integrations: models, coding agents and tools · Vekrun" description="Vekrun's native agent runs on OpenRouter, Ollama or LM Studio. Claude Code, Codex and Antigravity CLI are optional. Native integrations with GitHub, GitLab, Jira, Linear, Sentry, Notion, Figma, Slack and Obsidian, plus any MCP server you add.">
  <PageHero eyebrow="Integrations" title="Your models, your tools. Vekrun coordinates them." lede="Vekrun’s native agent does the work with the models you connect; coding-agent CLIs are optional. Vekrun connects to your trackers, Git hosts, monitoring and docs, and to any MCP server you add." />

  {agentGroups.map((g, i) => (
    <section class:list={['group-sec rule', i % 2 === 0 && 'bg-bg-elevated']} aria-labelledby={`g-${g.key}`}>
      <div class="container-site group-in">
        <div>
          <h2 id={`g-${g.key}`} class="heading-3 text-text">{g.title}</h2>
          <p class="mt-2 max-w-sm text-[0.98rem] text-text-2">{g.line}</p>
        </div>
        <ul class="tiles">
          {g.tools.map((t) => <li><IntegrationLogo id={t.id} name={t.name} monogram={t.mono} /><span>{t.name}</span></li>)}
        </ul>
      </div>
    </section>
  ))}

  <section class="section-pad rule pb-0" aria-labelledby="native-title">
    <div class="container-site">
      <SectionHeading id="native-title" title="Native integrations." lede="Vekrun connects to these directly. Work comes in as issues and incidents; results go back as pull requests, comments and updates." />
    </div>
  </section>
  {nativeGroups.map((g) => (
    <section class="group-sec" aria-labelledby={`g-${g.key}`}>
      <div class="container-site group-in">
        <div>
          <h3 id={`g-${g.key}`} class="heading-3 text-text">{g.title}</h3>
          <p class="mt-2 max-w-sm text-[0.98rem] text-text-2">{g.line}</p>
        </div>
        <ul class="tiles">
          {g.tools.map((t) => <li><IntegrationLogo id={t.id} name={t.name} monogram={t.mono} /><span>{t.name}</span></li>)}
        </ul>
      </div>
    </section>
  ))}

  <section id="mcp" class="section-pad rule bg-bg-elevated scroll-mt-16" aria-labelledby="mcp-title">
    <div class="container-site">
      <div class="mcp-head">
        <IntegrationLogo id="mcp" name="Model Context Protocol" monogram="Mc" size="lg" />
        <SectionHeading id="mcp-title" title="Everything else, through MCP." lede="Databases, cloud consoles, payment dashboards: if a service has an MCP server, Vekrun’s agents can use it, on your terms. A catalog of vendor-published servers is built in." />
      </div>
      <dl class="facts facts-grid facts-lg mt-10">
        {mcp.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <p class="mt-10 text-[0.95rem] text-text-2">Planned: {plannedConnections.join('; ')}.</p>
    </div>
  </section>

  <section class="section-pad rule" aria-labelledby="platforms-title">
    <div class="container-site">
      <SectionHeading id="platforms-title" title="Built for whole products, not single repos." lede="An Expo app and its Rails API, a Shopify storefront, a Tauri desktop client. Vekrun coordinates them together." />
      <ul class="plat" aria-label="Platforms">
        {platforms.map((t) => <li><IntegrationLogo id={t.id} name={t.name} monogram={t.mono} size="sm" />{t.name}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-pad rule bg-bg-elevated" aria-labelledby="connect-title">
    <div class="container-site">
      <SectionHeading id="connect-title" title="Connecting is simple. Staying in control is the point." />
      <dl class="facts facts-grid facts-lg mt-10">
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <p class="mt-10 text-[0.95rem] text-text-2">Each service connects its own way: a signed-in CLI, a sign-in with the service, or an API key kept in your system keychain. How data is handled is on the <a href="/security/" class="text-accent link-slide">security page</a>.</p>
      <p class="mt-6 text-[0.8125rem] text-text-3">Logos are trademarks of their owners and show compatibility, not endorsement.</p>
    </div>
  </section>

  <ClosingCta title="Bring your tools. Vekrun does the coordinating." />
</Base>

<style>
  .mcp-head { display: grid; gap: 1.5rem; align-items: start; }
  @media (min-width: 48rem) { .mcp-head { grid-template-columns: auto minmax(0, 1fr); gap: 2rem; } }
  .group-sec { padding-block: 3.5rem; }
  @media (min-width: 64rem) { .group-sec { padding-block: 4.5rem; } }
  .group-in { display: grid; gap: 1.75rem; }
  @media (min-width: 64rem) { .group-in { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 4rem; align-items: start; } }
  .tiles { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
  @media (min-width: 40rem) { .tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .tiles li { display: flex; align-items: center; gap: 0.75rem; min-width: 0; padding: 0.7rem 0.8rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); font-size: 0.95rem; font-weight: 520; color: var(--text); }
  .tiles li span:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .plat { margin: 2.5rem 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .plat li { display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.4rem 0.85rem 0.4rem 0.45rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); font-size: 0.95rem; color: var(--text); }
</style>
