---
/**
 * Integrations: the customer's own tools, grouped by what they do for them.
 * OpenRouter is featured as a first-class model connection. Platforms show the
 * kinds of products Vekrun is built to coordinate. Logos mean compatibility,
 * never endorsement.
 */
import Base from '@/layouts/Base.astro';
import ClosingCta from '@/components/ClosingCta.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import IntegrationLogo from '@/components/brand/IntegrationLogo.astro';
import { toolGroups, platforms } from '@/data/integrations';

const facts = [
  ['Your accounts, your bills', 'Model providers bill you directly. Vekrun never resells inference or adds a markup.'],
  ['Logins stay on your machine', 'Signed-in coding agents run on your own computer. Their credentials are never copied anywhere.'],
  ['You choose what agents can touch', 'Every connection asks before it reads or changes something new.'],
];
---
<Base title="Integrations" fullTitle="Integrations: keep the tools you love · Vekrun" description="Vekrun works with Claude Code, Codex, Gemini CLI, OpenRouter, GitHub, GitLab, Jira, Linear, Sentry, Ollama and more. Keep your tools; Vekrun coordinates the engineering around them.">
  <PageHero eyebrow="Integrations" title="Keep the tools you love. Let Vekrun coordinate them." lede="Bring your coding agents, models, repositories and trackers. Vekrun connects the work between them." />

  <section class="rule" aria-labelledby="openrouter-title">
    <div class="container-site py-14">
      <div class="feature reveal">
        <IntegrationLogo id="openrouter" name="OpenRouter" monogram="Or" size="lg" />
        <div>
          <h2 id="openrouter-title" class="text-[1.35rem] font-[620] tracking-[-0.02em] text-text">Every model through one connection.</h2>
          <p class="mt-2 max-w-2xl text-[1.0625rem] text-text-2">Connect OpenRouter once and give the Council or any job the model that fits. Billed by OpenRouter, separately from Vekrun.</p>
        </div>
      </div>
    </div>
  </section>

  {toolGroups.map((g, i) => (
    <section class:list={['group-sec rule', i % 2 === 0 && 'bg-bg-elevated']} aria-labelledby={`g-${g.key}`}>
      <div class="container-site group-in">
        <div class="reveal">
          <h2 id={`g-${g.key}`} class="heading-3 text-text">{g.title}</h2>
          <p class="mt-2 max-w-sm text-[0.98rem] text-text-2">{g.line}</p>
        </div>
        <ul class="tiles reveal-group">
          {g.tools.map((t) => <li><IntegrationLogo id={t.id} name={t.name} monogram={t.mono} /><span>{t.name}</span></li>)}
        </ul>
      </div>
    </section>
  ))}

  <section class="section-pad rule" aria-labelledby="platforms-title">
    <div class="container-site">
      <SectionHeading id="platforms-title" title="Built for whole products, not single repos." lede="An Expo app and its Rails API, a Shopify storefront, a Tauri desktop client. Vekrun is built to coordinate them together." class="reveal" />
      <ul class="plat reveal-group" aria-label="Platforms">
        {platforms.map((t) => <li><IntegrationLogo id={t.id} name={t.name} monogram={t.mono} size="sm" />{t.name}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-pad rule bg-bg-elevated" aria-labelledby="connect-title">
    <div class="container-site">
      <SectionHeading id="connect-title" title="Connecting is simple. Staying in control is the point." class="reveal" />
      <dl class="facts facts-grid facts-lg reveal-group mt-10">
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <p class="mt-10 text-[0.95rem] text-text-2 reveal">Each provider connects its own way: a signed-in CLI, a sign-in with the service, or an API key. How data is handled is on the <a href="/security/" class="text-accent link-slide">security page</a>.</p>
      <p class="mt-6 text-[0.8125rem] text-text-3">Logos are trademarks of their owners and show compatibility, not endorsement.</p>
    </div>
  </section>

  <ClosingCta title="Bring your tools. Vekrun does the coordinating." />
</Base>

<style>
  .feature { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; }
  .group-sec { padding-block: 3.5rem; }
  @media (min-width: 64rem) { .group-sec { padding-block: 4.5rem; } }
  .group-in { display: grid; gap: 1.75rem; }
  @media (min-width: 64rem) { .group-in { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 4rem; align-items: start; } }
  .tiles { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
  @media (min-width: 40rem) { .tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .tiles li { display: flex; align-items: center; gap: 0.75rem; min-width: 0; padding: 0.7rem 0.8rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); font-size: 0.95rem; font-weight: 520; color: var(--text); }
  .tiles li span:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .plat { margin: 2.5rem 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .plat li { display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.4rem 0.85rem 0.4rem 0.45rem; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); font-size: 0.95rem; color: var(--text); }
</style>
