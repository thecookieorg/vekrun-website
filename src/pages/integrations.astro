---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import IntegrationCatalog from '@/components/catalog/IntegrationCatalog.astro';
import { availability, site, type Availability } from '@/data/site';

const statuses = Object.keys(availability) as Availability[];
const title = 'Integrations';
const description = 'The AI models, coding tools, project trackers, Git hosts and developer services Vekrun connects to, and what each connection lets you do.';
---
<Base title={title} description={description}>
  <Section padded="tight" class="pt-16 sm:pt-20">
    <SectionHeading level="h1" title="Connect the tools you already use." lede="Your AI provider, your ticket tracker, your Git host and the services your work depends on, each connected with your own account." />
    <p class="mt-5 max-w-3xl text-[0.9375rem] leading-relaxed text-text-2">
      Hosted AI providers bill you directly. A consumer chat subscription is not an API key, and Vekrun never presents it as one. Setup steps live in the <a href="/docs/" class="text-accent underline underline-offset-2">documentation</a>.
    </p>
  </Section>

  <Section padded="tight" rule>
    <ul class="flex flex-wrap gap-x-8 gap-y-3" role="list" aria-label="What the statuses mean">
      {statuses.map((s) => (
        <li class="flex items-center gap-3 text-[0.875rem] text-text-2">
          <StatusBadge status={s} compact />
          <span>{availability[s].description}</span>
        </li>
      ))}
    </ul>
    <p class="mt-3 text-[0.8125rem] text-text-3">{site.status.meaning} Reconciled on {site.status.asOf}.</p>
  </Section>

  <Section rule padded="tight" class="pb-24">
    <IntegrationCatalog />
    <p class="mt-12 text-[0.9375rem] text-text-2">
      Connected trackers put your tickets on the <a href="/features/board/" class="text-accent underline underline-offset-2">Board</a>, one click from a branch, a terminal and an agent.
    </p>
  </Section>
</Base>
