---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import RoadmapBoard from '@/components/catalog/RoadmapBoard.astro';
import { roadmapStatuses, site, type RoadmapStatus } from '@/data/site';

const legend: RoadmapStatus[] = ['implemented', 'in-progress', 'planned', 'proposed', 'released'];
const dot: Record<string, string> = { ok: 'bg-ok', warn: 'bg-warn', muted: 'bg-text-3', info: 'bg-info', faint: 'bg-border-strong' };
const title = 'Roadmap';
const description = 'What is verified in the Vekrun development build, what is in development and what is planned: the AI Factory, isolated environments, coding agents, Board, Inbox, verification, Engineering Memory, Host and Mobile, Vekrun Teams and releases.';
---
<Base title={title} description={description}>
  <PageHero eyebrow="Roadmap" title="What works," accent="what is next." lede={`${site.status.line} Grouped by the experiences you will use. Nothing here is publicly released, and planned work is not promised to a date.`} align="left">
    <Fragment slot="status">
      <ul class="flex flex-wrap gap-x-6 gap-y-2" role="list" aria-label="What the statuses mean">
        {legend.map((s) => (
          <li class="flex items-center gap-2 text-[0.875rem] text-text-2">
            <span class:list={['h-2 w-2 rounded-full', dot[roadmapStatuses[s].tone]]} aria-hidden="true"></span>
            <span class="font-[540] text-text">{roadmapStatuses[s].label}</span>
            <span class="hidden text-text-3 lg:inline">{roadmapStatuses[s].description}</span>
          </li>
        ))}
      </ul>
      <p class="w-full text-[0.8125rem] text-text-3">{site.status.meaning} Reconciled on <time datetime={site.status.asOf}>{site.status.asOf}</time>.</p>
    </Fragment>
  </PageHero>

  <section class="container-site pt-10 pb-24">
    <RoadmapBoard />
    <p class="mt-12 text-[0.9375rem] text-text-2">
      The earlier engineering milestones are kept as history in <a href="/docs/advanced/progress/" class="text-accent link-slide">technical progress</a>. They describe the path to the development build, not the current plan.
    </p>
  </section>
</Base>
