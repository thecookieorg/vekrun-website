---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import RoadmapBoard from '@/components/catalog/RoadmapBoard.astro';
import { roadmapStatuses, site, type RoadmapStatus } from '@/data/site';

const legend: RoadmapStatus[] = ['implemented', 'in-progress', 'planned'];
const title = 'Roadmap';
const description = 'What you can do in Vekrun today, what is being built, and what is planned, grouped by terminal, AI coding, Board, AI Teams, code reviews and releases.';
---
<Base title={title} description={description}>
  <Section padded="tight" class="pt-16 sm:pt-20">
    <SectionHeading level="h1" title="What works, what is next." lede={site.status.line + ' This page tracks the capabilities you will use, not the engineering behind them.'} />
  </Section>

  <Section rule padded="tight">
    <ul class="flex flex-wrap gap-x-8 gap-y-3" role="list" aria-label="What the statuses mean">
      {legend.map((s) => (
        <li class="flex items-center gap-3 text-[0.875rem] text-text-2">
          <StatusBadge status={s} kind="roadmap" compact />
          <span>{roadmapStatuses[s].description}</span>
        </li>
      ))}
    </ul>
    <p class="mt-3 text-[0.8125rem] text-text-3">{site.status.meaning} Reconciled on <time datetime={site.status.asOf}>{site.status.asOf}</time>.</p>
  </Section>

  <Section rule padded="tight" class="pb-24">
    <RoadmapBoard />
    <p class="mt-12 text-[0.9375rem] text-text-2">
      Contributors can follow the engineering milestones in <a href="/docs/advanced/progress/" class="text-accent underline underline-offset-2">detailed technical progress</a>.
    </p>
  </Section>
</Base>
