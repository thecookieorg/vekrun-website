---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { site } from '@/data/site';
const title = 'Contact';
const description = 'How to reach the Vekrun project.';
---
<Base title={title} description={description}>
  <Section padded="tight" class="pt-16 sm:pt-20">
    <SectionHeading level="h1" title="Get in touch." lede="Public channels open with the source code. This page lists only what exists today." />
  </Section>
  <Section rule padded="tight" class="pb-24">
    <ul class="ruled-grid max-w-3xl" role="list">
      <li class="p-6">
        <h2 class="text-[1rem] font-[560] text-text">Bugs and ideas</h2>
        {site.repo.public ? (
          <p class="mt-2 text-[0.9rem] leading-relaxed text-text-2">
            Open an issue on <a href={`${site.repo.url}/issues`} class="text-accent underline underline-offset-2" target="_blank" rel="noopener noreferrer">GitHub</a>.
            {site.contact.discussionsUrl && <> Questions go to <a href={site.contact.discussionsUrl} class="text-accent underline underline-offset-2" target="_blank" rel="noopener noreferrer">discussions</a>.</>}
          </p>
        ) : (
          <p class="mt-2 text-[0.9rem] leading-relaxed text-text-2">GitHub issues open when the source repository does. The link will appear here.</p>
        )}
      </li>
      <li class="p-6">
        <h2 class="text-[1rem] font-[560] text-text">Everything else</h2>
        {site.contact.generalEmail ? (
          <p class="mt-2 text-[0.9rem] leading-relaxed text-text-2">Email <strong class="text-text">{site.contact.generalEmail}</strong>.</p>
        ) : (
          <p class="mt-2 text-[0.9rem] leading-relaxed text-text-2">A public address will be published before the first release.</p>
        )}
      </li>
      <li class="p-6">
        <h2 class="text-[1rem] font-[560] text-text">Security</h2>
        <p class="mt-2 text-[0.9rem] leading-relaxed text-text-2">Never in a public issue. See the <a href="/security/" class="text-accent underline underline-offset-2">security page</a>.</p>
      </li>
    </ul>
  </Section>
</Base>
