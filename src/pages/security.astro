---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { site } from '@/data/site';

const commitments = [
  { title: 'Nothing an agent reads is trusted', body: 'Text in your repository, model replies, tool results and terminal output are treated as untrusted input. Your permissions decide what an agent may do, not the prompt.' },
  { title: 'Keys stay in your keychain', body: 'API keys are stored by your operating system, kept out of logs and the interface by design, and not handed to tools or remote machines unless you say so.' },
  { title: 'Deny by default', body: 'An agent can only do what you have allowed. Every action that touches files, commands, Git or the network is recorded.' },
  { title: 'Limits are stated', body: 'How well an agent is isolated differs by operating system. Vekrun says what each platform can and cannot enforce instead of glossing over it.' },
];
const scope = [
  'Any way for an agent, an integration or content in a repository to act outside your permissions.',
  'Any exposure of API keys or credentials.',
  'Any way for an interrupted task to repeat a command that should run once.',
  'Any way to reach Vekrun from outside your machine without being allowed to.',
  'Problems in how Vekrun is built, released or updated.',
];
const title = 'Security';
const description = 'How Vekrun handles untrusted input, your API keys and agent permissions, and how to report a vulnerability.';
---
<Base title={title} description={description}>
  <Section padded="tight" class="pt-16 sm:pt-20">
    <SectionHeading level="h1" title="Agents act on your behalf. These are the rules they follow." lede="Vekrun runs commands, edits files and talks to AI providers for you. Four commitments shape how it does that." />
  </Section>

  <Section rule padded="tight">
    <ul class="ruled-grid sm:grid-cols-2" role="list">
      {commitments.map((c) => (
        <li class="p-6">
          <h2 class="text-[1rem] font-[560] text-text">{c.title}</h2>
          <p class="mt-2 text-[0.9rem] leading-relaxed text-text-2">{c.body}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section rule padded="tight" class="pb-24">
    <div class="grid gap-10 lg:grid-cols-2">
      <div class="prose-site">
        <h2 class="!mt-0">Reporting a vulnerability</h2>
        <p>Please report security problems privately, never in a public issue.</p>
        {site.contact.securityEmail ? (
          <p>Email <strong>{site.contact.securityEmail}</strong> with steps to reproduce, your platform and the Vekrun version. You will hear back within seven days.</p>
        ) : (
          <p>A security address will be published here before the first public release. Once the source repository is public, GitHub's private vulnerability reporting will also work. Include steps to reproduce, your platform and the Vekrun version; reports are acknowledged within seven days.</p>
        )}
        <p>There are no releases yet. Once there are, the latest release is supported.</p>
      </div>
      <div class="prose-site">
        <h2 class="!mt-0">What counts</h2>
        <ul>{scope.map((s) => <li>{s}</li>)}</ul>
      </div>
    </div>
  </Section>
</Base>
