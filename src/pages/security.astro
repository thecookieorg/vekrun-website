---
/**
 * Security: how Vekrun handles untrusted input, credentials, isolation and
 * approvals, the shared responsibility of self-hosting, and how to report a
 * vulnerability. No certifications are claimed.
 */
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { site } from '@/data/site';

const rules = [
  ['Nothing an agent reads is trusted', 'Repository text, model replies and tool output are untrusted input. Your permissions decide what an agent may do, not the prompt.'],
  ['Deny by default', 'Agents can only do what you’ve allowed. Every action on files, commands, Git or the network is recorded.'],
  ['Keys stay in your keychain', 'Your operating system stores API keys. They stay out of logs and out of the interface.'],
  ['Logins stay on your machine', 'Coding agents stay signed in on your computer. Their logins are never copied into a job’s environment.'],
  ['One environment per job', 'Each piece of work runs isolated. Isolation reduces risk; it doesn’t make a malicious dependency harmless.'],
  ['People approve what matters', 'Merges follow your branch protections. Production commands run only under explicit policy and approval.'],
];
---
<Base title="Security" fullTitle="Security · Vekrun" description="How Vekrun handles untrusted input, credentials, isolated environments and approvals, what self-hosting Vekrun Teams changes, and how to report a vulnerability.">
  <PageHero eyebrow="Security" title="Agents act for you. These are their rules." lede="Vekrun runs commands, edits code and talks to model providers on your behalf. Here’s how it keeps that safe." />

  <section class="rule py-14" aria-label="Security rules">
    <div class="container-site">
      <dl class="facts facts-grid facts-lg">{rules.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
    </div>
  </section>

  <section class="rule bg-bg-elevated py-14" aria-labelledby="shared">
    <div class="container-site prose-site max-w-3xl">
      <h2 id="shared" class="!mt-0">Self-hosting is shared responsibility</h2>
      <p>With Vekrun Teams you run the Coordinator, its data and the workers. You control where code and records live, and you own access, patching, backups and network exposure for those servers. Vekrun stays responsible for the software: secure defaults, timely updates and honest security notices.</p>
      <p>Model providers you connect receive what a job sends them, under your accounts and their terms. Local models keep that on your hardware.</p>
      <p>Vekrun holds no SOC 2 report or other certification, and doesn’t claim end-to-end encryption or zero access.</p>
    </div>
  </section>

  <section class="rule pb-24 pt-14" aria-labelledby="report">
    <div class="container-site prose-site max-w-3xl">
      <h2 id="report" class="!mt-0">Reporting a vulnerability</h2>
      {site.contact.securityEmail ? (
        <p>Email <strong>{site.contact.securityEmail}</strong> with steps to reproduce, your platform and the Vekrun version. You’ll hear back within seven days.</p>
      ) : (
        <p>Please report privately, never in a public issue. A security address will be published here before the first release.</p>
      )}
    </div>
  </section>
</Base>
