---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageHero from '@/components/PageHero.astro';
import { site } from '@/data/site';

const commitments = [
  { title: 'Nothing an agent reads is trusted', body: 'Text in your repository, model replies, tool results and terminal output are treated as untrusted input. Your permissions decide what an agent may do, not the prompt.' },
  { title: 'Keys stay in your keychain', body: 'API keys are stored by your operating system, kept out of logs and the interface by design, and not handed to tools or remote machines unless you say so.' },
  { title: 'Deny by default', body: 'An agent can only do what you have allowed. Every action that touches files, commands, Git or the network is recorded.' },
  { title: 'Logins stay on the Host', body: 'Coding CLIs stay signed in on your machine. Vekrun never copies their logins or sessions into a job’s environment, and seeds jobs with code without handing over your Git credentials.' },
  { title: 'One environment per job', body: 'Each Work Item is planned to run in its own isolated environment. Isolation reduces risk; it does not make a malicious dependency or a bad change harmless, and limits differ by operating system.' },
  { title: 'People approve consequential actions', body: 'Merges follow your branch protections. Production commands and deploys run only under explicit policy and approval.' },
  { title: 'Limits are stated', body: 'Vekrun says what each platform can and cannot enforce instead of glossing over it. It claims no certification it does not have.' },
];
const scope = [
  'Any way for an agent, an integration or content in a repository to act outside your permissions.',
  'Any exposure of API keys or credentials.',
  'Any way for an interrupted task to repeat a command that should run once.',
  'Any way to reach a Vekrun Host or Coordinator from outside without being allowed to.',
  'Any way for a job to escape its environment or reach a login it should not.',
  'Problems in how Vekrun is built, released or updated.',
];
const title = 'Security';
const description = 'How Vekrun handles untrusted input, credentials, isolated environments and approvals, what self-hosting Vekrun Teams does and does not change, and how to report a vulnerability.';
---
<Base title={title} description={description}>
  <PageHero eyebrow="Security" title="Agents act on your behalf." accent="These are the rules they follow." lede="Vekrun runs commands, edits files and talks to model providers for you. These commitments shape how it does that." align="left" />

  <Section padded="tight">
    <ul class="ruled-grid sm:grid-cols-2 lg:grid-cols-3" role="list">
      {commitments.map((c) => (
        <li class="p-6">
          <h2 class="text-[1rem] font-[560] text-text">{c.title}</h2>
          <p class="mt-2 text-[0.9rem] leading-relaxed text-text-2">{c.body}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section rule padded="tight" aria-labelledby="shared">
    <div class="prose-site max-w-3xl">
      <h2 id="shared" class="!mt-0">Self-hosted Teams: shared responsibility</h2>
      <p>With Vekrun Teams, your organization runs the Coordinator, its data store and the workers. That gives you control over where code, records and audit history live. It also makes you responsible for those servers: access, patching, backups, network exposure and secrets management.</p>
      <p>Vekrun remains responsible for the software it ships: secure defaults, timely updates and honest security notices. Self-hosting does not exempt anyone from those duties, and it does not stop model providers from receiving what a job sends them.</p>
      <p>Vekrun holds no SOC 2 report or other certification, and does not claim end-to-end encryption or zero access. If that changes, this page will say exactly what is covered.</p>
    </div>
  </Section>

  <Section rule padded="tight" class="pb-24">
    <div class="grid gap-10 lg:grid-cols-2">
      <div class="prose-site">
        <h2 class="!mt-0">Reporting a vulnerability</h2>
        <p>Please report security problems privately, never in a public issue.</p>
        {site.contact.securityEmail ? (
          <p>Email <strong>{site.contact.securityEmail}</strong> with steps to reproduce, your platform and the Vekrun version. You will hear back within seven days.</p>
        ) : (
          <p>A security address will be published here before the first public release. Include steps to reproduce, your platform and the Vekrun version; reports will be acknowledged within seven days.</p>
        )}
        <p>There are no releases yet. Once there are, the latest release is supported.</p>
      </div>
      <div class="prose-site">
        <h2 class="!mt-0">What counts</h2>
        <ul>{scope.map((s) => <li>{s}</li>)}</ul>
      </div>
    </div>
  </Section>
</Base>
