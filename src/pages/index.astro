---
/**
 * The homepage, in five acts and nothing more:
 *   1. The promise and the stage: one Work Item from request to pull request.
 *   2. The differentiator: Competitive Engineering.
 *   3. One complete journey: context, plan, build, verify, proof, review.
 *   4. Memory that compounds, with a short bridge to Teams.
 *   5. Your rules (models, infrastructure, approvals), then the two plans.
 * Everything else (the capability detail, provider catalogues, Live Share,
 * Before & After) lives on Product, Integrations and the supporting pages.
 */
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import EngineHero from '@/components/home/EngineHero.astro';
import StackMarquee from '@/components/liveshare/StackMarquee.astro';
import JourneyDemo from '@/components/home/JourneyDemo.astro';
import MemoryBridge from '@/components/home/MemoryBridge.astro';
import CompeteDemo from '@/components/compete/CompeteDemo.astro';
import Button from '@/components/Button.astro';
import { site, personalCta, teamsInterestMailto, teamsPricing, usd } from '@/data/site';
import { ArrowRight, Check, Laptop, Server, Lock } from '@lucide/astro';

const free = ['Your own AI engineering team, on your Mac', 'Competitive Engineering and Proof Packs', 'Personal Engineering Memory', 'Work Anywhere on your own VPS'];
const teams = ['Connected AI Factories and coordination', 'Shared verified Proof Packs and memory', 'SSO, safeguards and organization policies', 'Connected Desktops or your own Coordinator'];

const structuredData = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: site.url, logo: `${site.url}/brand/vekrun-mark-dark-512.png`, email: site.earlyAccess.email },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url },
  {
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: site.name, applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS', description: site.description, url: site.url,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', name: 'Vekrun Free' },
  },
];
---
<Base title={site.name} fullTitle={`${site.name} · ${site.headline}`} description={site.description} structuredData={structuredData} page="home">
  <!-- Act 1: the promise and the stage -->
  <PageHero breakTitle title={site.headline} subtitle={site.subheadline} lede="Describe what you want built. Vekrun plans it, builds competing approaches, verifies the work and hands you a pull request with the evidence." cta={personalCta} secondary={{ label: 'See it in action', href: '#demo' }} class="home-hero" wide>
    <p slot="after" class="hero-line enter" style="--i: 4">Free for individuals. Runs with the models you choose, including local ones.</p>
    <EngineHero />
    <div class="hero-stacks">
      <p class="hero-stacks-k">Builds, tests and previews the stack you already use</p>
      <StackMarquee label="Stacks Vekrun works with" />
    </div>
  </PageHero>

  <!-- Act 2: the differentiator -->
  <section id="competitive" class="act act-alt scroll-mt-16" aria-labelledby="competitive-title">
    <div class="container-site"><div class="act-head">
      <p class="act-k">Competitive Engineering</p>
      <h2 id="competitive-title" class="act-h">Don’t guess which approach is better. Build both. Prove it.</h2>
      <p class="act-l">One task, two independent implementations from the same commit, the same acceptance criteria. You choose with evidence, and when neither qualifies, Vekrun tells you.</p>
    </div></div>
    <div class="container-wide act-stage"><CompeteDemo /></div>
    <div class="container-site"><a href="/product/#competitive" class="link-more group act-more">How Competitive Engineering works<ArrowRight class="icon-nudge h-4 w-4" aria-hidden="true" /></a></div>
  </section>

  <!-- Act 3: one complete journey -->
  <section id="journey" class="act scroll-mt-16" aria-labelledby="journey-title">
    <div class="container-site"><div class="act-head">
      <p class="act-k">One engineering journey</p>
      <h2 id="journey-title" class="act-h">From request to reviewed pull request.</h2>
      <p class="act-l">Vekrun handles the engineering workflow. You keep the decisions.</p>
    </div></div>
    <div class="container-site act-stage"><JourneyDemo /></div>
    <div class="container-site"><a href="/how-it-works/" class="link-more group act-more">Walk through the whole workflow<ArrowRight class="icon-nudge h-4 w-4" aria-hidden="true" /></a></div>
  </section>

  <!-- Act 4: memory that compounds -->
  <section id="memory" class="act act-alt scroll-mt-16" aria-labelledby="memory-title">
    <div class="container-site"><div class="act-head">
      <p class="act-k">Engineering Memory</p>
      <h2 id="memory-title" class="act-h">The next task starts where the last one finished.</h2>
      <p class="act-l">What Vekrun proves and decides is remembered with its sources and revision, and it’s checked for freshness before it’s reused. No more re-explaining your repository.</p>
    </div></div>
    <div class="container-site act-stage"><MemoryBridge /></div>
    <div id="team-memory" class="container-site"><div class="bridge">
      <div>
        <h3 class="bridge-h">Your engineering organization, working as one.</h3>
        <p class="bridge-l">Vekrun Teams shares that memory, and much more: every developer’s Factory, Proof Packs, handoffs and safeguards, connected on their own Macs or a server you control.</p>
      </div>
      <a href="/teams/" class="link-more group">Explore Vekrun Teams<ArrowRight class="icon-nudge h-4 w-4" aria-hidden="true" /></a>
    </div></div>
  </section>

  <!-- Act 5: your rules, then the choice -->
  <section id="control" class="act scroll-mt-16" aria-labelledby="control-title">
    <div class="container-site ctl">
      <div>
        <p class="act-k">Your rules</p>
        <h2 id="control-title" class="act-h">Your models. Your infrastructure. Your rules.</h2>
        <p class="act-l">Run on your Mac, or send the heavy work to your own VPS with Work Anywhere. Pick your models and agents. Git, verification and approvals stay yours, and nothing needs Vekrun-hosted compute.</p>
        <p id="models" class="ctl-models">Models through OpenRouter, xAI, or locally with Ollama and LM Studio. Claude Code, Codex, Antigravity CLI and Grok Build are optional. <a href="/integrations/" class="text-accent link-slide">All integrations</a></p>
      </div>
      <figure class="map" aria-label="Your Mac runs Vekrun and connects privately to a worker on your own server">
        <div class="map-n"><span class="map-ic"><Laptop class="h-5 w-5" aria-hidden="true" /></span><b>Your Mac</b><span>Vekrun, your decisions</span></div>
        <div class="map-l" aria-hidden="true"><span></span><em><Lock class="h-3.5 w-3.5" />private connection</em><span></span></div>
        <div class="map-n"><span class="map-ic"><Server class="h-5 w-5" aria-hidden="true" /></span><b>Your VPS</b><span>Builds, tests, Work Items</span></div>
      </figure>
    </div>

    <div id="pricing" class="container-site plans scroll-mt-16">
      <article class="plan">
        <h3>Free</h3>
        <p class="plan-p"><b>$0</b> forever, for individual developers</p>
        <ul>{free.map((f) => <li><Check class="h-4 w-4" aria-hidden="true" />{f}</li>)}</ul>
        <div class="plan-a"><Button href={personalCta.href}>{personalCta.label}</Button></div>
      </article>
      <article class="plan is-teams">
        <h3>Teams</h3>
        <p class="plan-p"><b>{usd(teamsPricing.base)}</b> a month includes {teamsPricing.included} developers, plus {usd(teamsPricing.perExtra)} for each additional developer</p>
        <ul>{teams.map((f) => <li><Check class="h-4 w-4" aria-hidden="true" />{f}</li>)}</ul>
        <div class="plan-a"><Button href="/teams/" variant="secondary">Explore Teams</Button><a href={teamsInterestMailto} class="text-accent link-slide text-[0.9rem]">Register interest</a></div>
      </article>
    </div>
    <p class="container-site plans-note">Early access is by email, and Teams starts with a conversation. <a href="/pricing/" class="text-accent link-slide">Compare plans</a></p>
    <div class="container-site"><p class="stackline">Works in the repositories you already have: Rails, Laravel, Django, Next.js, Expo, Flutter, Swift, Kotlin and more.</p></div>
  </section>
</Base>

<style>
  :global(.home-hero) { padding-top: 4rem !important; padding-bottom: 4.5rem !important; }
  @media (min-width: 64rem) { :global(.home-hero) { padding-top: 6rem !important; padding-bottom: 6rem !important; } }
  :global(.home-hero .display) { font-size: clamp(2.5rem, 1.5rem + 4vw, 4.75rem); }
  :global(.home-hero .page-hero-stage) { margin-top: 3.5rem !important; }
  .hero-stacks { margin-top: 3rem; }
  .hero-stacks-k { margin: 0; text-align: center; font-size: 0.9rem; color: var(--foreground-secondary); }
  .hero-line { margin: 1.25rem 0 0; font-size: 0.9rem; color: var(--foreground-secondary); }

  .act { padding-block: 5.5rem; border-top: 1px solid var(--border); }
  @media (min-width: 64rem) { .act { padding-block: 7.5rem; } }
  .act-alt { background: var(--bg-elevated, var(--surface)); }
  .act-head { max-width: 56rem; }
  .act-k { margin: 0; font-size: 0.9rem; font-weight: 560; color: var(--accent-text); }
  .act-h { margin: 0.8rem 0 0; max-width: 22ch; font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem); line-height: 1.06; font-weight: 660; letter-spacing: -0.035em; color: var(--foreground); }
  .act-l { margin: 1.25rem 0 0; max-width: 40rem; font-size: 1.13rem; line-height: 1.55; color: var(--foreground-secondary); }
  .act-stage { margin-top: 3.5rem; }
  .act-more { margin-top: 2.25rem; }

  .bridge { margin-top: 5rem; display: grid; gap: 1.25rem; padding-top: 2.5rem; border-top: 1px solid var(--border); }
  @media (min-width: 64rem) { .bridge { grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 3rem; } }
  .bridge-h { margin: 0; max-width: 26ch; font-size: clamp(1.45rem, 1.1rem + 1.2vw, 2rem); line-height: 1.2; font-weight: 640; letter-spacing: -0.025em; color: var(--foreground); }
  .bridge-l { margin: 0.75rem 0 0; max-width: 38rem; font-size: 1rem; line-height: 1.55; color: var(--foreground-secondary); }

  .ctl { display: grid; gap: 3rem; }
  @media (min-width: 64rem) { .ctl { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 4rem; align-items: center; } }
  .ctl .act-h { font-size: clamp(2rem, 1.3rem + 2vw, 2.9rem); }
  .ctl-models { margin: 1.5rem 0 0; max-width: 40rem; font-size: 0.95rem; line-height: 1.55; color: var(--foreground-secondary); }
  .map { margin: 0; display: grid; gap: 0.5rem; justify-items: stretch; }
  @media (min-width: 30rem) { .map { grid-template-columns: minmax(0, 1fr) 6.5rem minmax(0, 1fr); align-items: center; gap: 0; } }
  .map-n { display: grid; justify-items: start; gap: 0.25rem; padding: 1.1rem; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); }
  .map-n b { font-size: 1rem; font-weight: 620; color: var(--foreground); }
  .map-n > span:last-child { font-size: 0.84rem; color: var(--foreground-secondary); }
  .map-ic { display: inline-grid; place-items: center; width: 2.25rem; height: 2.25rem; margin-bottom: 0.4rem; border-radius: var(--radius-sm); background: var(--accent-subtle); color: var(--accent-text); }
  .map-l { display: flex; flex-direction: column; align-items: center; gap: 0.3rem; padding: 0.3rem 0; }
  @media (min-width: 30rem) { .map-l { flex-direction: row; } }
  .map-l span { flex: 1; width: 2px; min-height: 1rem; background: var(--border-interactive); }
  @media (min-width: 30rem) { .map-l span { width: auto; height: 2px; min-height: 0; } }
  .map-l em { display: inline-flex; align-items: center; gap: 0.25rem; font-style: normal; font-size: 0.7rem; white-space: nowrap; color: var(--foreground-secondary); }
  @media (min-width: 30rem) { .map-l em { flex-direction: column; text-align: center; white-space: normal; padding: 0 0.3rem; } }

  .plans { margin-top: 6rem; display: grid; gap: 0.9rem; }
  @media (min-width: 48rem) { .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .plan { display: flex; flex-direction: column; padding: 1.6rem; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); }
  .plan.is-teams { border-color: var(--border-interactive); }
  .plan h3 { margin: 0; font-size: 1.2rem; font-weight: 640; color: var(--foreground); }
  .plan-p { margin: 0.5rem 0 0; font-size: 0.95rem; line-height: 1.5; color: var(--foreground-secondary); }
  .plan-p b { font-size: 1.6rem; font-weight: 660; letter-spacing: -0.02em; color: var(--foreground); }
  .plan ul { margin: 1.25rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.5rem; }
  .plan li { display: flex; gap: 0.5rem; align-items: flex-start; font-size: 0.95rem; color: var(--foreground); }
  .plan li :global(svg) { margin-top: 0.2rem; flex-shrink: 0; color: var(--accent-text); }
  .plan-a { margin-top: auto; padding-top: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; }
  .plans-note { margin-top: 1.25rem; font-size: 0.88rem; color: var(--foreground-secondary); }
  .stackline { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border); font-size: 0.9rem; color: var(--foreground-secondary); }
</style>
