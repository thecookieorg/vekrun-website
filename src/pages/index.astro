---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import ProductPreview from '@/components/home/ProductPreview.astro';
import BoardDemo from '@/components/home/BoardDemo.astro';
import TeamsFlow from '@/components/home/TeamsFlow.astro';
import GithubMark from '@/components/GithubMark.astro';
import { site, featurePages } from '@/data/site';
import { Terminal, Columns2, Search, Network, KeyRound, HardDrive, Link2, ArrowUpRight } from '@lucide/astro';

const terminalPoints = [
  { icon: Columns2, title: 'Tabs and splits', text: 'Arrange shells the way you work. Splits never restart a shell.' },
  { icon: Network, title: 'SSH built in', text: 'Open remote shells with host keys you have checked.' },
  { icon: Search, title: 'Search and restore', text: 'Find anything in scrollback. Pick up where you left off after a restart.' },
  { icon: Terminal, title: 'Your shell, your keys', text: 'Bash, Zsh, Fish, PowerShell or WSL, with themes and keybindings you set.' },
];

const aiModes = [
  { icon: KeyRound, title: 'Your API key', text: 'Connect Claude, OpenAI, Gemini or any OpenAI-compatible endpoint. You pay the provider directly, and keys stay in your OS keychain.', providers: ['Anthropic', 'OpenAI', 'Google Gemini', 'OpenAI-compatible'] },
  { icon: HardDrive, title: 'A local model', text: 'Use Ollama or LM Studio and nothing leaves your machine.', providers: ['Ollama', 'LM Studio'] },
  { icon: Link2, title: 'A coding-agent account you already pay for', text: 'Planned. Only through each provider’s supported sign-in, and never required.', providers: ['Claude Code', 'Codex', 'Gemini CLI'], planned: true },
];

const reviewPoints = [
  'See the pull requests waiting for your review.',
  'Open a teammate’s changes and read the diff where you code.',
  'Ask AI to point out problems before you do.',
  'Compare findings from several models when it matters.',
  'Leave your feedback without leaving Vekrun.',
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: site.name,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Windows, Linux',
    description: site.description,
    url: site.url,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    softwareHelp: `${site.url}/docs/`,
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url },
];
---
<Base title={`${site.name}: ${site.headline}`} description={site.description} structuredData={structuredData}>
  <!-- Hero -->
  <section class="relative overflow-hidden" aria-labelledby="hero-title">
    <div class="dot-field pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-site relative pt-16 pb-10 sm:pt-24 sm:pb-14 lg:pt-28">
      <div class="max-w-4xl">
        <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-border bg-surface/60 px-3 py-1.5 text-[0.8125rem] text-text-2">
          <span class="h-1.5 w-1.5 rounded-full bg-warn" aria-hidden="true"></span>
          Free and open source. {site.status.label}, no public release yet.
        </p>
        <h1 id="hero-title" class="display">
          <span class="block">Your terminal.</span>
          <span class="block">Your AI.</span>
          <span class="block text-accent">Your workflow.</span>
        </h1>
        <p class="lede mt-7 max-w-2xl">{site.subheading}</p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <Button href="#board" size="lg">See how it works</Button>
          <Button href="/roadmap/" size="lg" variant="secondary">View roadmap</Button>
          {site.repo.public && <Button href={site.repo.url} size="lg" variant="ghost" external><GithubMark /> GitHub</Button>}
        </div>
      </div>
    </div>
  </section>

  <!-- Product preview -->
  <Section padded="none" class="pb-20 sm:pb-24 lg:pb-28">
    <div class="reveal"><ProductPreview /></div>
    <p class="measure-wide mt-8 text-[0.9375rem] leading-relaxed text-text-2">
      A ticket from your Board, taken to a reviewed pull request. The agent plans, you approve, it builds and tests on its own branch, a second agent checks the work, and nothing merges until you say so.
    </p>
  </Section>

  <!-- A. A better terminal -->
  <Section rule aria-labelledby="terminal-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <SectionHeading id="terminal-title" title="A better terminal" lede="A modern terminal for everyday development. It works with no AI connected, and it stays fast when AI is slow.">
        <a href="/features/terminal/" class="mt-6 inline-flex items-center gap-1.5 text-[0.9375rem] font-[540] text-accent hover:underline hover:underline-offset-4">More about the terminal<ArrowUpRight class="h-4 w-4" aria-hidden="true" /></a>
      </SectionHeading>
      <ul class="grid gap-x-8 gap-y-7 sm:grid-cols-2">
        {terminalPoints.map((p) => (
          <li class="flex gap-3.5">
            <p.icon class="mt-0.5 h-5 w-5 shrink-0 text-accent" aria-hidden="true" />
            <div>
              <h3 class="text-[1.0625rem] font-[560] text-text">{p.title}</h3>
              <p class="mt-1 text-[0.9375rem] leading-relaxed text-text-2">{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- B. Bring your own AI -->
  <Section rule tone="elevated" aria-labelledby="byo-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <SectionHeading id="byo-title" title="Bring your own AI" lede="Use the models you already trust. No Vekrun subscription, no lock-in to one provider, and nothing is sent anywhere without you seeing it first.">
        <p class="mt-5 text-[0.9rem] leading-relaxed text-text-3">Hosted providers bill you at their own rates. Local models are free to run.</p>
        <a href="/features/ai-coding/" class="mt-5 inline-flex items-center gap-1.5 text-[0.9375rem] font-[540] text-accent hover:underline hover:underline-offset-4">More about AI coding<ArrowUpRight class="h-4 w-4" aria-hidden="true" /></a>
      </SectionHeading>
      <ul class="divide-y divide-border border-y border-border">
        {aiModes.map((m) => (
          <li class="flex gap-4 py-6">
            <m.icon class="mt-1 h-5 w-5 shrink-0 text-accent" aria-hidden="true" />
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                <h3 class="text-[1.0625rem] font-[560] text-text">{m.title}</h3>
                {m.planned && <StatusBadge status="planned" compact />}
              </div>
              <p class="mt-1 max-w-xl text-[0.9375rem] leading-relaxed text-text-2">{m.text}</p>
              <ul class="mt-3 flex flex-wrap gap-2" aria-label="Providers">
                {m.providers.map((p) => <li class="rounded-md border border-border bg-surface px-2 py-1 text-[0.8125rem] text-text-2">{p}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- C. Your tasks, ready to build -->
  <Section id="board" rule aria-labelledby="board-title">
    <SectionHeading id="board-title" title="Your tasks, ready to build" lede="Connect Jira, Linear or Asana. See the tickets assigned to you. Click Start Work and you have a branch, a worktree and a terminal, with the ticket as context for you or an agent." />
    <ol class="mt-8 flex flex-wrap gap-x-2 gap-y-2 text-[0.9375rem] text-text-2" aria-label="The Start Work flow">
      {['Connect your tracker', 'See your assigned tickets', 'Click Start Work', 'Start coding'].map((s, i, arr) => (
        <li class="flex items-center gap-2">
          <span class="font-[540] text-text">{s}</span>
          {i < arr.length - 1 && <span class="text-text-3" aria-hidden="true">›</span>}
        </li>
      ))}
    </ol>
    <div class="mt-10 reveal"><BoardDemo /></div>
    <p class="mt-8 text-[1.0625rem] font-[540] text-text">Your tasks, your terminal, and your AI, all connected.</p>
    <div class="mt-5"><Button href="/features/board/" variant="secondary">More about the Board</Button></div>
  </Section>

  <!-- D. AI coding teams -->
  <Section rule tone="elevated" aria-labelledby="teams-title">
    <SectionHeading id="teams-title" title="AI coding teams" lede="For work that is bigger than one conversation: agents plan it, implement and test it on separate branches, a different agent reviews the result, and you keep the final say." />
    <div class="mt-10 reveal"><TeamsFlow /></div>
    <p class="mt-6 max-w-2xl text-[0.9375rem] leading-relaxed text-text-2">
      Every stage is optional. Small tasks go straight to a single agent, and a plan review by several models is there when a decision matters.
    </p>
    <div class="mt-6"><Button href="/ai-teams/" variant="secondary">More about AI Teams</Button></div>
  </Section>

  <!-- E. Code reviews in one place -->
  <Section rule aria-labelledby="review-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <SectionHeading id="review-title" title="Code reviews in one place" lede="Pull requests, AI findings and your feedback, side by side with the code.">
        <p class="mt-5 flex items-center gap-2 text-[0.875rem] text-text-3"><StatusBadge status="planned" compact /> The pull-request inbox is planned. AI review of local branches works today.</p>
        <a href="/features/code-review/" class="mt-5 inline-flex items-center gap-1.5 text-[0.9375rem] font-[540] text-accent hover:underline hover:underline-offset-4">More about code reviews<ArrowUpRight class="h-4 w-4" aria-hidden="true" /></a>
      </SectionHeading>
      <ul class="divide-y divide-border border-y border-border">
        {reviewPoints.map((p) => <li class="py-3.5 text-[1rem] text-text-2">{p}</li>)}
      </ul>
    </div>
  </Section>

  <!-- Open source, briefly -->
  <Section rule tone="elevated" padded="tight" aria-labelledby="oss-title">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <h2 id="oss-title" class="heading-3">Free and open source</h2>
        <p class="mt-2 text-[0.9375rem] leading-relaxed text-text-2">No account, no subscription, no hosted service in the middle.</p>
      </div>
      <div>
        <h3 class="heading-3">Runs on your machine</h3>
        <p class="mt-2 text-[0.9375rem] leading-relaxed text-text-2">Sessions, memory and credentials stay local. You can see what is sent to a provider before it goes.</p>
      </div>
      <div>
        <h3 class="heading-3">You set the permissions</h3>
        <p class="mt-2 text-[0.9375rem] leading-relaxed text-text-2">Agents write files and run commands only when you allow it. <a href="/open-source/" class="text-accent hover:underline hover:underline-offset-4">Why we build it this way</a>.</p>
      </div>
    </div>
  </Section>

  <!-- Feature index + CTA -->
  <Section rule aria-labelledby="cta-title">
    <div class="max-w-3xl">
      <h2 id="cta-title" class="heading-1">Your development environment should belong to you.</h2>
      <p class="lede mt-5">One terminal. Any supported model. Your tasks and reviews where you write the code.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/roadmap/" size="lg">See what is ready</Button>
        <Button href="/docs/" size="lg" variant="secondary">Read the docs</Button>
      </div>
    </div>
    <ul class="mt-16 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-5">
      {featurePages.map((f) => (
        <li>
          <a href={f.href} class="flex min-w-0 flex-col gap-1 border-t border-border py-4 transition-colors hover:border-border-strong">
            <span class="text-[0.9375rem] font-[540] text-text">{f.label}</span>
            <span class="text-[0.8125rem] leading-snug text-text-3">{f.description}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-10 text-[0.8125rem] text-text-3">{site.status.line} Status as of {site.status.asOf}.</p>
  </Section>
</Base>
