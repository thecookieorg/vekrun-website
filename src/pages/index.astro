---
/**
 * The homepage. Vekrun is an AI software engineering Factory: the hero is the
 * Factory itself (a Coordinator composer and jobs across projects), and every
 * section after it answers one question a new visitor has, in order.
 */
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FactoryHero from '@/components/factory/FactoryHero.astro';
import JobFlow from '@/components/factory/JobFlow.astro';
import ParallelLanes from '@/components/factory/ParallelLanes.astro';
import AgentBridge from '@/components/factory/AgentBridge.astro';
import ProofPack from '@/components/factory/ProofPack.astro';
import MemoryInsights from '@/components/factory/MemoryInsights.astro';
import MobileHost from '@/components/factory/MobileHost.astro';
import PlanCards from '@/components/teams/PlanCards.astro';
import { site, primaryCta } from '@/data/site';
import { hasRelease } from '@/data/releases';
import { Check, MessageSquareText, SquareKanban, Siren, ArrowUpRight } from '@lucide/astro';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: site.name,
    applicationCategory: 'DeveloperApplication',
    description: site.description,
    url: site.url,
    softwareHelp: `${site.url}/docs/`,
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url },
];
const cta = hasRelease ? { label: primaryCta.releasedLabel, href: primaryCta.releasedHref } : { label: primaryCta.label, href: primaryCta.href };
const contrast = [
  ['Writes and edits code in a session', 'Owns the outcome from the goal to a reviewed pull request'],
  ['Works in the directory you give it', 'Gives each Work Item its own isolated environment'],
  ['Forgets when the session ends', 'Keeps durable Work Items, a journal and Engineering Memory'],
  ['Reports that it is done', 'Runs the checks, then has an independent verifier inspect the result'],
  ['Stops when it hits a limit', 'Routes to another capable worker and hands over the context'],
  ['One engineer, one terminal', 'Shared Board, Inbox and queues for a whole team'],
];
const starts = [
  { i: MessageSquareText, k: 'Describe the outcome', t: 'Build a feature in an existing repository.', d: 'Say what should be true when the work is done. New projects work the same way.', ex: 'Add CSV export to the monthly report, with the same filters as the table', href: '/features/factory/' },
  { i: SquareKanban, k: 'Start from your Board', t: 'Pick up tickets, issues and reviews.', d: 'Jira, Linear, Asana, GitHub and GitLab work arrives on one Board, ready to become a Factory job.', ex: 'ENG-418 · Add CSV export to reports · assigned to you', href: '/features/board/' },
  { i: Siren, k: 'Investigate production', t: 'Turn an incident into a verified fix.', d: 'Sentry, Honeybadger, AppSignal or Datadog → deduplicate → reproduce → fix → verified PR → review → observe.', ex: 'Honeybadger · TypeError in CheckoutTotal · 312 events', href: '/features/board/#incidents' },
];
---
<Base title={`${site.name}: ${site.tagline}`} fullTitle={`${site.name}: the AI software engineering Factory`} description={site.description} structuredData={structuredData}>
  <!-- A. Hero -->
  <section class="hero ambient" aria-labelledby="hero-title">
    <div class="grid-field pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-wide relative">
      <div class="hero-copy">
        <p class="eyebrow enter" style="--i: 0">{site.eyebrow}</p>
        <h1 id="hero-title" class="display enter mt-5 text-text" style="--i: 1">{site.headline}</h1>
        <p class="lede enter mt-6 max-w-2xl" style="--i: 2">{site.subheading}</p>
        <div class="enter mt-8 flex flex-wrap items-center gap-3" style="--i: 3">
          <Button href={cta.href} size="lg">{cta.label}</Button>
          <Button href="/teams/" size="lg" variant="secondary">Self-hosted Teams</Button>
        </div>
        <div class="hero-meta enter" style="--i: 4">
          <p class="hero-trust">Your repositories <span aria-hidden="true">·</span> Your models <span aria-hidden="true">·</span> Your infrastructure</p>
          <p class="hero-status"><span aria-hidden="true"></span>{site.status.line}</p>
        </div>
      </div>
      <div class="hero-stage enter-stage relative" style="--i: 5"><FactoryHero /></div>
    </div>
  </section>

  <!-- C. Category contrast -->
  <section class="section-pad" aria-labelledby="contrast-title">
    <div class="container-site">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <div class="reveal">
          <p class="kicker">Why Vekrun</p>
          <h2 id="contrast-title" class="heading-2 mt-3 text-text">Your coding agent is the worker. <span class="text-gradient">Vekrun is the Factory.</span></h2>
          <p class="lede mt-4">Keep Claude Code, Codex or Gemini CLI. Vekrun does not replace them, or your editor. It coordinates the work around them: context, isolated execution, verification, delivery and memory, across every project you own.</p>
        </div>
        <div class="reveal contrast" role="table" aria-label="A coding agent compared with Vekrun">
          <div class="contrast-row contrast-head" role="row"><span role="columnheader">A coding agent on its own</span><span role="columnheader">With Vekrun</span></div>
          {contrast.map(([a, b]) => <div class="contrast-row" role="row"><span role="cell">{a}</span><span role="cell"><Check class="h-4 w-4 shrink-0 text-accent" aria-hidden="true" />{b}</span></div>)}
        </div>
      </div>
    </div>
  </section>

  <!-- D. Three starting points -->
  <section class="section-pad rule bg-bg-elevated" aria-labelledby="starts-title">
    <div class="container-site">
      <SectionHeading id="starts-title" kicker="Three ways to start" title="Work starts where it already lives." class="reveal" />
      <ul class="starts reveal-group">
        {starts.map((s) => (
          <li class="start card">
            <s.i class="h-5 w-5 text-accent" aria-hidden="true" />
            <p class="start-k">{s.k}</p>
            <h3 class="start-t">{s.t}</h3>
            <p class="start-d">{s.d}</p>
            <p class="start-ex" aria-label="Example">{s.ex}</p>
            <a href={s.href} class="start-a group link-slide">Learn more<ArrowUpRight class="icon-nudge h-3.5 w-3.5" aria-hidden="true" /></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- E. How a job works -->
  <section id="how" class="section-pad rule scroll-mt-16" aria-labelledby="how-title">
    <div class="container-wide">
      <SectionHeading id="how-title" kicker="How an engineering job works" title="From a goal to a reviewed pull request." lede="Orchestration and your policies govern every change. Where you require approval, the job waits for a person." class="reveal" />
      <div class="mt-12"><JobFlow /></div>
      <p class="reveal mt-10 text-[0.875rem] text-text-3">Per-job isolated environments, the Vekrun bridge and automatic hand-over between agents are product direction, being built now. <a href="/how-it-works/" class="text-accent link-slide">See the full walkthrough</a></p>
    </div>
  </section>

  <!-- F. Parallel projects -->
  <section class="section-pad rule bg-bg-elevated" aria-labelledby="parallel-title">
    <div class="container-site">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16 lg:items-center">
        <div class="reveal">
          <p class="kicker">Parallel work</p>
          <h2 id="parallel-title" class="heading-2 mt-3 text-text">One Factory. Many projects. No shared working-directory collisions.</h2>
          <p class="lede mt-4">Each job has its own repository copy, branch, services, test database and preview, and waits its turn when the machine is busy. Two changes to the same code can still conflict when they merge; Vekrun shows you, it does not pretend otherwise.</p>
        </div>
        <div class="reveal"><ParallelLanes /></div>
      </div>
    </div>
  </section>

  <!-- G. Bring your own AI -->
  <section class="section-pad rule" aria-labelledby="ai-title">
    <div class="container-site">
      <SectionHeading id="ai-title" kicker="Bring your existing AI" title="Your signed-in agents. Routed with care." lede="Vekrun finds the coding CLIs on your machine, checks their versions and sign-in, and picks a capable worker for each task. When one reaches its limit, work can move to another with its context. Coding CLI accounts and paid API access are separate things, billed by their providers." class="reveal" />
      <div class="reveal mt-12"><AgentBridge /></div>
      <p class="reveal mt-6 text-[0.875rem] text-text-3">Vekrun respects each provider’s terms; using a personal subscription for unattended automation may not be allowed. <a href="/integrations/" class="text-accent link-slide">All connections and their status</a></p>
    </div>
  </section>

  <!-- H. Verification -->
  <section class="section-pad rule ambient" aria-labelledby="proof-title">
    <div class="container-wide">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-14 lg:items-start">
        <div class="reveal lg:sticky lg:top-24">
          <p class="kicker">Verification you can inspect</p>
          <h2 id="proof-title" class="heading-2 mt-3 text-text">Trust the evidence, not the agent’s confidence.</h2>
          <p class="lede mt-4">Every job ends with a Proof Pack: what was run, what passed, what failed and was fixed, what was not run and why, on the exact revision. An independent verifier checks the result against the goal. Your branch protections still decide what merges.</p>
          <Button href="/features/verification/" variant="secondary" class="mt-7">How verification works</Button>
        </div>
        <div class="reveal min-w-0"><ProofPack /></div>
      </div>
    </div>
  </section>

  <!-- I. Memory and Insights -->
  <section class="section-pad rule bg-bg-elevated" aria-labelledby="memory-title">
    <div class="container-wide">
      <SectionHeading id="memory-title" kicker="Engineering Memory and Insights" title="Every decision on the record. Every result measurable." lede="Ask why something was built the way it was and get the decision, the ticket, the change and the evidence. Report on what actually shipped: pull requests merged, bugs fixed and verified, features delivered, time to review, rework and spend." class="reveal" />
      <div class="reveal mt-12"><MemoryInsights /></div>
    </div>
  </section>

  <!-- J. Personal and Teams -->
  <section class="section-pad rule" aria-labelledby="plans-title">
    <div class="container-site">
      <SectionHeading id="plans-title" kicker="Built for engineers, coordinated for teams" title="Free on your machine. Self-hosted for your team." lede="Vekrun Personal runs on your own computer. Vekrun Teams adds a shared Coordinator on your infrastructure, with organization policies, SSO, shared incidents and reporting. Model providers you choose still receive the prompts and code a job sends them." class="reveal" />
      <div class="reveal-group mt-12"><PlanCards compact /></div>
    </div>
  </section>

  <!-- K. Mobile and Host -->
  <section class="section-pad rule bg-bg-elevated" aria-labelledby="mobile-title">
    <div class="container-site">
      <SectionHeading id="mobile-title" kicker="Mobile and an always-on Host" title="Your Factory stays within reach." class="reveal" />
      <div class="reveal mt-12"><MobileHost /></div>
    </div>
  </section>

  <!-- L. Final call to action -->
  <section class="rule ambient ambient-low" aria-labelledby="cta-title">
    <div class="container-site relative py-20 text-center sm:py-24">
      <h2 id="cta-title" class="heading-1 text-text">Your next engineering task starts with an outcome.</h2>
      <p class="lede mx-auto mt-5 max-w-2xl">See how the AI Factory plans, builds, verifies and delivers, and where each part stands today.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href={cta.href} size="lg">{cta.label}</Button>
        <Button href="/roadmap/" size="lg" variant="secondary">See the roadmap</Button>
      </div>
      <p class="mt-6 text-[0.875rem] text-text-3">{site.status.line}</p>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--border); padding-top: 4.5rem; padding-bottom: 3.5rem; }
  @media (min-width: 64rem) { .hero { padding-top: 5.5rem; padding-bottom: 4.5rem; } }
  .hero::before { left: -6%; top: -10rem; width: 60rem; height: 34rem; }
  .hero::after { right: 2%; top: 18rem; }
  .hero-copy { max-width: 50rem; }
  .hero-meta { margin-top: 1.75rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.5rem; font-size: 0.875rem; }
  .hero-trust { margin: 0; color: var(--text-2); }
  .hero-trust span { margin-inline: 0.35rem; color: var(--text-3); }
  .hero-status { margin: 0; display: inline-flex; align-items: center; gap: 0.5rem; color: var(--text-3); }
  .hero-status span { width: 0.4rem; height: 0.4rem; border-radius: 50%; background: var(--warn); }
  .hero-stage { margin-top: 3rem; }
  @media (min-width: 64rem) { .hero-stage { margin-top: 3.75rem; } }

  .contrast { border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--surface); }
  .contrast-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); }
  .contrast-row + .contrast-row { border-top: 1px solid var(--border); }
  .contrast-row > span { padding: 0.8rem 1rem; font-size: 0.9rem; line-height: 1.45; }
  .contrast-row > span:first-child { color: var(--text-3); }
  .contrast-row > span:last-child { display: flex; gap: 0.55rem; align-items: flex-start; color: var(--text); border-left: 1px solid var(--border); background: color-mix(in srgb, var(--accent) 4%, transparent); }
  .contrast-row > span:last-child :global(svg) { margin-top: 0.15rem; }
  .contrast-head > span { font-size: 0.75rem !important; font-weight: 560; color: var(--text-2) !important; background: var(--surface-2) !important; }

  .starts { margin: 3rem 0 0; padding: 0; list-style: none; display: grid; gap: 1.25rem; }
  @media (min-width: 64rem) { .starts { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .start { display: flex; flex-direction: column; padding: 1.5rem; }
  .start-k { margin: 1rem 0 0; font-size: 0.8125rem; color: var(--accent); font-weight: 560; }
  .start-t { margin: 0.35rem 0 0; font-size: 1.15rem; font-weight: 600; letter-spacing: -0.015em; color: var(--text); }
  .start-d { margin: 0.5rem 0 0; font-size: 0.9rem; line-height: 1.55; color: var(--text-2); }
  .start-ex { margin: 1.1rem 0 0; padding: 0.6rem 0.75rem; border: 1px solid var(--border); border-radius: 8px; background: var(--bg-elevated); font-family: var(--font-mono); font-size: 0.72rem; line-height: 1.5; color: var(--text-2); }
  .start-a { margin-top: auto; padding-top: 1.1rem; display: inline-flex; align-items: center; gap: 0.3rem; align-self: flex-start; font-size: 0.9rem; font-weight: 540; color: var(--accent); }
</style>
