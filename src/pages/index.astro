---
/**
 * The homepage tells one story, one idea per section: the promise, the problem,
 * how it works, the Council, verification, Live Share, before and after, your
 * tools, Teams Remote Factory, and the two packages.
 */
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FactoryHero from '@/components/factory/FactoryHero.astro';
import Council from '@/components/visuals/Council.astro';
import Screenshot from '@/components/visuals/Screenshot.astro';
import RemoteFactory from '@/components/visuals/RemoteFactory.astro';
import PlanCards from '@/components/teams/PlanCards.astro';
import IntegrationLogo from '@/components/brand/IntegrationLogo.astro';
import { site, personalCta, teams } from '@/data/site';
import { toolById } from '@/data/integrations';
import { ArrowRight, RotateCw } from '@lucide/astro';

const chores = ['Write the prompt', 'Watch it work', 'Fix what it missed', 'Test it yourself', 'Explain it again'];
const factory = [
  { t: 'Outcome', d: 'You say what should be true.' },
  { t: 'Council', d: 'The approach gets challenged.' },
  { t: 'Build', d: 'Your agents do the work.' },
  { t: 'Verify', d: 'The result gets proven.' },
  { t: 'Deliver', d: 'You review a finished PR.' },
];
const pairs = [
  { b: 'Every new agent session starts out knowing nothing about your codebase.', a: 'Vekrun reads the repository, its conventions and your team’s notes first.' },
  { b: 'Six weeks on, nobody remembers why the code changed.', a: 'Engineering Memory keeps each decision with its evidence.' },
];
const tools = ['claude-code', 'codex', 'antigravity', 'openrouter', 'github', 'gitlab', 'jira', 'linear', 'sentry'].map((id) => toolById(id)!);

const structuredData = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: site.url, logo: `${site.url}/brand/vekrun-mark-dark-512.png` },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url },
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: site.name, applicationCategory: 'DeveloperApplication', description: site.description, url: site.url },
];
---
<Base title={site.name} fullTitle={`${site.name} · From prompt to verified outcome`} description={site.description} structuredData={structuredData} page="home">
  <PageHero eyebrow="The AI software engineering Factory" title={site.headline} lede={site.subheading} cta={personalCta} secondary={{ label: 'See how it works', href: '/product/' }} wide>
    <FactoryHero />
  </PageHero>

  <section class="section-pad rule" aria-labelledby="problem-title">
    <div class="container-site problem">
      <SectionHeading id="problem-title" title="Your agents write the code. You’re still running the project." lede="Prompting, checking, correcting, re-explaining. That part of the job never got automated." class="reveal" />
      <ol class="loop reveal-group" aria-label="The loop you run today">
        {chores.map((c) => <li>{c}</li>)}
        <li class="loop-back"><RotateCw class="h-4 w-4" aria-hidden="true" />Repeat</li>
      </ol>
    </div>
  </section>

  <section class="section-pad rule bg-bg-elevated" aria-labelledby="factory-title">
    <div class="container-site">
      <SectionHeading id="factory-title" title="Vekrun runs the engineering around them." lede="You set the outcome. The Factory takes it from there and comes back with proof." class="reveal" />
      <ol class="flow reveal-group" aria-label="How the Factory works">
        {factory.map((s) => <li><b>{s.t}</b><span>{s.d}</span></li>)}
      </ol>
      <p class="mt-10 reveal"><a href="/product/#how" class="link-more group">See every step<ArrowRight class="icon-nudge h-4 w-4" aria-hidden="true" /></a></p>
    </div>
  </section>

  <section class="section-pad rule" aria-labelledby="council-title">
    <div class="container-site split">
      <div class="reveal">
        <h2 id="council-title" class="heading-2 text-text">Argue about the plan before anyone writes code.</h2>
        <p class="lede mt-4">When a decision matters, several models challenge it. You see the reasoning and the objections, not just the winner.</p>
      </div>
      <div class="reveal min-w-0"><Council compact /></div>
    </div>
  </section>

  <section class="section-pad rule bg-bg-elevated" aria-labelledby="verify-title">
    <div class="container-site">
      <SectionHeading id="verify-title" title="Done means proven, not claimed." lede="Tests, a real browser and an independent verifier check the work. The evidence arrives with it." class="reveal" />
      <div class="reveal mt-12"><Screenshot name="browser-verified" alt="The Vekrun desktop app comparing a page before and after a fix, with each review comment verified and an independent test run passed." /></div>
    </div>
  </section>
  <section class="section-pad rule" aria-labelledby="share-title">
    <div class="container-site">
      <SectionHeading id="share-title" title="Show it running. Fix what reviewers point at." lede="Live Share puts the app you’re building on a permanent HTTPS link. Clients and teammates select what’s wrong, right on the page. Approve their feedback and the Factory fixes it and verifies the fix." class="reveal" />
      <div class="reveal mt-12"><Screenshot name="liveshare-review" alt="The Live Share Review Inbox in the Vekrun desktop app: a reviewer’s comment about a cramped checkout heading, with the region they selected highlighted on the page." caption="Live Share’s Review Inbox in the Vekrun desktop app." /></div>
      <p class="mt-10 reveal"><a href="/product/#live-share" class="link-more group">How Live Share works<ArrowRight class="icon-nudge h-4 w-4" aria-hidden="true" /></a></p>
    </div>
  </section>
  <section class="section-pad rule bg-bg-elevated" aria-labelledby="ba-title">
    <div class="container-site">
      <SectionHeading id="ba-title" title="Before Vekrun, you were the glue." class="reveal" />
      <div class="ba reveal-group">
        {pairs.map((p) => (
          <div class="ba-pair">
            <p class="ba-b"><span>Before</span>{p.b}</p>
            <p class="ba-a"><span>After</span>{p.a}</p>
          </div>
        ))}
      </div>
      <p class="mt-10 reveal"><a href="/before-and-after/" class="link-more group">See the whole day, before and after<ArrowRight class="icon-nudge h-4 w-4" aria-hidden="true" /></a></p>
    </div>
  </section>
  <section class="section-pad rule" aria-labelledby="tools-title">
    <div class="container-site split">
      <div class="reveal">
        <h2 id="tools-title" class="heading-2 text-text">Keep the tools you like.</h2>
        <p class="lede mt-4">Vekrun works through your agents, repositories and trackers. It doesn’t replace them.</p>
        <p class="mt-8"><a href="/integrations/" class="link-more group">All integrations<ArrowRight class="icon-nudge h-4 w-4" aria-hidden="true" /></a></p>
      </div>
      <ul class="logos reveal-group" aria-label="Some of the tools Vekrun works with">
        {tools.map((t) => <li><IntegrationLogo id={t.id} name={t.name} monogram={t.mono} /><span>{t.name}</span></li>)}
      </ul>
    </div>
  </section>
  <section id="teams" class="section-pad rule bg-bg-elevated scroll-mt-16" aria-labelledby="remote-title">
    <div class="container-site remote">
      <div class="reveal">
        <p class="kicker">Vekrun Teams</p>
        <h2 id="remote-title" class="heading-2 mt-3 text-text">One Factory for the whole team, wherever they work.</h2>
        <p class="lede mt-4">Vekrun Teams will run a shared Factory on your own servers. Work keeps moving when people step away, anyone authorized can drive it from anywhere, and code and credentials stay with you.</p>
        <p class="mt-4 text-[0.95rem] text-text-2">{teams.availability}</p>
        <p class="mt-8"><a href="/teams/#remote" class="link-more group">Why teams run their own Factory<ArrowRight class="icon-nudge h-4 w-4" aria-hidden="true" /></a></p>
      </div>
      <div class="reveal min-w-0"><RemoteFactory compact /></div>
    </div>
  </section>
  <section class="section-pad rule" aria-labelledby="plans-title">
    <div class="container-site">
      <SectionHeading id="plans-title" title="Start on your machine. Bring your team when you’re ready." lede="Personal is free and runs locally. Teams follows, with one plan and one price, on your own servers." class="reveal" />
      <div class="reveal mt-12"><PlanCards compact /></div>
    </div>
  </section>

</Base>

<style>
  .split { display: grid; gap: 2.5rem; }
  @media (min-width: 64rem) { .split { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 4rem; align-items: center; } }

  .problem { display: grid; gap: 2.5rem; }
  @media (min-width: 64rem) { .problem { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 4rem; align-items: center; } }
  .loop { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.5rem; }
  .loop li { display: flex; align-items: center; gap: 0.75rem; padding: 0.8rem 1rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); font-size: 1rem; color: var(--text-2); }
  .loop li::before { content: ''; width: 0.5rem; height: 0.5rem; border-radius: 50%; border: 1.5px solid var(--text-3); flex: 0 0 auto; }
  .loop .loop-back { justify-content: center; border-style: dashed; color: var(--warn); }
  .loop .loop-back::before { display: none; }

  .flow { margin: 3rem 0 0; padding: 0; list-style: none; display: grid; gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; counter-reset: s; }
  @media (min-width: 48rem) { .flow { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .flow li { counter-increment: s; display: grid; gap: 0.35rem; padding: 1.4rem 1.25rem 1.5rem; background: var(--surface); }
  .flow li::before { content: counter(s); font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-3); }
  .flow b { font-size: 1.15rem; font-weight: 600; letter-spacing: -0.02em; color: var(--text); }
  .flow span { font-size: 0.92rem; line-height: 1.45; color: var(--text-2); }
  .flow li:last-child { background: var(--accent-soft); }
  .flow li:last-child b { color: var(--accent); }

  .remote { display: grid; gap: 2.5rem; }
  @media (min-width: 64rem) { .remote { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 4rem; align-items: center; } }

  .ba { margin-top: 3rem; display: grid; gap: 1.25rem; }
  @media (min-width: 64rem) { .ba { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .ba-pair { display: grid; border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
  .ba-pair p { margin: 0; padding: 1.4rem 1.5rem; font-size: 1.15rem; line-height: 1.4; letter-spacing: -0.015em; }
  .ba-pair span { display: block; margin-bottom: 0.4rem; font-size: 0.8125rem; letter-spacing: 0; }
  .ba-b { background: var(--surface); color: var(--text-2); }
  .ba-b span { color: var(--text-3); }
  .ba-a { background: var(--accent-soft); color: var(--text); border-top: 1px solid var(--accent-line); }
  .ba-a span { color: var(--accent); }

  .logos { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
  @media (min-width: 40rem) { .logos { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .logos li { display: flex; align-items: center; gap: 0.7rem; padding: 0.6rem 0.7rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); font-size: 0.92rem; font-weight: 520; color: var(--text); min-width: 0; }
  .logos li span:last-child { min-width: 0; line-height: 1.25; }

</style>
