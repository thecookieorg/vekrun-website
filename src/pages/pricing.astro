---
/**
 * Pricing: two plans. Free is the individual engineering platform as it exists;
 * Teams is self-hosted and has a fixed price (see `teamsPricing`).
 * There is no checkout. Teams interest is an email to the team
 * (`teamsInterestMailto`), not a form.
 */
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import PlanCards from '@/components/PlanCards.astro';
import TeamsCalc from '@/components/pricing/TeamsCalc.astro';
import { ArrowRight, Brain, ChevronDown, KeyRound, Mail, Server, Scale } from '@lucide/astro';
import { site, teamsInterestMailto, teamsPricing, teamsMonthly, usd } from '@/data/site';

const base = usd(teamsPricing.base);
const extra = usd(teamsPricing.perExtra);
const n = teamsPricing.included;

const compare: [string, string, string][] = [
  ['Who it’s for', 'You, on your own projects', 'An engineering team working together'],
  ['Engineering Memory', 'Personal Engineering Memory', 'Shared Engineering Memory across engineers, repositories and team workflows'],
  ['Sign-in and access', 'No Vekrun account needed', 'SSO, role-based access and repository permissions'],
  ['Where it runs', 'Your machine', 'Your machines, plus Coordinator and Factory workers on servers you control'],
  ['Remote execution', 'Work Anywhere: run the Factory on your own VPS', 'Shared remote worker pools and team-level management'],
  ['Work Items', 'Your work, planned and tracked', 'Team-wide coordination of Work Items'],
  ['Policies and approvals', 'Your rules for your repositories', 'Organization policies, permissions and approvals'],
  ['Collaboration', 'Live Share reviews with anyone', 'Engineers’ installations working together'],
  ['Visibility', 'Your delivery and evidence', 'Delivery and verification across the team'],
  ['Models and compute', 'Yours, billed by your providers', 'Yours, billed by your providers'],
  ['Price', '$0, forever', `${base} per month for up to ${n} engineers, then ${extra} each`],
  ['How to start', 'Request early access', 'Register Teams interest'],
];

const faq: [string, string][] = [
  ['Is Vekrun Free really free?', 'Yes. Free is the full local-first engineering experience for an individual, at $0 forever: the Factory and Coordinator, Council, Competitive Engineering, Work Items, Engineering Memory, Proof Packs, Live Share and more. No trial, no usage limits set by Vekrun and no paid feature gates. You bring your own model accounts and computer.'],
  ['What’s included in Teams?', 'Everything in Free for every engineer, plus Shared Engineering Memory: the decisions, verified fixes and architecture knowledge your team creates, reusable by every authorized teammate and their agents. Teams also includes SSO and role-based access, team-wide Work Items, organization policies, shared worker pools on your own servers, and visibility into delivery and verification. Register your interest and we’ll set Teams up with your organization.'],
  ['How does pricing change when the team grows?', `${base} per month covers up to ${n} engineers, so a team of 5 pays the same as a team of ${n}. Each engineer beyond ${n} adds ${extra} per month: ${n + 1} engineers is ${usd(teamsMonthly(n + 1))}, 20 is ${usd(teamsMonthly(20))} and 30 is ${usd(teamsMonthly(30))}. There are no per-agent, per-task, per-pull-request or per-Work-Item fees.`],
  ['Does Teams include cloud infrastructure?', 'No. Teams is self-hosted: the Coordinator and Factory workers run on servers or a cloud account your organization controls, and engineers keep working from their own installations. Vekrun doesn’t host your code or run your workloads.'],
  ['Who pays for AI model usage and remote workers?', 'You do, directly. Model usage is billed by the providers you choose, under your accounts, and remote workers run on servers you rent or own, billed by your hosting provider. Neither plan includes those bills, and Vekrun adds no markup or per-worker fees.'],
  ['Do I need Teams to run Vekrun on my own server?', 'No. Work Anywhere, included in Vekrun Free, lets an individual connect their own VPS and run the Factory there at no Vekrun cost. Teams adds shared worker pools and team-level management.'],
  ['Is SSO an extra cost?', 'No. SSO and role-based access control are part of Teams at the same price, with no add-on and no Enterprise upsell.'],
  ['Can an individual use Vekrun without Teams?', 'Yes. Vekrun Free is complete for individual work and needs no Vekrun-hosted account. Teams is only for organizations that want to coordinate several engineers.'],
  ['Do we need a separate Enterprise plan?', `No. There is no Enterprise tier. Teams, including SSO, is self-hosted for organizations of any size, at ${base} per month for up to ${n} engineers and ${extra} per month for each engineer after that.`],
];

const structuredData = [
  {
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: site.name, applicationCategory: 'DeveloperApplication', operatingSystem: 'macOS', url: `${site.url}/pricing/`,
    offers: [{ '@type': 'Offer', name: 'Vekrun Free', price: '0', priceCurrency: 'USD' }],
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base title="Pricing" fullTitle="Pricing: Vekrun Free and Vekrun Teams · Vekrun" description={`Vekrun Free is $0 forever for individual engineers. Vekrun Teams is self-hosted: ${base} USD per month for up to ${n} engineers, plus ${extra} per additional engineer.`} image="/og/pricing.png" structuredData={structuredData}>
  <PageHero eyebrow="Pricing" title="Free for you. Teams on your infrastructure." lede={`Your own AI engineering team, free on your machine. When your team wants to share what it learns, Vekrun Teams adds Shared Engineering Memory and SSO on infrastructure you control, at ${base} per month for up to ${n} engineers.`} />

  <section class="rule pb-20 pt-14" aria-label="Plans">
    <div class="container-site">
      <PlanCards />
      <p class="mt-8 max-w-3xl text-[0.92rem] text-text-2">Both plans use the models and servers you choose: OpenRouter, xAI, local models or optional coding agents, under your own accounts. Vekrun charges no usage fees: none per agent, task, pull request or Work Item. External models and your infrastructure are billed by their providers.</p>
    </div>
  </section>

  <section id="teams" class="section-pad rule bg-bg-elevated scroll-mt-16" aria-labelledby="teams-title">
    <div class="container-site teams">
      <div>
        <SectionHeading id="teams-title" title="Vekrun Teams: one engineering brain for your whole team." lede={`Teams is for sharing what your engineers learn. ${base} per month for up to ${n} engineers, then ${extra} per month for each engineer after that. Self-hosted, not a Vekrun-hosted compute subscription.`} />
        <div class="lead-b">
          <Brain class="h-5 w-5" aria-hidden="true" />
          <div>
            <h3>Shared Engineering Memory</h3>
            <p>Decisions, verified fixes and architecture discoveries become knowledge every authorized teammate and their agents can use, with sources, revisions and permissions attached.</p>
          </div>
        </div>
        <ul class="sup">
          <li><KeyRound class="h-4 w-4" aria-hidden="true" />SSO and role-based access, included</li>
          <li><Server class="h-4 w-4" aria-hidden="true" />Shared worker pools on your own servers</li>
          <li><Scale class="h-4 w-4" aria-hidden="true" />Organization policies, coordination and insights</li>
        </ul>
        <p class="mt-6 max-w-xl text-[0.92rem] leading-relaxed text-text-2">Teams keeps Vekrun local-first: engineers work from their own installations, with no requirement to route your work through a Vekrun-hosted service.</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <Button href={teamsInterestMailto} size="lg" data-teams-interest><Mail class="h-4 w-4" aria-hidden="true" />Register Teams interest</Button>
          <a href="/teams/" class="link-more group">Explore Vekrun Teams<ArrowRight class="icon-nudge h-4 w-4" aria-hidden="true" /></a>
        </div>
        <p class="mt-4 max-w-xl text-[0.85rem] leading-relaxed text-text-3">Opens an email to {site.earlyAccess.email} with optional questions filled in. Nothing is sent until you send it; reply “unsubscribe” to be removed. <a href="/privacy/" class="text-accent link-slide">Privacy</a></p>
      </div>
      <div class="min-w-0"><TeamsCalc /></div>
    </div>
  </section>

  <section class="section-pad rule" aria-labelledby="compare-title">
    <div class="container-site">
      <SectionHeading id="compare-title" title="Personal engineering, or a team working as one." lede="Free is the individual engineering platform. Teams adds Shared Engineering Memory, organizational identity and coordination on infrastructure you control. Neither plan includes hosting or model provider bills." />
      <div class="cmp-wrap mt-10" tabindex="0" role="region" aria-labelledby="compare-title">
        <table class="cmp">
          <thead><tr><th scope="col"><span class="sr-only">Compared</span></th><th scope="col">Free</th><th scope="col">Teams</th></tr></thead>
          <tbody>
            {compare.map(([k, a, b]) => <tr><th scope="row">{k}</th><td>{a}</td><td>{b}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section-pad rule bg-bg-elevated" aria-labelledby="faq-title">
    <div class="container-site grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <h2 id="faq-title" class="heading-2 text-text">Questions.</h2>
      <div class="faq">
        {faq.map(([q, a]) => (
          <details class="faq-i">
            <summary>{q}<ChevronDown class="h-4 w-4" aria-hidden="true" /></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .teams { display: grid; gap: 2.5rem; }
  @media (min-width: 64rem) { .teams { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 4rem; align-items: center; } }
  .lead-b { margin-top: 2rem; display: flex; gap: 0.9rem; align-items: flex-start; padding: 1.2rem 1.3rem; border: 1px solid var(--border-interactive); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--glow-accent); }
  .lead-b > :global(svg) { flex-shrink: 0; margin-top: 0.15rem; color: var(--accent-text); }
  .lead-b h3 { margin: 0; font-size: 1.15rem; font-weight: 620; color: var(--foreground); }
  .lead-b p { margin: 0.35rem 0 0; font-size: 0.95rem; line-height: 1.55; color: var(--foreground-secondary); }
  .sup { margin: 1.25rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.5rem; }
  .sup li { display: flex; gap: 0.55rem; align-items: center; font-size: 0.95rem; color: var(--foreground); }
  .sup :global(svg) { flex-shrink: 0; color: var(--accent-text); }
  .cmp-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); }
  .cmp-wrap:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .cmp { width: 100%; min-width: 36rem; border-collapse: collapse; font-size: 0.92rem; }
  .cmp th, .cmp td { padding: 0.85rem 1.1rem; text-align: left; vertical-align: top; border-top: 1px solid var(--border); }
  .cmp thead th { border-top: 0; font-size: 0.95rem; font-weight: 620; color: var(--foreground); }
  .cmp tbody th { width: 24%; font-weight: 560; color: var(--foreground); }
  .cmp td { color: var(--foreground-secondary); }
  .cmp-tag { margin-left: 0.4rem; padding: 0.1rem 0.4rem; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); font-size: 0.72rem; font-weight: 540; color: var(--foreground-secondary); }
</style>
