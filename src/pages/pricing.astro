---
/**
 * Pricing: two plans. Free is the individual engineering platform as it exists;
 * Teams is planned, self-hosted and has a fixed price (see `teamsPricing`).
 * There is no checkout. Teams interest is an email to the team
 * (`teamsInterestMailto`), not a form.
 */
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import PlanCards from '@/components/PlanCards.astro';
import TeamsCalc from '@/components/pricing/TeamsCalc.astro';
import { ChevronDown, Mail } from '@lucide/astro';
import { site, teamsInterestMailto, teamsPricing, teamsMonthly, usd } from '@/data/site';

const base = usd(teamsPricing.base);
const extra = usd(teamsPricing.perExtra);
const n = teamsPricing.included;

const compare: [string, string, string][] = [
  ['Who it’s for', 'You, on your own projects', 'An engineering team working together'],
  ['Where it runs', 'Your machine', 'Your machines, plus Coordinator and Factory workers on servers you control'],
  ['Engineering Memory', 'Your projects’ memory', 'Shared memory and context across the team'],
  ['Work Items', 'Your work, planned and tracked', 'Team-wide coordination of Work Items'],
  ['Policies and approvals', 'Your rules for your repositories', 'Organization policies, permissions and approvals'],
  ['Collaboration', 'Live Share reviews with anyone', 'Engineers’ installations working together'],
  ['Visibility', 'Your delivery and evidence', 'Delivery and verification across the team'],
  ['Models and compute', 'Yours, billed by your providers', 'Yours, billed by your providers'],
  ['Price', '$0, forever', `${base} per month for up to ${n} engineers, then ${extra} each`],
  ['Availability', 'Early access', 'Planned'],
];

const faq: [string, string][] = [
  ['Is Vekrun Free really free?', 'Yes. Free is the full local-first engineering experience for an individual, at $0 forever: the Factory and Coordinator, Council, Competitive Engineering, Work Items, Engineering Memory, Proof Packs, Live Share and more. No trial, no usage limits set by Vekrun and no paid feature gates. You bring your own model accounts and computer.'],
  ['What’s included in Teams?', 'Everything in Free for every engineer, plus what a team needs to work as one: shared Engineering Memory, team-wide Work Items, organization policies and approvals, Coordinator and Factory workers on your own servers, and visibility into delivery and verification. Teams is planned, so these capabilities are what we’re building toward, not features available today.'],
  [`Does Teams include ${n} engineers?`, `Yes. ${base} per month covers up to ${n} engineers. A team of 5 pays ${usd(teamsMonthly(5))}, and so does a team of ${n}.`],
  ['How does pricing change when the team grows?', `Each engineer beyond ${n} adds ${extra} per month: ${n + 1} engineers is ${usd(teamsMonthly(n + 1))}, 20 is ${usd(teamsMonthly(20))} and 30 is ${usd(teamsMonthly(30))}. There are no per-agent, per-task, per-pull-request or per-Work-Item fees.`],
  ['Does Teams include cloud infrastructure?', 'No. Teams is self-hosted. You run it on servers or a cloud account you already control; Vekrun doesn’t host your code or run your workloads.'],
  ['Who pays for AI model usage and remote workers?', 'You do, directly. Model usage is billed by the providers you choose, under your accounts, and remote workers run on your infrastructure at your cost. Vekrun adds no markup.'],
  ['Can Teams run on our own servers?', 'Yes, that’s the design. The Coordinator and Factory workers run on infrastructure your organization controls, and engineers keep working from their own installations.'],
  ['Can an individual use Vekrun without Teams?', 'Yes. Vekrun Free is complete for individual work and needs no Vekrun-hosted account. Teams is only for organizations that want to coordinate several engineers.'],
  ['Is Teams available yet?', 'Not yet. Teams is planned and can’t be bought today; there’s no checkout. Register your interest and we’ll email you when it’s ready.'],
  ['Do we need a separate Enterprise plan?', `No. There is no Enterprise tier. Teams is self-hosted for organizations of any size, at ${base} per month for up to ${n} engineers and ${extra} per month for each engineer after that.`],
];

const structuredData = [
  {
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: site.name, applicationCategory: 'DeveloperApplication', operatingSystem: 'macOS', url: `${site.url}/pricing/`,
    offers: [{ '@type': 'Offer', name: 'Vekrun Free', price: '0', priceCurrency: 'USD' }],
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base title="Pricing" fullTitle="Pricing: Vekrun Free and Vekrun Teams · Vekrun" description={`Vekrun Free is $0 forever for individual engineers. Vekrun Teams is planned and self-hosted: ${base} USD per month for up to ${n} engineers, plus ${extra} per additional engineer.`} image="/og/pricing.png" structuredData={structuredData}>
  <PageHero eyebrow="Pricing" title="Free for you. Teams on your infrastructure." lede={`Your own AI engineering team, free on your machine. When your team wants to work as one, Vekrun Teams runs on infrastructure you control, at ${base} per month for up to ${n} engineers.`} />

  <section class="rule pb-20 pt-14" aria-label="Plans">
    <div class="container-site">
      <PlanCards />
      <p class="mt-8 max-w-3xl text-[0.92rem] text-text-2">Both plans use the models you choose: OpenRouter, local models or optional coding agents, under your own accounts. Vekrun charges no usage fees: none per agent, task, pull request or Work Item. External models and your infrastructure are billed by their providers. Teams is planned and not available yet.</p>
    </div>
  </section>

  <section id="teams" class="section-pad rule bg-bg-elevated scroll-mt-16" aria-labelledby="teams-title">
    <div class="container-site teams">
      <div>
        <SectionHeading id="teams-title" title="Vekrun Teams, on infrastructure you control." lede={`One price for the team: ${base} per month for up to ${n} engineers, then ${extra} per month for each engineer after that. Teams is self-hosted, not a Vekrun-hosted compute subscription.`} />
        <p class="mt-6 max-w-xl text-[0.92rem] leading-relaxed text-text-2">Teams is planned. Its capabilities describe what we’re building, and it keeps Vekrun local-first: engineers work from their own installations, with no requirement to route your work through a Vekrun-hosted service.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={teamsInterestMailto} size="lg" data-teams-interest><Mail class="h-4 w-4" aria-hidden="true" />Register Teams interest</Button>
        </div>
        <p class="mt-4 max-w-xl text-[0.85rem] leading-relaxed text-text-3">Opens an email to {site.earlyAccess.email} with optional questions filled in. Nothing is sent until you send it; reply “unsubscribe” to be removed. <a href="/privacy/" class="text-accent link-slide">Privacy</a></p>
      </div>
      <div class="min-w-0"><TeamsCalc /></div>
    </div>
  </section>

  <section class="section-pad rule" aria-labelledby="compare-title">
    <div class="container-site">
      <SectionHeading id="compare-title" title="Personal engineering, or a team working as one." lede="Free is the individual engineering platform. Teams adds shared coordination and infrastructure you control." />
      <div class="cmp-wrap mt-10" tabindex="0" role="region" aria-labelledby="compare-title">
        <table class="cmp">
          <thead><tr><th scope="col"><span class="sr-only">Compared</span></th><th scope="col">Free</th><th scope="col">Teams <span class="cmp-tag">Planned</span></th></tr></thead>
          <tbody>
            {compare.map(([k, a, b]) => <tr><th scope="row">{k}</th><td>{a}</td><td>{b}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section-pad rule bg-bg-elevated" aria-labelledby="faq-title">
    <div class="container-site grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <h2 id="faq-title" class="heading-2 text-text">Questions.</h2>
      <div class="faq">
        {faq.map(([q, a]) => (
          <details class="faq-i">
            <summary>{q}<ChevronDown class="h-4 w-4" aria-hidden="true" /></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .teams { display: grid; gap: 2.5rem; }
  @media (min-width: 64rem) { .teams { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 4rem; align-items: center; } }
  .cmp-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); }
  .cmp-wrap:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .cmp { width: 100%; min-width: 36rem; border-collapse: collapse; font-size: 0.92rem; }
  .cmp th, .cmp td { padding: 0.85rem 1.1rem; text-align: left; vertical-align: top; border-top: 1px solid var(--border); }
  .cmp thead th { border-top: 0; font-size: 0.95rem; font-weight: 620; color: var(--foreground); }
  .cmp tbody th { width: 24%; font-weight: 560; color: var(--foreground); }
  .cmp td { color: var(--foreground-secondary); }
  .cmp-tag { margin-left: 0.4rem; padding: 0.1rem 0.4rem; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); font-size: 0.72rem; font-weight: 540; color: var(--foreground-secondary); }
</style>
