---
/**
 * Vekrun Teams: an engineering organization working as one. The page leads
 * with the connected network (Factories, Proof Packs, handoffs, safeguards),
 * then what Teams adds beyond shared memory, the two deployment options (both
 * in one subscription), and a price that can't be misread.
 * Pricing comes from `teamsPricing`; the calculator is shared with /pricing/.
 */
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import OrgNetwork from '@/components/teams/OrgNetwork.astro';
import DeployCompare from '@/components/teams/DeployCompare.astro';
import MemoryStory from '@/components/teams/MemoryStory.astro';
import WorkerPool from '@/components/teams/WorkerPool.astro';
import SsoDemo from '@/components/teams/SsoDemo.astro';
import TeamsCalc from '@/components/pricing/TeamsCalc.astro';
import { site, teamsInterestMailto, teamsPricing, teamsMonthly, usd } from '@/data/site';
import { ArrowRight, Check, ChevronDown, Brain, Users, Cpu, ShieldCheck, ShieldAlert, Workflow, FileCode2, CircleDashed, GitCommitHorizontal, Lock } from '@lucide/astro';

const base = usd(teamsPricing.base);
const extra = usd(teamsPricing.perExtra);
const n = teamsPricing.included;
const priceLine = `${base} a month includes ${n} developers. ${extra} a month for each additional developer.`;

const pillars = [
  { i: Cpu, t: 'Connected AI Factories', d: 'Every developer’s Factory knows what the others are building, so work is split instead of duplicated.' },
  { i: Users, t: 'Cross-developer coordination', d: 'Shared Work Items, reviews across machines and large changes split between developers.' },
  { i: ShieldCheck, t: 'Shared verified Proof Packs', d: 'Evidence travels with the work. A teammate’s verified result is reused, not re-proved from scratch.' },
  { i: ShieldAlert, t: 'Engineering safeguards', d: 'Organization policies, required approvals and risk checks apply on every developer’s machine.' },
  { i: Workflow, t: 'Dependencies and handoffs', d: 'Vekrun sees what blocks what, and hands work over with its plan, decisions and evidence.' },
  { i: Brain, t: 'Organizational intelligence', d: 'Shared Engineering Memory, architecture knowledge and engineering insights that grow with every task.' },
];
const better = [
  { i: FileCode2, t: 'Cites its sources', d: 'Every record links to the code, pull request or incident it came from.' },
  { i: GitCommitHorizontal, t: 'Knows its revision', d: 'Knowledge is tied to the revision it was true at, so outdated facts can be spotted.' },
  { i: CircleDashed, t: 'Separates proven from inferred', d: 'Verified fixes carry their evidence. Guesses are labelled as guesses.' },
  { i: Lock, t: 'Respects permissions', d: 'People and agents see only what their role and repositories allow. Superseded decisions are marked, never silently reused.' },
];
const sso = [
  'Single Sign-On through your organization’s identity provider',
  'OIDC with Microsoft Entra ID, Google Workspace, Okta and other compatible providers',
  'Members managed by your organization: invite, remove, revoke',
  'Role-based access, plus repository and project permissions',
  'Revoking someone closes shared projects, memory and workers to them',
  'Organizational actions recorded in an audit trail',
];
const price = [
  'Connected Desktops and Dedicated Coordinator, both included',
  'Every Teams capability, with SSO and access control',
  'No per-agent, per-task, per-PR or per-Work-Item fees',
  'Your servers and model usage are billed by their providers',
];
const faq: [string, string][] = [
  ['What does Vekrun Teams cost?', `${base} USD per month, including ${n} developers. Each additional developer is ${extra} per month: ${n + 1} developers is ${usd(teamsMonthly(n + 1))}, 10 is ${usd(teamsMonthly(10))} and 20 is ${usd(teamsMonthly(20))}. One subscription includes both deployment options.`],
  ['Is Teams just shared memory?', 'No. Shared Engineering Memory is one part. Teams connects every developer’s AI Factory, coordinates work across machines, shares verified Proof Packs, enforces engineering safeguards, tracks dependencies and handoffs, and builds organizational intelligence.'],
  ['What’s the difference between Connected Desktops and a Dedicated Coordinator?', 'Connected Desktops needs no server: the authorized Vekrun apps on your developers’ Macs form a peer network and synchronize directly. A Dedicated Coordinator is a Rust and PostgreSQL service you host, for persistent synchronization, centralized governance and always-on availability.'],
  ['Do we pay more for the Dedicated Coordinator?', 'No. Both deployment options are part of the same Teams subscription, at the same price. You run the Coordinator on your own server, billed by your hosting provider.'],
  ['Where does our shared data live?', 'On machines your organization controls: the developers’ own Macs with Connected Desktops, plus your server with a Dedicated Coordinator. There’s no Vekrun-operated cloud, and each developer’s private work stays on their machine.'],
  ['Can we control who sees what?', 'Yes. Access follows SSO identities, roles and repository or project permissions, and revoking a member closes shared projects, memory and workers to them.'],
  ['Why would a team pay when individuals use Vekrun for free?', 'Free gives each developer a complete AI engineering team for their own work. Teams makes those teams work together, so the organization coordinates, proves and learns as one.'],
  ['How do we get started?', 'Register your interest by email. We’ll talk through your team size and which deployment option suits you, and set Teams up with you.'],
];

const structuredData = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base title="Teams" fullTitle="Vekrun Teams: your engineering organization, working as one · Vekrun" image="/og/teams.png" description={`Vekrun Teams connects every developer’s AI Factory: coordination, shared verified Proof Packs, safeguards, dependencies, handoffs and organizational intelligence. ${priceLine}`} structuredData={structuredData}>
  <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('tm-motion');</script>
  <PageHero eyebrow="Vekrun Teams" title="Your engineering organization, working as one." lede="Teams connects every developer’s Vekrun: AI Factories that coordinate, verified Proof Packs the whole team can trust, safeguards, dependencies, handoffs and the intelligence your organization builds with every task." cta={{ label: 'Register Teams interest', href: teamsInterestMailto }} secondary={{ label: 'See Teams pricing', href: '#pricing' }} wide>
    <p slot="after" class="hero-price enter" style="--i: 4"><b>{base}</b> a month includes {n} developers, then {extra} for each additional developer. Connected Desktops and Dedicated Coordinator, both included.</p>
    <div id="network" class="scroll-mt-24"><OrgNetwork /></div>
  </PageHero>

  <section id="platform" class="section-pad rule bg-bg-elevated scroll-mt-16" aria-labelledby="pl-title">
    <div class="container-site">
      <SectionHeading id="pl-title" title="Much more than shared memory." lede="Free gives each developer their own AI engineering team. Teams makes all of those teams work together." />
      <ul class="pillars">
        {pillars.map((p, i) => <li class="reveal" style={`--d:${i}`}><span class="pillar-ic"><p.i class="h-5 w-5" aria-hidden="true" /></span><h3>{p.t}</h3><p>{p.d}</p></li>)}
      </ul>
    </div>
  </section>

  <section id="deploy" class="section-pad rule scroll-mt-16" aria-labelledby="dp-title">
    <div class="container-site">
      <SectionHeading id="dp-title" title="Two ways to connect. One subscription." lede="Connect the developers’ Macs directly, or run a Coordinator on your own server. Either way there’s no Vekrun-operated cloud, and your code stays on machines you control." />
      <div class="mt-12 reveal"><DeployCompare /></div>
    </div>
  </section>

  <section id="shared-memory" class="section-pad rule bg-bg-elevated scroll-mt-16" aria-labelledby="sm-title">
    <div class="container-site">
      <SectionHeading id="sm-title" title="Every lesson becomes organizational intelligence." lede="Decisions, verified fixes and architecture discoveries stop disappearing into closed sessions and review threads. They become knowledge every authorized teammate and their agents can use." />
    </div>
    <div class="container-wide mt-12"><MemoryStory /></div>
    <div class="container-site">
      <h3 class="h3 mt-16">More than shared docs or chat history.</h3>
      <ul class="better">
        {better.map((b, i) => <li class="reveal" style={`--d:${i}`}><span class="better-ic"><b.i class="h-4 w-4" aria-hidden="true" /></span><h4>{b.t}</h4><p>{b.d}</p></li>)}
      </ul>
    </div>
  </section>

  <section id="sso" class="section-pad rule scroll-mt-16" aria-labelledby="sso-title">
    <div class="container-site split">
      <div>
        <SectionHeading id="sso-title" title="Your engineers. Your identities. Your access rules." lede="Developers sign in with the identity your organization already manages, and see only the projects and memory they’re allowed to. SSO is part of Teams, not an add-on." />
        <ul class="ticks">{sso.map((s) => <li><Check class="h-4 w-4" aria-hidden="true" />{s}</li>)}</ul>
      </div>
      <div class="min-w-0"><SsoDemo /></div>
    </div>
  </section>

  <section id="workers" class="section-pad rule bg-bg-elevated scroll-mt-16" aria-labelledby="workers-title">
    <div class="container-site split">
      <div>
        <SectionHeading id="workers-title" title="One pool of workers. Many developers." lede="Work Anywhere, in Vekrun Free, lets one developer run the Factory on their own VPS. Teams turns that into shared infrastructure: a pool of workers your organization hosts, used by the people your policies allow." />
        <ul class="ticks">
          <li><Check class="h-4 w-4" aria-hidden="true" />Shared remote worker pools on your own servers</li>
          <li><Check class="h-4 w-4" aria-hidden="true" />Policies decide who can use which workers, for which repositories</li>
          <li><Check class="h-4 w-4" aria-hidden="true" />Team-wide visibility into execution and verification</li>
          <li><Check class="h-4 w-4" aria-hidden="true" />No Vekrun per-worker or per-execution fees</li>
        </ul>
        <p class="mt-8"><a href="/product/#work-anywhere" class="link-more group">How Work Anywhere works<ArrowRight class="icon-nudge h-4 w-4" aria-hidden="true" /></a></p>
      </div>
      <div class="min-w-0"><WorkerPool /></div>
    </div>
  </section>

  <section id="pricing" class="section-pad rule scroll-mt-16" aria-labelledby="tp-title">
    <div class="container-site">
      <SectionHeading id="tp-title" title="One price for the whole organization." lede="No tiers to choose between and no usage fees. Every Teams capability and both deployment options are in one subscription." />
      <div class="tp">
        <div class="tp-card">
          <h3>Vekrun Teams</h3>
          <p class="tp-price"><b>{base}</b><span>USD per month</span></p>
          <p class="tp-inc">Includes {n} developers</p>
          <p class="tp-extra"><b>+{extra}</b> per month for each additional developer</p>
          <ul>{price.map((p) => <li><Check class="h-4 w-4" aria-hidden="true" />{p}</li>)}</ul>
          <Button href={teamsInterestMailto} size="lg" class="mt-6 w-full justify-center" data-teams-interest>Register Teams interest</Button>
          <p class="tp-fine">Opens an email to {site.earlyAccess.email}; nothing is sent until you send it.</p>
        </div>
        <div class="min-w-0">
          <TeamsCalc />
          <p class="mt-6"><a href="/pricing/#teams" class="link-more group">Compare Teams with Vekrun Free<ArrowRight class="icon-nudge h-4 w-4" aria-hidden="true" /></a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad rule bg-bg-elevated" aria-labelledby="faq-title">
    <div class="container-site grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <h2 id="faq-title" class="heading-2 text-text">Questions.</h2>
      <div class="faq">
        {faq.map(([q, a]) => (
          <details class="faq-i">
            <summary>{q}<ChevronDown class="h-4 w-4" aria-hidden="true" /></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-pad rule" aria-labelledby="go-title">
    <div class="container-site text-center">
      <h2 id="go-title" class="heading-2 text-text">Bring your whole engineering organization.</h2>
      <p class="lede mx-auto mt-4 max-w-2xl">{priceLine} Connected Desktops and Dedicated Coordinator included.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href={teamsInterestMailto} size="lg">Register Teams interest</Button>
        <Button href="/pricing/" size="lg" variant="secondary">Compare plans</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-price { margin: 1.25rem 0 0; font-size: 0.95rem; line-height: 1.5; color: var(--foreground-secondary); }
  .hero-price b { font-weight: 640; color: var(--foreground); }
  .split { display: grid; gap: 2.5rem; }
  @media (min-width: 64rem) { .split { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 4rem; align-items: start; } }
  .h3 { font-size: 1.35rem; font-weight: 620; letter-spacing: -0.02em; color: var(--foreground); }

  /* Scroll reveals, only with motion allowed (see the inline script) and only once. */
  :global(html.tm-motion) .reveal { transition: opacity 700ms var(--ease-out), transform 700ms var(--ease-out); transition-delay: calc(var(--d, 0) * 80ms); }
  :global(html.tm-motion) .reveal:not(:global(.is-visible)) { opacity: 0; transform: translateY(18px); }

  .pillars { margin: 3rem 0 0; padding: 0; list-style: none; display: grid; gap: 0 2.5rem; }
  @media (min-width: 40rem) { .pillars { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .pillars { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .pillars li { position: relative; padding: 1.6rem 0 1.8rem; border-top: 1px solid var(--border); }
  .pillars li::after { content: ''; position: absolute; left: 0; top: -1px; width: 100%; height: 1px; background: var(--accent-text); transform: scaleX(0); transform-origin: left; transition: transform 500ms var(--ease-out); }
  .pillars li:hover::after { transform: scaleX(1); }
  .pillar-ic { display: inline-grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: var(--radius-md); background: var(--accent-subtle); color: var(--accent-text); transition: background-color 300ms var(--ease-out), color 300ms var(--ease-out), box-shadow 300ms var(--ease-out); }
  .pillars li:hover .pillar-ic { background: var(--accent); color: var(--accent-foreground); box-shadow: 0 0 22px color-mix(in srgb, var(--accent) 35%, transparent); }
  .pillars h3 { margin: 1rem 0 0; font-size: 1.12rem; font-weight: 620; letter-spacing: -0.015em; color: var(--foreground); }
  .pillars p { margin: 0.4rem 0 0; font-size: 0.95rem; line-height: 1.55; color: var(--foreground-secondary); }

  .better { margin: 1.5rem 0 0; padding: 0; list-style: none; display: grid; column-gap: 3rem; }
  @media (min-width: 48rem) { .better { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .better li { display: grid; grid-template-columns: 2rem minmax(0, 1fr); column-gap: 0.9rem; padding: 1.1rem 0; border-top: 1px solid var(--border); }
  .better-ic { grid-row: span 2; display: inline-grid; place-items: center; width: 2rem; height: 2rem; border-radius: var(--radius-sm); background: var(--accent-subtle); color: var(--accent-text); }
  .better h4 { margin: 0; font-size: 1rem; font-weight: 600; color: var(--foreground); }
  .better p { margin: 0.3rem 0 0; font-size: 0.92rem; line-height: 1.5; color: var(--foreground-secondary); }
  .ticks { margin: 1.75rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.6rem; }
  .ticks li { display: flex; gap: 0.55rem; align-items: flex-start; font-size: 0.98rem; line-height: 1.5; color: var(--foreground); }
  .ticks :global(svg) { margin-top: 0.25rem; flex-shrink: 0; color: var(--accent-text); }

  .tp { margin-top: 3rem; display: grid; gap: 2rem; }
  @media (min-width: 64rem) { .tp { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 3rem; align-items: start; } }
  .tp-card { padding: 1.8rem; border: 1px solid var(--border-interactive); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--glow-accent), 0 24px 60px -32px color-mix(in srgb, var(--accent) 40%, transparent); }
  .tp-card h3 { margin: 0; font-size: 1.2rem; font-weight: 620; color: var(--foreground); }
  .tp-price { margin: 1rem 0 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.6rem; }
  .tp-price b { font-size: clamp(3rem, 2.4rem + 2vw, 4rem); font-weight: 660; letter-spacing: -0.05em; line-height: 1; color: var(--foreground); }
  .tp-price span { color: var(--foreground-secondary); }
  .tp-inc { margin: 0.6rem 0 0; font-size: 1.1rem; font-weight: 600; color: var(--accent-text); }
  .tp-extra { margin: 0.3rem 0 0; font-size: 0.98rem; color: var(--foreground-secondary); }
  .tp-extra b { font-weight: 640; color: var(--foreground); }
  .tp-card ul { margin: 1.3rem 0 0; padding: 1.3rem 0 0; border-top: 1px solid var(--border); list-style: none; display: grid; gap: 0.55rem; }
  .tp-card li { display: flex; gap: 0.55rem; align-items: flex-start; font-size: 0.93rem; color: var(--foreground); }
  .tp-card li :global(svg) { margin-top: 0.2rem; flex-shrink: 0; color: var(--accent-text); }
  .tp-fine { margin: 0.9rem 0 0; font-size: 0.8rem; color: var(--foreground-muted); }
  @media (prefers-reduced-motion: reduce) { .pillars li::after, .pillar-ic { transition: none; } }
</style>
