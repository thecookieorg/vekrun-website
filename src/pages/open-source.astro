---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageHero from '@/components/PageHero.astro';
import Button from '@/components/Button.astro';
import { site } from '@/data/site';

const points = [
  { title: 'No account, no subscription', body: 'Nothing to sign up for and nothing to pay Vekrun. Every desktop feature is in the free build. Vekrun Cloud, the optional team service, is the only thing Vekrun will ever charge for, and you never need it.' },
  { title: 'Your models', body: 'Connect Claude, OpenAI, Gemini, any compatible service, or a model running on your machine. Switch whenever you like.' },
  { title: 'Runs on your machine', body: 'Your code, sessions and history stay local. You see what leaves your machine before it leaves.' },
  { title: 'Your permissions', body: 'Agents do only what you allow. Every change is a diff you approve, and you can stop anything at any time.' },
  { title: 'Your infrastructure', body: 'If you want agents to run elsewhere, they run on a machine you own. The optional Vekrun Cloud coordinates a team; it does not run your code.' },
  { title: 'Open code', body: 'The source will be published with its architecture, roadmap and decisions, so you can see how it works and change it.' },
];
const title = 'Open source';
const description = 'Why Vekrun is free and open source, what it will never ask of you, and the licence it is published under.';
---
<Base title={title} description={description}>
  <PageHero eyebrow="Open source" title="Your development environment should" accent="belong to you." lede="AI coding tools tend to arrive with an account, a subscription and one vendor's models. Vekrun is the other way around: a terminal that works without AI, and when you want AI, it uses whichever models you choose." align="left" />

  <Section padded="tight">
    <ul class="ruled-grid sm:grid-cols-2 lg:grid-cols-3" role="list">
      {points.map((p) => (
        <li class="p-6">
          <h2 class="text-[1rem] font-[560] text-text">{p.title}</h2>
          <p class="mt-2 text-[0.9rem] leading-relaxed text-text-2">{p.body}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section rule padded="tight" class="pb-24">
    <div class="prose-site max-w-3xl text-[1.0625rem] leading-relaxed">
      <h2 class="!mt-0">Contributing</h2>
      <p>
        {site.status.line} The source repository is not yet public. When it opens, the most useful help will be testing on Windows and Linux and reporting what does not work. See <a href="/docs/advanced/contributing/">contributing</a> for how the project is built.
      </p>

      <h2 id="license">License</h2>
      <p>
        Vekrun will be published under the <strong>{site.license.name}</strong> ({site.license.status}). Everything, including AI Teams, the Board and the integrations, is part of that open build.
      </p>
      {site.repo.public ? (
        <p>The licence text is in the <a href={`${site.repo.url}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">repository</a>.</p>
      ) : (
        <p>The licence file will be linked here when the repository is public.</p>
      )}

      <h2>What may cost money</h2>
      <p>
        Vekrun is free. Hosted AI providers charge for what you use, coding-agent subscriptions have their own terms, and a machine you run agents on is yours to pay for. Local models cost nothing per token; larger AI Teams work may need a capable machine or a hosted provider.
      </p>
    </div>
    <div class="mt-10 flex flex-wrap gap-3">
      <Button href="/roadmap/">See the roadmap</Button>
      <Button href="/docs/" variant="secondary">Read the docs</Button>
    </div>
  </Section>
</Base>
