---
/**
 * The Product page, as five chapters of engineering work: Think, Build,
 * Prove, Deliver, and Remember and collaborate, closed by the models it all
 * runs on. Each chapter leads with one large demonstration and says the rest
 * in a sentence or two rather than a list.
 * Every older section id survives as an anchor inside its chapter, so feature
 * and docs URLs keep landing in the right place. Copy sells what people can
 * do, never how it's implemented.
 */
import Base from '@/layouts/Base.astro';
import ClosingCta from '@/components/ClosingCta.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Screenshot from '@/components/visuals/Screenshot.astro';
import Council from '@/components/visuals/Council.astro';
import ModelChoice from '@/components/home/ModelChoice.astro';
import MemoryDemo from '@/components/home/MemoryDemo.astro';
import LiveShareDemo from '@/components/home/LiveShareDemo.astro';
import LiveShareFlow from '@/components/liveshare/LiveShareFlow.astro';
import ArchGraph from '@/components/memory/ArchGraph.astro';
import EnvSetup from '@/components/product/EnvSetup.astro';
import ProofPack from '@/components/factory/ProofPack.astro';
import CompeteDemo from '@/components/compete/CompeteDemo.astro';
import WorkAnywhere from '@/components/anywhere/WorkAnywhere.astro';
import BoardFlow from '@/components/factory/BoardFlow.astro';
import MobileHost from '@/components/factory/MobileHost.astro';
import IntegrationLogo from '@/components/brand/IntegrationLogo.astro';
import { productSections } from '@/data/site';
import { toolById, hostingProviders as providers } from '@/data/integrations';
import { projectExamples } from '@/data/capabilities';
import { Check, ArrowRight, SquareTerminal, FileDiff, GitBranch, MessagesSquare, Monitor, Terminal, ShieldAlert, Gauge, FlaskConical, Workflow, Lock, ShieldCheck, Server, Brain, Network, Eye, SlidersHorizontal, GitPullRequest, History, Crosshair, Users, Mic } from '@lucide/astro';

const secure = [
  { t: 'Closed by default', d: 'Inbound traffic is denied, and public SSH closes once private access works.' },
  { t: 'Least privilege', d: 'The worker gets only the permissions it needs, with credentials stored and rotated.' },
  { t: 'Isolated work', d: 'Each Work Item runs separately from the others.' },
  { t: 'Previews without open ports', d: 'Approved previews leave over outbound-only tunnels, ready for Live Share.' },
];
const apps = [
  { logos: ['ios', 'swift'], t: 'iOS', d: 'Swift projects built and tested with your Xcode toolchain, and previewed in the iOS Simulator.' },
  { logos: ['android', 'kotlin'], t: 'Android', d: 'Kotlin projects built and tested with the Android SDK, and previewed in the emulator.' },
  { logos: ['expo', 'react-native'], t: 'Expo and React Native', d: 'One codebase for iOS and Android, with screens reviewed in the simulator.' },
  { logos: ['flutter'], t: 'Flutter', d: 'Mobile and web from one project, tested with Flutter’s own tooling.' },
  { logos: ['tauri', 'electron'], t: 'Desktop', d: 'Tauri and Electron apps, built and checked through their web interface.' },
];
const tools = [
  { i: Terminal, t: 'Headless CLI and MCP', d: 'Run Vekrun from your terminal, a script or another agent, with the same plans, permissions and Proof Packs as the app.' },
  { i: SquareTerminal, t: 'Terminal and SSH', d: 'Open a shell in any job, here or on a remote machine.' },
  { i: FileDiff, t: 'Code and diffs', d: 'Read exactly what changed before it goes anywhere.' },
  { i: GitBranch, t: 'Git and worktrees', d: 'Branches per job, so work never collides.' },
  { i: MessagesSquare, t: 'Coding sessions', d: 'Pair with a model directly when you’d rather drive.' },
];
const prove = [
  { i: Gauge, t: 'Risk Intelligence', d: 'Every change is weighed before it moves: what it touches, how far it reaches and what has gone wrong there before.' },
  { i: ShieldCheck, t: 'Adaptive Verification', d: 'A copy fix gets a quick check. A payment change gets browser runs, an independent review and a mutation challenge.' },
  { i: Eye, t: 'Independent review', d: 'A model from another AI developer reviews the work against your request, and its objections stay on the record.' },
];
const deliverMore = [
  { i: SlidersHorizontal, t: 'Autonomy Controller', d: 'Decide how much freedom each kind of change has earned: draft only, open a pull request, or merge when the evidence and your rules allow it.' },
  { i: GitPullRequest, t: 'Advanced PR Intelligence', d: 'Vekrun understands each pull request in context: its review history, the risk it carries and what reviewers will ask about.' },
];
const remember = [
  { i: History, t: 'Verified Failure Learning', d: 'When a failure is proven and fixed, the lesson is kept with its evidence, so the same mistake isn’t investigated twice.' },
  { i: Crosshair, t: 'Context Engine', d: 'Each agent gets the decisions, code and lessons that matter for its task, smaller and sharper, instead of everything.' },
  { i: Network, t: 'Living Architecture', d: 'Decisions and evidence stay attached to the parts of the system they concern.' },
];
const logo = (id: string) => toolById(id) ?? { id, name: id === 'ios' ? 'iOS' : id === 'android' ? 'Android' : id, mono: id.slice(0, 2) };
---
<Base title="Product" fullTitle="Product: everything your AI engineering team can do · Vekrun" image="/og/product.png" description="Think, build, prove, deliver, remember and collaborate: Competitive Engineering, Living Architecture Intelligence, Proof Packs, PR Guardian, Engineering Memory and Live Share, with Grok, Claude, OpenRouter or local models you download through Vekrun.">
  <PageHero eyebrow="Product" title="Everything your AI engineering team can do." lede="Vekrun thinks through the problem, builds it, proves it works and delivers it, then remembers what it learned. You stay in control of every decision that matters." cta={{ label: 'Request early access', href: '/download/' }} secondary={{ label: 'How it works', href: '/how-it-works/' }} />

  <nav class="pnav" aria-label="On this page">
    <div class="container-site"><ul>{productSections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}</ul></div>
  </nav>

  <!-- Think -->
  <section id="think" class="section-pad anchor" aria-labelledby="think-title">
    <div class="container-site">
      <header class="ch"><p class="ch-k">Think</p><h2 id="think-title" class="heading-2 text-text">Decide with evidence, before code is written.</h2><p class="ch-l">A Council of models weighs the approach, competing implementations settle what opinion can’t, and Living Architecture shows what a change will touch.</p></header>

      <div id="competitive" class="blk anchor">
        <h3 class="blk-t">Competitive Engineering</h3>
        <p class="blk-big">Don’t guess which approach is better. Build both. Prove it.</p>
        <p class="sub-lede">Vekrun designs two or three genuinely different approaches, builds each from the same revision, tests them against the same requirements and compares the evidence: verification, performance, cost and change size. You choose; the alternatives are kept. If none qualifies, it says so.</p>
      </div>
    </div>
    <div class="container-wide mt-10"><CompeteDemo /></div>
    <div class="container-site">
      <div class="duo">
        <div id="experiments" class="duo-i anchor">
          <span class="duo-ic"><Gauge class="h-4 w-4" aria-hidden="true" /></span>
          <h3>Measured engineering experiments</h3>
          <p>Compare performance before and after a change under a stated workload, with invariants that must still hold and a rehearsed rollback.</p>
          <dl class="exp">
            <div><dt>Workload</dt><dd>200 concurrent searches, 50,000 products</dd></div>
            <div><dt>Search p95</dt><dd>940 ms → 120 ms</dd></div>
            <div><dt>Invariants</dt><dd><Check class="h-3.5 w-3.5" aria-hidden="true" />Results and prices unchanged</dd></div>
            <div><dt>Rollback</dt><dd><Check class="h-3.5 w-3.5" aria-hidden="true" />Rehearsed and clean</dd></div>
          </dl>
        </div>
        <div id="improvement-lab" class="duo-i anchor">
          <span class="duo-ic"><FlaskConical class="h-4 w-4" aria-hidden="true" /></span>
          <h3>Factory Improvement Lab</h3>
          <p>Does a different model, prompt or workflow actually produce better verified results? The Improvement Lab measures it on real engineering tasks instead of assuming it.</p>
          <p class="duo-q">Better means more verified outcomes, not more confident claims.</p>
        </div>
      </div>

      <div id="council" class="blk split anchor">
        <div>
          <h3 class="blk-t">The Council</h3>
          <p class="blk-big">More than one perspective on decisions that matter.</p>
          <p class="sub-lede">Vekrun can bring models from different AI developers together to assess an approach, surface disagreements and name the risks. You see the reasoning, the objections and the decision, and a reviewer from another model family challenges the result later.</p>
          <p class="fine">Not every task convenes a Council, and more models don’t guarantee a correct answer: they make the reasoning visible and harder to get wrong quietly.</p>
        </div>
        <div class="min-w-0"><Council /></div>
      </div>

      <div id="architecture" class="blk split anchor">
        <div>
          <h3 class="blk-t">Living Architecture Intelligence</h3>
          <p class="blk-big">Understand your software before changing it.</p>
          <p class="sub-lede">Explore how components relate, step back through history with the Git Time Machine and see what a proposed change might affect. Every view is tied to its revision, and every relationship cites its source; inferred ones are marked.</p>
          <div id="production" class="mini anchor">
            <p class="mini-t"><ShieldAlert class="h-4 w-4" aria-hidden="true" />From a production error to the code behind it</p>
            <p>Production-to-Code Intelligence connects errors from your monitoring tools to the code involved, shows it in its architectural context, links the change that likely caused it and turns it into a Work Item.</p>
          </div>
          <div id="voice" class="mini anchor">
            <p class="mini-t"><Mic class="h-4 w-4" aria-hidden="true" />Talk it through</p>
            <p>Discuss options out loud or in text with a colleague who knows the codebase. Agree on a direction and it becomes work you approve.</p>
          </div>
        </div>
        <div class="min-w-0"><ArchGraph /></div>
      </div>
    </div>
  </section>

  <!-- Build -->
  <section id="build" class="section-pad rule bg-bg-elevated anchor" aria-labelledby="build-title">
    <div class="container-site">
      <header class="ch"><p class="ch-k">Build</p><h2 id="build-title" class="heading-2 text-text">A Factory that works while you don’t.</h2><p class="ch-l">Work is planned into Work Items, each built in its own isolated environment, on your Mac or on a server you control, and you can step in at any point.</p></header>
      <div id="board" class="blk anchor">
        <h3 class="blk-t">Factory and Work Items</h3>
        <p class="blk-big">All your engineering work on one Board.</p>
        <p class="sub-lede">Tickets, pull requests and production errors, each one a job away from a fix. Dependencies are respected and independent work runs in parallel.</p>
        <div class="mt-8"><BoardFlow /></div>
      </div>

      <div id="work-anywhere" class="blk anchor">
        <h3 class="blk-t">Work Anywhere</h3>
        <p class="blk-big">Your laptop isn’t your build server. Unless you want it to be.</p>
        <p class="sub-lede">Run the Factory locally or on infrastructure you control. Send builds, tests and autonomous work to your own VPS, and get verified results back on your Mac.</p>
        <div class="mt-8"><WorkAnywhere /></div>
        <div class="split mt-10">
          <div>
            <p class="prose-s">Keep long builds off your laptop. Connect a server you already have, or let Vekrun set up a new one, then follow every remote Work Item from your Mac. Vekrun charges nothing per worker or per run.</p>
            <ul class="prov-p" aria-label="Hosting providers">{providers.map((p) => <li><IntegrationLogo id={p.id} name={p.name} monogram={p.mono} size="sm" />{p.name}</li>)}<li><span class="prov-srv"><Server class="h-3.5 w-3.5" aria-hidden="true" /></span>Any existing server</li></ul>
          </div>
          <div>
            <p class="mini-t"><Lock class="h-4 w-4" aria-hidden="true" />Private from the first boot</p>
            <ul class="sec">{secure.map((c) => <li><h4>{c.t}</h4><p>{c.d}</p></li>)}</ul>
          </div>
        </div>
        <p class="fine">Work Anywhere is included in Vekrun Free. Teams adds shared worker pools; see <a href="/teams/#workers" class="text-accent link-slide">Vekrun Teams</a>.</p>
      </div>

      <div id="environments" class="blk split anchor">
        <div>
          <h3 class="blk-t">Environments</h3>
          <p class="blk-big">Less time configuring. More time building.</p>
          <p class="sub-lede">Vekrun reads your project and prepares what it needs: supported toolchains, dependencies, and the databases and services your tests rely on. One-time prerequisites, such as Xcode, are called out plainly.</p>
          <div id="templates" class="mini anchor">
            <p class="mini-t"><Workflow class="h-4 w-4" aria-hidden="true" />Workflow Templates</p>
            <p>Start from a proven way of working, such as a bug fix or a dependency upgrade, and customize its steps, checks and approvals. Or take over unfinished work on an existing branch.</p>
          </div>
        </div>
        <div class="min-w-0"><EnvSetup /></div>
      </div>

      <div id="tools" class="blk anchor">
        <h3 class="blk-t">Step in whenever you want</h3>
        <ul class="pts">{tools.map((t) => <li><t.i class="h-5 w-5 text-accent" aria-hidden="true" /><h4>{t.t}</h4><p>{t.d}</p></li>)}</ul>
      </div>

      <div id="apps" class="blk anchor">
        <h3 class="blk-t">Every screen, not just the browser</h3>
        <ul class="apps">
          {apps.map((a) => (
            <li>
              <span class="apps-logos">{a.t === 'Desktop' && <span class="apps-ic"><Monitor class="h-4 w-4" aria-hidden="true" /></span>}{a.logos.map((id) => { const t = logo(id); return <IntegrationLogo id={t.id} name={t.name} monogram={t.mono} size="sm" />; })}</span>
              <h4>{a.t}</h4>
              <p>{a.d}</p>
            </li>
          ))}
        </ul>
      </div>

      <div id="stack" class="blk anchor">
        <h3 class="blk-t">Your stack. Your repository. Your workflow.</h3>
        <p class="sub-lede">Vekrun works in your repositories with your project’s own tooling. <a href="/integrations/" class="text-accent link-slide">See the integrations</a></p>
        <ul class="ex">
          {projectExamples.map((e) => (
            <li>
              <span class="ex-logos">{e.logos.map((id) => { const t = logo(id); return <IntegrationLogo id={t.id} name={t.name} monogram={t.mono} size="sm" />; })}</span>
              <h4>{e.title}</h4>
              <p>{e.line}</p>
            </li>
          ))}
        </ul>
      </div>

      <div id="mobile" class="blk anchor">
        <h3 class="blk-t">Your Factory, in your pocket</h3>
        <p class="sub-lede">Assign and approve work from your phone while your own machine does the building.</p>
        <div class="mt-8"><MobileHost /></div>
      </div>
    </div>
  </section>

  <!-- Prove -->
  <section id="prove" class="section-pad rule anchor" aria-labelledby="prove-title">
    <div class="container-site">
      <header class="ch"><p class="ch-k">Prove</p><h2 id="prove-title" class="heading-2 text-text">Done means proven, not just claimed.</h2><p class="ch-l">The depth of checking follows the risk of the change, and every result arrives with a Proof Pack: the evidence on the exact revision, and an honest list of what wasn’t checked.</p></header>
      <ul class="trio">{prove.map((c) => <li><span class="duo-ic"><c.i class="h-4 w-4" aria-hidden="true" /></span><h3>{c.t}</h3><p>{c.d}</p></li>)}</ul>
      <div id="proof" class="blk split anchor">
        <div>
          <h3 class="blk-t">Proof Packs</h3>
          <p class="blk-big">Evidence you can read in a minute.</p>
          <p class="sub-lede">Your project’s own test results, checked against the acceptance criteria and pinned to the exact revision. Review findings and objections stay in, known gaps are listed rather than hidden, and your approval is recorded with the result.</p>
          <div id="high-assurance" class="mini anchor">
            <p class="mini-t"><FlaskConical class="h-4 w-4" aria-hidden="true" />Do your tests actually catch mistakes?</p>
            <p>For high-assurance work, a mutation challenge makes small deliberate changes to the code and checks whether your tests notice. Tests that miss them are listed.</p>
          </div>
        </div>
        <div class="min-w-0"><ProofPack /></div>
      </div>
      <div id="browser" class="blk split anchor">
        <div>
          <h3 class="blk-t">Interactive Browser</h3>
          <p class="blk-big">Point at the problem instead of explaining it.</p>
          <p class="sub-lede">Click through your running app inside Vekrun, select what’s wrong and say why. Each comment carries its page, viewport and revision, becomes a Work Item, and the fix is checked in the same browser.</p>
        </div>
        <div class="min-w-0"><Screenshot name="browser-annotate" alt="The Vekrun desktop app's Interactive Browser: a checkout page with two numbered comments, each queued as work for an agent." caption="The Interactive Browser in the Vekrun desktop app." /></div>
      </div>
    </div>
  </section>

  <!-- Deliver -->
  <section id="deliver" class="section-pad rule bg-bg-elevated anchor" aria-labelledby="deliver-title">
    <div class="container-site">
      <header class="ch"><p class="ch-k">Deliver</p><h2 id="deliver-title" class="heading-2 text-text">Your branches. Your policies. Your approvals.</h2><p class="ch-l">Vekrun delivers inside the Git workflow you already have, and you decide how far it goes on its own.</p></header>
      <div id="delivery" class="blk split anchor">
        <div id="guardian" class="anchor">
          <h3 class="blk-t">PR Guardian</h3>
          <p class="blk-big">Pull requests that look after themselves.</p>
          <p class="sub-lede">Once a pull request is open, PR Guardian keeps watching. It notices failing CI and requested changes, repairs them when you’ve allowed it, with fresh evidence, and merges only if you’ve explicitly said it may.</p>
        </div>
        <div>
          <h3 class="blk-t">Git, your way</h3>
          <p class="blk-big">Your branch rules, honoured.</p>
          <p class="sub-lede">Projects become Work Items that respect their dependencies and run in parallel where they can. Protected branches and your review rules are honoured, changes land safely in existing checkouts, and the Board shows what’s in flight and what shipped.</p>
        </div>
      </div>
      <ul class="trio is-two">{deliverMore.map((c) => <li><span class="duo-ic"><c.i class="h-4 w-4" aria-hidden="true" /></span><h3>{c.t}</h3><p>{c.d}</p></li>)}</ul>
    </div>
  </section>

  <!-- Remember -->
  <section id="remember" class="section-pad rule anchor" aria-labelledby="remember-title">
    <div class="container-site">
      <header class="ch"><p class="ch-k">Remember</p><h2 id="remember-title" class="heading-2 text-text">Every task leaves the project better understood.</h2><p class="ch-l">Engineering Memory keeps decisions, verified fixes and their evidence, so the next task starts from what you already know. The people you work with can join in while the work is still happening.</p></header>
      <div id="memory" class="blk split anchor">
        <div>
          <h3 class="blk-t">Engineering Memory</h3>
          <p class="blk-big">Ask why, and get the answer with its sources.</p>
          <p class="sub-lede">Vekrun understands your repository’s structure and conventions, reads your docs and Obsidian vaults without editing them, and links Work Items to their evidence.</p>
          <ul class="stack3">{remember.map((c) => <li><span class="duo-ic"><c.i class="h-4 w-4" aria-hidden="true" /></span><div><h4>{c.t}</h4><p>{c.d}</p></div></li>)}</ul>
        </div>
        <div class="min-w-0"><MemoryDemo /></div>
      </div>
      <p class="tier-line"><Brain class="h-4 w-4" aria-hidden="true" /><span>Personal Engineering Memory is in Vekrun Free. <a href="/teams/" class="text-accent link-slide">Vekrun Teams</a> shares it across engineers, repositories and their agents.</span></p>
      <div id="collaborate" class="blk-sub anchor">
        <h3 class="blk-sub-h">Bring people, and other Vekruns, into the work.</h3>
        <p class="ch-l">Reviewers use what you’re building while it’s being built, and Vekrun installations can work together directly.</p>
      </div>
      <div id="live-share" class="blk anchor">
        <h3 class="blk-t">Live Share</h3>
        <p class="blk-big">Don’t send screenshots. Send the app.</p>
        <div class="split mt-8">
          <LiveShareFlow />
          <div class="min-w-0"><LiveShareDemo /></div>
        </div>
        <p class="fine">Web, iOS, Android, Expo, Flutter and desktop apps, each previewed the way that suits it. Your review link stays the same, but it isn’t hosting: the app runs on your machine, so reviewers can use it while Live Share is on. Choose who gets in. <a href="/privacy/#live-share" class="text-accent link-slide">What Live Share relays and keeps</a></p>
      </div>
      <div class="mini is-wide">
        <p class="mini-t"><Users class="h-4 w-4" aria-hidden="true" />Vekrun-to-Vekrun collaboration</p>
        <p>Your Vekrun and a teammate’s can work together directly: hand over a Work Item with its context, ask another installation for a review, or split a project across machines, each keeping its own permissions.</p>
      </div>
    </div>
  </section>

  <!-- Models -->
  <section id="models" class="section-pad rule bg-bg-elevated anchor" aria-labelledby="models-title">
    <div class="container-site">
      <SectionHeading id="models-title" kicker="Models" title="Your AI. Your hardware. Your choice." lede="Use Vekrun’s native agent with OpenRouter, Grok through xAI, or compatible local models you download through Vekrun. Bring Claude Code, Codex, Antigravity CLI or Grok Build if you like; none is required." />
      <div class="mt-12"><ModelChoice /></div>
      <p class="mt-10"><a href="/integrations/#grok" class="link-more group">Three ways to bring Grok into Vekrun<ArrowRight class="icon-nudge h-4 w-4" aria-hidden="true" /></a></p>
    </div>
  </section>

  <ClosingCta title="Hand Vekrun your next outcome." />
</Base>

<style>
  .ch { max-width: 48rem; }
  .ch-k { margin: 0; font-size: clamp(2.6rem, 1.8rem + 3vw, 4.2rem); line-height: 1; font-weight: 680; letter-spacing: -0.045em; color: var(--accent-text); }
  .ch h2 { margin-top: 1rem; }
  .ch-l { margin: 1rem 0 0; font-size: 1.1rem; line-height: 1.55; color: var(--foreground-secondary); }
  .blk { margin-top: 4rem; }
  @media (min-width: 64rem) { .blk { margin-top: 5rem; } }
  .blk-t { margin: 0; font-size: 0.9rem; font-weight: 600; color: var(--foreground-secondary); }
  .blk-big { margin: 0.4rem 0 0; max-width: 40rem; font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem); line-height: 1.2; font-weight: 640; letter-spacing: -0.025em; color: var(--foreground); }
  .mini { margin-top: 1.5rem; padding: 1.1rem 1.2rem; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); }
  .mini.is-wide { margin-top: 3rem; max-width: 52rem; }
  .mini-t { margin: 0; display: flex; align-items: center; gap: 0.5rem; font-size: 1rem; font-weight: 620; color: var(--foreground); }
  .mini-t :global(svg) { flex-shrink: 0; color: var(--accent-text); }
  .mini > p:not(.mini-t) { margin: 0.45rem 0 0; font-size: 0.93rem; line-height: 1.55; color: var(--foreground-secondary); }
  .trio { margin: 3rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.75rem; }
  @media (min-width: 56rem) { .trio { grid-template-columns: repeat(3, minmax(0, 1fr)); } .trio.is-two { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .trio li { padding: 1.3rem; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); }
  .trio h3 { margin: 0.75rem 0 0; font-size: 1.1rem; font-weight: 620; color: var(--foreground); }
  .trio p { margin: 0.4rem 0 0; font-size: 0.93rem; line-height: 1.55; color: var(--foreground-secondary); }
  .stack3 { margin: 1.75rem 0 0; padding: 0; list-style: none; display: grid; gap: 1.1rem; }
  .stack3 li { display: flex; gap: 0.8rem; align-items: flex-start; }
  .stack3 h4 { margin: 0.15rem 0 0; font-size: 1rem; font-weight: 620; color: var(--foreground); }
  .stack3 p { margin: 0.2rem 0 0; font-size: 0.92rem; line-height: 1.5; color: var(--foreground-secondary); }
  .sec { margin-top: 1rem !important; }
  @media (min-width: 64rem) { .sec { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; } }
  .apps h4, .ex h4, .pts h4 { margin: 0; font-size: 1rem; font-weight: 600; color: var(--foreground); }
  @media (min-width: 64rem) { .pts { grid-template-columns: repeat(5, minmax(0, 1fr)) !important; } }
  .pts { margin-top: 1.25rem !important; }
