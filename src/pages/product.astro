---
/**
 * The Product page: everything Vekrun's AI engineering team can do, one
 * capability per section. Models first, then how decisions, knowledge,
 * feedback, verification and delivery work, then the kinds of software you
 * can build and the tools around it. The workflow narrative lives on How It
 * Works. Section ids are stable: old feature and docs URLs redirect to them.
 * Copy sells what people can do, never how it's implemented.
 */
import Base from '@/layouts/Base.astro';
import ClosingCta from '@/components/ClosingCta.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Screenshot from '@/components/visuals/Screenshot.astro';
import Council from '@/components/visuals/Council.astro';
import ModelChoice from '@/components/home/ModelChoice.astro';
import MemoryDemo from '@/components/home/MemoryDemo.astro';
import LiveShareDemo from '@/components/home/LiveShareDemo.astro';
import LiveShareFlow from '@/components/liveshare/LiveShareFlow.astro';
import LiveShareTargets from '@/components/liveshare/LiveShareTargets.astro';
import ArchGraph from '@/components/memory/ArchGraph.astro';
import VoiceDemo from '@/components/product/VoiceDemo.astro';
import EnvSetup from '@/components/product/EnvSetup.astro';
import ProofPack from '@/components/factory/ProofPack.astro';
import CompeteDemo from '@/components/compete/CompeteDemo.astro';
import WorkAnywhere from '@/components/anywhere/WorkAnywhere.astro';
import BoardFlow from '@/components/factory/BoardFlow.astro';
import MobileHost from '@/components/factory/MobileHost.astro';
import IntegrationLogo from '@/components/brand/IntegrationLogo.astro';
import { productSections } from '@/data/site';
import { stackRows, toolById } from '@/data/integrations';
import { projectExamples } from '@/data/capabilities';
import { Check, ArrowRight, SquareTerminal, FileDiff, GitBranch, MessagesSquare, Monitor, Terminal, ShieldAlert, Gauge, FlaskConical, Workflow, Lock, ShieldCheck, Server, Brain, Network } from '@lucide/astro';

const council = [
  'Different models can evaluate the same engineering problem',
  'Important decisions get extra scrutiny before code is written',
  'Objections and alternative approaches stay visible',
  'A change can be reviewed by a model from a different family',
  'Verification evidence shows what was checked, and what wasn’t',
];
const memoryNow = [
  'Understands your repository’s structure and conventions',
  'Remembers engineering decisions and the reasoning behind them',
  'Tracks Work Items and links them to their verification evidence',
  'Reads your documentation and Obsidian vaults, without editing them',
  'Answers project questions with links to its sources',
  'Means less re-explaining between sessions',
];
const competitive = [
  'Designs two or three genuinely different approaches',
  'Builds each one independently, from the same starting revision',
  'Tests every approach against the same acceptance requirements',
  'Compares verification, performance, cost, change size and architectural impact',
  'Recommends an approach only when the evidence supports it',
  'Leaves the choice to you, and keeps the alternatives and their reasoning',
];
const arch = [
  { t: 'Architecture Explorer', d: 'See how components relate and what depends on what.' },
  { t: 'Git Time Machine', d: 'Step back through history and see how the architecture evolved.' },
  { t: 'Change Impact Intelligence', d: 'See what a proposed change might affect before it’s made.' },
  { t: 'Revision-bound graphs', d: 'Every view is tied to the exact revision it describes.' },
  { t: 'Sources and dependencies', d: 'Relationships cite the code they were found in.' },
  { t: 'Part of Engineering Memory', d: 'Decisions and evidence connect to the parts of the system they concern.' },
];
const production = [
  'Connects production errors and stack traces to the code involved',
  'Shows that code in its architectural context: what calls it and what it affects',
  'Links recent changes that may have introduced the problem',
  'Turns an error into a Work Item, with the context already attached',
];
const guardian = [
  'Watches your pull requests after they’re opened',
  'Notices failing CI and requested changes',
  'Repairs them when you’ve authorized it, with fresh evidence',
  'Merges verified code only if you’ve explicitly allowed it',
];
const templates = [
  'Start from predefined workflows, such as a bug fix or a dependency upgrade',
  'Customize the steps, checks and approvals for your team',
  'Take over unfinished work on an existing branch',
];
const anywhere = [
  'Work locally or on remote infrastructure you control',
  'Keep long builds and engineering jobs off your laptop',
  'Connect an existing server, or provision a new one',
  'Choose your own hosting provider',
  'Follow and manage remote Work Items in Vekrun',
  'Open remote previews through secured connections',
  'No Vekrun per-worker or per-execution fees',
];
const provisioning = [
  'Open Work Anywhere',
  'Pick a hosting provider, or connect an existing server',
  'Choose a server size',
  'Authorize Vekrun to set it up',
  'Vekrun installs its headless worker securely',
  'Private access and firewall rules are put in place',
  'The server appears as a place the Factory can run',
  'Work Items run there, and come back verified',
];
const providers = [
  { id: 'hetzner', name: 'Hetzner', mono: 'HZ' },
  { id: 'digitalocean', name: 'DigitalOcean', mono: 'DO' },
  { id: 'vultr', name: 'Vultr', mono: 'VU' },
  { id: 'akamai', name: 'Akamai Linode', mono: 'AK' },
  { id: 'aws', name: 'AWS', mono: 'AW' },
];
const secure = [
  { t: 'Closed by default', d: 'Inbound traffic is denied unless it’s needed.' },
  { t: 'Private access', d: 'Reach the server over a private network such as Tailscale, then close public SSH once private access works.' },
  { t: 'Enrolled securely', d: 'The worker is set up and registered with your machine from the first boot.' },
  { t: 'Least privilege', d: 'The worker gets only the permissions it needs.' },
  { t: 'Isolated work', d: 'Each Work Item runs separately from the others.' },
  { t: 'Previews without open ports', d: 'Approved app previews leave over outbound-only tunnels, compatible with Live Share.' },
  { t: 'Credentials handled with care', d: 'Stored securely and rotated.' },
  { t: 'Nothing hidden', d: 'See the server’s security settings at a glance.' },
];
const next = [
  { theme: 'Safer autonomous delivery', items: [
    { t: 'Risk Intelligence', d: 'Understand how risky a change is before it moves forward.' },
    { t: 'Adaptive Verification', d: 'Match the depth of checking to the risk of the change.' },
    { t: 'Autonomy Controller', d: 'Decide how much autonomy each change has earned. PR Guardian already merges when you authorize it.' },
    { t: 'Advanced PR Intelligence', d: 'Deeper understanding of pull requests, reviews and their history.' },
  ] },
  { theme: 'Learning from engineering evidence', items: [
    { t: 'Verified Failure Learning', d: 'Learn from failures that were proven and fixed, so they aren’t repeated.' },
    { t: 'Context Engine Optimization', d: 'Give every agent sharper, smaller context for each task.' },
  ] },
  { theme: 'Connected developer workspaces', items: [
    { t: 'Full headless CLI and MCP', d: 'Everything in the app from the terminal and other agents. CLI and MCP work today; full parity is coming.' },
    { t: 'Vekrun-to-Vekrun collaboration', d: 'Installations working together directly.' },
  ] },
];
const share = [
  'Review software while it’s still being built',
  'Open supported previews in a normal browser',
  'Interact with the running app remotely',
  'No development tools needed on the reviewer’s side',
  'Comments stay tied to their screen or element',
  'Approve what becomes work, then see the fix verified',
];
const browser = [
  'Click through your running app inside Vekrun',
  'Select the element that’s wrong and say why',
  'Each comment carries its page, viewport and revision',
  'Approved comments become Work Items, and the fix is checked in the same browser',
];
const proof = [
  'Test results from your project’s own suite',
  'Verification results against the acceptance criteria',
  'Pinned to the exact revision they were taken on',
  'Review findings, including objections',
  'Known gaps, listed rather than hidden',
  'Your approval, recorded with the result',
  'Optional mutation challenges for high-assurance work',
];
const delivery = [
  'Projects planned into Work Items',
  'Dependencies respected, independent work run in parallel',
  'Branch policies and protected branches honoured',
  'Pull and merge requests with evidence attached',
  'Review and approval workflows you define',
  'Changes integrated safely into existing checkouts',
  'A Board that shows what’s in flight and what shipped',
];
const envs = [
  'Detects what your project needs from its own files',
  'Prepares supported language toolchains and dependencies',
  'Starts the databases and services your tests rely on',
  'Tells you plainly about one-time prerequisites, such as Xcode or Android Studio',
];
const voice = [
  'Discuss ideas and options out loud or in text',
  'Ask questions about your project and get sourced answers',
  'Challenge an approach and hear the trade-offs',
  'Turn an approved decision into a Work Item',
];
const apps = [
  { logos: ['ios', 'swift'], t: 'iOS', d: 'Swift projects built and tested with your Xcode toolchain, and previewed in the iOS Simulator.' },
  { logos: ['android', 'kotlin'], t: 'Android', d: 'Kotlin projects built and tested with the Android SDK, and previewed in the emulator.' },
  { logos: ['expo', 'react-native'], t: 'Expo and React Native', d: 'One codebase for iOS and Android, with screens reviewed in the simulator.' },
  { logos: ['flutter'], t: 'Flutter', d: 'Mobile and web from one project, tested with Flutter’s own tooling.' },
  { logos: ['tauri', 'electron'], t: 'Desktop', d: 'Tauri and Electron apps, built and checked through their web interface.' },
];
const tools = [
  { i: SquareTerminal, t: 'Terminal and SSH', d: 'Open a shell in any job, here or on a remote machine.' },
  { i: FileDiff, t: 'Code and diffs', d: 'Read exactly what changed before it goes anywhere.' },
  { i: GitBranch, t: 'Git and worktrees', d: 'Branches per job, so work never collides.' },
  { i: MessagesSquare, t: 'Coding sessions', d: 'Pair with a model directly when you’d rather drive.' },
  { i: Terminal, t: 'CLI and MCP', d: 'Drive Vekrun from your terminal or from another agent.' },
];
const logo = (id: string) => toolById(id) ?? { id, name: id === 'ios' ? 'iOS' : id === 'android' ? 'Android' : id, mono: id.slice(0, 2) };
---
<Base title="Product" fullTitle="Product: everything your AI engineering team can do · Vekrun" image="/og/product.png" description="Competitive Engineering, Living Architecture Intelligence, Proof Packs with high-assurance checks, PR Guardian, Live Share and Engineering Memory, with OpenRouter or local models you download through Vekrun. Work Anywhere is coming to Free.">
  <PageHero eyebrow="Product" title="Everything your AI engineering team can do." lede="Vekrun plans, builds, verifies and delivers real software with the models you choose, and keeps you in control of every decision that matters." cta={{ label: 'Request early access', href: '/download/' }} secondary={{ label: 'How it works', href: '/how-it-works/' }} />

  <nav class="pnav" aria-label="On this page">
    <div class="container-site"><ul>{productSections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}</ul></div>
  </nav>

  <section id="models" class="section-pad anchor" aria-labelledby="models-title">
    <div class="container-site">
      <SectionHeading id="models-title" title="Your AI. Your hardware. Your choice." lede="Connect OpenRouter, or discover and download compatible local models through Vekrun. Run AI on your own hardware, with no paid cloud model subscription needed for supported workflows." />
      <div class="mt-12"><ModelChoice /></div>
    </div>
  </section>

  <section id="council" class="section-pad rule bg-bg-elevated anchor" aria-labelledby="council-title">
    <div class="container-site split">
      <div>
        <SectionHeading id="council-title" title="Better engineering decisions deserve more than one perspective." lede="Vekrun can bring different AI models together to assess an approach, surface disagreements and identify risks. You see the reasoning, the objections and the decision." />
        <ul class="ticks">{council.map((c) => <li><Check class="h-4 w-4" aria-hidden="true" />{c}</li>)}</ul>
        <div class="second">
          <h3>A second opinion that actually challenges the first.</h3>
          <p>Vekrun can bring a model from another AI developer into the review process, helping identify weaknesses that the original implementation and its tests may have missed. In one recent review the tests were passing, and the reviewer still found that they didn’t properly test the ranking they were meant to prove.</p>
        </div>
        <p class="fine">Not every task convenes a Council, and more models don’t guarantee a correct answer: they make the reasoning visible and harder to get wrong quietly.</p>
      </div>
      <div class="min-w-0"><Council /></div>
    </div>
  </section>

  <section id="competitive" class="section-pad rule anchor" aria-labelledby="competitive-title">
    <div class="container-site">
      <SectionHeading id="competitive-title" title="Don’t guess which approach is better. Build both. Prove it." lede="Most AI coding tools give you one implementation. Vekrun can build competing approaches, verify each against the same requirements, compare the evidence and help you choose." />
      <div class="split mt-12">
        <div>
          <ul class="ticks mt-0">{competitive.map((c) => <li><Check class="h-4 w-4" aria-hidden="true" />{c}</li>)}</ul>
          <p class="fine">If no approach meets the requirements, Vekrun says so instead of picking the least bad one.</p>
        </div>
        <div class="min-w-0"><CompeteDemo /></div>
      </div>
      <div class="duo">
        <div id="experiments" class="duo-i anchor">
          <span class="duo-ic"><Gauge class="h-4 w-4" aria-hidden="true" /></span>
          <h3>Measured engineering experiments</h3>
          <p>Compare performance before and after a change under a stated workload, with invariants that must still hold and a rehearsed rollback.</p>
          <dl class="exp">
            <div><dt>Workload</dt><dd>200 concurrent searches, 50,000 products</dd></div>
            <div><dt>Search p95</dt><dd>940 ms → 120 ms</dd></div>
            <div><dt>Invariants</dt><dd><Check class="h-3.5 w-3.5" aria-hidden="true" />Results and prices unchanged</dd></div>
            <div><dt>Rollback</dt><dd><Check class="h-3.5 w-3.5" aria-hidden="true" />Rehearsed and clean</dd></div>
          </dl>
          <p class="exp-cap">Example figures.</p>
        </div>
        <div id="improvement-lab" class="duo-i anchor">
          <span class="duo-ic"><FlaskConical class="h-4 w-4" aria-hidden="true" /></span>
          <h3>Factory Improvement Lab</h3>
          <p>Does a different model, prompt or workflow actually produce better verified results? The Improvement Lab measures it on real engineering tasks instead of assuming it.</p>
          <p class="duo-q">Better means more verified outcomes, not more confident claims.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="memory" class="section-pad rule bg-bg-elevated anchor" aria-labelledby="memory-title">
    <div class="container-site">
      <SectionHeading id="memory-title" title="Software that understands your software." lede="Vekrun builds an evolving understanding of your project, connecting decisions, changes, requirements and evidence, so your team works with context instead of starting over." />
      <div class="sub">
        <div class="sub-head"><h3>Engineering Memory</h3></div>
        <div class="split mt-6">
          <ul class="ticks mt-0">{memoryNow.map((c) => <li><Check class="h-4 w-4" aria-hidden="true" />{c}</li>)}</ul>
          <div class="min-w-0"><MemoryDemo /></div>
        </div>
        <p class="tier-line"><Brain class="h-4 w-4" aria-hidden="true" />Vekrun Free includes personal Engineering Memory. Shared Engineering Memory across a team is coming to <a href="/teams/" class="text-accent link-slide">Vekrun Teams</a>.</p>
        <div class="mt-10"><Screenshot name="memory-understand" width={1440} height={437} alt="Engineering Memory in the Vekrun desktop app: Understand this project lists what was read (files and languages, manifests and CI, entry points, code map, docs and tests, Git history, interpretations), above Knowledge sources with an Add Obsidian vault button." caption="Engineering Memory in the Vekrun desktop app: project understanding and knowledge sources." /></div>
      </div>
      <div id="architecture" class="sub anchor">
        <div class="sub-head"><h3>Living Architecture Intelligence</h3></div>
        <p class="sub-big">Understand your codebase, not just its files.</p>
        <p class="sub-lede">Explore how components relate, what depends on what, how the architecture evolved, and what a proposed change might affect.</p>
        <div class="split mt-6">
          <ul class="arch">{arch.map((a) => <li><Network class="h-4 w-4" aria-hidden="true" /><div><p>{a.t}</p><span>{a.d}</span></div></li>)}</ul>
          <div class="min-w-0"><ArchGraph /></div>
        </div>
        <p class="fine">The graph is built from what Vekrun can see in your code and its history. Some relationships, such as ones resolved only at runtime, can be missed or are marked as inferred. Vekrun shows its sources and its uncertainty, so you know how far to trust each connection.</p>
      </div>
    </div>
  </section>

  <section id="live-share" class="section-pad rule anchor" aria-labelledby="share-title">
    <div class="container-site">
      <SectionHeading id="share-title" title="Let anyone experience what you’re building." lede="Share an interactive preview with your team, designer, tester or client while development is still underway. They explore the app in their browser, leave feedback in context and help improve the result without waiting for a release." />
      <p class="big-line">Don’t send screenshots. Send the app.</p>
      <div class="split mt-10">
        <LiveShareFlow />
        <div class="min-w-0"><LiveShareDemo /></div>
      </div>
      <h3 class="h3 h3-gap">Web, mobile and desktop.</h3>
      <p class="sub-lede">Live Share works with the kinds of apps you build, each previewed the way that suits it.</p>
      <div class="mt-6"><LiveShareTargets /></div>
      <div class="split mt-14">
        <div>
          <h3 class="h3">What reviewers and you get.</h3>
          <ul class="ticks">{share.map((c) => <li><Check class="h-4 w-4" aria-hidden="true" />{c}</li>)}</ul>
          <p class="fine">Your review link stays the same between sessions, but it isn’t hosting: the app runs on your machine, so reviewers can use it while Live Share is on and your machine is running. Choose who gets in: anyone with the link, a password, or no one. Live Share relays through a gateway Vekrun operates. <a href="/privacy/#live-share" class="text-accent link-slide">What it relays and keeps</a></p>
        </div>
        <div class="min-w-0"><Screenshot name="liveshare-review" alt="The Live Share Review Inbox in the Vekrun desktop app: a reviewer’s comment about a cramped checkout heading, with the region they selected highlighted on the page and the page, viewport and revision recorded." caption="Live Share’s Review Inbox in the Vekrun desktop app. Each comment keeps the exact region, page and revision it refers to." /></div>
      </div>
    </div>
  </section>

  <section id="browser" class="section-pad rule bg-bg-elevated anchor" aria-labelledby="browser-title">
    <div class="container-site split">
      <div>
        <SectionHeading id="browser-title" title="Point at the problem instead of explaining it." lede="The Interactive Browser lets you use your running app inside Vekrun, mark what’s wrong and turn it into work. Live Share brings other people in; the Interactive Browser is for you." />
        <ul class="ticks">{browser.map((c) => <li><Check class="h-4 w-4" aria-hidden="true" />{c}</li>)}</ul>
      </div>
      <div class="min-w-0"><Screenshot name="browser-annotate" alt="The Vekrun desktop app's Interactive Browser: a checkout page with two numbered comments, each queued as work for an agent." caption="The Interactive Browser in the Vekrun desktop app. Point at what’s wrong; each comment becomes verified work." /></div>
    </div>
  </section>

  <section id="proof" class="section-pad rule anchor" aria-labelledby="proof-title">
    <div class="container-site split">
      <div>
        <SectionHeading id="proof-title" title="Done means proven, not just claimed." lede="Every result comes with a Proof Pack: the evidence that it works on the exact revision, and an honest list of what wasn’t checked." />
        <ul class="ticks">{proof.map((c) => <li><Check class="h-4 w-4" aria-hidden="true" />{c}</li>)}</ul>
        <p class="fine">Passing tests are strong evidence, not a guarantee that every part of an app works. That’s why gaps are listed.</p>
        <div id="high-assurance" class="second anchor">
          <h3>Do your tests actually catch mistakes?</h3>
          <p>For high-assurance work, a Proof Pack can include a mutation challenge: Vekrun makes small deliberate changes to the code and checks whether your tests notice. Tests that miss them are listed, so you know where coverage is thin.</p>
        </div>
      </div>
      <div class="min-w-0"><ProofPack /></div>
    </div>
  </section>

  <section id="production" class="section-pad rule bg-bg-elevated anchor" aria-labelledby="production-title">
    <div class="container-site split">
      <div>
        <SectionHeading id="production-title" title="From a production error to the code behind it." lede="Production-to-Code Intelligence connects errors and stack traces from your monitoring tools to the relevant code, and shows it in its architectural context." />
        <ul class="ticks">{production.map((c) => <li><Check class="h-4 w-4" aria-hidden="true" />{c}</li>)}</ul>
      </div>
      <figure class="trace" aria-label="Example: a production error traced to code">
        <div class="trace-head"><ShieldAlert class="h-4 w-4" aria-hidden="true" /><span>NoMethodError in CheckoutTotal#apply_discount</span><em>Example</em></div>
        <ol class="trace-steps">
          <li><span>Error</span><p>312 events in the last hour · Honeybadger</p></li>
          <li><span>Code</span><p><code>app/services/checkout_total.rb:42</code></p></li>
          <li><span>Context</span><p>Called by Orders API · used by web and mobile checkout</p></li>
          <li><span>Likely cause</span><p>Changed in PR #471, two days ago</p></li>
          <li class="is-go"><span>Next</span><p>Work Item created with this context attached</p></li>
        </ol>
      </figure>
    </div>
  </section>

  <section id="delivery" class="section-pad rule anchor" aria-labelledby="delivery-title">
    <div class="container-site">
      <SectionHeading id="delivery-title" title="Your branches. Your policies. Your approvals." lede="Vekrun manages engineering work inside the workflow you already have. It keeps parallel work coordinated and respects your team’s Git rules." />
      <ul class="ticks cols">{delivery.map((c) => <li><Check class="h-4 w-4" aria-hidden="true" />{c}</li>)}</ul>
      <div class="duo">
        <div id="guardian" class="duo-i anchor">
          <span class="duo-ic"><ShieldCheck class="h-4 w-4" aria-hidden="true" /></span>
          <h3>PR Guardian</h3>
          <p>Looks after your pull requests once they’re open.</p>
          <ul class="ticks">{guardian.map((c) => <li><Check class="h-4 w-4" aria-hidden="true" />{c}</li>)}</ul>
        </div>
        <div id="templates" class="duo-i anchor">
          <span class="duo-ic"><Workflow class="h-4 w-4" aria-hidden="true" /></span>
          <h3>Workflow Templates</h3>
          <p>Start from a proven way of working instead of a blank prompt.</p>
          <ul class="ticks">{templates.map((c) => <li><Check class="h-4 w-4" aria-hidden="true" />{c}</li>)}</ul>
        </div>
      </div>
      <div id="board" class="anchor mt-12">
        <h3 class="h3">All your engineering work on one Board.</h3>
        <p class="sub-lede">Tickets, pull requests and production errors, each one a job away from a fix.</p>
        <div class="mt-6"><BoardFlow /></div>
      </div>
    </div>
  </section>

  <section id="work-anywhere" class="section-pad rule bg-bg-elevated anchor" aria-labelledby="anywhere-title">
    <div class="container-site">
      <div class="sub-head"><span class="state">Free and Teams</span></div>
      <SectionHeading id="anywhere-title" class="mt-4" title="Your laptop isn’t your build server. Unless you want it to be." lede="Work Anywhere runs your engineering Factory locally or on infrastructure you control. Use your own VPS for builds, tests and autonomous work, without buying Vekrun-hosted compute. It will be included in Vekrun Free." />
      <div class="mt-12"><WorkAnywhere /></div>
      <div class="split mt-14">
        <div>
          <h3 class="h3">What you get.</h3>
          <ul class="ticks">{anywhere.map((c) => <li><Check class="h-4 w-4" aria-hidden="true" />{c}</li>)}</ul>
        </div>
        <div>
          <h3 class="h3">From zero to a working server.</h3>
          <ol class="prov">{provisioning.map((c, i) => <li><span>{i + 1}</span>{c}</li>)}</ol>
          <ul class="prov-p" aria-label="Hosting providers we intend to support">{providers.map((p) => <li><IntegrationLogo id={p.id} name={p.name} monogram={p.mono} size="sm" />{p.name}</li>)}<li><span class="prov-srv"><Server class="h-3.5 w-3.5" aria-hidden="true" /></span>Any existing server</li></ul>
          <p class="fine">These providers are integration targets, not finished integrations. Vekrun will use provider APIs and command-line tools where they help, and a provider-independent path for servers you already have.</p>
        </div>
      </div>
      <h3 class="h3 h3-gap"><Lock class="inline h-5 w-5 align-[-3px] text-accent" aria-hidden="true" /> Private from the first boot.</h3>
      <p class="sub-lede">Vekrun is designed to set up remote workers with public management ports closed, authenticated private connectivity and isolated engineering environments.</p>
      <ul class="sec">{secure.map((c) => <li><h4>{c.t}</h4><p>{c.d}</p></li>)}</ul>
      <p class="fine">Security depends on your provider and server too; Vekrun aims for safe defaults, not a guarantee. A Tailscale-style private network and outbound tunnels are the design; neither Tailscale nor any provider integration is finished, and Cloudflare Tunnel won’t be required. Teams adds shared worker pools; see <a href="/teams/#workers" class="text-accent link-slide">Vekrun Teams</a>.</p>
    </div>
  </section>

  <section id="environments" class="section-pad rule anchor" aria-labelledby="env-title">
    <div class="container-site split">
      <div>
