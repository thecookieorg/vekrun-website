---
/**
 * The Product page: what Vekrun is made of. Models first (the native agent,
 * optional coding agents), then Engineering Memory, Live Share, your stack, the
 * Board, mobile and the hands-on tools. The workflow itself is on How It Works.
 * Section ids are stable: old feature and docs URLs redirect to them.
 */
import Base from '@/layouts/Base.astro';
import ClosingCta from '@/components/ClosingCta.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Screenshot from '@/components/visuals/Screenshot.astro';
import ModelChoice from '@/components/home/ModelChoice.astro';
import IntegrationLogo from '@/components/brand/IntegrationLogo.astro';
import BoardFlow from '@/components/factory/BoardFlow.astro';
import MobileHost from '@/components/factory/MobileHost.astro';
import { productSections } from '@/data/site';
import { stackRows } from '@/data/integrations';
import { SquareTerminal, FileDiff, GitBranch, MessagesSquare, ArrowRight, Link2, KeyRound, MousePointerClick, Wrench, ScanSearch, Compass, NotebookText, ScrollText } from '@lucide/astro';

const share = [
  { i: Link2, t: 'One permanent HTTPS link', d: 'The app you’re building, at the same address every time you share it. It’s served from your machine while Live Share is on, not hosted for you.' },
  { i: KeyRound, t: 'You decide who gets in', d: 'Anyone with the link, a password, or off. Sign everyone out whenever you like.' },
  { i: MousePointerClick, t: 'Reviewers point at it', d: 'Clients and teammates select what’s wrong on the page and say why. No account needed.' },
  { i: Wrench, t: 'Approved feedback gets fixed', d: 'Feedback waits in your Review Inbox. Approve it and the Factory fixes it and verifies the fix.' },
];
const memory = [
  { i: ScanSearch, t: 'Reads the repository', d: 'Structure, manifests, CI, entry points, docs and tests. Read-only, and nothing leaves your computer.' },
  { i: Compass, t: 'Learns how it’s built', d: 'Conventions and architecture, explained from the files themselves and marked as interpretation, not fact.' },
  { i: NotebookText, t: 'Imports your team’s notes', d: 'Add an Obsidian vault. Vekrun keeps what the notes say apart from what the code proves, and never edits a note.' },
  { i: ScrollText, t: 'Remembers why', d: 'Every decision, change and verification, linked to the work it came from. Insights show what actually shipped.' },
];
const tools = [
  { i: SquareTerminal, t: 'Terminal and SSH', d: 'Open a shell in any job, here or on a remote machine.' },
  { i: FileDiff, t: 'Code and diffs', d: 'Read exactly what changed before it goes anywhere.' },
  { i: GitBranch, t: 'Git and worktrees', d: 'Branches per job, so work never collides.' },
  { i: MessagesSquare, t: 'Coding sessions', d: 'Pair with a model directly when you’d rather drive.' },
];
---
<Base title="Product" fullTitle="Product: your AI engineering team, on your machine · Vekrun" description="Vekrun's native agent runs the engineering workflow with the models you choose: OpenRouter or local models, with Claude Code, Codex and Antigravity as optional integrations. Engineering Memory, Live Share and any stack.">
  <PageHero eyebrow="Product" title="An AI engineering team that runs on your machine." lede="Vekrun’s own agent, the models you choose, a memory of your project and a way to show the app while you build it." cta={{ label: 'Request early access', href: '/download/' }} secondary={{ label: 'How it works', href: '/how-it-works/' }} wide>
    <Screenshot name="browser-annotate" eager alt="The Vekrun desktop app's Interactive Browser: a checkout page with two numbered comments, each queued as work for an agent." caption="The Interactive Browser in the Vekrun desktop app. Point at what’s wrong; each comment becomes verified work." />
  </PageHero>

  <nav class="pnav" aria-label="On this page">
    <div class="container-site"><ul>{productSections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}</ul></div>
  </nav>

  <section id="models" class="section-pad anchor" aria-labelledby="models-title">
    <div class="container-site">
      <SectionHeading id="models-title" title="Your models. Your choice." lede="Vekrun’s native agent runs the whole workflow with OpenRouter or a local model. Claude Code, Codex and Antigravity are optional: bring them if you already use them." />
      <div class="mt-12"><ModelChoice /></div>
    </div>
  </section>

  <section id="memory" class="section-pad rule bg-bg-elevated anchor" aria-labelledby="memory-title">
    <div class="container-site">
      <SectionHeading id="memory-title" title="Your project shouldn’t start from zero every session." lede="Engineering Memory starts with your repository and your team’s own notes, and grows with every decision the Factory makes." />
      <div class="mt-12"><Screenshot name="memory-understand" width={1440} height={437} alt="Engineering Memory in the Vekrun desktop app: Understand this project lists what was read (files and languages, manifests and CI, entry points, code map, docs and tests, Git history, interpretations), above Knowledge sources with an Add Obsidian vault button." caption="Engineering Memory in the Vekrun desktop app: project understanding and knowledge sources." /></div>
      <ul class="pts">
        {memory.map((t) => <li><t.i class="h-5 w-5 text-accent" aria-hidden="true" /><h3>{t.t}</h3><p>{t.d}</p></li>)}
      </ul>
    </div>
  </section>

  <section id="live-share" class="section-pad rule anchor" aria-labelledby="share-title">
    <div class="container-site">
      <SectionHeading id="share-title" title="Don’t send screenshots. Send the app." lede="Live Share puts the app you’re building on a secure link while you build it. Reviewers point at what’s wrong; the Factory fixes what you approve and proves the fix." />
      <div class="mt-12"><Screenshot name="liveshare-review" alt="The Live Share Review Inbox in the Vekrun desktop app: a reviewer’s comment about a cramped checkout heading, with the region they selected highlighted on the page and the page, viewport and revision recorded." caption="Live Share’s Review Inbox in the Vekrun desktop app. Each comment keeps the exact region, page and revision it refers to." /></div>
      <ul class="pts">
        {share.map((t) => <li><t.i class="h-5 w-5 text-accent" aria-hidden="true" /><h3>{t.t}</h3><p>{t.d}</p></li>)}
      </ul>
      <p class="mt-8 text-[0.92rem] text-text-2">Live Share is optional and relays through a gateway Vekrun operates. <a href="/privacy/#live-share" class="text-accent link-slide">What it relays and keeps</a></p>
    </div>
  </section>

  <section id="stack" class="section-pad rule bg-bg-elevated anchor" aria-labelledby="stack-title">
    <div class="container-site">
      <SectionHeading id="stack-title" title="Built for whole products, in any stack." lede="An Expo app and its Rails API, a Laravel shop, a Tauri desktop client. Vekrun works in your repositories with your project’s own tooling and coordinates the pieces together." />
      <ul class="plat" aria-label="Technologies">
        {stackRows.flat().map((t) => <li><IntegrationLogo id={t.id} name={t.name} monogram={t.mono} size="sm" />{t.name}</li>)}
      </ul>
    </div>
  </section>

  <section id="board" class="section-pad rule anchor" aria-labelledby="board-title">
    <div class="container-site">
      <SectionHeading id="board-title" title="All your engineering work on one Board." lede="Tickets, pull requests and production errors, each one a job away from a fix." />
      <div class="mt-12"><BoardFlow /></div>
    </div>
  </section>

  <section id="mobile" class="section-pad rule bg-bg-elevated anchor" aria-labelledby="mobile-title">
    <div class="container-site">
      <SectionHeading id="mobile-title" title="Your Factory, in your pocket." lede="Assign work and approve it from your phone, while your own machine does the building." />
      <div class="mt-12"><MobileHost /></div>
      <p class="mt-10"><a href="/pricing/" class="link-more group">Want it hosted or on your servers? See Cloud and Enterprise<ArrowRight class="icon-nudge h-4 w-4" aria-hidden="true" /></a></p>
    </div>
  </section>

  <section id="tools" class="section-pad rule anchor" aria-labelledby="tools-title">
    <div class="container-site">
      <SectionHeading id="tools-title" title="Step in whenever you want." lede="Every job comes with the tools to take over by hand. Your editor stays your editor." />
      <ul class="pts">
        {tools.map((t) => <li><t.i class="h-5 w-5 text-accent" aria-hidden="true" /><h3>{t.t}</h3><p>{t.d}</p></li>)}
      </ul>
    </div>
  </section>

  <ClosingCta title="Hand Vekrun your next outcome." class="bg-bg-elevated" />
</Base>

<style>
  .anchor { scroll-margin-top: 7rem; }
  .pnav { position: sticky; top: 4rem; z-index: 20; border-block: 1px solid var(--border); background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .pnav ul { margin: 0; padding: 0.5rem 0; list-style: none; display: flex; gap: 0.25rem; overflow-x: auto; scrollbar-width: none; }
  .pnav ul::-webkit-scrollbar { display: none; }
  .pnav a { display: inline-flex; align-items: center; height: 2rem; padding: 0 0.75rem; border-radius: var(--radius-sm); font-size: 0.875rem; color: var(--text-2); white-space: nowrap; }
  .pnav a:hover { color: var(--text); background: var(--surface); }
  .plat { margin: 2.5rem 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .plat li { display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.4rem 0.85rem 0.4rem 0.45rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); font-size: 0.95rem; color: var(--text); }
  .pts { margin: 3rem 0 0; padding: 0; list-style: none; display: grid; gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
  @media (min-width: 40rem) { .pts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .pts { grid-template-columns: repeat(4, minmax(0, 1fr)); } .pts-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .pts li { display: grid; gap: 0.5rem; align-content: start; padding: 1.5rem; background: var(--surface); }
  .pts h3 { margin: 0.25rem 0 0; font-size: 1.05rem; font-weight: 600; color: var(--text); }
  .pts p { margin: 0; font-size: 0.92rem; line-height: 1.5; color: var(--text-2); }
</style>
